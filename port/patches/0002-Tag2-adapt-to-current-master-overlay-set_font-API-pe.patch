From 2d9be47cf753e930031ebaf301e50f086ab38949 Mon Sep 17 00:00:00 2001
From: tag2-port <tag2@local>
Date: Fri, 13 Nov 2026 13:23:01 +0900
Subject: [PATCH 2/5] Tag2: adapt to current master (overlay set_font API,
 persistent VK pipeline cache into pipe compiler, portability fixes)

- set_font(name,size) -> set_font(size,name) for upstream overlay API change
- feed render_device persistent pipeline cache into upstream shared pipe compiler cache (not destroyed twice)
- hex literal pp-number fixes (0x1e+x) for GCC/Clang
- -fexceptions for SPIRVCommon.cpp / vkutils/device.cpp in CMake (matches vcxproj)
- ggpo platform_windows.h: include mmsystem.h for timeGetTime under WIN32_LEAN_AND_MEAN
---
 3rdparty/ggpo_sync/src/lib/ggpo/platform_windows.h | 1 +
 rpcs3/Emu/CMakeLists.txt                           | 2 +-
 rpcs3/Emu/Cell/TTT2LobbySnapshot.h                 | 4 ++--
 rpcs3/Emu/Cell/green_rollback_native.h             | 2 +-
 rpcs3/Emu/ttt2_framedata.h                         | 2 +-
 rpcs3/rpcs3qt/tag2_lobby_overlay.h                 | 2 +-
 6 files changed, 7 insertions(+), 6 deletions(-)

diff --git a/3rdparty/ggpo_sync/src/lib/ggpo/platform_windows.h b/3rdparty/ggpo_sync/src/lib/ggpo/platform_windows.h
index 1d308ceb0..aaaedc4b6 100644
--- a/3rdparty/ggpo_sync/src/lib/ggpo/platform_windows.h
+++ b/3rdparty/ggpo_sync/src/lib/ggpo/platform_windows.h
@@ -11,6 +11,7 @@
 #include <winsock2.h>
 #include <ws2tcpip.h>
 #include <windows.h>
+#include <mmsystem.h> // timeGetTime (not pulled in under WIN32_LEAN_AND_MEAN)
 #include <stdio.h>
 #include "types.h"
 
diff --git a/rpcs3/Emu/CMakeLists.txt b/rpcs3/Emu/CMakeLists.txt
index 6f583bfde..d9f6133b6 100644
--- a/rpcs3/Emu/CMakeLists.txt
+++ b/rpcs3/Emu/CMakeLists.txt
@@ -108,7 +108,7 @@ set_source_files_properties("../../Utilities/JITLLVM.cpp" "../../Utilities/JITAS
     SKIP_PRECOMPILE_HEADERS ON
 )
 
-set_source_files_properties("../util/yaml.cpp" "Cell/GreenGGPOHost.cpp" "Cell/GreenGGPO.cpp" "Cell/TTT2LobbyPass.cpp" "ttt2_framedata.cpp" PROPERTIES
+set_source_files_properties("../util/yaml.cpp" "Cell/GreenGGPOHost.cpp" "Cell/GreenGGPO.cpp" "Cell/TTT2LobbyPass.cpp" "ttt2_framedata.cpp" "RSX/Program/SPIRVCommon.cpp" "RSX/VK/vkutils/device.cpp" PROPERTIES
     COMPILE_FLAGS "$<IF:$<CXX_COMPILER_ID:MSVC>,/EHsc,-fexceptions>"
     SKIP_PRECOMPILE_HEADERS ON
 )
diff --git a/rpcs3/Emu/Cell/TTT2LobbySnapshot.h b/rpcs3/Emu/Cell/TTT2LobbySnapshot.h
index 6c37c31cb..4afc3be0a 100644
--- a/rpcs3/Emu/Cell/TTT2LobbySnapshot.h
+++ b/rpcs3/Emu/Cell/TTT2LobbySnapshot.h
@@ -10,9 +10,9 @@ inline std::optional<snapshot> read_room_snapshot(std::span<const std::uint8_t>
   const auto member=0x14+i*0x6c;
   if(data[member+4]){
    if(get(member,4)!=i)return {};out.active|=1U<<i;if(data[member+0x14])out.ready|=1U<<i;
-   unsigned length=0;while(length<17&&data[member+0x1e+length])++length;
+   unsigned length=0;while(length<17&&data[member+0x1e +length])++length;
    if(!length||length==17)return {};
-   for(unsigned j=0;j<length;++j)out.accounts[i][j]=static_cast<char>(data[member+0x1e+j]);
+   for(unsigned j=0;j<length;++j)out.accounts[i][j]=static_cast<char>(data[member+0x1e +j]);
   }
  }
  if(!valid_snapshot(out)||static_cast<std::int32_t>(get(0x29c,4))!=out.queue[0]||static_cast<std::int32_t>(get(0x2a0,4))!=out.queue[1])return {};
