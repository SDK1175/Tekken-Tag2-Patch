+  if(entry.directory)continue;QByteArray plain;
+  if(entry.method==0){if(entry.compressed!=entry.size)throw Failure("Stored ZIP size mismatch");plain=data.mid(entry.offset,entry.size);}
+  else {
+   plain.resize(qMax<quint32>(1,entry.size));z_stream stream{};
+   stream.next_in=reinterpret_cast<Bytef*>(const_cast<char*>(data.constData()+entry.offset));stream.avail_in=entry.compressed;
+   stream.next_out=reinterpret_cast<Bytef*>(plain.data());stream.avail_out=static_cast<uInt>(plain.size());
