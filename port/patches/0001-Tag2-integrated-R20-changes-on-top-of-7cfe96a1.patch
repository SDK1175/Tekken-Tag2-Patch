+   if(!stage.isEmpty()){const auto parent=restart_arguments();QStringList args={"--tag2-recover",root,"--tag2-parent-pid",parent[1],"--tag2-parent-created",parent[2]};if(parser.isSet("tag2-resume-rollback"))args<<"--tag2-resume-rollback";pending_exit=ExitRequest{safe_path(stage,"rpcs3.exe"),root,args};result=0;return true;}
+   if(frames){
+    if(!qobject_cast<QApplication*>(QCoreApplication::instance()))throw Failure("Frame installation needs graphical startup");
+    NativeProgressDialog progress(QString::fromUtf8("프레임표 설치 중…"),QString{},0,0);progress.prevent_cancel();progress.setAutoClose(false);progress.setAutoReset(false);progress.setMinimumDuration(0);progress.setWindowModality(Qt::ApplicationModal);progress.show();QApplication::processEvents();
+    apply_frames(root,parser.value("tag2-frame-apply"),[&](const QString&,int n,int total){progress.setLabelText(QString::fromUtf8("프레임표 설치 중… %1 / %2").arg(n).arg(total));progress.setRange(0,total);progress.setValue(n);QApplication::processEvents();});progress.hide();
+    QCoreApplication::instance()->setProperty("tag2.frame_installed",true);
+   }
