+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+#include "ttt2_input_r4_build.h"
+#include "ttt2_input_r4_core.h"
+#include <array>
+#include <atomic>
+#include <cstdlib>
+#include <string>
+#include <string_view>
+#include <utility>
+namespace ttt2::input_r4
+{
+    inline std::string environment(const char* name)
+    {
+#ifdef _WIN32
+        char* value=nullptr; std::size_t length=0;
+        if (_dupenv_s(&value, &length, name) || !value) return {};
+        const std::string result(value); std::free(value); return result;
+#else
+        const char* value=std::getenv(name); return value ? value : "";
+#endif
+    }
+    inline bool enabled() { static const bool on=environment("TTT2_INPUT_R4_MODE")!="off"; return on; }
+    inline bool tracing()
+    {
+#if TTT2_INPUT_R4_MEASURE
+        static const bool on=!environment("TTT2_INPUT_R4_CSV").empty(); return on;
+#else
+        return false;
+#endif
+    }
+    inline bool target(std::string_view title, std::string_view version) { return title=="BLES01702" && version=="01.03"; }
+    enum class refresh_status : unsigned { disabled, busy, not_ready, masked, unsupported, recent, circuit_open, pulled };
+    struct refresh_result { refresh_status status=refresh_status::disabled; std::uint64_t us=0; backend device=backend::none; };
+    struct input_state
+    {
+        std::mutex gate;
+        bool ready=false;
+        std::array<std::atomic<std::uint64_t>,7> published{};
+        std::array<slow_guard,6> slow{};
+    };
+    template<class F> struct scope_exit { F f; explicit scope_exit(F func):f(std::move(func)) {} ~scope_exit(){ f(); } };
+}
