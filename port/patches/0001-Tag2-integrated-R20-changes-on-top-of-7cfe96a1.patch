+  FD_PY_BIND(init_config,"PyConfig_InitIsolatedConfig");FD_PY_BIND(set_string,"PyConfig_SetString");
+  FD_PY_BIND(append,"PyWideStringList_Append");FD_PY_BIND(initialize_config,"Py_InitializeFromConfig");
+  FD_PY_BIND(clear_config,"PyConfig_Clear");FD_PY_BIND(add_module,"PyImport_AddModule");
+  FD_PY_BIND(get_dict,"PyModule_GetDict");FD_PY_BIND(get_attribute,"PyObject_GetAttrString");
+  FD_PY_BIND(callable_check,"PyCallable_Check");FD_PY_BIND(call_object,"PyObject_CallObject");
+  FD_PY_BIND(run_string,"PyRun_StringFlags");FD_PY_BIND(decref,"Py_DecRef");
+  FD_PY_BIND(err_clear,"PyErr_Clear");FD_PY_BIND(save_thread,"PyEval_SaveThread");
+  FD_PY_BIND(restore_thread,"PyEval_RestoreThread");FD_PY_BIND(finalize,"Py_FinalizeEx");
+#undef FD_PY_BIND
