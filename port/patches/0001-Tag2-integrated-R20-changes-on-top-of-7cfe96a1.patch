+  if(u32(data,offset)!=0x04034b50||u16(data,offset+6)!=flags||u16(data,offset+8)!=method)throw Failure("ZIP local header mismatch");
+  quint16 localName=u16(data,offset+26),localExtra=u16(data,offset+28);
