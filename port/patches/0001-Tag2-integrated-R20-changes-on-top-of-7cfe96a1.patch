+ttt2::input_r4::refresh_result pad_thread::latency4_refresh(u32 port_no)
+{
+    using namespace ttt2::input_r4;
+    refresh_result result;
+    if (!enabled() || port_no>=m_pads.size() || !target(Emu.GetTitleID(),Emu.GetAppVersion())) return result;
+    std::unique_lock gate(m_latency4.gate,std::try_to_lock);
+    if (!gate.owns_lock()) {result.status=refresh_status::busy;return result;}
+    if (!m_latency4.ready || pad::g_reset || !pad::g_enabled || !Emu.IsRunning()
+        || g_cfg.io.pad_mode!=pad_handler_mode::single_threaded) {result.status=refresh_status::not_ready;return result;}
+    std::shared_ptr<PadHandlerBase> handler;
+    pad_handler type=pad_handler::null;
+    {
+        std::lock_guard lock(pad::g_pad_mutex);
+        const auto& p=m_pads[port_no];
+        if (!p || p->is_fake_pad || p->ldd || !p->is_connected() || m_info.ignore_input
+            || (m_info.system_info&CELL_PAD_INFO_INTERCEPTED) || !is_input_allowed())
+        {result.status=refresh_status::masked;return result;}
+        type=p->m_pad_handler;result.device=pad::latency4_backend(type);
+        if (!can_pull(result.device)) {result.status=refresh_status::unsupported;return result;}
+        // Do not partially refresh a handler with mixed copilot / virtual bindings.
+        for (const auto& other:m_pads)
+            if (other && other->m_pad_handler==type && (other->ldd || other->is_fake_pad || !other->copilots.empty() || other->is_copilot()))
+            {result.status=refresh_status::unsupported;return result;}
+        auto it=m_handlers.find(type);
+        if (it==m_handlers.end() || !it->second) {result.status=refresh_status::not_ready;return result;}
+        handler=it->second;
+    }
+    auto& guard=m_latency4.slow[static_cast<unsigned>(result.device)];
+    if (guard.disabled) {result.status=refresh_status::circuit_open;return result;}
+    const u64 start=get_system_time();
+    if (recent(m_latency4.published[port_no].load(std::memory_order_acquire),start))
+    {result.status=refresh_status::recent;return result;}
+    // XInput/MM only. No HID/SDL event pumping or OS poll while g_pad_mutex is held.
+    handler->process();
+    apply_copilots(type);
+    const u64 end=get_system_time();result.us=end>=start?end-start:0;
+    guard.observe(result.us);result.status=refresh_status::pulled;return result;
+}
