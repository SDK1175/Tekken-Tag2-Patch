+#include <yaml-cpp/yaml.h>
+namespace tag2 {
+namespace practice_config_detail {
+inline const QString target="config/patch_config.yml",folder=".tag2-native/practice-positions-v1/",identity="TAG2-PRACTICE-POSITIONS-20261110-1";
+inline QStringList keys(){return {"PPU-8645cfa235c9980ff74b5e06388b29e97fdbbed9",QString::fromUtf8("프랙티스 시작 위치 저장·불러오기"),"TEKKEN TAG TOURNAMENT 2","BLES01702","01.03","Enabled"};}
+inline void validate(const YAML::Node& node,int depth,int& count,QList<YAML::Node>& parents,QList<YAML::Node>& visited,bool& shared){
+ if(++count>100000||depth>64)throw Failure("Practice configuration structure limit");
