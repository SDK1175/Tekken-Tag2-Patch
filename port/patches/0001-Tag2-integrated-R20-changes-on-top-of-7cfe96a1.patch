+namespace tag2 {
+namespace {
+#include "tag2_native_frames.inc"
+const QString pending_path=".tag2-native/frames/pending.json";
+const QString receipt_path=".tag2-native/frames/installed.json";
+const QString flag_path="green_rollback/framedata_enabled.txt";
+const QString prefs_path="ttt2_framedata/settings.json";
+
+const QString previous_package_id="TAG2-FRAMES-20261103-1";
+const QMap<QString,QString>& previous_pins(){
+ static const auto pins=[] {auto result=frame_pins;for(auto it=frame_hotfix_before.begin();it!=frame_hotfix_before.end();++it)result[it.key()]=it.value();return result;}();
+ return pins;
+}
+QByteArray receipt_bytes(bool previous=false){return QJsonDocument(QJsonObject{{"schema",1},{"package",previous?previous_package_id:frame_package_id},{"manifest_sha256",previous?frame_base_manifest_hash:frame_manifest_hash}}).toJson();}
+QJsonObject preferences(const QString& root){
+ const auto path=safe_path(root,prefs_path);
+ return QFileInfo::exists(path)?strict_json(read_bytes(path,65536)):QJsonObject{};
+}
+void legacy_clear(const QString& root){
+ for(const QString& p:{".green-online-backups/frame-startup-20261102/active.json",".green-online-backups/framedata-next-20261102/active.json"})
+  if(QFileInfo::exists(safe_path(root,p)))throw Failure(QString::fromUtf8("이전 프레임표 설치 복구가 남아 있습니다: ")+p);
+}
+QSet<QString> frame_allowed(){QSet<QString> result;for(auto it=frame_pins.begin();it!=frame_pins.end();++it)result.insert(it.key());result.insert("frame-manifest.json");return result;}
+void verify_files(const QString& root,bool previous=false){
+ const auto& pins=previous?previous_pins():frame_pins;
+ for(auto it=pins.begin();it!=pins.end();++it)
+  if(hash_file(safe_path(root,it.key()))!=it.value())throw Failure(QString::fromUtf8("프레임표 파일이 없거나 변경되었습니다. 프레임표 다시 설치를 눌러 주세요: ")+it.key());
+}
+bool verified_ui_files(const QString& root){
+ // UI polling may reuse a successful hash check only while every payload
+ // file keeps its size and timestamp. Install, startup and launch never use
+ // this cache and independently hash the complete cohort.
+ struct Check { QByteArray fingerprint; bool valid=false; };
+ static QMap<QString,Check> checks;
+ QByteArray fingerprint;
+ for(auto it=frame_pins.begin();it!=frame_pins.end();++it){
+  const QFileInfo file(safe_path(root,it.key()));if(!file.isFile())return false;
+  fingerprint+=it.key().toUtf8()+'\0'+QByteArray::number(file.size())+':'+QByteArray::number(file.lastModified().toMSecsSinceEpoch())+'\n';
+ }
+ auto& cached=checks[root];
+ if(cached.fingerprint!=fingerprint){
+  cached.fingerprint=fingerprint;cached.valid=false;
+  try{verify_files(root);cached.valid=true;}catch(const Failure&){}
+ }
+ return cached.valid;
+}
+QString stage_relative(const QString& root,const QString& stage){
+ safe_absolute(root);safe_absolute(stage);
+ const auto relative=QDir(root).relativeFilePath(QFileInfo(stage).absoluteFilePath());
+ if(!QRegularExpression("^\\.tag2-native/frame-downloads/[0-9a-f]{32}$").match(relative).hasMatch())throw Failure("Unexpected frame staging folder");
+ return relative;
+}
+void write_verified(const QString& to,const QByteArray& bytes,const QString& expected){
+ if(hash_bytes(bytes)!=expected)throw Failure("Frame staging content changed");
+ atomic_write(to,bytes);
+ if(hash_file(to)!=expected)throw Failure("Frame write verification failed");
+}
+void upgrade_downloaded_frames(const QString& stage){
+ // The archive is still the pinned public base release. Upgrade only its
+ // verified staging files; normal apply/recovery commits the repaired cohort.
+ if(hash_file(safe_path(stage,"frame-manifest.json"))!=frame_base_manifest_hash)throw Failure("Frame base manifest changed");
+ for(auto it=frame_hotfix_before.begin();it!=frame_hotfix_before.end();++it)
+  if(hash_file(safe_path(stage,it.key()))!=it.value())throw Failure("Frame base source changed: "+it.key());
+ for(auto it=frame_hotfix_files.begin();it!=frame_hotfix_files.end();++it)
+  write_verified(safe_path(stage,it.key()),it.value(),frame_pins.value(it.key()));
+ write_verified(safe_path(stage,"frame-manifest.json"),frame_hotfix_manifest,frame_manifest_hash);
+}
+void validate_stage(const QString& root,const QString& stage,bool previous=false){
+ stage_relative(root,stage);
+ if(hash_file(safe_path(stage,"frame-manifest.json"))!=(previous?frame_base_manifest_hash:frame_manifest_hash))throw Failure("Unexpected frame package manifest");
+ verify_files(stage,previous);
+}
+void recover_locked(const QString& root,Progress progress){
+ const auto pending=safe_path(root,pending_path);if(!QFileInfo::exists(pending))return;
+ const auto journal=strict_json(read_bytes(pending));
+ const bool previous=journal["package"]==previous_package_id;
+ if(journal["schema"].toInt()!=1||(!previous&&journal["package"]!=frame_package_id)||!journal["operations"].isArray())throw Failure("Unsupported frame recovery journal");
+ const auto availability=journal.contains("availability")?journal["availability"].toString().toUtf8():QByteArray("1\n");
+ if((availability!="0\n"&&availability!="1\n")||(previous&&availability!="1\n"))throw Failure("Invalid frame recovery availability");
+ const auto stage=safe_path(root,journal["stage"].toString());validate_stage(root,stage,previous);
+ const auto& pins=previous?previous_pins():frame_pins;
+ QMap<QString,QString> expected=pins;expected.insert(flag_path,hash_bytes(availability));expected.insert(receipt_path,hash_bytes(receipt_bytes(previous)));
+ const auto operations=journal["operations"].toArray();QSet<QString> seen;
+ for(const auto value:operations){
+  const auto row=value.toObject();const auto path=row["path"].toString(),before=row["before"].toString(),after=row["after"].toString();
+  if(!expected.contains(path)||seen.contains(path)||after!=expected[path]||(!before.isEmpty()&&!QRegularExpression("^[0-9a-f]{64}$").match(before).hasMatch()))throw Failure("Invalid frame recovery operation");
+  seen.insert(path);
+  if(!before.isEmpty()&&hash_file(safe_path(stage,"original/"+path))!=before)throw Failure("Frame backup changed");
+  const auto current=hash_file(safe_path(root,path));if(current!=before&&current!=after)throw Failure("Frame files changed during interrupted install: "+path);
+ }
+ QSet<QString> expected_paths;for(auto it=expected.begin();it!=expected.end();++it)expected_paths.insert(it.key());
+ if(seen!=expected_paths)throw Failure("Incomplete frame recovery operations");
+ // Payload first, availability flag next, receipt last. Pending journal blocks launch.
+ QStringList ordered=pins.keys();ordered<<flag_path<<receipt_path;int count=0;
+ for(const auto& path:ordered){
+  assert_stopped(root);QJsonObject row;for(const auto value:operations)if(value.toObject()["path"]==path){row=value.toObject();break;}
+  const auto target=safe_path(root,path),current=hash_file(target);
+  if(current!=row["before"].toString()&&current!=expected[path])throw Failure("Frame target changed during install: "+path);
+  if(current!=expected[path]){
+   const auto bytes=path==flag_path?availability:path==receipt_path?receipt_bytes(previous):read_bytes(safe_path(stage,path),32*1024*1024);
+   write_verified(target,bytes,expected[path]);
+  }
+  if(progress)progress("frame-commit",++count,ordered.size());
+ }
+ verify_files(root,previous);
+ for(const auto& path:{flag_path,receipt_path})if(hash_file(safe_path(root,path))!=expected[path])throw Failure("Frame final verification failed");
+ atomic_write(safe_path(stage,"receipt.json"),QJsonDocument(journal).toJson());
+ if(!QFile::remove(pending))throw Failure("Cannot finish frame recovery");
+}
+}
+
+FrameState frame_state(const QString& root){
+ FrameState state;
+ if(QFileInfo::exists(safe_path(root,pending_path)))return state;
+ const auto receipt=safe_path(root,receipt_path);if(!QFileInfo::exists(receipt))return state;
+ state.installed=true;
+ try{
+  if(read_bytes(receipt,4096)!=receipt_bytes())return state;
+  state.ready=read_bytes(safe_path(root,flag_path),32)=="1\n"&&verified_ui_files(root);
+  const auto prefs=preferences(root);state.enabled=state.ready&&prefs["enabled"].isBool()&&prefs["enabled"].toBool();
+ }catch(const Failure&){state.enabled=false;}
+ return state;
+}
+void verify_frame_runtime(const QString& root){
+ legacy_clear(root);
+ if(QFileInfo::exists(safe_path(root,pending_path)))throw Failure("Frame installation recovery pending");
+ const auto flag=read_bytes(safe_path(root,flag_path),32);
+ if(flag!="0\n"&&flag!="1\n")throw Failure("Invalid optional frame setting");
+ const bool receipt=QFileInfo::exists(safe_path(root,receipt_path));
+ if(!receipt){if(flag=="1\n")throw Failure("Unverified optional frame runtime");return;}
+ if(read_bytes(safe_path(root,receipt_path),4096)!=receipt_bytes())throw Failure(QString::fromUtf8("프레임표 버전 확인이 필요합니다. 프레임표 다시 설치를 눌러 주세요."));
+ // Stable U1 starts capture unconditionally; validate both launch modes.
+ verify_files(root);
+}
+void set_frame_display(const QString& root,bool enabled){
+ NativeTransaction lock(root);legacy_clear(root);
+ if(!frame_state(root).ready)throw Failure(QString::fromUtf8("프레임표를 먼저 설치해 주세요."));
+ verify_frame_runtime(root);auto prefs=preferences(root);prefs["enabled"]=enabled;
+ atomic_write(safe_path(root,prefs_path),QJsonDocument(prefs).toJson());
+}
+void validate_frame_stage(const QString& root,const QString& stage){
+ validate_stage(root,stage);
+}
+QString stage_frames(const QString& root,Progress progress,const std::function<bool()>& cancelled){
+ legacy_clear(root);
+ const auto bytes=fetch(QUrl(frame_zip_url),frame_zip_size,progress,cancelled);
+ if(progress)progress("verify",0,0);
+ if(cancelled&&cancelled())throw Failure("Cancelled");
+ if(bytes.size()!=frame_zip_size||hash_bytes(bytes)!=frame_zip_hash)throw Failure("Frame ZIP size or SHA256 mismatch");
+ if(cancelled&&cancelled())throw Failure("Cancelled");
+ const auto stage=safe_path(root,".tag2-native/frame-downloads/"+QUuid::createUuid().toString(QUuid::Id128));
+ if(progress)progress("unpack",0,0);
+ if(cancelled&&cancelled())throw Failure("Cancelled");
+ unpack_zip(bytes,stage,frame_allowed());
+ upgrade_downloaded_frames(stage);
+ if(progress)progress("verify",0,0);
+ if(cancelled&&cancelled())throw Failure("Cancelled");
+ validate_frame_stage(root,stage);
+ if(cancelled&&cancelled())throw Failure("Cancelled");return stage;
+}
+static void apply_locked(const QString& root,const QString& stage,Progress progress,const QByteArray& availability,bool upgrading=false){
+ validate_frame_stage(root,stage);
+ verify_installed(root,parse_package(read_bytes(safe_path(root,manifest_path))));
+ QMap<QString,QString> expected=frame_pins;expected.insert(flag_path,hash_bytes(availability));expected.insert(receipt_path,hash_bytes(receipt_bytes()));
+ QMap<QString,QString> originals=previous_pins();originals.insert(flag_path,hash_bytes(availability));originals.insert(receipt_path,hash_bytes(receipt_bytes(true)));
+ QJsonArray operations;
+ for(auto it=expected.begin();it!=expected.end();++it){
+  const auto target=safe_path(root,it.key()),before=hash_file(target);
+  if(upgrading&&before!=originals.value(it.key()))throw Failure("Frame source changed before migration: "+it.key());
+  if(!before.isEmpty()){
+   const auto backup=safe_path(stage,"original/"+it.key());
+   if(QFileInfo::exists(backup)&&hash_file(backup)!=before)throw Failure("Frame stage was already used; download a fresh copy");
+   write_verified(backup,read_bytes(target,32*1024*1024),before);
+  }
+  operations.append(QJsonObject{{"path",it.key()},{"before",before},{"after",it.value()}});
+ }
+ for(const auto value:operations){const auto row=value.toObject();if(hash_file(safe_path(root,row["path"].toString()))!=row["before"].toString())throw Failure("Frame target changed while staging");}
+ assert_stopped(root);
+ atomic_write(safe_path(root,pending_path),QJsonDocument(QJsonObject{{"schema",1},{"package",frame_package_id},{"availability",QString::fromUtf8(availability)},{"stage",stage_relative(root,stage)},{"operations",operations}}).toJson());
+ if(progress)progress("frame-prepared",0,operations.size());recover_locked(root,progress);
+}
+void apply_frames(const QString& root,const QString& stage,Progress progress){
+ NativeTransaction lock(root);lock.recover();lock.recover_legacy();legacy_clear(root);recover_locked(root,progress);
+ apply_locked(root,stage,progress,"1\n");
+}
+void recover_frames(const QString& root,Progress progress){
+ auto exact_previous=[&]{try{return read_bytes(safe_path(root,receipt_path),4096)==receipt_bytes(true);}catch(const Failure&){return false;}};
+ if(!QFileInfo::exists(safe_path(root,pending_path))&&!exact_previous())return;
+ NativeTransaction lock(root);lock.recover();lock.recover_legacy();legacy_clear(root);recover_locked(root,progress);
+ if(!exact_previous())return;
+ QByteArray availability;
+ try{
+  verify_files(root,true);availability=read_bytes(safe_path(root,flag_path),32);
+  if(availability!="0\n"&&availability!="1\n")return;
+ }catch(const Failure&){return;} // Unknown or damaged optional files need explicit repair.
+ // The prior immutable cohort is recognized in full. Build a new private
+ // stage locally; the journal below backs up every original before writing.
+ const auto stage=safe_path(root,".tag2-native/frame-downloads/"+QUuid::createUuid().toString(QUuid::Id128));
+ for(auto it=frame_pins.begin();it!=frame_pins.end();++it){
+  const auto bytes=frame_hotfix_files.contains(it.key())?frame_hotfix_files.value(it.key()):read_bytes(safe_path(root,it.key()),32*1024*1024);
+  write_verified(safe_path(stage,it.key()),bytes,it.value());
+ }
+ write_verified(safe_path(stage,"frame-manifest.json"),frame_hotfix_manifest,frame_manifest_hash);
+ apply_locked(root,stage,progress,availability,true);
+}
+}
