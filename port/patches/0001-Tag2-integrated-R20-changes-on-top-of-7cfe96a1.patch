+bool mapped(u32 address, u32 bytes, bool writing = false)
+{
+    return address >= 0x10000 && bytes && u64{address} + bytes <= 0x40000000 &&
+        vm::check_addr(address, writing ? vm::page_writable : vm::page_readable, bytes);
