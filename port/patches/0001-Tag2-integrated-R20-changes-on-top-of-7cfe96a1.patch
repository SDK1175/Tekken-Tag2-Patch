+    u32 result_net = 0, result_local = 0, result_remote = 0, result_side = 0;
+    bool result_side_valid = false;
+    std::array<u32, sites.size()> original{};
+    ppu_thread* ppu = nullptr; // Only accessed by the owning combat thread.
+    std::atomic<u32> thread{0};
+    u32 task = 0, net = 0, local = 0, remote = 0, side = 0;
+    u32 manager = 0, origin = 0, next_id = 0, last_world = 0, last_input_id = absent;
+    u32 snapshot_ring = 0;
