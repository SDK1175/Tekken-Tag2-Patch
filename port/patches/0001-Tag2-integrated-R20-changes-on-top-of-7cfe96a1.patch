diff --git a/rpcs3/Input/ttt2_input_r4_core.h b/rpcs3/Input/ttt2_input_r4_core.h
new file mode 100644
index 000000000..392ef8318
--- /dev/null
+++ b/rpcs3/Input/ttt2_input_r4_core.h
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Host-input policy and exact digital-transition attribution. No guest state writes.
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <mutex>
+#include <optional>
+namespace ttt2::input_r4
+{
+    enum class backend : unsigned { none, keyboard, xinput, mm, ds4, sdl };
+    inline const char* name(backend b)
+    {
+        switch (b) { case backend::keyboard:return "keyboard"; case backend::xinput:return "xinput";
+        case backend::mm:return "mm"; case backend::ds4:return "ds4"; case backend::sdl:return "sdl"; default:return "none"; }
+    }
+    inline bool can_pull(backend b) { return b == backend::xinput || b == backend::mm; }
+    inline std::uint64_t worker_delay(std::uint64_t configured, bool enabled, backend b)
+    {
+        return enabled && b != backend::none && b != backend::keyboard ? std::min<std::uint64_t>(configured, 500) : configured;
+    }
+    inline bool recent(std::uint64_t last, std::uint64_t now) { return last && now >= last && now-last < 200; }
+    struct slow_guard
+    {
+        unsigned consecutive = 0; bool disabled = false;
+        void observe(std::uint64_t us) { consecutive = us > 2000 ? consecutive+1 : 0; disabled |= consecutive >= 2; }
+    };
+    template <class Buttons>
+    std::uint32_t signature(const Buttons& buttons, unsigned d1, unsigned d2)
+    {
+        std::uint32_t out = 0;
+        for (const auto& b : buttons) if (b.m_pressed)
+        {
+            if (b.m_offset == d1) out |= std::uint16_t(b.m_outKeyCode);
+            else if (b.m_offset == d2) out |= std::uint32_t(std::uint16_t(b.m_outKeyCode)) << 16;
+        }
+        return out;
+    }
+    struct event
+    {
+        std::uint64_t seq = 0, source_us = 0, mapped_us = 0, publish_us = 0, return_us = 0;
+        std::uint32_t signature = 0;
+    };
+    struct counters
+    {
+        std::uint64_t changes=0, published=0, completed=0, superseded=0, expired=0, invalidated=0, unmatched=0;
+    };
+    class chain_tracker
+    {
+        mutable std::mutex mutex_;
+        counters counts_{}; event pending_{};
+        enum class phase { empty, publish, returned } stage_ = phase::empty;
+        std::uint32_t last_ = 0; bool known_ = false;
+        void expire(std::uint64_t now)
+        {
+            if (stage_ != phase::empty && (now < pending_.source_us || now-pending_.source_us > 250000))
+            { ++counts_.expired; stage_=phase::empty; }
+        }
+    public:
+        void change(std::uint32_t before, std::uint32_t after, std::uint64_t source, std::uint64_t mapped)
+        {
+            if (before==after) return;
+            std::lock_guard lock(mutex_);
+            expire(source); ++counts_.changes;
+            if (stage_!=phase::empty) ++counts_.superseded;
+            stage_=phase::empty;
+            if (mapped < source || (known_ && last_==after)) { ++counts_.unmatched; return; }
+            pending_={counts_.changes, source, mapped, 0, 0, after}; stage_=phase::publish;
+        }
+        void publish(std::uint32_t value, std::uint64_t at)
+        {
+            std::lock_guard lock(mutex_);
+            expire(at);
+            const bool changed=!known_ || value!=last_; last_=value; known_=true;
+            if (stage_!=phase::publish) return;
+            if (value==pending_.signature && changed && at>=pending_.mapped_us)
+            { pending_.publish_us=at; stage_=phase::returned; ++counts_.published; }
+            else if (changed || value==pending_.signature) { stage_=phase::empty; ++counts_.unmatched; }
+        }
+        std::optional<event> returned(std::uint32_t value, std::uint64_t at)
+        {
+            std::lock_guard lock(mutex_); expire(at);
+            if (stage_!=phase::returned || value!=pending_.signature || at<pending_.publish_us) return {};
+            pending_.return_us=at; ++counts_.completed; stage_=phase::empty; return pending_;
+        }
+        void invalidate()
+        {
+            std::lock_guard lock(mutex_);
+            if (stage_!=phase::empty) ++counts_.invalidated;
+            stage_=phase::empty; known_=false;
+        }
+        void reset() { std::lock_guard lock(mutex_); counts_={}; pending_={}; stage_=phase::empty; known_=false; }
+        counters counts() const { std::lock_guard lock(mutex_); return counts_; }
+    };
+}
diff --git a/rpcs3/Input/ttt2_input_r4_trace.h b/rpcs3/Input/ttt2_input_r4_trace.h
new file mode 100644
index 000000000..28637bfcd
--- /dev/null
+++ b/rpcs3/Input/ttt2_input_r4_trace.h
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Measurement-only asynchronous CSV. Per-sample pushes perform no file IO.
+// The file is opened once during pad initialization; the writer thread owns flushes.
+#pragma once
+#include "ttt2_input_r4_core.h"
+#include <array>
+#include <condition_variable>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <thread>
+#include <vector>
+namespace ttt2::input_r4
+{
+    struct trace_row
+    {
+        const char* kind="Meta"; backend device=backend::none; unsigned port=0;
+        // session,seq,source,publish,return,source-publish,publish-return,source-return,
+        // poll_n,gap_total,gap_max,call_total,call_max,refresh_us,status,digital,
+        // changes,published,completed,superseded,expired,invalidated,unmatched
+        std::array<std::uint64_t,23> v{};
+    };
+    class csv_recorder
+    {
+        mutable std::mutex mutex_;
+        std::condition_variable cv_;
+        std::vector<trace_row> queue_;
+        std::ofstream out_;
+        std::thread thread_;
+        bool enabled_, done_=false, ok_=false;
+        std::uint64_t dropped_=0;
+        void write(const trace_row& row, std::uint64_t drops)
+        {
+            out_ << row.kind << ',' << (enabled_?"on":"off") << ',' << name(row.device) << ',' << row.port;
+            for(auto n:row.v) out_ << ',' << n;
+            out_ << ',' << drops << '\n';
+        }
+        void loop()
+        {
+            std::vector<trace_row> batch; batch.reserve(8192);
+            for (;;)
+            {
+                std::unique_lock lock(mutex_);
+                cv_.wait_for(lock, std::chrono::milliseconds(250), [this]{return done_ || queue_.size()>=256;});
+                batch.swap(queue_); const bool finish=done_; const auto drops=dropped_;
+                lock.unlock();
+                for(const auto& r:batch) write(r,drops);
+                batch.clear(); out_.flush();
+                if(!out_) { std::lock_guard failed(mutex_); ok_=false; }
+                if(finish) { trace_row end; end.kind="End"; write(end,drops); out_.flush(); return; }
+            }
+        }
+    public:
+        csv_recorder(const std::filesystem::path& path, bool enabled):enabled_(enabled)
+        {
+            // Callers create a unique run directory/file. Never silently append to an earlier run.
+            std::error_code path_error;
+            if(path.empty() || std::filesystem::exists(path,path_error) || path_error) return;
+            out_.open(path,std::ios::out|std::ios::binary);
+            if(!out_) return;
+            out_ << "kind,mode,backend,port,session,seq,source_us,publish_us,return_us,source_to_publish_us,publish_to_return_us,source_to_return_us,poll_n,poll_gap_total_us,poll_gap_max_us,poll_call_total_us,poll_call_max_us,refresh_us,status,digital,changes,published,completed,superseded,expired,invalidated,unmatched,dropped\n";
+            trace_row start; write(start,0); out_.flush();
+            queue_.reserve(8192); ok_=true;
+            try { thread_=std::thread([this]{loop();}); }
+            catch(const std::system_error&) {ok_=false;out_.close();}
+        }
+        ~csv_recorder()
+        {
+            {std::lock_guard lock(mutex_);done_=true;} cv_.notify_one();
+            if(thread_.joinable()) thread_.join();
+        }
+        bool good() const { std::lock_guard lock(mutex_);return ok_; }
+        void push(const trace_row& row)
+        {
+            std::lock_guard lock(mutex_);
+            if(!ok_ || queue_.size()>=8192) {++dropped_;return;}
+            queue_.push_back(row);
+            if(queue_.size()>=256) cv_.notify_one();
+        }
+        void flush() { cv_.notify_one(); } // destructor is the synchronous completion barrier
+    };
+    class measure_book
+    {
+        struct slot
+        {
+            std::mutex mutex;
+            chain_tracker tracker;
+            backend device=backend::none;
+            std::uint64_t session=0,last_poll=0,n=0,gaps=0,gap_total=0,gap_max=0,call_total=0,call_max=0,reads=0;
+        };
+        std::array<slot,7> slots_;
+        csv_recorder& out_;
+        static void set_device(slot& s,backend device)
+        {
+            if(s.device!=device) { s.tracker.invalidate();s.device=device;s.last_poll=0; }
+        }
+        void summary(slot& s,unsigned port)
+        {
+            trace_row r; r.kind="Summary";r.device=s.device;r.port=port;r.v[0]=s.session;
+            const auto c=s.tracker.counts();r.v[16]=c.changes;r.v[17]=c.published;r.v[18]=c.completed;
+            r.v[19]=c.superseded;r.v[20]=c.expired;r.v[21]=c.invalidated;r.v[22]=c.unmatched;out_.push(r);
+        }
+    public:
+        explicit measure_book(csv_recorder& out):out_(out) {}
+        void reset()
+        {
+            for(unsigned i=0;i<slots_.size();++i)
+            {
+                auto& s=slots_[i];std::lock_guard lock(s.mutex);
+                if(s.reads || s.n) summary(s,i);
+                s.tracker.reset();++s.session;s.device=backend::none;
+                s.last_poll=s.n=s.gaps=s.gap_total=s.gap_max=s.call_total=s.call_max=s.reads=0;
+            }
+        }
+        void invalidate(unsigned p)
+        {
+            if(p>=slots_.size())return;
+            auto& s=slots_[p];std::lock_guard lock(s.mutex);s.tracker.invalidate();s.last_poll=0;
+        }
+        void poll(unsigned p,backend device,std::uint64_t start,std::uint64_t end)
+        {
+            if(p>=slots_.size() || device==backend::none)return;
+            auto& s=slots_[p];std::lock_guard lock(s.mutex);set_device(s,device);
+            if(s.last_poll && end>=s.last_poll) { const auto gap=end-s.last_poll;++s.gaps;s.gap_total+=gap;s.gap_max=std::max(s.gap_max,gap); }
+            s.last_poll=end;++s.n;const auto cost=end>=start?end-start:0;s.call_total+=cost;s.call_max=std::max(s.call_max,cost);
+            if(s.n==256)
+            {
+                trace_row r;r.kind="Poll";r.device=device;r.port=p;r.v[0]=s.session;r.v[1]=s.n;r.v[4]=end;
+                r.v[8]=s.gaps;r.v[9]=s.gap_total;r.v[10]=s.gap_max;r.v[11]=s.call_total;r.v[12]=s.call_max;
+                out_.push(r);s.n=s.gaps=s.gap_total=s.gap_max=s.call_total=s.call_max=0;
+            }
+        }
+        void change(unsigned p,backend device,std::uint32_t before,std::uint32_t after,std::uint64_t source,std::uint64_t mapped)
+        {
+            if(p>=slots_.size() || device==backend::none)return;
+            auto& s=slots_[p];std::lock_guard lock(s.mutex);set_device(s,device);s.tracker.change(before,after,source,mapped);
+        }
+        void publish(unsigned p,backend device,std::uint32_t value,std::uint64_t at)
+        {
+            if(p>=slots_.size() || device==backend::none)return;
+            auto& s=slots_[p];std::lock_guard lock(s.mutex);set_device(s,device);s.tracker.publish(value,at);
+        }
+        void returned(unsigned p,backend device,std::uint32_t value,std::uint64_t at)
+        {
+            if(p>=slots_.size() || device==backend::none)return;
+            auto& s=slots_[p];std::lock_guard lock(s.mutex);set_device(s,device);
+            if(auto e=s.tracker.returned(value,at))
+            {
+                trace_row r;r.kind="Event";r.device=device;r.port=p;
+                r.v[0]=s.session;r.v[1]=e->seq;r.v[2]=e->source_us;r.v[3]=e->publish_us;r.v[4]=at;
+                r.v[5]=e->publish_us-e->source_us;r.v[6]=at-e->publish_us;r.v[7]=at-e->source_us;r.v[15]=value;
+                const auto c=s.tracker.counts();r.v[16]=c.changes;r.v[17]=c.published;r.v[18]=c.completed;
+                r.v[19]=c.superseded;r.v[20]=c.expired;r.v[21]=c.invalidated;r.v[22]=c.unmatched;
+                out_.push(r);
+            }
+        }
+        void read(unsigned p,backend device,std::uint64_t at,std::uint64_t status,std::uint64_t refresh_us)
+        {
+            if(p>=slots_.size())return;
+            auto& s=slots_[p];std::lock_guard lock(s.mutex);set_device(s,device);
+            trace_row r;r.kind="Read";r.device=device;r.port=p;r.v[0]=s.session;r.v[4]=at;r.v[13]=refresh_us;r.v[14]=status;out_.push(r);
+            if(++s.reads%300==0)summary(s,p);
+        }
+    };
+}
