diff --git a/rpcs3/Emu/RSX/ttt2_latency1.h b/rpcs3/Emu/RSX/ttt2_latency1.h
new file mode 100644
index 000000000..18d3b7c5c
--- /dev/null
+++ b/rpcs3/Emu/RSX/ttt2_latency1.h
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// TTT2_LATENCY1_R1: opt-in host-side experiment, not an input-to-photon meter.
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <limits>
+#include <string_view>
+#include <utility>
+
+namespace ttt2::latency1
+{
+    inline bool exact_env(const char* name, std::string_view expected)
+    {
+        const char* value = std::getenv(name);
+        return value && std::string_view(value) == expected;
+    }
+
+    inline bool early_requested()
+    {
+        static const bool value = exact_env("TTT2_LATENCY1_MODE", "early");
+        return value;
+    }
+
+    inline bool trace_requested()
+    {
+        static const bool value = exact_env("TTT2_LATENCY1_TRACE", "1");
+        return value;
+    }
+
+    inline bool is_target(std::string_view title, std::string_view version)
+    {
+        return title == "BLES01702" && version == "01.03";
+    }
+
+    struct deferred_wait
+    {
+        std::uint64_t deadline = 0;
+        void arm(std::uint64_t now, std::uint64_t duration)
+        {
+            const auto max = std::numeric_limits<std::uint64_t>::max();
+            deadline = now > max - duration ? max : now + duration;
+        }
+        std::uint64_t remaining(std::uint64_t now) const
+        {
+            return deadline > now ? deadline - now : 0;
+        }
+    };
+
+    struct metric
+    {
+        std::uint64_t count = 0, total = 0, peak = 0;
+        void add(std::uint64_t value)
+        {
+            ++count;
+            total += value;
+            peak = std::max(peak, value);
+        }
+        std::uint64_t mean() const { return count ? total / count : 0; }
+    };
+
+    struct frame_window
+    {
+        std::uint64_t count = 0, moved = 0;
+        metric requested, before, after, flip;
+    };
+
+    struct vk_window
+    {
+        metric submit, acquire, cleanup, contexts;
+    };
+
+    struct pad_window
+    {
+        metric call, mutex, gap;
+        std::uint64_t previous = 0;
+    };
+
+    template <typename F> struct scope_exit
+    {
+        F fn;
+        explicit scope_exit(F f) : fn(std::move(f)) {}
+        scope_exit(const scope_exit&) = delete;
+        scope_exit& operator=(const scope_exit&) = delete;
+        ~scope_exit() { fn(); }
+    };
+}
