+struct result_journal
+{
+    u64 session_id;
+    std::shared_ptr<diagnostic_lifetime> lifetime;
+    bounded_file_sink file;
+    std::atomic<std::shared_ptr<const std::string>> cached;
+    async_log_writer writer;
+    result_journal(std::string path, u64 stamp, std::shared_ptr<diagnostic_lifetime> owner)
+        : session_id(stamp), lifetime(std::move(owner)), file(std::move(path), stamp, "results", 256 * 1024),
+          writer([this](const std::string& line) { return file.write(line) && file.flush(); },
+              [this] { return file.flush(); })
+    { note("result_session_start"); }
+    ~result_journal() { writer.close(); }
+
+    void note(const char* event, const char* reason = "", u64 detail = 0, int elapsed_ms = -1, int signal_read = -1) noexcept
+    {
+        try
+        {
+            const auto snapshot = cached.load();
+            const auto counts = writer.stats();
+            writer.enqueue(fmt::format("{\"event\":%s,\"schema\":1,\"session_id\":%llu,\"timestamp_us\":%llu,"
+                "\"reason\":%s,\"detail\":%llu,\"elapsed_ms\":%d,\"read_sysutil_signal\":%d,"
+                "\"outcome_scope\":\"last_observed_snapshot\",\"rank_points\":null,\"storage_confirmed\":null,"
+                "\"log_dropped\":%llu,\"log_sink_failures\":%llu,%s}\n",
+                diagnostic_quote(event), session_id, diagnostic_time_us(), diagnostic_quote(reason), detail, elapsed_ms, signal_read,
+                counts.dropped, counts.failures, snapshot ? *snapshot : "\"snapshot_available\":false,\"outcome\":\"unknown\""));
+        }
+        catch (...) { } // Diagnostic failure never changes gameplay or exit policy.
+    }
+
+    void observe(const result_observation& observed, u64 epoch, u32 frame, u64 connection, int local_side,
+        const char* event = nullptr) noexcept
+    {
+        if (!observed.changed && !event) return;
+        try
+        {
+            const auto& s = observed.snapshot;
+            auto fields = std::make_shared<const std::string>(fmt::format(
+                "\"snapshot_available\":true,\"snapshot_utc_us\":%llu,\"epoch\":%llu,\"frame\":%u,"
+                "\"connection_id\":%llu,\"match_serial\":%llu,\"local_side\":%d,\"ranked_valid\":%s,\"scene\":%u,"
+                "\"phase_current\":%d,\"phase_next\":%d,\"round_wins\":[%d,%d],\"round_result\":[%d,%d],"
+                "\"target_wins\":%d,\"result_code\":%d,\"selected_actor\":%d,\"outcome\":\"%s\","
+                "\"storage_state\":%d,\"storage_error\":%d,\"storage_status\":%d,"
+                "\"interpretation\":\"fresh_ranked_result_phase8_targets1to5_idle_is_not_saved\"",
+                diagnostic_time_us(), epoch, frame, connection, observed.match_serial, local_side, s.ranked_valid ? "true" : "false", s.scene,
+                s.phase_current, s.phase_next, s.wins[0], s.wins[1], s.round_result[0], s.round_result[1],
+                s.target_wins, s.result_code, s.selected_winner, diagnostic_outcome(observed.outcome),
+                s.storage_state, s.storage_error, s.storage_status));
+            cached.store(std::move(fields));
+            note(observed.final_transition ? "match_result" : event ? event : "result_state");
+        }
+        catch (...) { }
+    }
+};
+std::atomic<std::shared_ptr<result_journal>> active_result_journal;
