+				}
+			}
+		}
+		catch (...) { rsx_log.warning("Could not save native Vulkan pipeline cache; existing cache retained"); }
+		vkDestroyPipelineCache(dev, m_pipeline_cache, nullptr);
+		m_pipeline_cache = VK_NULL_HANDLE;
+		m_pipeline_cache_key.clear();
+	}
