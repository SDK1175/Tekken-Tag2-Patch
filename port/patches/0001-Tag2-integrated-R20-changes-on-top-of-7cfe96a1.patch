+namespace tag2 {
+#include "tag2_native_defaults.inc"
+static QString cleanup_locked(const QString& root){
+ for(const QString& p:{".tag2-native/pending.json",".tag2-update/pending.json",".tag2-update/online-pending.json"})if(QFileInfo::exists(safe_path(root,p)))throw Failure("Recovery pending");
+ const auto package=parse_package(read_bytes(safe_path(root,manifest_path)));verify_installed(root,package);
+ const QString entry=safe_path(root,QString::fromUtf8("태그2.exe"));const QString before=hash_file(entry);if(before.isEmpty())return {};
+ const QSet<QString> known={"06be3abb0fe47ccfec86414536f79e29355d04a6eb909b4e5641dd27541bb2b8","58441ddd5c7abc291ccc8aa563cc25c988ac4f50f07379daac140f5591b2aae3"};
+ if(!known.contains(before))return QString::fromUtf8("기존 태그2.exe가 확인된 배포본과 달라 그대로 보존했습니다.");
+ const QString backup=safe_path(root,".tag2-native/retired-launchers/"+before+QString::fromUtf8("/태그2.exe"));
+ if(QFileInfo::exists(backup)){if(hash_file(backup)!=before)throw Failure("Legacy entry backup changed");}
+ else atomic_write(backup,read_bytes(entry,4*1024*1024));
+ if(hash_file(backup)!=before||hash_file(entry)!=before)throw Failure("Legacy entry changed during backup");
+ const QString receipt=safe_path(root,".tag2-native/legacy-entry.json");
+ QJsonObject record{{"schema",1},{"sha256",before},{"backup",backup},{"state","backed_up"}};atomic_write(receipt,QJsonDocument(record).toJson());
+ if(!QFile::remove(entry))return QString::fromUtf8("새 RPCS3가 준비되었습니다. 기존 태그2.exe는 백업했지만 삭제하지 못했습니다.");
+ record["state"]="removed";atomic_write(receipt,QJsonDocument(record).toJson());return QString::fromUtf8("기존 태그2.exe를 백업하고 정리했습니다.");
+}
+QString initialize_installation(const QString& root){
+ recover_frames(root);
+ NativeTransaction tx(root);tx.recover();tx.recover_legacy();
+ const auto package=parse_package(read_bytes(safe_path(root,manifest_path)));
+ for(const auto& e:package.entries)if(e.policy=="replace"&&installed_file_hash(root,e,package.sequence)!=e.hash)throw Failure("Installed file changed: "+e.path);
+ install_embedded_patch_locked(root,package.release);
+ for(auto it=shipped_defaults.begin();it!=shipped_defaults.end();++it){const QString p=safe_path(root,it.key());if(!QFileInfo::exists(p))atomic_write(p,it.value());}
+ QString graphics_notice;
+ if(package.sequence>=13){
+  try{migrate_graphics_locked(root);}
+  catch(const GraphicsDuplicateKey&e){
+   // Duplicate input keys are rejected before graphics writes are prepared.
+   // Preserve ambiguous user settings and retry after they are corrected.
+   graphics_notice=QString::fromUtf8("기존 설정에 중복 항목이 있어 그래픽 자동 설정을 보류했습니다. 기존 설정으로 실행할 수 있습니다.\n")+QString::fromUtf8(e.what());
+  }
+ }
+ QString practice_notice;
+ if(package.sequence>=17){
+  try{enable_practice_positions_locked(root);}
+  catch(const Failure& e){practice_notice=QString::fromUtf8("프랙티스 위치 저장 기능의 최초 설정을 보류했습니다. 기존 설정과 백업을 보존했습니다.\n")+QString::fromUtf8(e.what());}
+ }
+ const QString enabled=safe_path(root,"green_rollback/framedata_enabled.txt");
+ QString frame_notice;
+ if(read_bytes(enabled,32)=="1\n"&&!QFileInfo::exists(safe_path(root,".tag2-native/frames/installed.json"))){
+  atomic_write(safe_path(root,".tag2-native/retired-settings/framedata_enabled-1.txt"),"1\n");atomic_write(enabled,"0\n");
+ }
+ try{verify_frame_runtime(root);}catch(const Failure& e){
+  // Startup precedes every native boot route and the once-per-process capture flag.
+  // Keep the main UI usable so an explicit reinstall can repair the optional files.
+  atomic_write(enabled,"0\n");frame_notice=QString::fromUtf8("프레임표 파일 확인에 실패하여 표시를 껐습니다. 프레임표 다시 설치를 눌러 주세요.\n")+QString::fromUtf8(e.what());
+ }
+ verify_installed(root,package);disable_legacy_capture(root);const auto cleanup=cleanup_locked(root);
+ QString retirement_notice;
+ if(package.sequence>=17){
+  try{retirement_notice=retire_legacy_launchers_locked(root);}
+  catch(const Failure& e){retirement_notice=QString::fromUtf8("구 실행기 정리를 보류했습니다. 백업과 남은 파일을 보존했습니다.\n")+QString::fromUtf8(e.what());}
+ }
+ verify_installed(root,package);
+ QStringList notices;for(const auto&notice:{graphics_notice,practice_notice,frame_notice,cleanup,retirement_notice})if(!notice.isEmpty())notices.append(notice);return notices.join('\n');
+}
+QString cleanup_legacy_entry(const QString& root){NativeTransaction tx(root);return cleanup_locked(root);}
+}
