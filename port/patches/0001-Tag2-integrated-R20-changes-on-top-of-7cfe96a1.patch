+ bool initialize(const std::filesystem::path& home,const std::vector<std::filesystem::path>& paths)
+ {
+  if(active||!initialize_config||is_initialized()){failure="invalid interpreter ownership";return false;}
+  preconfig pre{};pre_config(&pre);pre.configure_locale=0;pre.utf8_mode=1;
+  if(!success(pre_initialize(&pre)))return false;
+  config c{};init_config(&c);
+  c.isolated=1;c.use_environment=0;c.install_signal_handlers=0;c.parse_argv=0;
+  c.site_import=0;c.user_site_directory=0;c.write_bytecode=0;c.configure_c_stdio=0;
+  c.pathconfig_warnings=0;c.module_search_paths_set=1;
+  auto home_w=home.wstring();
+  if(!success(set_string(&c,&c.home,home_w.c_str()))){clear_config(&c);return false;}
+  for(const auto& path:paths)
+  {
+   auto wide=path.wstring();if(!success(append(&c.module_search_paths,wide.c_str()))){clear_config(&c);return false;}
+  }
+  if(!success(append(&c.argv,L"TTT2_H5_EMBEDDED"))){clear_config(&c);return false;}
+  const bool ok=success(initialize_config(&c));clear_config(&c);
+  if(!ok)return false;
+  active=true;owner=std::this_thread::get_id();
+  auto main=add_module("__main__");globals=main?get_dict(main):nullptr;
+  if(!globals){failure="Python main module unavailable";finish();return false;}
+  return true;
+ }
+ bool exec(const std::string& code)
+ {
+  if(!own())return false;
+  // PyRun_StringFlags propagates SystemExit instead of terminating RPCS3.
+  auto result=run_string(code.c_str(),257,globals,globals,nullptr);
+  if(!result){err_clear();failure="embedded Python statement failed; see runtime log";return false;}
+  decref(result);return true;
+ }
+ bool bind_tick(const char* name)
+ {
+  if(!own())return false;
+  if(tick_function){decref(tick_function);tick_function=nullptr;}
+  auto main=add_module("__main__");tick_function=main?get_attribute(main,name):nullptr;
+  if(!tick_function||!callable_check(tick_function))
+  {if(tick_function){decref(tick_function);tick_function=nullptr;}err_clear();failure="tick callable missing";return false;}
+  return true;
+ }
+ bool tick()
+ {
+  if(!own()||!tick_function)return false;
+  auto result=call_object(tick_function,nullptr);
+  if(!result){err_clear();failure="embedded tick raised an exception";return false;}
+  decref(result);return true;
+ }
+ void allow_other_threads(std::chrono::milliseconds delay)
+ {
+  if(!own())return;
+  auto state=save_thread();std::this_thread::sleep_for(delay);restore_thread(state);
+ }
+ int finish()
+ {
+  if(!own())return active?-1:0;
+  if(tick_function){decref(tick_function);tick_function=nullptr;}
+  globals=nullptr;active=false;
+  return finalize();
+ }
+};
+}
