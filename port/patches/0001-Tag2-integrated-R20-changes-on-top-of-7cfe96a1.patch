+ void check(){value();ws();if(p!=b.size())throw Failure("Trailing JSON data");}
+};
+quint16 u16(const QByteArray& b,qsizetype p){if(p<0||p+2>b.size())throw Failure("Truncated ZIP");return qFromLittleEndian<quint16>(b.constData()+p);}
