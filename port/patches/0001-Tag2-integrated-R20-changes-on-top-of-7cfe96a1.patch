+ bool take(char c){ws();if(p<b.size()&&b[p]==c){++p;return true;}return false;}
+ void need(char c){if(!take(c))throw Failure("Invalid JSON structure");}
+ QString string() {
+  ws();qsizetype start=p;need('"');bool escaped=false;
