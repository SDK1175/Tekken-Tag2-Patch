+
+// Call once after a FULL native save, store identities and hash saved_sources;
+// call again at restore ENTRY before any native store, compare both before
+// permitting the original code. Snapshot-valid byte can still be zero while
+// capture runs. Same-address allocator reuse requires a separate host epoch.
+inline result inspect_layout(memory m,std::uint32_t manager,std::uint32_t slot,std::uint32_t slots=slot_count) noexcept
+{
+    detail::inspector x{m,{},slots};
+    try
+    {
+        if(x.ring(manager,slot))
+        {
+            for(std::uint32_t i=0;i<4&&x.out.code==status::ok;i++)
+                x.actor(x.ptr(0x0163ad98+i*4),x.add(slot,i*0x5c80),i,false);
+            for(std::uint32_t i=0;i<2&&x.out.code==status::ok;i++)
+            {const auto a=x.extra_actor(i);if(a)x.actor(a,x.add(slot,0x17200+i*0x5c80),i,true);}
