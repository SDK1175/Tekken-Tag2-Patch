+#pragma once
+#include <filesystem>
+#include <string>
+namespace ttt2_py {
+struct framedata_paths
+{
+ std::filesystem::path code;
+ std::filesystem::path preferences;
+};
+inline framedata_paths select_framedata_paths(const std::filesystem::path& executable_directory)
+{
+ const auto original=executable_directory/"ttt2_framedata";
+ const auto bundled=executable_directory/"green_online_framedata";
+ // The installer never writes the original H7 tree. An incomplete new bundle
+ // must report its own load error, not silently select a different calculator.
+ return {std::filesystem::exists(bundled)?bundled:original,original};
+}
+// Hex quoting handles Korean, apostrophes, backslashes and newlines uniformly.
+inline std::string python_path(const std::filesystem::path& path)
+{
+ const auto utf8=path.u8string();const char* hex="0123456789abcdef";
+ std::string out="bytes.fromhex('";
+ for(auto c:utf8){const auto b=static_cast<unsigned char>(c);out+=hex[b>>4];out+=hex[b&15];}
+ return out+"').decode('utf-8')";
+}
+}
