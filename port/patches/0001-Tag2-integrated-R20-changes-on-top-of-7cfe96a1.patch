diff --git a/rpcs3/rpcs3qt/tag2_native_legacy_capture.h b/rpcs3/rpcs3qt/tag2_native_legacy_capture.h
new file mode 100644
index 000000000..30612ca9f
--- /dev/null
+++ b/rpcs3/rpcs3qt/tag2_native_legacy_capture.h
@@ -0,0 +1,50 @@
+#pragma once
+#include "tag2_native_files.h"
+#include <QDir>
+#include <QFileInfo>
+#include <QJsonDocument>
+#include <QProcess>
+#include <QRegularExpression>
+#include <QSet>
+
+namespace tag2 {
+// Stop only a known, installer-owned B0 collector for this installation.
+// Do not run old Python, delete historical files or touch the user's registry.
+inline void disable_legacy_capture(const QString& root) noexcept {
+ try {
+  const auto settings=safe_path(root,"TTT2_B0_AutoCollect/settings.json");
+  if(!QFileInfo::exists(settings))return;
+  const auto original=read_bytes(settings,64*1024);auto value=strict_json(original);
+  if(value["schema"].toInt()!=1||!value["enabled"].isBool()||!value["enabled"].toBool())return;
+  auto same=[](const QString& a,const QString& b){
+   return QFileInfo(a).isAbsolute()&&QFileInfo(b).isAbsolute()&&
+    QDir::cleanPath(QDir::fromNativeSeparators(a)).compare(QDir::cleanPath(QDir::fromNativeSeparators(b)),Qt::CaseInsensitive)==0;
+  };
+  const auto install=QDir(root).absolutePath();
+  if(!same(value["root"].toString(),install))return;
+  const auto tool=value["tool"].toString();safe_absolute(tool);
+  const auto relative=QDir(install).relativeFilePath(QDir::fromNativeSeparators(tool));
+  if(!QRegularExpression("^TTT2_B0_AutoCollect/tool/[0-9a-f]{16}$").match(relative).hasMatch())return;
+  const auto worker=safe_path(install,relative+"/src/beta_autocollect.py");
+  const auto python=safe_path(install,relative+"/runtime/pythonw.exe");
+  const auto generation=value["generation"].toString();
