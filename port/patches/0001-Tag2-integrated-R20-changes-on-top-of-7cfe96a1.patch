diff --git a/rpcs3/rpcs3qt/tag2_native_patch.h b/rpcs3/rpcs3qt/tag2_native_patch.h
new file mode 100644
index 000000000..b0908d105
--- /dev/null
+++ b/rpcs3/rpcs3qt/tag2_native_patch.h
@@ -0,0 +1,65 @@
+#pragma once
+#include "tag2_native_transaction.h"
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonDocument>
+#include <QRegularExpression>
+#include <QtEndian>
+namespace tag2 {
+namespace patch_detail {
+#include "tag2_native_patch_payload.inc"
+inline QByteArray payload(){
+ const auto packed=QByteArray::fromBase64(embedded_patch_base64);
+ if(packed.size()<4||embedded_patch_size>16*1024*1024||qFromBigEndian<quint32>(packed.constData())!=embedded_patch_size)throw Failure("Invalid embedded patch size");
+ const auto bytes=qUncompress(packed);
+ if(bytes.size()!=embedded_patch_size||hash_bytes(bytes)!=embedded_patch_sha256)throw Failure("Embedded patch verification failed");
+ return bytes;
+}
+inline void verify_backup(const QString& root,const QJsonObject& journal){
+ const QString before=journal["before"].toString(),backup=journal["backup"].toString();
+ if(before.isEmpty()){if(!backup.isEmpty())throw Failure("Unexpected patch backup");return;}
+ if(!QRegularExpression("^[0-9a-f]{64}$").match(before).hasMatch()||backup!=".tag2-native/patches/backups/"+before+".yml"||hash_file(safe_path(root,backup))!=before)throw Failure("Patch backup verification failed");
+}
+}
+// Caller holds NativeTransaction for the installation. The journal remains if
+// interrupted; its original hash prevents overwriting a later manual change.
+inline void install_embedded_patch_locked(const QString& root,const QString& release,Progress progress={}){
+ using namespace patch_detail;
+ const QString pending=safe_path(root,".tag2-native/patches/pending.json"),receipt=safe_path(root,".tag2-native/patches/applied.json"),target=safe_path(root,"patches/patch.yml");
+ const QString expected=QString::fromLatin1(embedded_patch_sha256);
+ if(!QFileInfo::exists(pending)&&QFileInfo::exists(receipt)){
+  const auto applied=strict_json(read_bytes(receipt));
+  if(applied["schema"].toInt()==1&&applied["release"]==release&&applied["sha256"]==expected)return;
+ }
+ const auto bytes=payload();QJsonObject journal;
+ if(QFileInfo::exists(pending))journal=strict_json(read_bytes(pending));
+ else{
+  const auto before=hash_file(target);QString backup;
+  if(!before.isEmpty()&&before!=expected){
+   backup=".tag2-native/patches/backups/"+before+".yml";const auto file=safe_path(root,backup);
+   if(!QFileInfo::exists(file)){
+    const auto original=read_bytes(target,128LL*1024*1024);
+    if(hash_bytes(original)!=before)throw Failure("Patch changed while backing up");
+    atomic_write(file,original);
+   }
+   if(hash_file(file)!=before)throw Failure("Existing patch backup changed");
+  }
+  journal=QJsonObject{{"schema",1},{"release",release},{"path","patches/patch.yml"},{"before",before},{"sha256",expected},{"backup",backup}};
+  if(hash_file(target)!=before)throw Failure("Patch changed before replacement");
+  atomic_write(pending,QJsonDocument(journal).toJson());
+  if(progress)progress("patch-prepared",0,1);
+ }
+ if(journal["schema"].toInt()!=1||journal["release"]!=release||journal["path"]!="patches/patch.yml"||journal["sha256"]!=expected||!journal["before"].isString()||!journal["backup"].isString())throw Failure("Invalid patch recovery journal");
+ const auto before=journal["before"].toString();
+ // No backup is needed if the shipped file was already present.
+ if(before!=expected)verify_backup(root,journal);else if(!journal["backup"].toString().isEmpty())throw Failure("Unexpected unchanged-patch backup");
+ const auto current=hash_file(target);
+ if(current!=before&&current!=expected)throw Failure(QString::fromUtf8("패치 복구 중 파일이 변경되어 중단했습니다. 기존 패치와 백업은 그대로 보존했습니다."));
+ assert_stopped(root);
+ if(current!=expected)atomic_write(target,bytes);
+ if(hash_file(target)!=expected)throw Failure("Installed patch verification failed");
+ if(progress)progress("patch-committed",1,1);
+ atomic_write(receipt,QJsonDocument(journal).toJson());
+ if(!QFile::remove(pending))throw Failure("Cannot finish patch recovery");
+}
+}
