diff --git a/rpcs3/Emu/ttt2_framedata_core.h b/rpcs3/Emu/ttt2_framedata_core.h
new file mode 100644
index 000000000..266299859
--- /dev/null
+++ b/rpcs3/Emu/ttt2_framedata_core.h
@@ -0,0 +1,189 @@
+#pragma once
+// Host-only diagnostics. No game writes and no simulated-frame synchronization.
+#include <cstdint>
+#include <cstddef>
+#include <string>
+#include <string_view>
+namespace ttt2_framedata
+{
+    // Header byte 108 advertises this optional display-only extension.
+    constexpr std::uint32_t native_style_capability=1;
+    struct display_style
+    {
+        unsigned background_percent=75;
+        std::string_view body;
+    };
+    inline display_style parse_display_style(std::string_view text)
+    {
+        display_style result{75,text};
+        constexpr std::string_view prefix="@FDHUD3:";
+        if(text.substr(0,prefix.size())!=prefix)return result;
+        const auto end=text.find('\n');
+        if(end==std::string_view::npos)return result;
+        // Bounded decimal parsing; malformed envelopes never change opacity.
+        result.body=text.substr(end+1);
+        const auto digits=text.substr(prefix.size(),end-prefix.size());
+        if(digits.empty() || digits.size()>2)return result;
+        unsigned value=0;
+        for(char c:digits){if(c<'0' || c>'9')return result;value=value*10+unsigned(c-'0');}
+        if(value<=90)result.background_percent=value;
+        return result;
+    }
+    // v3 includes PS3 contact slots A50/A8C and A90/ACC in the same copied
+    // actor observation as its action and recovery state. No guest writes.
+    constexpr std::uint32_t actor_size=0xb00;
+    constexpr std::uint32_t header_size=4096, record_size=256+4*actor_size, capacity=128;
+    constexpr std::uint32_t mapping_size=header_size+record_size*capacity;
+    struct alignas(8) capture_record
+    {
+        std::uint64_t guard{},sequence{},host_us{};
+        std::uint32_t frame_before{},frame_after{},valid{},gate_passed{};
+        std::uint32_t mode{},main{},wrapper{},game{},main_mode{},main_pending{};
+        std::uint32_t main_vtable{},wrapper_vtable{},game_vtable{},state{},backref{},native_flags{};
+        std::uint32_t p1_pointer{},p2_pointer{},p1_active{},p2_active{};
+        std::uint64_t rejected_before{};
+        std::uint64_t gate_epoch{};
+        std::uint32_t p1_partner{},p2_partner{},partner1_active{},partner2_active{},actor_mask{};
+        // Optional v2 extension in reserved bytes: StandbyPractice phase and
+        // init/termination-request/termination-complete bytes, packed low first.
+        std::uint32_t warmup_step{},warmup_flags{},mode_pending{};
+        std::uint8_t reserved[104]{},p1[actor_size]{},p2[actor_size]{},partner1[actor_size]{},partner2[actor_size]{};
+    };
+    static_assert(sizeof(capture_record)==record_size);
+    static_assert(offsetof(capture_record,p1)==256 && offsetof(capture_record,p2)==256+actor_size);
+    static_assert(offsetof(capture_record,rejected_before)==104);
+    static_assert(offsetof(capture_record,p1_partner)==120 && offsetof(capture_record,actor_mask)==136);
+    static_assert(offsetof(capture_record,partner1)==256+2*actor_size && offsetof(capture_record,partner2)==256+3*actor_size);
+    static_assert(offsetof(capture_record,gate_epoch)==112);
+    static_assert(offsetof(capture_record,warmup_step)==140 && offsetof(capture_record,warmup_flags)==144
+        && offsetof(capture_record,mode_pending)==148);
+    struct gate_generation
+    {
+        std::uint64_t value=0;
+        void start(){++value;}
+        void unsafe_observation(){++value;}
+    };
+    inline std::uint32_t be32(const std::uint8_t* b)
+    { return (std::uint32_t(b[0])<<24)|(std::uint32_t(b[1])<<16)|(std::uint32_t(b[2])<<8)|b[3]; }
+    inline bool valid_pointer(std::uint32_t p) {return p>=0x10000 && p<0x40000000 && !(p&15);}
+    inline bool offline_practice(const capture_record& r)
+    {
+        return r.mode==21 && r.main_mode==9 && r.main_pending==9 && r.main
+            && r.backref==r.main && r.main_vtable==0x14fb0b0 && r.wrapper_vtable==0x14fadb0
+            && r.game_vtable==0x14fadf8 && r.state==0x15525b0 && !(r.native_flags&4)
+            && valid_pointer(r.p1_pointer) && valid_pointer(r.p2_pointer) && r.p1_pointer!=r.p2_pointer;
+    }
+    inline bool valid_actor(const std::uint8_t* b,std::uint32_t active)
+    {
+        const auto moveset=be32(b+0x88);
+        return active<=1 && be32(b+0x3f4)<=1 && be32(b+0x54)<59
+            && moveset>=0x10000 && moveset<0x40000000 && !(moveset&3);
+    }
+    inline bool online_warmup(const capture_record& r)
+    {
+        // BLES01702 01.03: quick+684 dispatch index 11 calls 1FC384 -> CAB40.
+        // 1F91B8 sets init; 1F9238 requests termination. This component is
+        // independent of OnlineQuickMatch's changing search/join state OPD.
+        return r.mode==21 && r.mode_pending==21 && (r.main_mode==32 || r.main_mode==33) && r.main_pending==r.main_mode && r.main
+            && r.backref==r.main && r.main_vtable==0x14fb0b0 && r.wrapper_vtable==0x14fbb80
+            && r.game_vtable==0x14fbbc8 && r.warmup_step==11 && r.warmup_flags==1
+            && valid_pointer(r.p1_pointer) && valid_pointer(r.p2_pointer) && r.p1_pointer!=r.p2_pointer;
+    }
+    inline bool practice_context(const capture_record& r) {return offline_practice(r) || online_warmup(r);}
+    inline bool warmup_dummy(const std::uint8_t* b,std::uint32_t active)
+    {
+        const auto moveset=be32(b+0x88);
+        // Native init 1FA4C4/1FA4F4 selects character 59. Side preference can
+        // put this dummy on either side; playable Mokujin is a regular actor.
+        return active==1 && be32(b+0x3f4)==1 && be32(b+0x54)==59 && be32(b+0x50)==66
+            && moveset>=0x10000 && moveset<0x40000000 && !(moveset&3);
+    }
+    inline bool valid_team(std::uint32_t root,const std::uint8_t* a,std::uint32_t active,
+                           std::uint32_t partner,const std::uint8_t* b,std::uint32_t partner_active,bool present)
+    {
+        if(!valid_actor(a,active))return false;
+        if(be32(a+0x3f4)==1)return active==1 && !present && partner==0;
+        return present && valid_pointer(partner) && root!=partner && be32(a+0xac)==partner
+            && valid_actor(b,partner_active) && be32(b+0x3f4)==0 && be32(b+0xac)==root
+            && (active==1 || partner_active==1);
+    }
+    inline bool practice_teams(const capture_record& r)
+    {
+        if(!practice_context(r) || (r.actor_mask&3)!=3 || (r.actor_mask&~15u))return false;
+        const bool warmup=online_warmup(r);
+        const bool dummy1=warmup && warmup_dummy(r.p1,r.p1_active);
+        const bool dummy2=warmup && warmup_dummy(r.p2,r.p2_active);
+        if(warmup && dummy1==dummy2)return false;
+        if(dummy1 ? (r.p1_partner || (r.actor_mask&4))
+            : !valid_team(r.p1_pointer,r.p1,r.p1_active,r.p1_partner,r.partner1,r.partner1_active,r.actor_mask&4))return false;
+        if(dummy2 ? (r.p2_partner || (r.actor_mask&8))
+            : !valid_team(r.p2_pointer,r.p2,r.p2_active,r.p2_partner,r.partner2,r.partner2_active,r.actor_mask&8))return false;
+        return (!r.p1_partner || (r.p1_partner!=r.p2_pointer && r.p1_partner!=r.p2_partner))
+            && (!r.p2_partner || r.p2_partner!=r.p1_pointer);
+    }
+    inline bool practice_solo(const capture_record& r)
+    {return practice_teams(r) && r.actor_mask==3;}
+    inline bool coherent(const capture_record& r) {return r.frame_before==r.frame_after && practice_teams(r);}
+    inline bool fresh(std::uint64_t now,std::uint64_t then,std::uint64_t max_age)
+    {return then && now>=then && now-then<=max_age;}
+    inline bool same_context(const capture_record& a,const capture_record& b)
+    {
+        return a.mode==b.mode && a.mode_pending==b.mode_pending && a.main_mode==b.main_mode && a.main_pending==b.main_pending
+            && a.main_vtable==b.main_vtable && a.wrapper_vtable==b.wrapper_vtable && a.game_vtable==b.game_vtable
+            && ((online_warmup(a) && online_warmup(b)) || a.state==b.state)
+            && a.backref==b.backref && a.native_flags==b.native_flags
+            && a.warmup_step==b.warmup_step && a.warmup_flags==b.warmup_flags;
+    }
+    inline bool same_capture_header(const capture_record& a,const capture_record& b)
+    {
+        return same_context(a,b) && a.main==b.main && a.wrapper==b.wrapper && a.game==b.game
+            && a.p1_pointer==b.p1_pointer && a.p2_pointer==b.p2_pointer
+            && a.p1_active==b.p1_active && a.p2_active==b.p2_active;
+    }
+    inline bool same_identity(const capture_record& a,const capture_record& b)
+    {return same_context(a,b) && a.main==b.main && a.wrapper==b.wrapper && a.game==b.game && a.p1_pointer==b.p1_pointer && a.p2_pointer==b.p2_pointer
+        && a.p1_partner==b.p1_partner && a.p2_partner==b.p2_partner && a.actor_mask==b.actor_mask;}
+    inline std::string cleared_training_values(std::string_view text)
+    {
+        // Keep only the negotiated five-row layout/opacity while a training
+        // reset invalidates numbers. Context, pause and freshness gates still
+        // apply; no prior measurement is shown across the frame discontinuity.
+        std::string out;
+        unsigned row=0;
+        for(std::size_t pos=0;pos<text.size();)
+        {
+            auto end=text.find('\n',pos);if(end==std::string_view::npos)end=text.size();
+            const auto line=text.substr(pos,end-pos);
+            const auto tab=line.find('\t');
+            if(tab==std::string_view::npos)out.append(line);else {out.append(line.substr(0,tab+1));out+=(row++==1?"--- (---)":"---");}
+            if(end<text.size())out+='\n';pos=end+1;
+        }
+        return out;
+    }
+    inline std::string sanitize_utf8(std::string_view input)
+    {
+        std::string out;out.reserve(input.size());
+        for(std::size_t i=0;i<input.size();)
+        {
+            const auto first=static_cast<std::uint8_t>(input[i]);
+            std::uint32_t cp=first,min_cp=0;std::size_t length=1;
+            if(first>=0xc2 && first<=0xdf){cp=first&0x1f;length=2;min_cp=0x80;}
+            else if(first>=0xe0 && first<=0xef){cp=first&0x0f;length=3;min_cp=0x800;}
+            else if(first>=0xf0 && first<=0xf4){cp=first&0x07;length=4;min_cp=0x10000;}
+            else if(first>=0x80){out+='?';++i;continue;}
+            bool valid=i+length<=input.size();
+            for(std::size_t j=1;valid && j<length;j++)
+            {
+                const auto next=static_cast<std::uint8_t>(input[i+j]);
+                if((next&0xc0)!=0x80)valid=false;
+                else cp=(cp<<6)|(next&0x3f);
+            }
+            if(!valid || cp<min_cp || cp>0x10ffff || (cp>=0xd800 && cp<=0xdfff))
+            {out+='?';++i;continue;}
+            if((cp<0x20 && cp!='\n' && cp!='\t') || (cp>=0x7f && cp<=0x9f))out+='?';
+            else out.append(input.substr(i,length));
+            i+=length;
+        }
+        return out;
+    }
+}
