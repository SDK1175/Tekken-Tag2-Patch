+#pragma once
+
+#include <QString>
+#include <memory>
+
+namespace tag2
+{
+struct DiagnosticRequest
+{
+    QString root, config_root, log_root, executable;
+    qint64 started_us = 0;
+    quint64 pid = 0, created = 0;
+};
+
+// Reading, hashing, and archive construction belong on the collector thread.
+class DiagnosticArchive
+{
+public:
+    explicit DiagnosticArchive(DiagnosticRequest request);
+    ~DiagnosticArchive();
+    DiagnosticArchive(const DiagnosticArchive&) = delete;
+    DiagnosticArchive& operator=(const DiagnosticArchive&) = delete;
+    QString snapshot(const QString& state, qint64 until_us);
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> m_impl;
+};
+
+void start_diagnostics(const QString& root, const QString& config_root, const QString& log_root) noexcept;
+void stop_diagnostics() noexcept;
+}
diff --git a/rpcs3/rpcs3qt/tag2_native_files.cpp b/rpcs3/rpcs3qt/tag2_native_files.cpp
new file mode 100644
index 000000000..eff67c1e4
--- /dev/null
+++ b/rpcs3/rpcs3qt/tag2_native_files.cpp
@@ -0,0 +1,159 @@
+#include "tag2_native_files.h"
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QSaveFile>
+#include <QJsonDocument>
+#include <QJsonArray>
+#include <QCryptographicHash>
+#include <QRegularExpression>
+#include <QStringDecoder>
+#include <QtEndian>
+#include <QMap>
+#include <algorithm>
+#include <zlib.h>
+#ifdef _WIN32
+#include <windows.h>
+#endif
+namespace tag2 {
+void safe_absolute(const QString& path) {
+ QString node=QDir::cleanPath(QFileInfo(path).absoluteFilePath());
+ for(;;) {
+#ifdef _WIN32
+  DWORD attr=GetFileAttributesW(reinterpret_cast<const wchar_t*>(QDir::toNativeSeparators(node).utf16()));
+  if(attr!=INVALID_FILE_ATTRIBUTES && (attr&FILE_ATTRIBUTE_REPARSE_POINT))throw Failure("Reparse path rejected: "+node);
+  if(attr==INVALID_FILE_ATTRIBUTES && GetLastError()!=ERROR_FILE_NOT_FOUND && GetLastError()!=ERROR_PATH_NOT_FOUND)
+   throw Failure("Cannot inspect path: "+node);
+#else
+  if(QFileInfo(node).isSymLink())throw Failure("Symbolic path rejected: "+node);
+#endif
+  QString parent=QFileInfo(node).dir().absolutePath();if(parent==node)break;
+  if(QFileInfo::exists(parent)&&!QFileInfo(parent).isDir())throw Failure("Directory collision: "+parent);
+  node=parent;
+ }
+}
+QString safe_path(const QString& root,const QString& relative) {
+ if(relative.isEmpty()||relative.contains('\\')||relative.contains(':')||relative.startsWith('/'))throw Failure("Unsafe relative path");
+ static const QRegularExpression reserved(R"(^(CON|PRN|AUX|NUL|COM[1-9\x{00b9}\x{00b2}\x{00b3}]|LPT[1-9\x{00b9}\x{00b2}\x{00b3}])$)",QRegularExpression::CaseInsensitiveOption);
+ for(const QString& part:relative.split('/')) {
+  if(part.isEmpty()||part=="."||part==".."||part.endsWith('.')||part.endsWith(' ')||reserved.match(part.section('.',0,0)).hasMatch())throw Failure("Unsafe path component");
