+u64 green_ggpo_pad_sleep(u64 configured)
+{
+    // Ignore only U1's optional 250 us setting in this GGPO title session.
+    // Keep shared configuration untouched; the separate Delay executable and
+    // every other chosen interval retain their original behavior. Existing R4
