@@ -22,11 +22,15 @@
 #endif
 
 #include "SPIRVCommon.h"
+#include "shader_cache_file.h"
 #include "Emu/RSX/Program/GLSLTypes.h"
+#include "Emu/system_config.h"
+#include <atomic>
 
 namespace spirv
 {
 	static TBuiltInResource g_default_config;
+	static std::atomic<u64> cache_hits{0}, cache_misses{0};
 
 	void init_default_resources(TBuiltInResource& rsc)
 	{
@@ -125,7 +129,7 @@ namespace spirv
 		rsc.limits.generalConstantMatrixVectorIndexing = true;
 	}
 
-	bool compile_glsl_to_spv(std::vector<u32>& spv, std::string& shader, ::glsl::program_domain domain, ::glsl::glsl_rules rules)
+	static bool compile_uncached(std::vector<u32>& spv, std::string& shader, ::glsl::program_domain domain, ::glsl::glsl_rules rules)
 	{
 		EShLanguage lang = (domain == ::glsl::glsl_fragment_program)
 			? EShLangFragment
@@ -192,14 +196,39 @@ namespace spirv
 		return success;
 	}
 
+	bool compile_glsl_to_spv(std::vector<u32>& spv, std::string& shader, ::glsl::program_domain domain, ::glsl::glsl_rules rules)
+	{
+		if (rules != ::glsl::glsl_rules_vulkan || g_cfg.video.disable_on_disk_shader_cache)
+			return compile_uncached(spv, shader, domain, rules);
+
+		// Version this compiler policy if resources, targets or SpvOptions change.
+		// It is intentionally independent of RPCS3 build ID and executable name.
+		const auto version = glslang::GetVersion();
+		const auto profile = fmt::format("tag2-spv1-glslang-%d.%d.%d-%s-resources1-vk10-spv10-noopt-size",
+			version.major, version.minor, version.patch, version.flavor);
+		const auto directory = fs::get_cache_dir() + "cache/vulkan_spirv/";
+		bool hit = false;
+		const bool ok = rsx::persistent_cache::get_or_compile(spv, shader,
+			static_cast<u32>(domain), static_cast<u32>(rules), profile,
+			[&](const std::string& key) { return rsx::persistent_cache::read_file(directory + key + ".bin"); },
+			[&](const std::string& key, const auto& bytes) { rsx::persistent_cache::write_file(directory, key, bytes); },
+			[&](auto& words) { return compile_uncached(words, shader, domain, rules); }, hit);
+		(hit ? cache_hits : cache_misses).fetch_add(1, std::memory_order_relaxed);
+		return ok;
+	}
+
 	void initialize_compiler_context()
 	{
+		cache_hits.store(0, std::memory_order_relaxed);
+		cache_misses.store(0, std::memory_order_relaxed);
 		glslang::InitializeProcess();
 		init_default_resources(g_default_config);
 	}
 
 	void finalize_compiler_context()
 	{
+		rsx_log.notice("Native SPIR-V cache: %llu reused, %llu compiled (existing RSX shader cache preserved)",
+			cache_hits.load(std::memory_order_relaxed), cache_misses.load(std::memory_order_relaxed));
 		glslang::FinalizeProcess();
 	}
 }
diff --git a/rpcs3/Emu/RSX/Program/persistent_shader_cache.h b/rpcs3/Emu/RSX/Program/persistent_shader_cache.h
new file mode 100644
index 000000000..a03960e7f
--- /dev/null
+++ b/rpcs3/Emu/RSX/Program/persistent_shader_cache.h
@@ -0,0 +1,151 @@
+#pragma once
+#include "Crypto/sha256.h"
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace rsx::persistent_cache
+{
+    using bytes = std::vector<std::uint8_t>;
+    constexpr std::size_t max_blob_size = 64 * 1024 * 1024;
+    constexpr std::size_t envelope_size = 80;
+
+    inline std::array<std::uint8_t, 32> digest(std::span<const std::uint8_t> data)
+    {
+        std::array<std::uint8_t, 32> result{};
+        mbedtls_sha256_ret(data.data(), data.size(), result.data(), 0);
+        return result;
+    }
+
+    inline void put32(bytes& out, std::uint32_t value)
+    {
+        for (unsigned i = 0; i < 4; ++i) out.push_back(static_cast<std::uint8_t>(value >> (i * 8)));
+    }
+    inline std::uint32_t get32(std::span<const std::uint8_t> data, std::size_t offset)
+    {
+        std::uint32_t value = 0;
+        for (unsigned i = 0; i < 4; ++i) value |= std::uint32_t{data[offset + i]} << (i * 8);
+        return value;
+    }
+
+    inline std::string key_for(std::string_view source, std::uint32_t stage,
+        std::uint32_t rules, std::string_view profile)
+    {
+        // Length-delimited inputs prevent ambiguous concatenations. Profile
+        // identifies glslang and compiler options, independently of RPCS3's EXE.
+        bytes input;
+        if (source.size() > max_blob_size || profile.size() > 1024) return {};
+        input.reserve(source.size() + profile.size() + 16);
+        put32(input, stage); put32(input, rules);
+        put32(input, static_cast<std::uint32_t>(profile.size()));
+        input.insert(input.end(), profile.begin(), profile.end());
+        put32(input, static_cast<std::uint32_t>(source.size()));
+        input.insert(input.end(), source.begin(), source.end());
+        const auto hash = digest(input);
+        constexpr char hex[] = "0123456789abcdef";
+        std::string key;
+        key.reserve(64);
+        for (auto c : hash) { key += hex[c >> 4]; key += hex[c & 15]; }
+        return key;
+    }
+
+    inline std::array<std::uint8_t, 32> key_digest(std::string_view key)
+    {
+        return digest({reinterpret_cast<const std::uint8_t*>(key.data()), key.size()});
+    }
+
+    inline bytes pack(std::string_view key, std::span<const std::uint8_t> payload)
+    {
+        if (key.empty() || payload.empty() || payload.size() > max_blob_size - envelope_size) return {};
+        bytes out;
+        out.reserve(envelope_size + payload.size());
+        constexpr std::array<std::uint8_t, 8> magic{'T','2','C','A','C','H','E',1};
+        out.insert(out.end(), magic.begin(), magic.end());
+        const auto identity = key_digest(key);
+        out.insert(out.end(), identity.begin(), identity.end());
+        put32(out, static_cast<std::uint32_t>(payload.size())); put32(out, 0);
+        const auto hash = digest(payload);
+        out.insert(out.end(), hash.begin(), hash.end());
+        out.insert(out.end(), payload.begin(), payload.end());
+        return out;
+    }
+
+    inline std::span<const std::uint8_t> unpack(std::string_view key, std::span<const std::uint8_t> data)
+    {
+        constexpr std::array<std::uint8_t, 8> magic{'T','2','C','A','C','H','E',1};
+        if (key.empty() || data.size() <= envelope_size || data.size() > max_blob_size ||
+            !std::equal(magic.begin(), magic.end(), data.begin())) return {};
+        const auto identity = key_digest(key);
+        if (!std::equal(identity.begin(), identity.end(), data.begin() + 8) ||
+            get32(data, 44) != 0 || get32(data, 40) != data.size() - envelope_size) return {};
+        const auto payload = data.subspan(envelope_size);
+        const auto hash = digest(payload);
+        if (!std::equal(hash.begin(), hash.end(), data.begin() + 48)) return {};
+        return payload;
+    }
+
+    inline bool valid_spirv(std::span<const std::uint32_t> words)
+    {
+        if (words.size() < 5 || words.size() > 4 * 1024 * 1024 || words[0] != 0x07230203 ||
+            words[1] != 0x00010000 || !words[3] || words[3] > 0x3fffff || words[4]) return false;
+        for (std::size_t at = 5; at < words.size();)
+        {
+            const auto count = words[at] >> 16;
+            if (!count || count > words.size() - at) return false;
+            at += count;
+        }
+        return true;
+    }
+
+    template<class Read, class Write, class Compile>
+    bool get_or_compile(std::vector<std::uint32_t>& words, std::string_view source,
+        std::uint32_t stage, std::uint32_t rules, std::string_view profile,
+        Read&& read, Write&& write, Compile&& compile, bool& hit)
+    {
+        hit = false;
+        const auto key = key_for(source, stage, rules, profile);
+        if (!key.empty())
+        {
+            try
+            {
+                const auto data = read(key);
+                const auto payload = unpack(key, data);
+                if (!payload.empty() && payload.size() % 4 == 0 && payload.size() <= 16 * 1024 * 1024)
+                {
+                    std::vector<std::uint32_t> cached(payload.size() / 4);
+                    for (std::size_t i = 0; i < cached.size(); ++i) cached[i] = get32(payload, i * 4);
+                    if (valid_spirv(cached)) { words = std::move(cached); hit = true; return true; }
+                }
+            }
+            catch (...) { /* Cache availability never decides shader correctness. */ }
+        }
+        if (!compile(words)) return false;
+        if (!key.empty() && valid_spirv(words))
+        {
+            try
+            {
+                bytes payload;
+                payload.reserve(words.size() * 4);
+                for (auto word : words) put32(payload, word);
+                const auto encoded = pack(key, payload);
+                if (!encoded.empty()) write(key, encoded);
+            }
+            catch (...) { /* Read-only disks still render normally. */ }
+        }
+        return true;
+    }
+
+    inline bool compatible_pipeline(std::span<const std::uint8_t> data,
+        std::uint32_t vendor, std::uint32_t device, std::span<const std::uint8_t, 16> uuid)
+    {
+        // VkPipelineCacheHeaderVersionOne fields are explicitly little endian.
+        return data.size() >= 32 && get32(data, 0) == 32 && get32(data, 4) == 1 &&
+            get32(data, 8) == vendor && get32(data, 12) == device &&
+            std::equal(uuid.begin(), uuid.end(), data.begin() + 16);
+    }
+}
diff --git a/rpcs3/Emu/RSX/Program/shader_cache_file.h b/rpcs3/Emu/RSX/Program/shader_cache_file.h
new file mode 100644
index 000000000..e24b57f09
--- /dev/null
+++ b/rpcs3/Emu/RSX/Program/shader_cache_file.h
@@ -0,0 +1,25 @@
+#pragma once
+#include "persistent_shader_cache.h"
+#include "Utilities/File.h"
+
+namespace rsx::persistent_cache
+{
+    inline bytes read_file(const std::string& path)
+    {
+        fs::file input(path);
+        if (!input) return {};
+        const auto size = input.size();
+        if (size <= envelope_size || size > max_blob_size) return {};
+        bytes data(static_cast<std::size_t>(size));
+        if (input.read(data.data(), data.size()) != data.size()) return {};
+        return data;
+    }
+
+    inline bool write_file(const std::string& directory, const std::string& key, const bytes& data)
+    {
+        if (data.empty() || data.size() > max_blob_size || !fs::create_path(directory)) return false;
+        fs::pending_file output(directory + key + ".bin");
+        if (!output.file || output.file.write(data.data(), data.size()) != data.size()) return false;
+        return output.commit();
+    }
+}
