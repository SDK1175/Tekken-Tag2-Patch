+  if(!after.isEmpty()&&hash_file(replacement(row))!=after)throw Failure("Missing recovery replacement: "+p);
+  if(!before.isEmpty()&&((!online&&!native)||before!=after)&&hash_file(safe_path(tx,"original/"+p))!=before)throw Failure("Missing recovery original: "+p);
