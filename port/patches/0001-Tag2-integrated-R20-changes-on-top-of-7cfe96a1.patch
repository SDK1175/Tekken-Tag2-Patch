+)TAG2GRAPHICS";
+static const char graphics_restore_script[] = "@echo off\r\necho Close RPCS3 before restoring the previous graphics settings.\r\n\"%~dp0rpcs3.exe\" --headless --tag2-graphics-restore \"%~dp0.\"\r\nif errorlevel 1 (echo Graphics restore failed. Existing backups were retained.) else (echo Previous graphics settings restored. R13 features remain installed.)\r\npause\r\n";
diff --git a/rpcs3/rpcs3qt/tag2_native_handoff.cpp b/rpcs3/rpcs3qt/tag2_native_handoff.cpp
new file mode 100644
index 000000000..19b954e98
--- /dev/null
+++ b/rpcs3/rpcs3qt/tag2_native_handoff.cpp
@@ -0,0 +1,55 @@
+#include "tag2_native_handoff.h"
+#include <QDir>
+#include <QFileInfo>
+#include <QRegularExpression>
+#include <windows.h>
+namespace tag2 {
+QString pending_update_stage(const QString& root){
+ const QString pending=safe_path(root,".tag2-native/pending.json");if(!QFileInfo::exists(pending))return {};
+ NativeTransaction tx(root);tx.validate_recovery();
+ const auto journal=strict_json(read_bytes(pending));const QString id=journal["transaction_id"].toString();
+ if(!QRegularExpression("^[0-9a-f]{32}$").match(id).hasMatch())throw Failure("Invalid recovery identity");
+ const QString stage=safe_path(root,".tag2-native/transactions/"+id+"/replacement");
+ if(load_package(stage).release!=journal["release"].toString())throw Failure("Recovery package identity changed");return stage;
+}
+QStringList restart_arguments(){
+ FILETIME created{},exit{},kernel{},user{};
+ if(!GetProcessTimes(GetCurrentProcess(),&created,&exit,&kernel,&user))throw Failure("Cannot identify updater process");
+ return {"--restart-parent",QString::number(GetCurrentProcessId()),QString::number((quint64(created.dwHighDateTime)<<32)|created.dwLowDateTime)};
+}
+void validate_update_stage(const QString& root,const QString& stage){
+ safe_absolute(root);safe_absolute(stage);
+ const QString relative=QDir(root).relativeFilePath(QFileInfo(stage).absoluteFilePath());
+ if(!QRegularExpression("^\\.tag2-native/downloads/[0-9a-f]{32}$").match(relative).hasMatch())throw Failure("Unexpected update staging folder");
+ load_package(stage);
+}
+void wait_for_parent(const QString& root,const QString& pid_text,const QString& creation){
+ bool pid_ok=false,time_ok=false;const DWORD pid=pid_text.toUInt(&pid_ok);const quint64 expected=creation.toULongLong(&time_ok);
+ if(!pid_ok||!time_ok||!pid||!expected||pid==GetCurrentProcessId())throw Failure("Invalid updater parent");
+ HANDLE parent=OpenProcess(SYNCHRONIZE|PROCESS_QUERY_LIMITED_INFORMATION,FALSE,pid);
+ if(!parent){if(GetLastError()==ERROR_INVALID_PARAMETER)return;throw Failure("Cannot inspect updater parent");}
+ FILETIME created{},exit{},kernel{},user{};wchar_t path[32768];DWORD size=32768;
+ // Image lookup can fail during teardown before the process handle signals.
+ // Keep the same handle and wait for confirmed termination, never assume exit
+ // from a failed query or a reused PID. Installation still checks its file lock.
+ if(!GetProcessTimes(parent,&created,&exit,&kernel,&user)){
+  const DWORD error=GetLastError(),waited=WaitForSingleObject(parent,30000);CloseHandle(parent);
+  if(waited==WAIT_OBJECT_0)return;throw Failure("Cannot identify updater parent (process time error "+QString::number(error)+")");
+ }
+ if(((quint64(created.dwHighDateTime)<<32)|created.dwLowDateTime)!=expected){CloseHandle(parent);throw Failure("Updater parent changed");}
+ if(!QueryFullProcessImageNameW(parent,0,path,&size)){
+  const DWORD error=GetLastError(),waited=WaitForSingleObject(parent,30000);CloseHandle(parent);
+  if(waited==WAIT_OBJECT_0)return;throw Failure("Cannot identify updater parent (image error "+QString::number(error)+")");
+ }
+ bool valid=false;
+ try{const QString image=QDir::fromNativeSeparators(QString::fromWCharArray(path,size));safe_absolute(image);
+  const QString relative=QDir(root).relativeFilePath(image).toCaseFolded();
+  valid=relative==QString::fromUtf8("rpcs3.exe")||QRegularExpression(QString::fromUtf8("^\\.tag2-native/(downloads/[0-9a-f]{32}|transactions/[0-9a-f]{32}/replacement)/rpcs3\\.exe$")).match(relative).hasMatch();
+ }catch(...){CloseHandle(parent);throw;}
+ if(!valid){CloseHandle(parent);throw Failure("Unexpected updater parent path");}
+ const DWORD result=WaitForSingleObject(parent,30000);CloseHandle(parent);if(result!=WAIT_OBJECT_0)throw Failure("Previous launcher has not exited");
+}
+void apply_staged_update(const QString& root,const QString& stage,Progress progress){
+ validate_update_stage(root,stage);NativeTransaction tx(root,progress);tx.apply(stage);
+}
+}
