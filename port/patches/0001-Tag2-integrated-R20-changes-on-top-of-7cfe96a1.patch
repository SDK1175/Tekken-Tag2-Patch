+struct diagnostic_lifetime
+{
+    fs::file lock;
+    std::string path;
+    explicit diagnostic_lifetime(std::string name) : path(std::move(name))
+    {
+        if (!lock.open(path, fs::write + fs::create + fs::excl + fs::lock))
+            throw std::runtime_error("Cannot reserve rollback diagnostic session");
+    }
+    ~diagnostic_lifetime() { try { lock.close(); fs::remove_file(path); } catch (...) { } }
+};
+
+// fs::file::write/sync terminate on some OS failures. Diagnostic I/O must
+// instead return false so the async writer can disable only its own sink.
+bool diagnostic_write(fs::file& output, std::string_view bytes) noexcept
+{
+    if (!output) return false;
+    while (!bytes.empty())
+    {
+#ifdef _WIN32
+        const DWORD size = static_cast<DWORD>(std::min<usz>(bytes.size(), 1024 * 1024));
+        DWORD written = 0;
+        if (!WriteFile(output.get_handle(), bytes.data(), size, &written, nullptr) || !written) return false;
+#else
+        const auto written = ::write(output.get_handle(), bytes.data(), bytes.size());
+        if (written < 0 && errno == EINTR) continue;
+        if (written <= 0) return false;
+#endif
+        bytes.remove_prefix(static_cast<usz>(written));
+    }
+    return true;
+}
+
+bool diagnostic_sync(fs::file& output) noexcept
+{
+    if (!output) return false;
+#ifdef _WIN32
+    return FlushFileBuffers(output.get_handle()) != 0;
+#else
+    int status;
+    do { status = ::fsync(output.get_handle()); } while (status != 0 && errno == EINTR);
+    return status == 0;
+#endif
+}
