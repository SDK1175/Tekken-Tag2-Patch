@@ -0,0 +1,19 @@
+#pragma once
+#include <atomic>
+
+namespace green_rollback {
+enum class netcode_mode { delay, rollback };
+class launch_modes {
+ // This build restores native RPCN delay. Legacy GUI, command-line resume,
+ // and direct set_mode callers cannot re-enable the removed GGPO hooks.
+ std::atomic<netcode_mode> requested{netcode_mode::delay};
+ std::atomic<netcode_mode> running{netcode_mode::delay};
+public:
+ void request(netcode_mode){requested.store(netcode_mode::delay);}
+ netcode_mode preference() const{return requested.load();}
+ netcode_mode for_title(bool tag2) const{return tag2?requested.load():netcode_mode::delay;}
+ void effective(netcode_mode){running.store(netcode_mode::delay);}
+ netcode_mode effective() const{return running.load();}
+ void stop(){running.store(netcode_mode::delay);}
+};
+}
diff --git a/rpcs3/Emu/Cell/green_native_receive_guard.h b/rpcs3/Emu/Cell/green_native_receive_guard.h
new file mode 100644
index 000000000..cd8bab3dd
--- /dev/null
+++ b/rpcs3/Emu/Cell/green_native_receive_guard.h
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+#include <array>
+#include <cstdint>
+
+namespace green_rollback::receive_guard
+{
+// Retail BLES01702 v1.03: 100 * 0x5eb-byte slots at object+0x190.
+// Slot 100 aliases the receive-list head at object+0x2515c. Check occupancy
+// before dequeue, leaving queued events upstream until native cleanup runs.
+inline constexpr std::uint32_t hook_address = 0x0070cdbc;
+inline constexpr std::uint32_t displaced = 0x815d0000;
+inline constexpr std::uint32_t contract_address = 0x0070c000;
+inline constexpr std::uint32_t contract_size = 0x1000;
+// Pins the constructor, cleanup and complete receive function, not just the
+// displaced instruction. No retail game payload is embedded in this header.
+inline constexpr std::array<std::uint8_t, 32> contract_digest{
+    0xd8,0x8d,0x45,0xa9,0x43,0xf3,0x58,0x5e,0x83,0xc7,0xed,0x7b,0x19,0x3d,0x03,0xb6,
+    0x4b,0xbc,0x52,0x60,0x9b,0x87,0x94,0xd7,0x8d,0xbe,0x36,0xa8,0x80,0x7f,0xff,0xee};
+
+// Both absolute branch targets are aligned and below 0x02000000. No LR/CTR,
+// TOC, stack or nonvolatile register is modified by this trampoline. Restore
+// CR7 before either continuation; native code immediately overwrites r0.
+inline constexpr std::array<std::uint32_t, 9> instructions{
+    0x7c000026, // mfcr r0
+    0x895d0070, // lbz r10,0x70(r29)
+    0x2b8a0064, // cmplwi cr7,r10,100
+    0x419c000c, // blt cr7,+12
+    0x7c001120, // mtcrf 1,r0
+    0x4870cf3a, // ba 0x70cf38 (original epilogue)
+    0x7c001120, // mtcrf 1,r0
+    displaced, // lwz r10,0(r29)
+    0x4870cdc2  // ba 0x70cdc0 (original continuation)
+};
+}
diff --git a/rpcs3/Emu/Cell/green_rollback_async_log.h b/rpcs3/Emu/Cell/green_rollback_async_log.h
new file mode 100644
index 000000000..f71f7b917
--- /dev/null
+++ b/rpcs3/Emu/Cell/green_rollback_async_log.h
@@ -0,0 +1,85 @@
+#pragma once
+#include <atomic>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+
+namespace green_rollback
+{
+// Only immutable, owned strings cross the thread boundary. The sink must
+// outlive this object. The owning thread closes/destroys once producers stop;
+// enqueue may race close, but concurrent close calls are not supported.
+class async_log_writer
+{
+public:
+    struct counters { std::uint64_t accepted, written, dropped, failures; };
+    using sink = std::function<bool(const std::string&)>;
+    using finish = std::function<bool()>;
+private:
+    sink write;
+    finish flush;
+    std::vector<std::string> queue;
+    const std::size_t byte_limit, record_limit;
+    std::mutex mutex;
+    std::condition_variable ready;
+    std::size_t head{}, count{}, bytes{};
+    bool stopping{};
+    std::atomic<std::uint64_t> accepted{}, written{}, dropped{}, failures{};
+    std::thread worker;
+
+    void run() noexcept
+    {
+        bool healthy = true;
+        for (;;)
+        {
+            std::string line;
+            {
+                std::unique_lock lock(mutex);
+                ready.wait(lock, [&] { return stopping || count; });
+                if (!count) break;
+                line = std::move(queue[head]);
+                head = (head + 1) % queue.size(); --count; bytes -= line.size();
+            }
+            if (!healthy) { ++dropped; continue; }
+            try { healthy = write(line); } catch (...) { healthy = false; }
+            if (healthy) ++written;
+            else ++failures; // A partial/failed write permanently closes the sink circuit.
+        }
+        try { if (flush && !flush()) ++failures; } catch (...) { ++failures; }
+    }
+public:
+    explicit async_log_writer(sink output, finish final = {}, std::size_t capacity = 128,
+                              std::size_t max_bytes = 256 * 1024, std::size_t max_record = 16 * 1024)
+        : write(std::move(output)), flush(std::move(final)), queue(capacity ? capacity : 1),
+          byte_limit(max_bytes), record_limit(max_record), worker([this] { run(); }) {}
+    async_log_writer(const async_log_writer&) = delete;
+    async_log_writer& operator=(const async_log_writer&) = delete;
+    ~async_log_writer() { close(); }
+
+    bool enqueue(std::string line) noexcept
+    {
+        // A slow sink never holds this mutex. Even producer contention drops
+        // a record instead of waiting for another thread's scheduling/I/O.
+        std::unique_lock lock(mutex, std::try_to_lock);
+        if (!lock || stopping || failures.load(std::memory_order_relaxed) ||
+            count == queue.size() || line.size() > record_limit || line.size() > byte_limit - bytes)
+        { ++dropped; return false; }
+        bytes += line.size(); queue[(head + count) % queue.size()] = std::move(line);
+        ++count; ++accepted;
+        lock.unlock(); ready.notify_one(); return true;
+    }
+    counters stats() const noexcept { return {accepted.load(), written.load(), dropped.load(), failures.load()}; }
+    void close()
+    {
+        if (!worker.joinable()) return;
+        { std::lock_guard lock(mutex); stopping = true; }
+        ready.notify_one(); worker.join();
+    }
+};
+}
diff --git a/rpcs3/Emu/Cell/green_rollback_bounded_log.h b/rpcs3/Emu/Cell/green_rollback_bounded_log.h
new file mode 100644
index 000000000..8a8e2a9a8
--- /dev/null
+++ b/rpcs3/Emu/Cell/green_rollback_bounded_log.h
@@ -0,0 +1,108 @@
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <utility>
+namespace green_rollback
+{
+// Single writer-thread policy. The producer owns JSON serialization; this
+// class checks object framing, physical record boundaries and byte budgets.
+// append must write the complete supplied record; atomic_replace must commit
+// the complete supplied image atomically. A failed sink closes the worker's
+// circuit: the policy preserves its state, but cannot undo a partial disk I/O.
+class bounded_json_log
+{
+public:
+    using sink = std::function<bool(const std::string&)>;
+private:
+    static constexpr std::size_t max_line = 16 * 1024;
+    static constexpr std::size_t marker_reserve =
+        sizeof("{\"event\":\"log_truncated\",\"trim_count\":18446744073709551615}\n") - 1;
+    const std::size_t limit;
+    const std::string header;
+    sink append, atomic_replace;
+    std::string contents;
+    std::size_t records_start{};
+    std::uint64_t trims{};
+
+    static bool framed(const std::string& line) noexcept
+    {
+        if (line.size() < 3 || line.size() > max_line || line.front() != '{' ||
+            line[line.size() - 2] != '}' || line.back() != '\n') return false;
+        for (std::size_t i = 0; i + 1 < line.size(); ++i)
+            if (static_cast<unsigned char>(line[i]) < 0x20) return false;
+        return true;
+    }
+    static bool invoke(const sink& callback, const std::string& data) noexcept
+    {
+        try { return callback(data); }
+        catch (...) { return false; }
+    }
+public:
+    bounded_json_log(std::size_t byte_limit, std::string ownership_header,
+                     sink append_record, sink replace_image)
+        : limit(byte_limit), header(std::move(ownership_header)),
+          append(std::move(append_record)), atomic_replace(std::move(replace_image))
+    {
+        // Reserve enough room for a full-width future trim counter and at
+        // least the smallest object record. Subtract only after size checks.
+        if (!framed(header) || !append || !atomic_replace || limit < header.size() ||
+            limit - header.size() < marker_reserve + 3)
+            throw std::invalid_argument("invalid bounded JSONL header, sinks or budget");
+    }
+
+    bool write(const std::string& line) noexcept
+    {
+        if (!framed(line) || line.size() > limit - header.size() - marker_reserve)
+            return false;
+        try
+        {
+            if (contents.empty())
+            {
+                std::string next = header + line;
+                // Fix each image's capacity at the cap, avoiding geometric
+                // append growth beyond it. Trimming holds at most two images.
+                next.reserve(limit);
+                if (!invoke(atomic_replace, next)) return false;
+                contents.swap(next);
+                records_start = header.size();
+                return true;
+            }
+            if (line.size() <= limit - contents.size())
+            {
+                const auto old_size = contents.size();
+                contents.append(line); // Allocate before committing disk output.
+                if (!invoke(append, line))
+                {
+                    contents.resize(old_size);
+                    return false;
+                }
+                return true;
+            }
+            const auto next_trims = trims == std::numeric_limits<std::uint64_t>::max()
+                ? trims : trims + 1;
+            const std::string marker = "{\"event\":\"log_truncated\",\"trim_count\":" +
+                std::to_string(next_trims) + "}\n";
+            const auto budget = limit - header.size() - marker.size();
+            const auto retain = std::min(budget / 2, budget - line.size());
+            auto start = std::max(records_start, contents.size() - std::min(contents.size(), retain));
+            if (start > records_start && contents[start - 1] != '\n')
+                start = contents.find('\n', start) + 1;
+
+            std::string next;
+            next.reserve(limit);
+            next.append(header).append(marker).append(contents, start, std::string::npos).append(line);
+            if (!invoke(atomic_replace, next)) return false;
+            contents.swap(next);
+            records_start = header.size() + marker.size();
+            trims = next_trims;
+            return true;
+        }
+        catch (...) { return false; }
+    }
+};
+}
