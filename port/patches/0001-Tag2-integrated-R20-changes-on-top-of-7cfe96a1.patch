+  const auto parent=restart_arguments();QStringList args={"--tag2-parent-pid",parent[1],"--tag2-parent-created",parent[2]};if(parser.isSet("tag2-resume-rollback"))args<<"--tag2-resume-rollback";
+  pending_exit=ExitRequest{safe_path(root,"rpcs3.exe"),root,args};result=0;return true;
+ }catch(const std::exception& e){failure(QString::fromUtf8("태그2 설치 확인"),QString::fromUtf8(e.what()));result=1;return true;}
+}
+}
