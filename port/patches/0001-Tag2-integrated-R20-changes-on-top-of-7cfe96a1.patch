+struct runtime
+{
+    fs::file log;
+    std::string log_path;
+    u64 epoch = 0;
+    u32 thread = 0, manager = 0, ring = 0, net = 0, local = 0, remote = 0;
+    u32 observed_frame = 0, predicted_at = absent_id;
+    u32 save_slot = 0, save_manager = 0, restore_slot = 0;
+    u32 step_frame = 0, step_argument = 0;
+    bool full_save = false, active = false, poisoned = false, replaying = false;
+    bool entering_fight = false;
+    std::array<u32, event_count> trampolines{};
+    std::array<frame_image, snapshot_count> snapshots{};
+    std::vector<owner_image> saving_owners;
+    snapshot_store supplements{0x10000};
+    input_timeline local_inputs, remote_inputs;
+    session_guard guard;
+    u64 saves = 0, restores = 0, replay_frames = 0, predictions = 0, stalls = 0, rejected = 0;
+    u64 unsupported_snapshots = 0, next_summary = 300;
