@@ -0,0 +1,16 @@
+#pragma once
+#include <QEvent>
+#include <QKeyEvent>
+#include <functional>
+
+namespace tag2 {
+inline bool lobby_hotkey(QEvent* event, bool focused, bool enabled, const std::function<bool()>& request, const std::function<bool()>& confirm)
+{
+    if (!focused || !enabled || event->type() != QEvent::KeyPress) return false;
+    const auto* key = static_cast<QKeyEvent*>(event);
+    if (key->isAutoRepeat() || key->key() != Qt::Key_F8) return false;
+    if (key->modifiers() == Qt::ControlModifier) return request && request();
+    if (key->modifiers() == (Qt::ControlModifier | Qt::ShiftModifier)) return confirm && confirm();
+    return false;
+}
+}
diff --git a/rpcs3/rpcs3qt/tag2_native_network.cpp b/rpcs3/rpcs3qt/tag2_native_network.cpp
new file mode 100644
index 000000000..ddd635dca
--- /dev/null
+++ b/rpcs3/rpcs3qt/tag2_native_network.cpp
@@ -0,0 +1,92 @@
+#include "tag2_native_network.h"
+#include <QJsonArray>
+#include <QNetworkAccessManager>
+#include <QNetworkReply>
+#include <QNetworkRequest>
+#include <QEventLoop>
+#include <QTimer>
+#include <QElapsedTimer>
+#include <QRegularExpression>
+#include <QUuid>
+namespace tag2 {
+static constexpr qint64 max_zip=256LL*1024*1024;
+static QString asset_url(const Asset& a,const QString& tag){
+ const QString expected="https://github.com/"+QString(repository)+"/releases/download/"+tag+"/"+a.name;
+ if(a.url!=expected)throw Failure("Unexpected release asset URL");return a.url;
+}
+Release parse_release(const QByteArray& bytes){
+ const auto j=strict_json(bytes);if(!j["draft"].isBool()||!j["prerelease"].isBool())throw Failure("Invalid release flags");
+ if(j["draft"].toBool()||j["prerelease"].toBool())return {};
+ Release r;r.tag=j["tag_name"].toString();
+ if(!QRegularExpression("^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$").match(r.tag).hasMatch()||!j["assets"].isArray())throw Failure("Invalid release response");
+ for(const auto& value:j["assets"].toArray()){
+  auto row=value.toObject();Asset a{row["name"].toString(),row["browser_download_url"].toString(),row["size"].toInteger(-1)};
+  if(a.name.isEmpty()||r.assets.contains(a.name)||a.size<1)throw Failure("Invalid or duplicate release asset");r.assets.insert(a.name,a);
+ }
+ if(r.assets.contains("tag2-update.json")){const auto& a=r.assets["tag2-update.json"];if(a.size>65536)throw Failure("Metadata size limit");asset_url(a,r.tag);}
+ return r;
+}
+Update parse_update(const QByteArray& bytes,const Release& r,int installed){
+ const auto j=strict_json(bytes);if(j["schema"].toInt()==1)return {};
+ if(j["schema"].toInt()!=2||j["repository"]!=repository||j["tag"]!=r.tag)throw Failure("Unsupported native update metadata");
+ Update u;u.sequence=j["sequence"].toInt(-1);u.release=j["release_id"].toString();u.hash=j["sha256"].toString();
+ const QString name=j["asset"].toString();const qint64 size=j["size"].toInteger(-1);
+ if(u.sequence<6||!QRegularExpression("^TAG2-RPCS3-[0-9]{8}-R[0-9]+$").match(u.release).hasMatch()||!u.release.endsWith("-R"+QString::number(u.sequence))||!QRegularExpression("^[0-9a-f]{64}$").match(u.hash).hasMatch()||!QRegularExpression("^[A-Za-z0-9][A-Za-z0-9._-]*\\.zip$").match(name).hasMatch()||size<1||size>max_zip)throw Failure("Invalid native update identity");
+ if(!r.assets.contains(name)||r.assets[name].size!=size)throw Failure("Update asset size mismatch");
+ u.asset=r.assets[name];asset_url(u.asset,r.tag);u.available=u.sequence>installed;return u;
+}
+static void hop(const QUrl& url,bool redirected){
+ const QString host=url.host();
+ if(url.scheme()!="https"||url.port(443)!=443||!url.userInfo().isEmpty()||!url.fragment().isEmpty()||!(host=="github.com"||host=="api.github.com"||(redirected&&(host=="release-assets.githubusercontent.com"||host=="objects.githubusercontent.com"))))throw Failure("Unexpected download host");
+}
+QByteArray fetch(const QUrl& initial,qint64 maximum,Progress progress,const std::function<bool()>& cancelled){
+ if(maximum<1||maximum>max_zip)throw Failure("Download bound invalid");
+ QNetworkAccessManager manager;QUrl url=initial;QElapsedTimer elapsed;elapsed.start();
+ const qint64 deadline=maximum>1024*1024?900000:30000;
+ for(int n=0;n<6;++n){
+  if(cancelled&&cancelled())throw Failure("Cancelled");hop(url,n!=0);
+  QNetworkRequest request(url);request.setRawHeader("User-Agent","Tag2-RPCS3/6");request.setRawHeader("Accept","application/vnd.github+json, application/octet-stream");
+  request.setAttribute(QNetworkRequest::RedirectPolicyAttribute,QNetworkRequest::ManualRedirectPolicy);request.setTransferTimeout(15000);
+  QNetworkReply* reply=manager.get(request);QEventLoop loop;QTimer timer;timer.setInterval(100);QByteArray data;QString failure;
+  auto drain=[&]{data+=reply->readAll();if(data.size()>maximum){failure="Download exceeds declared size";reply->abort();}if(progress)progress("download",int(data.size()),int(maximum));};
+  QObject::connect(reply,&QNetworkReply::readyRead,&loop,drain);
+  QObject::connect(reply,&QNetworkReply::finished,&loop,&QEventLoop::quit);
+  QObject::connect(&timer,&QTimer::timeout,&loop,[&]{if((cancelled&&cancelled())||elapsed.elapsed()>deadline){failure=(cancelled&&cancelled())?"Cancelled":"Download timeout";reply->abort();}});
+  timer.start();loop.exec();timer.stop();drain();
+  const int status=reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+  const auto redirect=reply->attribute(QNetworkRequest::RedirectionTargetAttribute).toUrl();
+  const auto error=reply->error();const QString message=reply->errorString();const auto length=reply->header(QNetworkRequest::ContentLengthHeader);delete reply;
+  if(!failure.isEmpty())throw Failure(failure);
+  if(status==301||status==302||status==303||status==307||status==308){if(redirect.isEmpty())throw Failure("Missing redirect");url=url.resolved(redirect);continue;}
+  if(status!=200||error!=QNetworkReply::NoError)throw Failure("Update request failed: "+message);
+  if(length.isValid()&&length.toLongLong()!=data.size())throw Failure("Truncated response");return data;
+ }
+ throw Failure("Too many redirects");
+}
+Update available_update(const QString& root,Progress progress,const std::function<bool()>& cancelled){
+ const auto installed=parse_package(read_bytes(safe_path(root,manifest_path)));
+ const auto release=parse_release(fetch(QUrl("https://api.github.com/repos/"+QString(repository)+"/releases/latest"),1024*1024,progress,cancelled));
+ if(!release.assets.contains("tag2-update.json"))return {};
+ const auto meta=release.assets["tag2-update.json"];const auto data=fetch(QUrl(meta.url),meta.size,progress,cancelled);
+ if(data.size()!=meta.size)throw Failure("Metadata length mismatch");
+ return parse_update(data,release,installed.sequence);
+}
+QString stage_update(const QString& root,const Update& update,Progress progress,const std::function<bool()>& cancelled){
+ if(!update.available)return {};
+ const auto zip=fetch(QUrl(update.asset.url),update.asset.size,progress,cancelled);
+ if(progress)progress("verify",0,0);
+ if(cancelled&&cancelled())throw Failure("Cancelled");
+ if(zip.size()!=update.asset.size||hash_bytes(zip)!=update.hash)throw Failure("Update ZIP size or SHA256 mismatch");
+ if(cancelled&&cancelled())throw Failure("Cancelled");
+ const QString stage=safe_path(root,".tag2-native/downloads/"+QUuid::createUuid().toString(QUuid::Id128));
+ if(progress)progress("unpack",0,0);
+ if(cancelled&&cancelled())throw Failure("Cancelled");
+ unpack_zip(zip,stage,allowed_files());
+ if(progress)progress("verify",0,0);
+ if(cancelled&&cancelled())throw Failure("Cancelled");
+ const auto package=load_package(stage);
+ if(package.sequence!=update.sequence||package.release!=update.release)throw Failure("ZIP manifest identity mismatch");
+ if(cancelled&&cancelled())throw Failure("Cancelled");return stage;
+}
+QString check_update(const QString& root,Progress progress,const std::function<bool()>& cancelled){return stage_update(root,available_update(root,progress,cancelled),progress,cancelled);}
+}
