+        return vm::try_access(address,out,length,false);
+    }
+    inline std::atomic<bool> bridge_enabled{false};
+    // Sole emulated-memory capability supplied to the embedded calculator.
+    // It cannot call a guest function or write a gameplay variable.
+    inline int bridge_read(std::uint32_t address,void* out,std::uint32_t length) noexcept
+    {
+        if(!bridge_enabled.load(std::memory_order_acquire) || !out || !length || length>8*1024*1024)return 0;
+        try{return read_guest(address,out,length)?1:0;}catch(...){return 0;}
+    }
