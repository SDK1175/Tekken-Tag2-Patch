+// All methods after construction run on the async writer. Trimming commits a
+// complete replacement; an archive reader sees either complete generation.
+struct bounded_file_sink
+{
+    fs::file file;
+    std::string path;
+    std::unique_ptr<bounded_json_log> records;
+    bounded_file_sink(std::string name, u64 session_id, const char* stream, usz limit, bool owned = true)
+        : path(std::move(name))
+    {
+        if (!file.open(path, fs::write + fs::create + fs::excl))
+            throw std::runtime_error("Cannot create rollback diagnostic stream");
+        const std::string header = fmt::format("{\"event\":\"diagnostic_header\",\"owner\":\"%s\","
+            "\"schema\":1,\"session_id\":%llu,\"stream\":\"%s\",\"limit_bytes\":%llu}\n",
+            owned ? "tag2-rollback-results-1" : "tag2-rollback-unowned-1", session_id, stream, static_cast<u64>(limit));
+        records = std::make_unique<bounded_json_log>(limit, header,
+            [this](const std::string& bytes) { return diagnostic_write(file, bytes); },
+            [this](const std::string& bytes)
+            {
+                diagnostic_temporary replacement;
+                for (unsigned attempt = 0; attempt != 8; ++attempt)
+                {
+                    replacement.path = fs::generate_neighboring_path(path, 0);
+                    if (replacement.file.open(replacement.path, fs::write + fs::create + fs::excl)) break;
+                    const bool collided = fs::g_tls_error == fs::error::exist;
+                    replacement.path.clear(); // Never remove an unowned collision.
+                    if (!collided) return false;
+                }
+                if (!replacement.file) return false;
+#ifdef _WIN32
+                FILE_DISPOSITION_INFO disposition{};
+                disposition.DeleteFile = true;
+                if (!SetFileInformationByHandle(replacement.file.get_handle(), FileDispositionInfo, &disposition, sizeof(disposition))) return false;
+#endif
+                if (!diagnostic_write(replacement.file, bytes) || !diagnostic_sync(replacement.file)) return false;
+                // Windows can reject replacement while the destination handle
+                // is open, even with delete sharing. Keep its path intact until
+                // the complete pending image is ready, then close and commit.
+                file.close();
+#ifdef _WIN32
+                disposition.DeleteFile = false;
+                if (!SetFileInformationByHandle(replacement.file.get_handle(), FileDispositionInfo, &disposition, sizeof(disposition))) return false;
+#endif
+                replacement.file.close();
+                if (!fs::rename(replacement.path, path, true)) return false;
+                replacement.path.clear();
+                return file.open(path, fs::write + fs::append);
+            });
+    }
+    bool write(const std::string& line) { return records->write(line); }
+    bool flush() { return diagnostic_sync(file); }
+};
