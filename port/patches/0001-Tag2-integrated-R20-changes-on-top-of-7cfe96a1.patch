+    bool network(u32 candidate)
+    {
+        if (!mapped(candidate, 0x1780)) return false;
+        const u32 n = candidate + 0x28;
+        if (read32(n + 0x12f4) != 2 || read32(n + 0x12f8) != 2 || read32(n + 0x13b0) > 1) return false;
+        const u32 a = read32(n + 0x12dc), b = read32(n + 0x12e0);
