+constexpr qint64 mib = 1024 * 1024;
+constexpr qint64 archive_limit = 4 * mib;
+constexpr qint64 rpc_limit = 512 * 1024;
+constexpr int retained_archives = 5;
+const QString collector_id = QStringLiteral("tag2-native-diagnostics-1");
+
+qint64 now_us()
+{
+    return std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count();
+}
+
+// Keep this read-only handle for the entire capture session. In particular, a
+// rename/compression of RPCS3.log must not switch us to another launch's log.
+class SharedRead
+{
+#ifdef _WIN32
+    HANDLE m_handle = INVALID_HANDLE_VALUE;
+#else
+    QFile m_file;
+#endif
+public:
+    explicit SharedRead(const QString& path)
+    {
+        safe_absolute(path);
+#ifdef _WIN32
+        m_handle = CreateFileW(reinterpret_cast<const wchar_t*>(QDir::toNativeSeparators(path).utf16()),
+            GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr,
+            OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL | FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+        if (m_handle == INVALID_HANDLE_VALUE) throw Failure("Cannot open diagnostic source");
+        BY_HANDLE_FILE_INFORMATION info{};
+        if (!GetFileInformationByHandle(m_handle, &info) ||
+            (info.dwFileAttributes & (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DIRECTORY)))
+        {
+            CloseHandle(m_handle);
+            m_handle = INVALID_HANDLE_VALUE;
+            throw Failure("Unsafe diagnostic source");
+        }
+#else
+        m_file.setFileName(path);
+        if (!m_file.open(QIODevice::ReadOnly)) throw Failure("Cannot open diagnostic source");
+#endif
+    }
+
+    ~SharedRead()
+    {
+#ifdef _WIN32
+        if (m_handle != INVALID_HANDLE_VALUE) CloseHandle(m_handle);
+#endif
+    }
+    SharedRead(const SharedRead&) = delete;
+    SharedRead& operator=(const SharedRead&) = delete;
+
+    qint64 size() const
+    {
+#ifdef _WIN32
+        LARGE_INTEGER result{};
+        if (!GetFileSizeEx(m_handle, &result) || result.QuadPart < 0) throw Failure("Cannot size diagnostic source");
+        return result.QuadPart;
+#else
+        return m_file.size();
+#endif
+    }
+
+    qint64 modified_us() const
+    {
+#ifdef _WIN32
+        FILETIME modified{};
+        if (!GetFileTime(m_handle, nullptr, nullptr, &modified)) throw Failure("Cannot date diagnostic source");
+        const quint64 ticks = (quint64(modified.dwHighDateTime) << 32) | modified.dwLowDateTime;
+        return qint64((ticks - 116444736000000000ULL) / 10);
+#else
+        return QFileInfo(m_file).lastModified().toMSecsSinceEpoch() * 1000;
+#endif
+    }
+
+    QByteArray read_at(qint64 offset, qint64 count)
+    {
+        if (offset < 0 || count < 0 || count > 2 * mib) throw Failure("Diagnostic read bound");
+        QByteArray result(count, Qt::Uninitialized);
+#ifdef _WIN32
+        LARGE_INTEGER position{};
+        position.QuadPart = offset;
+        DWORD read = 0;
+        if (!SetFilePointerEx(m_handle, position, nullptr, FILE_BEGIN) ||
+            !ReadFile(m_handle, result.data(), static_cast<DWORD>(count), &read, nullptr))
+            throw Failure("Cannot read diagnostic source");
+        result.resize(read);
+#else
+        if (!m_file.seek(offset)) throw Failure("Cannot seek diagnostic source");
+        result = m_file.read(count);
+        if (m_file.error() != QFile::NoError) throw Failure("Cannot read diagnostic source");
+#endif
+        return result;
+    }
+};
+
+struct Excerpt
+{
+    QByteArray bytes;
+    QJsonObject info;
+};
+
+Excerpt excerpt(SharedRead& file, qint64 limit, qint64 head_bytes, bool json_lines)
+{
+    const qint64 size = file.size();
+    QByteArray bytes;
+    if (size <= limit)
+    {
+        bytes = file.read_at(0, size);
+        if (json_lines) bytes.truncate(bytes.lastIndexOf('\n') + 1);
+    }
+    else
+    {
+        const qint64 head_size = std::min(head_bytes, limit / 2);
+        QByteArray head = file.read_at(0, head_size);
+        head.truncate(head.lastIndexOf('\n') + 1);
+        QByteArray tail = file.read_at(size - (limit - head_size), limit - head_size);
+        const qsizetype newline = tail.indexOf('\n');
+        tail = newline < 0 ? QByteArray{} : tail.mid(newline + 1);
+        if (json_lines) tail.truncate(tail.lastIndexOf('\n') + 1);
+        bytes = head + tail;
+    }
+    return {bytes, {{"source_bytes", size}, {"captured_bytes", qint64(bytes.size())},
+        {"truncated", qint64(bytes.size()) < size}}};
+}
+
+QString redact_ips(const QString& text)
+{
+    struct Span { qsizetype start, size; };
+    QList<Span> spans;
+    // QHostAddress parses literals locally; this does not resolve a host or
+    // perform any network I/O. Validate IPv6 before masking its embedded IPv4.
+    static const QRegularExpression ipv6(QStringLiteral(
+        "(?<![0-9A-Za-z])(?:[0-9A-Fa-f]{0,4}:){2,}[0-9A-Fa-f:.]*(?:%[0-9A-Za-z_.~-]+)?"));
+    auto matches = ipv6.globalMatch(text);
+    while (matches.hasNext())
+    {
+        const auto match = matches.next();
+        QString candidate = match.captured();
+        qsizetype start = match.capturedStart();
+        if (candidate.startsWith(':') && !candidate.startsWith("::"))
+        {
+            candidate.remove(0, 1);
+            ++start;
+        }
+        // A sentence-ending period is outside the literal address.
+        while (candidate.endsWith('.')) candidate.chop(1);
+        const auto is_ipv6 = [](const QString& literal)
+        {
+            QHostAddress address;
+            return address.setAddress(literal) && address.protocol() == QAbstractSocket::IPv6Protocol;
+        };
+        qsizetype length = candidate.size();
+        if (!is_ipv6(candidate))
+        {
+            // A log separator or a filename suffix can be consumed by the
+            // broad candidate regex. Retry punctuation boundaries, longest
+            // first, without chopping arbitrary hex digits off an address.
+            // An unscoped IPv6 literal is at most 45 characters (mapped IPv4).
+            // Bound this search even for a damaged log full of colons.
+            length = 0;
+            for (qsizetype end = std::min<qsizetype>(45, candidate.size() - 1); end > 1; --end)
+            {
+                if ((candidate[end] == ':' || candidate[end] == '.') && is_ipv6(candidate.left(end)))
+                {
+                    length = end;
+                    break;
+                }
+            }
+        }
+        if (length) spans.append({start, length});
+    }
+    QString result = text;
+    for (auto it = spans.crbegin(); it != spans.crend(); ++it) result.replace(it->start, it->size, "<IP>");
+    spans.clear();
+    static const QRegularExpression ipv4(QStringLiteral("(?<![0-9])(?:[0-9]{1,3}\\.){3}[0-9]{1,3}(?![0-9])"));
+    matches = ipv4.globalMatch(result);
+    while (matches.hasNext())
+    {
+        const auto match = matches.next();
+        bool valid = true;
+        for (const QString& octet : match.captured().split('.'))
+            if (octet.toInt() > 255) { valid = false; break; }
+        if (valid) spans.append({match.capturedStart(), match.capturedLength()});
+    }
+    for (auto it = spans.crbegin(); it != spans.crend(); ++it) result.replace(it->start, it->size, "<IP>");
+    return result;
+}
+
+QByteArray redact_json_ips(const QByteArray& raw)
+{
+    // Edit only JSON string tokens, including keys and escaped Unicode. Leave
+    // numbers verbatim so uint64 counters and numeric formatting stay intact.
+    const auto visit_strings = [&](const auto& visit)
+    {
+        for (qsizetype start = 0; start < raw.size(); ++start)
+        {
+            if (raw[start] != '"') continue;
+            qsizetype end = start + 1;
+            for (; end < raw.size(); ++end)
+            {
+                if (raw[end] == '\\') { ++end; continue; }
+                if (raw[end] == '"') break;
+            }
+            if (end >= raw.size()) break;
+            qsizetype next = end + 1;
+            while (next < raw.size() && (raw[next] == ' ' || raw[next] == '\t' || raw[next] == '\r' || raw[next] == '\n')) ++next;
+            visit(start, end, next < raw.size() && raw[next] == ':');
+            start = end;
+        }
+    };
+    // Reserve original keys before choosing aliases, including markers that
+    // occur later in the file. Global aliases keep repeated address keys
+    // consistent across nested objects and JSONL records without merging any
+    // distinct original keys. Values and numeric tokens are never reserialized.
+    QSet<QString> reserved;
+    visit_strings([&](qsizetype start, qsizetype end, bool key)
+    {
+        if (!key) return;
+        const auto document = QJsonDocument::fromJson("[" + raw.mid(start, end - start + 1) + "]");
+        if (document.isArray() && document.array().size() == 1 && document.array()[0].isString())
+            reserved.insert(document.array()[0].toString());
+    });
+    QHash<QString, QString> aliases;
+    QHash<QString, quint64> suffixes;
+    QByteArray result;
+    qsizetype copied = 0;
+    visit_strings([&](qsizetype start, qsizetype end, bool key)
+    {
+        const QByteArray token = raw.mid(start, end - start + 1);
+        if (token.contains('.') || token.contains(':') || token.contains("\\u"))
+        {
+            const QJsonDocument document = QJsonDocument::fromJson("[" + token + "]");
+            if (document.isArray() && document.array().size() == 1 && document.array()[0].isString())
+            {
+                const QString original = document.array()[0].toString();
+                QString clean = redact_ips(original);
+                if (clean != original)
+                {
+                    if (key)
+                    {
+                        const auto alias = aliases.constFind(original);
+                        if (alias != aliases.cend()) clean = alias.value();
+                        else
+                        {
+                            const QString base = clean;
+                            quint64& suffix = suffixes[base];
+                            if (suffix < 2) suffix = 2;
+                            while (reserved.contains(clean)) clean = base + "#" + QString::number(suffix++);
+                            reserved.insert(clean);
+                            aliases.insert(original, clean);
+                        }
+                    }
+                    result += raw.mid(copied, start - copied);
+                    const QByteArray encoded = QJsonDocument(QJsonArray{clean}).toJson(QJsonDocument::Compact);
+                    result += encoded.mid(1, encoded.size() - 2);
+                    copied = end + 1;
+                }
+            }
+        }
+    });
+    result += raw.mid(copied);
+    return result;
+}
+
+QByteArray bound_json_lines(const QByteArray& data, qint64 limit, bool& truncated)
+{
+    truncated = data.size() > limit;
+    if (!truncated) return data;
+    const qint64 head_size = std::min<qint64>(32 * 1024, limit / 2);
+    QByteArray head = data.left(head_size);
+    head.truncate(head.lastIndexOf('\n') + 1);
+    QByteArray tail = data.right(limit - head_size);
+    const qsizetype cut = tail.indexOf('\n');
+    tail = cut < 0 ? QByteArray{} : tail.mid(cut + 1);
+    tail.truncate(tail.lastIndexOf('\n') + 1);
+    return head + tail;
+}
+
+QByteArray clean_rpc(const QByteArray& raw, const DiagnosticRequest& request, bool& truncated)
+{
+    truncated = false;
+    static const QRegularExpression secret(
+        QStringLiteral("password|authorization|auth.?token|access.?token|refresh.?token|ticket\\s*[:=]"),
+        QRegularExpression::CaseInsensitiveOption);
+    static const QRegularExpression user_path(
+        QStringLiteral("[A-Z]:[\\\\/]Users[\\\\/][^\\\\/\"\\r\\n]+"), QRegularExpression::CaseInsensitiveOption);
+    // NP prints roomPassword and its bytes on separate records. A tail excerpt
+    // can start after the label, so redact this channel's raw data independently.
+    // Keep VM/register/code dumps from unrelated channels available for analysis.
+    static const QRegularExpression np_data(
+        QStringLiteral("\\bsceNp2\\s*:\\s*data\\s*:"), QRegularExpression::CaseInsensitiveOption);
+    QStringList clean;
+    for (QString line : QString::fromUtf8(raw).split('\n'))
+    {
+        if (secret.match(line).hasMatch() || np_data.match(line).hasMatch()) continue;
+        // A config/log override can be outside the installation or user folder.
+        for (const auto& item : {qMakePair(request.root, QStringLiteral("<TAG2>")),
+                 qMakePair(request.config_root, QStringLiteral("<CONFIG>")),
+                 qMakePair(request.log_root, QStringLiteral("<LOG>"))})
+        {
+            const QString forward = QDir::fromNativeSeparators(QDir::cleanPath(item.first));
+            line.replace(forward, item.second, Qt::CaseInsensitive);
+            line.replace(QDir::toNativeSeparators(forward), item.second, Qt::CaseInsensitive);
+        }
+        line.replace(user_path, QStringLiteral("<USER>"));
+        clean.append(redact_ips(line));
+    }
+    QByteArray result = clean.join('\n').toUtf8();
+    // Invalid UTF-8 can expand while decoding; retain complete lines within the
+    // same byte budget even in that case.
+    if (result.size() > rpc_limit)
+    {
+        truncated = true;
+        QByteArray head = result.left(64 * 1024);
+        head.truncate(head.lastIndexOf('\n') + 1);
+        QByteArray tail = result.right(448 * 1024);
+        const auto cut = tail.indexOf('\n');
+        tail = cut < 0 ? QByteArray{} : tail.mid(cut + 1);
+        result = head + tail;
+    }
+    return result;
+}
+
+template <typename T> void little(QByteArray& output, T value)
+{
+    const qsizetype end = output.size();
+    output.resize(end + sizeof(T));
+    qToLittleEndian<T>(value, output.data() + end);
+}
+
+quint32 checksum(const QByteArray& bytes)
+{
+    return static_cast<quint32>(crc32(0, reinterpret_cast<const Bytef*>(bytes.constData()),
+        static_cast<uInt>(bytes.size())));
+}
+
+struct Entry { QString name; QByteArray bytes; };
+
+QByteArray deflate_log(const QByteArray& bytes)
+{
+    z_stream stream{};
+    if (deflateInit2(&stream, Z_BEST_SPEED, Z_DEFLATED, -MAX_WBITS, 8, Z_DEFAULT_STRATEGY) != Z_OK)
+        throw Failure("Cannot initialize diagnostic compression");
+    struct End { z_stream& s; ~End() { deflateEnd(&s); } } end{stream};
+    QByteArray compressed(qsizetype(deflateBound(&stream, uLong(bytes.size()))), Qt::Uninitialized);
+    stream.next_in = reinterpret_cast<Bytef*>(const_cast<char*>(bytes.constData()));
+    stream.avail_in = uInt(bytes.size());
+    stream.next_out = reinterpret_cast<Bytef*>(compressed.data());
+    stream.avail_out = uInt(compressed.size());
+    if (deflate(&stream, Z_FINISH) != Z_STREAM_END) throw Failure("Diagnostic compression failed");
+    compressed.resize(qsizetype(stream.total_out));
+    return compressed;
+}
+
+QByteArray stored_zip(const QList<Entry>& entries)
+{
+    QByteArray output, directory;
+    const QDateTime capture = QDateTime::currentDateTime();
+    const QDate day = capture.date();
+    const QTime clock = capture.time();
+    const quint16 date = quint16(((std::clamp(day.year(), 1980, 2107) - 1980) << 9) | (day.month() << 5) | day.day());
+    const quint16 time = quint16((clock.hour() << 11) | (clock.minute() << 5) | (clock.second() / 2));
+    for (const Entry& entry : entries)
+    {
+        const QByteArray name = redact_ips(entry.name).toUtf8();
+        const quint32 offset = static_cast<quint32>(output.size());
+        const quint32 size = static_cast<quint32>(entry.bytes.size());
+        const quint32 crc = checksum(entry.bytes);
+        // Keep the ownership member stored so older collectors can validate it.
+        QByteArray payload = entry.name == "report.json" ? entry.bytes : deflate_log(entry.bytes);
+        const quint16 method = entry.name != "report.json" && payload.size() < entry.bytes.size() ? 8 : 0;
+        if (!method) payload = entry.bytes;
+        const quint32 compressed_size = quint32(payload.size());
+        little<quint32>(output, 0x04034b50); little<quint16>(output, 20);
+        little<quint16>(output, 0x800); little<quint16>(output, method);
+        little<quint16>(output, time); little<quint16>(output, date);
+        little<quint32>(output, crc); little<quint32>(output, compressed_size); little<quint32>(output, size);
+        little<quint16>(output, quint16(name.size())); little<quint16>(output, 0);
+        output += name; output += payload;
+        little<quint32>(directory, 0x02014b50); little<quint16>(directory, 20); little<quint16>(directory, 20);
+        little<quint16>(directory, 0x800); little<quint16>(directory, method);
+        little<quint16>(directory, time); little<quint16>(directory, date);
+        little<quint32>(directory, crc); little<quint32>(directory, compressed_size); little<quint32>(directory, size);
+        little<quint16>(directory, quint16(name.size())); little<quint16>(directory, 0);
+        little<quint16>(directory, 0); little<quint16>(directory, 0); little<quint16>(directory, 0);
+        little<quint32>(directory, 0); little<quint32>(directory, offset); directory += name;
+    }
+    const quint32 directory_offset = static_cast<quint32>(output.size());
+    output += directory;
+    little<quint32>(output, 0x06054b50); little<quint16>(output, 0); little<quint16>(output, 0);
+    little<quint16>(output, quint16(entries.size())); little<quint16>(output, quint16(entries.size()));
+    little<quint32>(output, static_cast<quint32>(directory.size())); little<quint32>(output, directory_offset);
+    little<quint16>(output, 0);
+    if (output.size() > archive_limit) throw Failure("Diagnostic archive size limit");
+    return output;
+}
+
+// Ownership is in the first stored ZIP member, with a CRC and original name.
+// A filename match alone must never authorize deletion of somebody else's file.
+QJsonObject owned_report(const QString& path)
+{
+    try
+    {
+        SharedRead file(path);
+        if (file.size() > archive_limit) return {};
+        const QByteArray header = file.read_at(0, 30);
+        if (header.size() != 30 || qFromLittleEndian<quint32>(header.constData()) != 0x04034b50 ||
+            qFromLittleEndian<quint16>(header.constData() + 6) != 0x800 ||
+            qFromLittleEndian<quint16>(header.constData() + 8) != 0 ||
+            qFromLittleEndian<quint16>(header.constData() + 26) != 11 ||
+            qFromLittleEndian<quint16>(header.constData() + 28) != 0) return {};
+        const quint32 size = qFromLittleEndian<quint32>(header.constData() + 18);
+        if (!size || size > 64 * 1024 || qFromLittleEndian<quint32>(header.constData() + 22) != size) return {};
+        const QByteArray member = file.read_at(30, 11 + size);
+        if (member.size() != 11 + size || member.left(11) != "report.json") return {};
+        const QByteArray json = member.mid(11);
+        if (checksum(json) != qFromLittleEndian<quint32>(header.constData() + 14)) return {};
+        const QJsonObject report = QJsonDocument::fromJson(json).object();
+        if (report.value("collector").toString() != collector_id ||
+            report.value("archive_name").toString() != QFileInfo(path).fileName() ||
+            report.value("archive_id").toString().isEmpty() || report.value("started_utc_us").toInteger() <= 0)
+            return {};
+        return report;
+    }
+    catch (...) { return {}; }
+}
+
+void prune_archives(const QString& folder)
+{
+    struct Owned { QString path; qint64 started, captured; };
+    QList<Owned> owned;
+    const QRegularExpression pattern(QStringLiteral("^롤백로그_\\d{4}-\\d{2}-\\d{2}_\\d{2}-\\d{2}(?:_[2-9]\\d*|_1\\d+)?\\.zip$"));
+    for (const QFileInfo& file : QDir(folder).entryInfoList({QStringLiteral("롤백로그_*.zip")}, QDir::Files | QDir::NoSymLinks))
+    {
+        if (!pattern.match(file.fileName()).hasMatch()) continue;
+        const QJsonObject report = owned_report(file.absoluteFilePath());
+        if (!report.isEmpty()) owned.append({file.absoluteFilePath(), report.value("started_utc_us").toInteger(),
+            report.value("first_capture_utc_us").toInteger()});
+    }
+    std::sort(owned.begin(), owned.end(), [](const Owned& a, const Owned& b)
+    {
+        if (a.started != b.started) return a.started > b.started;
+        if (a.captured != b.captured) return a.captured > b.captured;
+        return a.path > b.path;
+    });
+    for (qsizetype index = retained_archives; index < owned.size(); ++index)
+    {
+        try
+        {
+            const QString path = safe_path(folder, QFileInfo(owned[index].path).fileName());
+            safe_absolute(path + ".lock");
+            QLockFile lock(path + ".lock"); lock.setStaleLockTime(0);
+            if (!lock.tryLock(0)) continue; // An older launch is still using it.
+            if (owned_report(path).isEmpty()) continue;
+            safe_absolute(path);
+            QFile::remove(path);
+        }
+        catch (...) { } // Retention never invalidates a committed snapshot.
+    }
+}
+
+bool owned_stream(const QString& path, qint64 session, const QString& stream)
+{
+    try
+    {
+        safe_absolute(path);
+        SharedRead file(path);
+        const QByteArray head = file.read_at(0, std::min<qint64>(file.size(), 4096));
+        const auto newline = head.indexOf('\n');
+        if (newline < 0) return false;
+        const QJsonObject header = QJsonDocument::fromJson(head.left(newline)).object();
+        return header.value("event").toString() == "diagnostic_header" &&
+            header.value("owner").toString() == "tag2-rollback-results-1" &&
+            header.value("session_id").toInteger() == session && header.value("stream").toString() == stream;
+    }
+    catch (...) { return false; }
+}
+
+void prune_raw_sessions(const QString& folder)
+{
+    // New streams carry ownership metadata. Existing/imported logs have no such
+    // contract and are never adopted merely because their filename matches.
+    QMap<qint64, QList<QPair<QString, QString>>> sessions;
+    const QRegularExpression name(QStringLiteral("^(ggpo|results)-(\\d+)\\.jsonl$"));
+    for (const QFileInfo& file : QDir(folder).entryInfoList({"ggpo-*.jsonl", "results-*.jsonl"}, QDir::Files | QDir::NoSymLinks))
+    {
+        const auto match = name.match(file.fileName());
+        bool ok = false;
+        const qint64 stamp = match.captured(2).toLongLong(&ok);
+        if (match.hasMatch() && ok && stamp > 0 && owned_stream(file.absoluteFilePath(), stamp, match.captured(1)))
+            sessions[stamp].append({file.absoluteFilePath(), match.captured(1)});
+    }
+    int remaining = sessions.size();
+    for (auto it = sessions.cbegin(); it != sessions.cend() && remaining > retained_archives; ++it, --remaining)
+    {
+        try
+        {
+            const QString lock_path = safe_path(folder, "session-" + QString::number(it.key()) + ".active");
+#ifdef _WIN32
+            // The native writer holds a handle denying FILE_SHARE_WRITE for its
+            // entire lifetime. A stale lock after a crash can be opened safely.
+            const HANDLE handle = CreateFileW(reinterpret_cast<const wchar_t*>(QDir::toNativeSeparators(lock_path).utf16()),
+                GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+            if (handle == INVALID_HANDLE_VALUE && GetLastError() != ERROR_FILE_NOT_FOUND) continue;
+            struct Close { HANDLE h; ~Close() { if (h != INVALID_HANDLE_VALUE) CloseHandle(h); } } held{handle};
+#else
+            // Linux raw retention is conservative until the native lock can be
+            // checked here; archive retention remains available on all systems.
+            if (QFileInfo::exists(lock_path)) continue;
+#endif
+            for (const auto& item : it.value())
+            {
+                const QString path = safe_path(folder, QFileInfo(item.first).fileName());
+                if (owned_stream(path, it.key(), item.second)) QFile::remove(path);
+            }
+            QFile::remove(lock_path);
+        }
+        catch (...) { } // Retention cannot invalidate an already committed ZIP.
+    }
+}
+}
+
+struct DiagnosticArchive::Impl
+{
+    DiagnosticRequest request;
+    std::unique_ptr<SharedRead> rpc;
+    std::unique_ptr<QLockFile> archive_lock;
+    QString output, archive_id = QUuid::createUuid().toString(QUuid::WithoutBraces);
+    QJsonObject hashes, last_rpc_info;
+    QJsonArray hash_errors;
+    QByteArray last_rpc;
+    qint64 first_capture = 0, sequence = 0;
+    bool hashes_ready = false, committed = false;
+
+    explicit Impl(DiagnosticRequest value) : request(std::move(value))
+    {
+        for (QString* path : {&request.root, &request.config_root, &request.log_root, &request.executable})
+        {
+            *path = QDir::cleanPath(QFileInfo(*path).absoluteFilePath());
+            safe_absolute(*path);
+        }
+        if (request.started_us <= 0 || !request.pid || !request.created) throw Failure("Missing diagnostic process identity");
+        open_rpc(now_us());
+    }
+
+    void open_rpc(qint64 until)
+    {
+        if (rpc) return;
+        try
+        {
+            auto candidate = std::make_unique<SharedRead>(safe_path(request.log_root, "RPCS3.log"));
+            const qint64 modified = candidate->modified_us();
+            if (modified >= request.started_us && modified <= until) rpc = std::move(candidate);
+        }
+        catch (...) { }
+    }
+
+    void collect_hashes()
+    {
+        if (hashes_ready) return;
+        const QList<QPair<QString, QString>> files = {
+            {QFileInfo(request.executable).fileName(), QString{}},
+            {"patches/patch.yml", "patches/patch.yml"},
+            {"config/patch_config.yml", "config/patch_config.yml"}};
+        for (const auto& item : files)
+        {
+            try
+            {
+                // Optional paths may be absent, collide, or be rejected as
+                // reparse points. None of those failures should discard logs.
+                const QString path = item.second.isEmpty() ? request.executable : safe_path(request.config_root, item.second);
+                const QString hash = hash_file(path);
+                hashes.insert(item.first, hash.isEmpty() ? QJsonValue::Null : QJsonValue(hash));
+            }
+            catch (...)
+            {
+                hashes.insert(item.first, QJsonValue::Null);
+                hash_errors.append(QJsonObject{{"name", item.first}, {"error", "hash_unavailable"}});
+            }
+        }
+        hashes_ready = true;
+    }
+
+    void reserve_output()
+    {
+        if (!output.isEmpty()) return;
+        const QString folder = safe_path(request.root, "rollback_logs");
+        if (!QDir().mkpath(folder)) throw Failure("Cannot create diagnostic directory");
+        safe_absolute(folder);
+        const QString base = QStringLiteral("롤백로그_") +
+            QDateTime::fromMSecsSinceEpoch(request.started_us / 1000).toString("yyyy-MM-dd_HH-mm");
+        for (int suffix = 1; suffix <= 10000; ++suffix)
+        {
+            const QString path = safe_path(folder, base + (suffix == 1 ? QString{} : "_" + QString::number(suffix)) + ".zip");
+            if (QFileInfo::exists(path)) continue;
+            safe_absolute(path + ".lock");
+            auto lock = std::make_unique<QLockFile>(path + ".lock"); lock->setStaleLockTime(0);
+            if (!lock->tryLock(0) || QFileInfo::exists(path)) continue;
+            archive_lock = std::move(lock);
+            output = path;
+            return;
+        }
+        throw Failure("Diagnostic archive name collision limit");
+    }
+
+    QString snapshot(const QString& state, qint64 until)
+    {
+        if (state != "running" && state != "closing") throw Failure("Unknown diagnostic capture state");
+        struct Native { QString path, name; qint64 timestamp; };
+        QList<Native> found;
+        const QString native_root = safe_path(request.config_root, "green_rollback");
+        static const QRegularExpression native_name(QStringLiteral("^ggpo-(\\d+)\\.jsonl$"));
+        for (const QFileInfo& file : QDir(native_root).entryInfoList({"ggpo-*.jsonl"}, QDir::Files | QDir::NoSymLinks))
+        {
+            const auto match = native_name.match(file.fileName());
+            if (!match.hasMatch()) continue;
+            bool ok = false;
+            const qint64 timestamp = match.captured(1).toLongLong(&ok);
+            if (ok && timestamp >= request.started_us && timestamp <= until)
+                found.append({file.absoluteFilePath(), file.fileName(), timestamp});
+        }
+        if (found.isEmpty() && !committed) return {}; // Ordinary RPCS3 use makes no ZIP or folder.
+        std::sort(found.begin(), found.end(), [](const Native& a, const Native& b) { return a.timestamp > b.timestamp; });
+        collect_hashes();
+        QList<Entry> entries;
+        QJsonArray native_info, result_info, errors = hash_errors;
+        QJsonValue frames = QJsonValue::Null;
+        const qsizetype selected = std::min<qsizetype>(4, found.size());
+        for (qsizetype index = 0; index < selected; ++index)
+        {
+            try
+            {
+                SharedRead file(found[index].path);
+                const qint64 limit = index == 0 ? 2 * mib : 128 * 1024;
+                Excerpt data = excerpt(file, limit, 32 * 1024, true);
+                bool mask_truncated = false;
+                const QByteArray clean = bound_json_lines(redact_json_ips(data.bytes), limit, mask_truncated);
+                data.info.insert("redacted", clean != data.bytes);
+                data.info.insert("captured_bytes", qint64(clean.size()));
+                data.info.insert("truncated", data.info.value("truncated").toBool() || mask_truncated);
+                data.bytes = clean;
+                data.info.insert("name", found[index].name);
+                data.info.insert("last_capture_utc_us", now_us());
+                native_info.append(data.info);
+                entries.append({found[index].name, data.bytes});
+                for (const QByteArray& line : data.bytes.split('\n'))
+                {
+                    if (line.isEmpty()) continue;
+                    const QJsonObject event = QJsonDocument::fromJson(line).object();
+                    if (frames.isNull() && event.value("event").toString() == "session_start" &&
+                        event.value("rollback_limit").isDouble()) frames = event.value("rollback_limit");
+                }
+            }
+            catch (...) { errors.append(QJsonObject{{"name", found[index].name}, {"error", "read_unavailable"}}); }
+            const QString result_name = "results-" + QString::number(found[index].timestamp) + ".jsonl";
+            try
+            {
+                const QString result_path = safe_path(native_root, result_name);
+                if (!QFileInfo::exists(result_path)) continue;
+                if (!owned_stream(result_path, found[index].timestamp, "results"))
+                {
+                    errors.append(QJsonObject{{"name", result_name}, {"error", "invalid_result_header"}});
+                    continue;
+                }
+                SharedRead file(result_path);
+                Excerpt data = excerpt(file, 256 * 1024, 4096, true);
+                bool truncated = false;
+                const QByteArray clean = bound_json_lines(redact_json_ips(data.bytes), 256 * 1024, truncated);
+                data.info.insert("redacted", clean != data.bytes);
+                data.info.insert("captured_bytes", qint64(clean.size()));
+                data.info.insert("truncated", data.info.value("truncated").toBool() || truncated);
+                data.info.insert("name", result_name);
+                data.info.insert("last_capture_utc_us", now_us());
+                result_info.append(data.info);
+                entries.append({result_name, clean});
+            }
+            catch (...) { errors.append(QJsonObject{{"name", result_name}, {"error", "read_unavailable"}}); }
+        }
+        open_rpc(until);
+        if (rpc)
+        {
+            try
+            {
+                Excerpt data = excerpt(*rpc, rpc_limit, 64 * 1024, false);
+                bool clean_truncated = false;
+                const QByteArray clean = clean_rpc(data.bytes, request, clean_truncated);
+                data.info.insert("available", true);
+                data.info.insert("captured_bytes", qint64(clean.size()));
+                data.info.insert("truncated", data.info.value("truncated").toBool() || clean_truncated);
+                data.info.insert("redacted", clean != data.bytes);
+                data.info.insert("last_capture_utc_us", now_us());
+                last_rpc = clean; last_rpc_info = data.info;
+            }
+            catch (...) { errors.append(QJsonObject{{"name", "RPCS3.log"}, {"error", "read_unavailable"}}); }
+        }
+        if (last_rpc_info.isEmpty()) last_rpc_info = {{"available", false}, {"captured_bytes", 0},
+            {"last_capture_utc_us", QJsonValue::Null}, {"error", "not_available_for_this_launch"}};
+        entries.append({"RPCS3.log", last_rpc});
+        reserve_output();
+        if (committed)
+        {
+            if (owned_report(output).value("archive_id").toString() != archive_id)
+                throw Failure("Diagnostic output ownership changed");
+        }
+        else if (QFileInfo::exists(output)) throw Failure("Diagnostic output collision");
+        const qint64 captured = now_us();
+        if (!first_capture) first_capture = captured;
+        const QJsonObject report{
+            {"schema", 1}, {"collector", collector_id}, {"archive_name", QFileInfo(output).fileName()},
+            {"archive_id", archive_id}, {"pid", qint64(request.pid)}, {"created", QString::number(request.created)},
+            {"process_executable", QFileInfo(request.executable).fileName()}, {"started_utc_us", request.started_us},
+            {"first_capture_utc_us", first_capture}, {"last_capture_utc_us", captured}, {"updated_utc_us", captured},
+            {"captured_until_utc_us", until}, {"capture_sequence", sequence + 1}, {"state", state},
+            {"exit_code", QJsonValue::Null}, {"frames", frames}, {"sha256", hashes}, {"native_files", native_info},
+            {"result_files", result_info}, {"result_schema", 1},
+            {"omitted_native_files", qint64(found.size() - selected)}, {"rpc_log", last_rpc_info}, {"read_errors", errors},
+            {"archive_limit_bytes", archive_limit}, {"retained_archives", retained_archives},
+            {"compression", "deflate_if_smaller"}, {"raw_session_limit", retained_archives},
+            {"raw_log_limit_bytes", 2 * mib}, {"result_log_limit_bytes", 256 * 1024},
+            {"ip_redaction", "textual_ipv4_ipv6"},
+            {"capture_note", "Best-effort log snapshot; closing is not an observed process exit or a game result."}};
+        const QByteArray report_bytes = redact_json_ips(QJsonDocument(report).toJson(QJsonDocument::Indented));
+        if (report_bytes.size() > 64 * 1024) throw Failure("Diagnostic report size limit");
+        entries.prepend({"report.json", report_bytes});
+        atomic_write(output, stored_zip(entries));
+        committed = true; ++sequence;
+        prune_archives(QFileInfo(output).absolutePath());
+        prune_raw_sessions(native_root);
+        return output;
+    }
+};
+
+DiagnosticArchive::DiagnosticArchive(DiagnosticRequest request) : m_impl(std::make_unique<Impl>(std::move(request))) { }
+DiagnosticArchive::~DiagnosticArchive() = default;
+QString DiagnosticArchive::snapshot(const QString& state, qint64 until_us) { return m_impl->snapshot(state, until_us); }
+
+namespace
+{
+class Worker
+{
+    std::mutex m_mutex;
+    std::condition_variable m_wake;
+    bool m_stopping = false;
+    std::thread m_thread;
+public:
+    explicit Worker(DiagnosticRequest request)
+    {
+        m_thread = std::thread([this, request = std::move(request)]
+        {
+            try
+            {
+                DiagnosticArchive archive(request);
+                bool active = false;
+                for (;;)
+                {
+                    bool closing;
+                    { std::lock_guard lock(m_mutex); closing = m_stopping; }
+                    try { active = !archive.snapshot(closing ? "closing" : "running", now_us()).isEmpty() || active; }
+                    catch (...) { active = true; } // Retry I/O failures at the slower active cadence.
+                    if (closing) break;
+                    std::unique_lock lock(m_mutex);
+                    m_wake.wait_for(lock, active ? std::chrono::seconds(10) : std::chrono::seconds(1), [this] { return m_stopping; });
+                }
+            }
+            catch (...) { } // Diagnostics must never terminate the application.
+        });
+    }
+    ~Worker()
+    {
+        { std::lock_guard lock(m_mutex); m_stopping = true; }
+        m_wake.notify_all();
+        if (m_thread.joinable()) m_thread.join();
+    }
+};
+
+struct WorkerState { std::mutex mutex; std::unique_ptr<Worker> worker; };
+WorkerState& worker_state() { static WorkerState state; return state; }
+}
+
+void start_diagnostics(const QString& root, const QString& config_root, const QString& log_root) noexcept
+{
+    // Normal releases keep RPCS3's own logger only. Keep the archive code as
+    // development source, but never start a supplemental capture thread here.
+    Q_UNUSED(root); Q_UNUSED(config_root); Q_UNUSED(log_root);
+}
+
+void stop_diagnostics() noexcept
+{
+    try
+    {
+        auto& state = worker_state();
+        std::lock_guard lock(state.mutex);
+        state.worker.reset();
+    }
+    catch (...) { }
+}
+}
