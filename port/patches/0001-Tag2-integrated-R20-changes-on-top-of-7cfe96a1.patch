+void NativePanel::refresh_lobby(){
+ auto button=findChild<QPushButton*>("passTurn");auto label=findChild<QLabel*>("passStatus");if(!button||!label)return;
+ using ttt2_lobby::pass_status;
+ const auto state=hooks.lobby_view?hooks.lobby_view():ttt2_lobby::pass_view{};
+ const bool running=hooks.stopped&&!hooks.stopped();
+ if(state.revision!=shown_pass_view.revision||state.status!=shown_pass_view.status||!running)pass_queued=false;
+ shown_pass_view=state;
+ button->setEnabled(running&&!working&&!checking&&!closing&&!pass_queued&&state.can_pass&&bool(hooks.lobby_action));
+ button->setText(state.swap_sides?(state.status==pass_status::approval_needed?QString::fromUtf8("자리 교환 동의 (Ctrl+Shift+F8)"):QString::fromUtf8("자리 교환 요청 (Ctrl+F8)")):QString::fromUtf8("내 차례 넘기기 (Ctrl+F8)"));
+ if(auto cancel=findChild<QPushButton*>("passCancel")){
+  cancel->setVisible(state.can_cancel||state.status==pass_status::approval_wait||state.status==pass_status::approval_needed);
+  cancel->setEnabled(running&&!working&&!checking&&!closing&&!pass_queued&&state.can_cancel&&bool(hooks.lobby_action));
+  cancel->setText(state.status==pass_status::approval_wait?QString::fromUtf8("요청 취소"):QString::fromUtf8("거절"));
+ }
+ QString text=state.swap_sides?QString::fromUtf8("두 분 모두 READY 상태이거나 다음 판이 시작되면 자리를 바꿀 수 없습니다. 방 참가자 모두 최신 버전을 사용해 주세요."):QString::fromUtf8("플매 2명: 서로 동의한 뒤 자리 교환 · 3명 이상: 준비 전 내 차례 넘기기 · 모두 최신 버전 필요");
+ if(running){
+  using ttt2_lobby::pass_status;
+  switch(state.status){
+  case pass_status::available:text=pass_queued?QString::fromUtf8("요청 전달 중…"):(state.swap_sides?QString::fromUtf8("상대가 동의해야 1P·2P가 바뀝니다. 한 분만 READY 상태여도 요청할 수 있으며, 준비 상태와 승수는 유지됩니다."):QString::fromUtf8("내 차례를 넘길 수 있습니다. 방에는 그대로 남습니다."));break;
+  case pass_status::pending:text=QString::fromUtf8("방장에게 요청했습니다. 처리 확인 중…");break;
+  case pass_status::accepted:text=state.swap_sides?QString::fromUtf8("서로 동의하여 1P·2P 자리를 바꿨습니다. 준비 상태와 승수는 유지됩니다."):QString::fromUtf8("내 차례를 다음 분에게 넘겼습니다.");break;
+  case pass_status::approval_wait:text=QString::fromUtf8("상대의 동의를 기다리고 있습니다. 응답이 없으면 요청만 취소되고 자리는 유지됩니다.");break;
+  case pass_status::approval_needed:text=pass_queued?QString::fromUtf8("응답 전달 중…"):QString::fromUtf8("상대가 1P·2P 자리 교환을 요청했습니다. 동의해야 바뀌며, 응답하지 않거나 거절하면 자리는 유지됩니다.");break;
+  case pass_status::retry:text=QString::fromUtf8("처리를 확인하지 못했습니다. 방의 현재 자리와 준비 상태를 확인한 뒤 다시 눌러 주세요.");break;
+  case pass_status::failed:text=QString::fromUtf8("이번 실행에서는 차례 넘기기를 사용할 수 없습니다.");break;
+  case pass_status::unavailable:text=QString::fromUtf8("이 게임에서는 차례 넘기기를 사용할 수 없습니다.");break;
+  default:break;
+  }
+ }
+ label->setText(text);
+}
+void NativePanel::choose_pass(){
+ if(working||checking||closing||pass_queued||!hooks.stopped||hooks.stopped()||!hooks.lobby_action)return;
+ if(!pressed_pass_view.can_pass){refresh_lobby();return;}
+ const auto action=pressed_pass_view.status==ttt2_lobby::pass_status::approval_needed?ttt2_lobby::pass_action::confirm:ttt2_lobby::pass_action::request;
+ if(hooks.lobby_action(action,pressed_pass_view.revision)){
+  pass_queued=true;
+  QTimer::singleShot(1000,this,[this]{pass_queued=false;refresh_lobby();});
+ }
+ refresh_lobby();
+}
+void NativePanel::cancel_pass(){
+ if(working||checking||closing||pass_queued||!hooks.stopped||hooks.stopped()||!hooks.lobby_action)return;
+ if(!pressed_cancel_view.can_cancel){refresh_lobby();return;}
+ if(hooks.lobby_action(ttt2_lobby::pass_action::cancel,pressed_cancel_view.revision)){
+  pass_queued=true;
+  QTimer::singleShot(1000,this,[this]{pass_queued=false;refresh_lobby();});
+ }
+ refresh_lobby();
+}
+void NativePanel::refresh_frames(){
