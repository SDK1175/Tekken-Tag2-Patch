+#pragma once
+#include "TTT2LobbyProtocol.h"
+namespace ttt2_lobby {
+inline std::optional<snapshot> read_room_snapshot(std::span<const std::uint8_t> data){
+ if(data.size()<0x3b0)return {};
+ auto get=[&](unsigned at,unsigned count){std::uint32_t value=0;for(unsigned i=0;i<count;++i)value=(value<<8)|data[at+i];return value;};
+ snapshot out;out.phase=get(0x2bc,4);
+ for(unsigned i=0;i<6;++i){
+  const auto id=get(0x2a4+2*i,2);out.queue[i]=id==0xffff?-1:static_cast<std::int16_t>(id);
+  const auto member=0x14+i*0x6c;
+  if(data[member+4]){
+   if(get(member,4)!=i)return {};out.active|=1U<<i;if(data[member+0x14])out.ready|=1U<<i;
+   unsigned length=0;while(length<17&&data[member+0x1e+length])++length;
+   if(!length||length==17)return {};
+   for(unsigned j=0;j<length;++j)out.accounts[i][j]=static_cast<char>(data[member+0x1e+j]);
+  }
+ }
+ if(!valid_snapshot(out)||static_cast<std::int32_t>(get(0x29c,4))!=out.queue[0]||static_cast<std::int32_t>(get(0x2a0,4))!=out.queue[1])return {};
+ return out;
+}
+}
diff --git a/rpcs3/Emu/Cell/TTT2Native.cpp b/rpcs3/Emu/Cell/TTT2Native.cpp
new file mode 100644
index 000000000..60a6b0ac7
--- /dev/null
+++ b/rpcs3/Emu/Cell/TTT2Native.cpp
@@ -0,0 +1,169 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// TTT2 Native1: limited native integer helpers, NOT a new rollback engine.
+// Host-side redirection follows the same RPCS3 facility used by Ekspym's
+// rb_input::install_static_hooks. No T6 addresses, memory snapshots or audio
+// changes are imported. GPL RPCS3 services remain authoritative.
+#include "stdafx.h"
+#include "TTT2Native.h"
+#include "TTT2NativeKernels.h"
+#include "TTT2NativePolicy.h"
+#include "PPUModule.h"
+#include "PPUFunction.h"
+#include "PPUInterpreter.h"
+#include "Emu/IdManager.h"
+#include "Emu/System.h"
+#include "Emu/system_config.h"
+#include <atomic>
+#include <cstring>
+#include <utility>
+
+LOG_CHANNEL(ttt2_native_log, "TTT2Native");
+extern bool ppu_form_branch_to_code(u32 entry, u32 target);
+extern u32 ppu_get_far_jump(u32 pc);
+
+namespace ttt2_native {
+namespace {
+constexpr auto helper_count=kernels::functions.size();
+struct helper_stats {
+    std::atomic<u64> calls{0}, verified{0}, native{0}, reference{0}, mismatches{0};
+    std::atomic<bool> disabled{false};
+    bool installed=false;
+    u32 target=0; // Own host-side far-jump target, immutable after startup.
+};
+struct session {
+    mode selected=mode::off;
+    std::array<helper_stats,helper_count> stats{};
+    ~session() {
+        if (selected==mode::off) return;
+        u64 calls=0, checks=0, fast=0, slow=0, mismatches=0;
+        for (usz i=0;i<stats.size();i++) {
+            const auto& s=stats[i];
+            const auto c=s.calls.load(std::memory_order_relaxed);
+            if (!s.installed) continue;
+            calls+=c;checks+=s.verified.load();fast+=s.native.load();slow+=s.reference.load();mismatches+=s.mismatches.load();
+            ttt2_native_log.notice("Native1 helper 0x%08x: calls=%llu verified=%llu native=%llu original=%llu mismatches=%llu disabled=%u",
+                kernels::functions[i].address,c,s.verified.load(),s.native.load(),s.reference.load(),s.mismatches.load(),s.disabled.load()?1u:0u);
+        }
+        ttt2_native_log.notice("Native1 TOTAL calls=%llu verified=%llu native=%llu original=%llu mismatches=%llu. Counters are not input-latency or rollback proof.",calls,checks,fast,slow,mismatches);
+    }
+};
+
+bool code_matches(const kernels::descriptor& f) {
+    const u32 bytes=static_cast<u32>(f.count*4);
+    if (!vm::check_addr(f.address,vm::page_readable | vm::page_executable,bytes)) return false;
+    for (usz j=0;j<f.count;j++) if (vm::read32(f.address+static_cast<u32>(j*4))!=f.words[j]) return false;
+    return true;
+}
+bool hooks_match(const kernels::descriptor& f,u32 target) {
+    if (!target || ppu_get_far_jump(f.address)!=target) return false;
+    for (usz j=1;j<f.count;j++) if (ppu_get_far_jump(f.address+static_cast<u32>(j*4))) return false;
+    return true;
+}
+u32 pack_xer(const ppu_thread& ppu) {
+    return (ppu.xer.so?0x80000000u:0u)|(ppu.xer.ov?0x40000000u:0u)|
+        (ppu.xer.ca?0x20000000u:0u)|(ppu.xer.cnt&0x7fu);
+}
+// Same step terminator as PPUThread.cpp's ppu_ret. Uses the real RPCS3
+// instruction decoder; not a second handwritten interpreter in the emulator.
+ppu_intrp_func step_end={[](ppu_thread& ppu,ppu_opcode_t,be_t<u32>* next,ppu_intrp_func*) {
+    ppu.cia=vm::get_addr(next);
+}};
+
+void run_reference(ppu_thread& ppu,const kernels::descriptor& f) {
+    // The accepted graph is bounded and forward-only. The final BLR is handled
+    // by REG_HIDDEN_FUNC's normal return wrapper. No guest memory side effects,
+    // calls, syscalls, atomics, LR/CTR changes or FP/vector ops are accepted.
+    struct restore_pc { ppu_thread& p;u32 cia;~restore_pc(){p.cia=cia;} } guard{ppu,ppu.cia};
+    ppu.cia=f.address;
+    for (usz step=0;step<f.count;step++) {
+        const u32 pc=ppu.cia;
+        if (pc<f.address || (pc-f.address)%4 || (pc-f.address)/4>=f.count)
+            fmt::throw_exception("Native1 reference escaped verified function 0x%x at 0x%x",f.address,pc);
+        const u32 word=f.words[(pc-f.address)/4];
+        if (word==0x4e800020u) return;
+        g_fxo->get<ppu_interpreter_rt>().decode(word)(ppu,{word},vm::_ptr<u32>(pc),&step_end);
+    }
+    fmt::throw_exception("Native1 bounded reference did not return: 0x%x",f.address);
+}
+
+template<usz I> void dispatch(ppu_thread& ppu) {
+    auto& ss=g_fxo->get<session>();auto& s=ss.stats[I];const auto& f=kernels::functions[I];
+    if (ppu.state) ppu.check_state();
+    if (!code_matches(f) || !hooks_match(f,s.target)) {
+        s.disabled.store(true,std::memory_order_release);
+        ttt2_native_log.error("Native1 code/host hook changed after install at 0x%08x. Stopping rather than executing stale lifted code. Restart this test build with TTT2_NATIVE_MODE=off.",f.address);
+        fmt::throw_exception("Native1 signature changed at 0x%x",f.address);
+    }
+    const u64 calls=s.calls.fetch_add(1,std::memory_order_relaxed)+1;
+    const u64 verified=s.verified.load(std::memory_order_acquire);
+    const bool disabled=s.disabled.load(std::memory_order_acquire);
+    if (needs_check(ss.selected,verified,calls,disabled)) {
+        std::array<u64,32> expected{};std::copy_n(ppu.gpr,32,expected.data());
+        u32 expected_cr=ppu.cr.pack();const u32 original_xer=pack_xer(ppu);
+        const u64 original_lr=ppu.lr,original_ctr=ppu.ctr;
+        f.run(expected.data(),expected_cr,original_xer);
+        run_reference(ppu,f);s.reference.fetch_add(1,std::memory_order_relaxed);
+        const bool equal=std::equal(expected.begin(),expected.end(),ppu.gpr) && expected_cr==ppu.cr.pack()
+            && original_xer==pack_xer(ppu) && original_lr==ppu.lr && original_ctr==ppu.ctr;
+        if (equal) s.verified.fetch_add(1,std::memory_order_release);
+        else {
+            s.mismatches.fetch_add(1,std::memory_order_relaxed);s.disabled.store(true,std::memory_order_release);
+            ttt2_native_log.error("Native1 verification mismatch at 0x%08x, call=%llu. Original result retained; native disabled for this helper until restart.",f.address,calls);
+        }
+        return; // Verification always keeps the original interpreter's result.
+    }
+    if (native_allowed(ss.selected,verified,disabled)) {
+        u32 cr=ppu.cr.pack();f.run(ppu.gpr,cr,pack_xer(ppu));ppu.cr.unpack(cr);
+        s.native.fetch_add(1,std::memory_order_relaxed);
+    } else {
+        run_reference(ppu,f);s.reference.fetch_add(1,std::memory_order_relaxed);
+    }
+}
+
+template<usz I> u32 register_one() { return REG_HIDDEN_FUNC(dispatch<I>); }
+template<usz... I> auto make_indices(std::index_sequence<I...>) {
+    return std::array<u32,sizeof...(I)>{register_one<I>()...};
+}
+const auto indices=make_indices(std::make_index_sequence<helper_count>{});
+} // anonymous
+
+void install(std::vector<u32>& applied) {
+    const char* value=std::getenv("TTT2_NATIVE_MODE");
+    const mode selected=parse_mode(value?value:"");
+    if (selected==mode::off) return;
+    if (!accepts_game(Emu.GetTitleID(),Emu.GetExecutableHash())) {
+        ttt2_native_log.warning("Native1 not installed: unsupported title or executable hash.");return;
+    }
+    if (g_cfg.core.ppu_decoder != ppu_decoder_type::llvm) {
+        ttt2_native_log.warning("Native1 not installed: first prototype only admits the LLVM PPU decoder.");return;
+    }
+    if (g_cfg.core.hook_functions || g_cfg.core.ppu_debug) {
+        ttt2_native_log.warning("Native1 not installed: disable optional Static HLE hook_functions / ppu_debug for this controlled test.");return;
+    }
+    // Usually default-created by init_fxo_for_exec, but do not rely on raw
+    // manual_typemap::get() constructing the object on less common load paths.
+    g_fxo->need<session>();
+    auto& ss=g_fxo->get<session>();
+    if (ss.selected!=mode::off) { ttt2_native_log.warning("Native1 duplicate install refused.");return; }
+    ss.selected=selected;
+    // Do not let additions to 'applied' from our own install affect later tests.
+    const std::vector<u32> existing=applied;
+    u32 installed=0;
+    for (usz i=0;i<helper_count;i++) {
+        const auto& f=kernels::functions[i];
+        bool hooked=false;
+        // calloc/far jumps are host-side and need not change guest instruction
+        // bytes. Check every word, not only the function entry.
+        for (usz j=0;j<f.count;j++) if (ppu_get_far_jump(f.address+static_cast<u32>(j*4))) {hooked=true;break;}
+        if (hooked || overlap(f.address,static_cast<u32>(f.count*4),existing) || !code_matches(f)) {
+            ttt2_native_log.notice("Native1 skipped patched/different helper 0x%08x",f.address);continue;
+        }
+        const u32 target=g_fxo->get<ppu_function_manager>().func_addr(indices[i],true);
+        if (!target || !ppu_form_branch_to_code(f.address,target)) {
+            ttt2_native_log.warning("Native1 failed to install helper 0x%08x",f.address);continue;
+        }
+        applied.push_back(f.address);ss.stats[i].target=target;ss.stats[i].installed=true;installed++;
+    }
+    ttt2_native_log.notice("Native1 installed %u/%u integer-only helpers in %s mode. A4/RPCN/RSX/audio/SPU unchanged. Full-game acceleration NOT claimed.",installed,static_cast<u32>(helper_count),selected==mode::verify?"verify":"native");
+}
+} // namespace ttt2_native
diff --git a/rpcs3/Emu/Cell/TTT2Native.h b/rpcs3/Emu/Cell/TTT2Native.h
