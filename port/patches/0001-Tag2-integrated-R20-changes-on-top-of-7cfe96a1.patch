+}
+QJsonObject strict_json(const QByteArray& b) {
+ if(b.isEmpty()||b.size()>1024*1024)throw Failure("JSON size limit");JsonKeys(b).check();
+ QJsonParseError error;auto doc=QJsonDocument::fromJson(b,&error);
+ if(error.error!=QJsonParseError::NoError||!doc.isObject())throw Failure("Expected JSON object");return doc.object();
+}
+void atomic_write(const QString& path,const QByteArray& b) {
+ safe_absolute(path);QString parent=QFileInfo(path).absolutePath();
+ if(!QDir().mkpath(parent))throw Failure("Cannot create destination directory");safe_absolute(path);
+ QSaveFile f(path);f.setDirectWriteFallback(false);
+ if(!f.open(QIODevice::WriteOnly)||f.write(b)!=b.size()||!f.flush()||!f.commit())throw Failure("Cannot atomically write: "+path);
+}
+void unpack_zip(const QByteArray& data,const QString& stage,const QSet<QString>& allowed) {
