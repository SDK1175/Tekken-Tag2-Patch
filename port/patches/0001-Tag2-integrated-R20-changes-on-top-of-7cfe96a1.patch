+
+    runtime()
+    {
+        const auto directory = fs::get_config_dir() + "green_rollback/";
+        fs::create_path(directory);
+        const std::string options_path = directory + "rollback_frames.txt";
+        if (fs::exists(options_path))
+        {
+            fs::file options(options_path, fs::read);
+            if (!options || options.size() > 32)
+                throw green_ggpo::failure("Cannot read green_rollback/rollback_frames.txt (maximum32 bytes)");
