-			m_last_pump_us = get_system_time();
-		}, nullptr, false);
+        // At most one R4 pump request is outstanding. SDL still runs on its
+        // original main-thread callback, NEVER in a PPU or HID polling thread.
+        if(r4_fast && m_input_r4_pump_pending.exchange(true,std::memory_order_acq_rel))return;
+        Emu.CallFromMainThread([this,r4_fast]()
+        {
+            ttt2::input_r4::scope_exit complete([this,r4_fast]()
+            {
+                if(r4_fast)m_input_r4_pump_pending.store(false,std::memory_order_release);
+            });
+            if(!m_initialized)return;
+            SDL_PumpEvents();
+            m_last_pump_us=get_system_time();
+            if(r4_fast)pad::latency4_keyboard_event(); // same worker wake, no key injection
+        },nullptr,false);
 	}
 }
 
