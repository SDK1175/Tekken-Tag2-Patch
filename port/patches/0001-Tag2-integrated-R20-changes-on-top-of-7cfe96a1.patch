+  if(finish>cd||data.mid(offset+30,localName)!=raw)throw Failure("ZIP local name or bounds mismatch");
+  if(!(flags&8)&&(u32(data,offset+14)!=crc||u32(data,offset+18)!=compressed||u32(data,offset+22)!=size))throw Failure("ZIP local identity mismatch");
+  for(const auto& range:ranges)if(quint64(offset)<range.second&&finish>range.first)throw Failure("Overlapping ZIP records");ranges.append({offset,finish});
+  entries.append({name,method,flags,crc,compressed,size,static_cast<quint32>(start),directory});p+=46+nameLength+extra+comment;
+ }
+ if(p!=end)throw Failure("ZIP directory length mismatch");
