+namespace ttt2_framedata_host
+{
+namespace
+{
+void invalid_option() noexcept
+{
+    try { sys_log.warning("GGPO frame table disabled: green_rollback/framedata_enabled.txt must contain ASCII 0 or 1 (maximum 32 bytes)"); }
+    catch (...) {} // A diagnostic failure must not change the safe disabled choice.
+}
+
+bool read_enabled() noexcept
+{
+    try
+    {
+        const auto path = fs::get_config_dir() + "green_rollback/framedata_enabled.txt";
+        if (!fs::exists(path)) return false;
+        fs::file option(path, fs::read);
+        if (!option || option.size() > 32) { invalid_option(); return false; }
+        // Bound the read as well as the initial size check, even if the file grows.
+        std::array<char, 33> bytes{};
+        const auto size = option.read(bytes.data(), bytes.size());
+        if (size > 32) { invalid_option(); return false; }
+        std::string_view value(bytes.data(), static_cast<std::size_t>(size));
+        const auto whitespace = [](char c) { return c == ' ' || c == '\t' || c == '\r' || c == '\n'; };
+        while (!value.empty() && whitespace(value.front())) value.remove_prefix(1);
+        while (!value.empty() && whitespace(value.back())) value.remove_suffix(1);
+        if (value == "1") return true;
+        if (value == "0") return false;
+        invalid_option();
+    }
+    catch (...) { invalid_option(); }
+    return false;
+}
+}
+
+void start()
+{
+    // This flag belongs to the separate GGPO executable. U1 payload presence
+    // never opts in; neither shared configuration nor the Delay executable changes.
+    ttt2_framedata::stop();
+    static const bool enabled = read_enabled();
+    if (enabled) ttt2_framedata::start();
+}
+
+void stop() { ttt2_framedata::stop(); }
+}
