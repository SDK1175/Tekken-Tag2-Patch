diff --git a/rpcs3/Emu/Cell/TTT2LobbyInbox.h b/rpcs3/Emu/Cell/TTT2LobbyInbox.h
new file mode 100644
index 000000000..b37ac0ea0
--- /dev/null
+++ b/rpcs3/Emu/Cell/TTT2LobbyInbox.h
@@ -0,0 +1,17 @@
+#pragma once
+#include "TTT2LobbyProtocol.h"
+#include <vector>
+
+namespace ttt2_lobby {
+// Accessed under runtime::mutex. Each capture owns its guest receive buffer.
+class message_inbox {
+    std::vector<message> messages;
+public:
+    void push(const message& packet) {
+        if(messages.size()==64)messages.erase(messages.begin());
+        messages.push_back(packet);
+    }
+    std::vector<message> take() { std::vector<message> result;result.swap(messages);return result; }
+    void clear() { messages.clear(); }
+};
+}
diff --git a/rpcs3/Emu/Cell/TTT2LobbyMessage.h b/rpcs3/Emu/Cell/TTT2LobbyMessage.h
new file mode 100644
index 000000000..24bb46280
--- /dev/null
+++ b/rpcs3/Emu/Cell/TTT2LobbyMessage.h
@@ -0,0 +1,22 @@
+#pragma once
+#include "TTT2LobbyProtocol.h"
+#include <algorithm>
+#include <cstddef>
+
+namespace ttt2_lobby {
+struct guest_object {
+ std::array<std::uint8_t,4> vtable{};
+ wire payload{};
+ std::array<std::uint8_t,4> valid{};
+};
+static_assert(sizeof(guest_object)==0x48&&offsetof(guest_object,payload)==4&&offsetof(guest_object,valid)==0x44);
+inline bool read_message(guest_object& object,std::span<const std::uint8_t> bytes){
+ object.valid={};
+ if(!decode(bytes))return false;
+ std::copy_n(bytes.begin(),object.payload.size(),object.payload.begin());object.valid[3]=1;return true;
+}
+inline std::size_t write_message(const guest_object& object,std::span<std::uint8_t> bytes){
+ if(bytes.size()<object.payload.size()||!decode(object.payload))return 0;
+ std::copy(object.payload.begin(),object.payload.end(),bytes.begin());return object.payload.size();
+}
+}
