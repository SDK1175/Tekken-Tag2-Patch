+        const u64 stamp = diagnostic_time_us();
+        try
+        {
+            log_lifetime = std::make_shared<diagnostic_lifetime>(directory + fmt::format("session-%llu.active", stamp));
+            results = std::make_shared<result_journal>(directory + fmt::format("results-%llu.jsonl", stamp), stamp, log_lifetime);
+        }
+        catch (...) { green_rb_log.error("Rollback result journal unavailable; game result handling is unchanged"); }
+        log_path = directory + fmt::format("ggpo-%llu.jsonl", stamp);
+        log_sink = std::make_unique<bounded_file_sink>(log_path, stamp, "ggpo", 2 * 1024 * 1024, !!log_lifetime);
+        log_writer = std::make_unique<async_log_writer>([this](const std::string& line)
+        {
+            if (log_sink->write(line)) return true;
+            green_rb_log.error("GGPO diagnostic sink failed: %s", log_path);
+            return false;
+        }, [this] { return log_sink->flush(); });
+        if (results) active_result_journal.store(results);
+        record("session_start");
+        green_rb_log.notice("GGPO 8F-P1; Sync 2fc5dbb5; native RPCN transport; %dF prediction; GGPO queue delay0 (native latency measured separately). Log: %s", rollback_limit, log_path);
+    }
+    ~runtime()
+    {
+        if (results)
+        {
+            auto expected = results;
+            active_result_journal.compare_exchange_strong(expected, {});
+            results->note("result_session_end");
+            results->writer.close();
+        }
+        if (!log_writer) return;
+        log_writer->close(); // Join before the file or any captured state is destroyed.
+        const auto counts = log_writer->stats();
+        if (counts.dropped || counts.failures)
+            green_rb_log.error("GGPO diagnostic loss: dropped=%llu sink_failures=%llu; %s",
+                counts.dropped, counts.failures, log_path);
+    }
+
+    void observe_result(const char* event = nullptr) noexcept
+    {
+        if (!results) return;
+        const auto snapshot = read_result_snapshot([](u32 address, std::span<std::byte> out)
+        { return read_memory(nullptr, address, out); });
+        const auto local_side = result_side_valid ? std::optional<std::uint32_t>{result_side} : std::nullopt;
+        const auto observation = result_observer.sample(snapshot, local_side, result_side_valid ? result_connection : 0);
+        results->observe(observation, epoch, mapped(world_address, 4) ? word(world_address) : last_world,
+            result_connection, result_side_valid ? static_cast<int>(result_side) : -1, event);
+    }
