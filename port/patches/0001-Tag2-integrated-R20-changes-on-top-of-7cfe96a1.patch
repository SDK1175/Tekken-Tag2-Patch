diff --git a/rpcs3/Emu/Cell/TTT2LobbyClient.h b/rpcs3/Emu/Cell/TTT2LobbyClient.h
new file mode 100644
index 000000000..1b82fa4e9
--- /dev/null
+++ b/rpcs3/Emu/Cell/TTT2LobbyClient.h
@@ -0,0 +1,25 @@
+#pragma once
+#include "TTT2LobbyProtocol.h"
+
+namespace ttt2_lobby {
+struct pending_request { std::uint64_t nonce=0,epoch=0,sequence=0;std::uint32_t actor=0xffffffff;message_kind kind=message_kind::request; };
+struct receive_effect { bool acknowledged=false,advertisement_changed=false,proposal_registered=false,cancelled=false; };
+inline receive_effect receive_host(std::optional<message>& advertised,const message& packet,std::uint32_t host,const pending_request& pending)
+{
+    receive_effect effect;
+    if(packet.sender!=host||(packet.kind!=message_kind::state&&packet.kind!=message_kind::accepted))return effect;
+    const bool pending_generation=pending.sequence&&pending.actor<6&&packet.nonce==pending.nonce&&
+        pending.epoch!=std::numeric_limits<std::uint64_t>::max()&&packet.epoch==pending.epoch+1;
+    effect.acknowledged=packet.kind==message_kind::accepted&&pending.kind!=message_kind::cancel&&pending_generation&&
+        packet.sequence==pending.sequence&&packet.actor==pending.actor;
+    effect.proposal_registered=packet.kind==message_kind::state&&pending.kind==message_kind::request&&pending_generation&&
+        active_offer(packet)&&packet.offer==pending.actor+1;
+    effect.cancelled=packet.kind==message_kind::state&&pending.kind==message_kind::cancel&&pending_generation&&!packet.offer;
+    // A later queue publication may overtake its acknowledgement. Completion
+    // and advertisement freshness are separate decisions.
+    if(!advertised||packet.nonce!=advertised->nonce||packet.epoch>=advertised->epoch){
+        advertised=packet;effect.advertisement_changed=true;
+    }
+    return effect;
+}
+}
