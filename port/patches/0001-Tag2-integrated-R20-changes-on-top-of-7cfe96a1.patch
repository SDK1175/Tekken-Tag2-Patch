diff --git a/rpcs3/rpcs3qt/green_netcode_dialog.h b/rpcs3/rpcs3qt/green_netcode_dialog.h
new file mode 100644
index 000000000..15ce92f92
--- /dev/null
+++ b/rpcs3/rpcs3qt/green_netcode_dialog.h
@@ -0,0 +1,58 @@
+#pragma once
+
+#include "Emu/Cell/GreenRollback.h"
+
+#include <QDialog>
+#include <QDialogButtonBox>
+#include <QLabel>
+#include <QPushButton>
+#include <QRadioButton>
+#include <QVBoxLayout>
+
+#include <optional>
+#include <string_view>
+
+namespace green_online
+{
+inline bool supports_netcode_selection(std::string_view boot_path, std::string_view boot_title,
+	std::string_view listed_path, std::string_view listed_title, std::string_view app_version)
+{
+	return boot_title == "BLES01702" && listed_title == boot_title && !boot_path.empty() &&
+		boot_path == listed_path && (app_version == "01.03" || app_version == "1.03");
+}
+
+inline std::optional<green_rollback::netcode_mode> select_netcode_mode(QWidget* parent)
+{
+	QDialog dialog(parent);
+	dialog.setWindowTitle(QString::fromUtf8("GREEN ONLINE — Netcode Selection"));
+	auto* layout = new QVBoxLayout(&dialog);
+	auto* description = new QLabel(QString::fromUtf8("양쪽 모두 같은 버전과 모드를 선택해.\nGGPO Rollback은 실험판이야."), &dialog);
+	description->setWordWrap(true);
+	layout->addWidget(description);
+
+	auto* delay = new QRadioButton(QStringLiteral("Delay Netcode (Stable)"), &dialog);
+	delay->setObjectName(QStringLiteral("green_delay"));
+	auto* rollback = new QRadioButton(QStringLiteral("GGPO Rollback (BETA)"), &dialog);
+	rollback->setObjectName(QStringLiteral("green_rollback"));
+	delay->setChecked(true);
+	layout->addWidget(delay);
+	layout->addWidget(rollback);
+
+	auto* buttons = new QDialogButtonBox(&dialog);
+	auto* launch = buttons->addButton(QStringLiteral("Launch Game"), QDialogButtonBox::AcceptRole);
+	launch->setObjectName(QStringLiteral("green_launch"));
+	launch->setDefault(true);
+	auto* cancel = buttons->addButton(QStringLiteral("Cancel"), QDialogButtonBox::RejectRole);
+	cancel->setObjectName(QStringLiteral("green_cancel"));
+	layout->addWidget(buttons);
+	QObject::connect(buttons, &QDialogButtonBox::accepted, &dialog, &QDialog::accept);
+	QObject::connect(buttons, &QDialogButtonBox::rejected, &dialog, &QDialog::reject);
+
+	if (dialog.exec() != QDialog::Accepted)
+	{
+		return std::nullopt;
+	}
+
+	return rollback->isChecked() ? green_rollback::netcode_mode::rollback : green_rollback::netcode_mode::delay;
+}
+}
