+                x.target(x.add(singleton,0x10),0x10c);x.target(0x016b7450,0x60);
+                x.target(0x0162840c,0x1b8);x.target(x.add(singleton,0x3d264),0x80);
+                x.finish();
+            }
+        }
+    }
+    catch(...){x.out.code=status::limit_exceeded;}
+    return std::move(x.out);
+}
+
+inline bool same_identity(const layout& saved,const layout& current) noexcept
+{
+    return saved.manager==current.manager&&saved.slot==current.slot&&saved.frame==current.frame&&
+        saved.coverage==current.coverage&&saved.identities==current.identities&&
+        saved.saved_sources==current.saved_sources&&saved.live_targets==current.live_targets&&saved.owners==current.owners;
+}
