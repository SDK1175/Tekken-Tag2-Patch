+#pragma once
+#include "green_rollback_native.h"
+#include <cstring>
+#include <optional>
+#include <type_traits>
+
+namespace green_ggpo
+{
+// Owned serializer buffers, not references to a game ring that can be reused.
+// This retains the native adapter's explicitly partial state-closure coverage.
+class native_state
+{
+    using memory = green_rollback::native::memory;
+    using layout = green_rollback::native::layout;
+    using identity = green_rollback::native::identity;
+    using range = green_rollback::native::range;
+    struct block { std::uint32_t address{}; std::vector<std::byte> bytes; };
+    struct owner { std::uint32_t address{}; std::array<std::byte, 336> bytes{}; };
+    std::uint64_t epoch{};
+    std::uint32_t manager{}, slot{}, saved_frame{};
+    std::vector<identity> identities;
+    std::vector<range> targets;
+    std::vector<block> sources;
+    std::vector<owner> owners;
+
+    template <class T> static void append(std::vector<std::byte>& out, const T& value)
+    {
+        static_assert(std::is_trivially_copyable_v<T>);
+        const auto bytes = std::as_bytes(std::span(&value, 1));
+        out.insert(out.end(), bytes.begin(), bytes.end());
+    }
+    static std::uint64_t hash(std::span<const std::byte> data)
+    {
+        std::uint64_t value = 14695981039346656037ull;
+        for (auto b : data) value = (value ^ std::to_integer<unsigned>(b)) * 1099511628211ull;
+        return value;
+    }
+    // 354544 restores all four primary actors with A66588 before 35437C
+    // reads primary[0/1]+1E70 to choose the extra actors. This word is copied
+    // from record+1E70 (A67ACC/A67B0C), not an allocation identity.
+    // Likewise each primary+118 is copied at A66800/A66828 before 354878
+    // restores its 70-byte entry. inspect_layout binds the historical entry's
+    // concrete live table base/count. Other pointer routes stay conservative.
+    using routes = std::array<identity, 6>;
+    bool saved_routes(routes& out) const
+    {
+        for (std::uint32_t i = 0; i < out.size(); ++i)
+        {
+            const auto index = i < 2 ? i : i - 2;
+            const auto offset = i < 2 ? 0x1e70u : 0x118u;
+            const auto actor = std::find_if(identities.begin(), identities.end(), [=](const identity& id)
+                { return id.address == 0x0163ad98 + 4 * index && id.size == 4; });
+            if (actor == identities.end() || actor->value > UINT32_MAX - offset) return false;
+            const auto route = std::find_if(identities.begin(), identities.end(), [&](const identity& id)
+                { return id.address == actor->value + offset && id.size == 4; });
+            if (route == identities.end()) return false;
+            const std::uint64_t at = std::uint64_t(slot) + index * 0x5c80 + offset;
+            const auto source = std::find_if(sources.begin(), sources.end(), [&](const block& b)
+                { return at >= b.address && at + 4 <= std::uint64_t(b.address) + b.bytes.size(); });
+            if (source == sources.end()) return false;
+            std::uint32_t value = 0;
+            for (unsigned j = 0; j < 4; ++j)
+                value = (value << 8) | std::to_integer<unsigned>(source->bytes[static_cast<std::size_t>(at - source->address) + j]);
+            if (value != route->value) return false; // Capture and native serializer must agree.
+            out[i] = *route;
+        }
+        return true;
+    }
+    struct overlay { const native_state* image; memory live; const routes& restored_routes; };
+    static bool overlay_read(void* p, std::uint32_t at, std::span<std::byte> out) noexcept
+    {
+        const auto& m = *static_cast<overlay*>(p);
+        for (const auto& r : m.restored_routes)
+            if (at == r.address && out.size() == 4)
+            {
+                for (unsigned i = 0; i < 4; ++i) out[i] = std::byte(r.value >> (24 - 8 * i));
+                return true;
+            }
+        for (const auto& b : m.image->sources)
+            if (at >= b.address && std::uint64_t(at) + out.size() <= std::uint64_t(b.address) + b.bytes.size())
+            { std::memcpy(out.data(), b.bytes.data() + (at - b.address), out.size()); return true; }
+        return m.live.read(m.live.context, at, out);
+    }
+    static bool overlay_valid(void* p, std::uint32_t at, std::uint32_t size, bool write) noexcept
+    {
+        const auto& m = *static_cast<overlay*>(p);
+        return m.live.valid(m.live.context, at, size, write);
+    }
+public:
+    enum class validation_code
+    {
+        ok, source_unwritable, identity_unreadable, identity_changed,
+        historical_route_invalid, layout_invalid, frame_changed, identity_layout_changed,
+        target_layout_changed, source_layout_changed, owner_unreadable,
+        owner_prefix_changed, owner_trailer_changed
+    };
+    struct validation_failure
+    {
+        validation_code code{validation_code::ok};
+        std::uint32_t address{}, expected{}, actual{}, route_changes{};
+    };
+    static const char* reason_name(validation_code code)
+    {
+        switch (code)
+        {
+        case validation_code::ok: return "ok";
+        case validation_code::source_unwritable: return "source_unwritable";
+        case validation_code::identity_unreadable: return "identity_unreadable";
+        case validation_code::identity_changed: return "identity_changed";
+        case validation_code::historical_route_invalid: return "historical_route_invalid";
+        case validation_code::layout_invalid: return "layout_invalid";
+        case validation_code::frame_changed: return "frame_changed";
+        case validation_code::identity_layout_changed: return "identity_layout_changed";
+        case validation_code::target_layout_changed: return "target_layout_changed";
+        case validation_code::source_layout_changed: return "source_layout_changed";
+        case validation_code::owner_unreadable: return "owner_unreadable";
+        case validation_code::owner_prefix_changed: return "owner_prefix_changed";
+        case validation_code::owner_trailer_changed: return "owner_trailer_changed";
+        }
+        return "unknown";
+    }
+    std::uint32_t frame() const { return saved_frame; }
+    std::uint32_t slot_address() const { return slot; }
+    std::uint32_t manager_address() const { return manager; }
+
+    static std::optional<native_state> capture(memory m, std::uint32_t manager, std::uint32_t slot, std::uint64_t epoch)
+    {
+        auto inspected = green_rollback::native::inspect_layout(m, manager, slot, 3);
+        if (inspected.code != green_rollback::native::status::ok || !epoch) return {};
+        native_state s;
+        s.epoch = epoch; s.manager = manager; s.slot = slot; s.saved_frame = inspected.value.frame;
+        s.identities = std::move(inspected.value.identities); s.targets = std::move(inspected.value.live_targets);
+        s.sources.reserve(inspected.value.saved_sources.size());
+        s.owners.reserve(inspected.value.owners.size());
+        std::size_t bytes = 0;
+        for (const auto& r : inspected.value.saved_sources)
+        {
+            if (r.size > 8 * 1024 * 1024 - bytes) return {};
+            bytes += r.size;
+            block b{r.address, std::vector<std::byte>(r.size)};
+            if (!m.read(m.context, r.address, b.bytes)) return {};
+            s.sources.push_back(std::move(b));
+        }
+        for (const auto& o : inspected.value.owners)
+        {
+            owner saved; saved.address = o.address;
+            if (!m.read(m.context, saved.address + 0x3270, saved.bytes)) return {};
+            s.owners.push_back(saved);
+        }
+        return s;
+    }
+
+    std::vector<std::byte> encode() const
+    {
+        std::vector<std::byte> out;
+        encode_append(out);
+        return out;
+    }
+
+    std::size_t encoded_size() const
+    {
+        std::size_t size = 48 + identities.size() * 9 + targets.size() * 8 + owners.size() * 340;
+        for (const auto& b : sources) size += 8 + b.bytes.size();
+        return size;
+    }
+
+    // Append directly after the host header. The native hash covers only the
+    // native payload, exactly as encode() did before; never include the prefix.
+    void encode_append(std::vector<std::byte>& out) const
+    {
+        const auto begin = out.size();
+        out.reserve(begin + encoded_size());
+        append(out, std::uint32_t{0x47535031}); append(out, epoch);
+        append(out, manager); append(out, slot); append(out, saved_frame);
+        append(out, static_cast<std::uint32_t>(identities.size()));
+        append(out, static_cast<std::uint32_t>(targets.size()));
+        append(out, static_cast<std::uint32_t>(sources.size()));
+        append(out, static_cast<std::uint32_t>(owners.size()));
+        for (const auto& v : identities) { append(out, v.address); append(out, v.value); append(out, v.size); }
+        for (const auto& v : targets) { append(out, v.address); append(out, v.size); }
+        for (const auto& b : sources)
+        {
+            append(out, b.address); append(out, static_cast<std::uint32_t>(b.bytes.size()));
+            out.insert(out.end(), b.bytes.begin(), b.bytes.end());
+        }
+        for (const auto& o : owners) { append(out, o.address); append(out, o.bytes); }
+        append(out, hash(std::span<const std::byte>(out).subspan(begin)));
+    }
+
+    static std::optional<native_state> decode(std::span<const std::byte> data, std::uint64_t epoch)
+    {
+        if (data.size() < 48 || data.size() > 8 * 1024 * 1024) return {};
+        std::uint64_t expected{};
+        std::memcpy(&expected, data.data() + data.size() - 8, 8);
+        if (hash(data.first(data.size() - 8)) != expected) return {};
+        data = data.first(data.size() - 8);
+        bool ok = true;
+        const auto take = [&]<class T>(T& value)
+        {
+            if (data.size() < sizeof(T)) { ok = false; return; }
+            std::memcpy(&value, data.data(), sizeof(T)); data = data.subspan(sizeof(T));
+        };
+        native_state s;
+        std::uint32_t magic{}, ni{}, nt{}, ns{}, no{};
+        take(magic); take(s.epoch); take(s.manager); take(s.slot); take(s.saved_frame);
+        take(ni); take(nt); take(ns); take(no);
+        if (!ok || magic != 0x47535031 || s.epoch != epoch || ni > 4096 || nt > 512 || !ns || ns > 512 || no > 6) return {};
+        s.identities.resize(ni); s.targets.resize(nt); s.sources.resize(ns); s.owners.resize(no);
+        for (auto& v : s.identities) { take(v.address); take(v.value); take(v.size); if (v.size != 1 && v.size != 4) return {}; }
+        for (auto& v : s.targets) { take(v.address); take(v.size); }
+        for (auto& b : s.sources)
+        {
+            std::uint32_t size{}; take(b.address); take(size);
+            if (!ok || !size || size > data.size()) return {};
+            b.bytes.assign(data.begin(), data.begin() + size); data = data.subspan(size);
+        }
+        for (auto& o : s.owners) { take(o.address); take(o.bytes); }
+        if (!ok || !data.empty()) return {};
+        return s;
+    }
+
+    bool validate(memory m, validation_failure* failure = nullptr) const
+    {
+        validation_failure result{};
+        const auto fail = [&](validation_code code, std::uint32_t at = 0, std::uint32_t expected = 0, std::uint32_t actual = 0)
+        {
+            result.code = code; result.address = at; result.expected = expected; result.actual = actual;
+            if (failure) *failure = result;
+            return false;
+        };
+        for (const auto& b : sources)
+            if (!m.valid(m.context, b.address, static_cast<std::uint32_t>(b.bytes.size()), true))
+                return fail(validation_code::source_unwritable, b.address, static_cast<std::uint32_t>(b.bytes.size()));
+        routes restored_routes{};
+        if (!saved_routes(restored_routes)) return fail(validation_code::historical_route_invalid, slot);
+        // Backing table/owner identities still compare against LIVE memory.
+        // Only audited native-restored selectors use the historical view.
+        for (const auto& id : identities)
+        {
+            std::array<std::byte, 4> bytes{};
+            if (!m.read(m.context, id.address, std::span(bytes).first(id.size)))
+                return fail(validation_code::identity_unreadable, id.address, id.value);
+            std::uint32_t value = 0;
+            for (unsigned i = 0; i < id.size; ++i) value = (value << 8) | std::to_integer<unsigned>(bytes[i]);
+            if (value == id.value) continue;
+            if (std::find(restored_routes.begin(), restored_routes.end(), id) == restored_routes.end())
+                return fail(validation_code::identity_changed, id.address, id.value, value);
+            ++result.route_changes;
+        }
+        overlay view{this, m, restored_routes};
+        const auto inspected = green_rollback::native::inspect_layout({&view, overlay_read, overlay_valid}, manager, slot, 3);
+        if (inspected.code != green_rollback::native::status::ok)
+            return fail(validation_code::layout_invalid, inspected.address, 0, static_cast<std::uint32_t>(inspected.code));
+        if (inspected.value.frame != saved_frame)
+            return fail(validation_code::frame_changed, slot + 0x22b10, saved_frame, inspected.value.frame);
+        if (inspected.value.identities != identities) return fail(validation_code::identity_layout_changed);
+        if (inspected.value.live_targets != targets) return fail(validation_code::target_layout_changed);
+        if (inspected.value.saved_sources.size() != sources.size()) return fail(validation_code::source_layout_changed);
+        for (std::size_t i = 0; i < sources.size(); ++i)
+            if (inspected.value.saved_sources[i].address != sources[i].address ||
+                inspected.value.saved_sources[i].size != sources[i].bytes.size())
+                return fail(validation_code::source_layout_changed, sources[i].address,
+                    static_cast<std::uint32_t>(sources[i].bytes.size()), inspected.value.saved_sources[i].size);
+        for (const auto& o : owners)
+        {
+            std::array<std::byte, 336> live{};
+            if (!m.read(m.context, o.address + 0x3270, live)) return fail(validation_code::owner_unreadable, o.address + 0x3270);
+            for (unsigned i = 0; i < live.size(); ++i)
+                if ((i < 48 || i >= 328) && live[i] != o.bytes[i])
+                    return fail(i < 48 ? validation_code::owner_prefix_changed : validation_code::owner_trailer_changed,
+                        o.address + 0x3270 + i, std::to_integer<unsigned>(o.bytes[i]), std::to_integer<unsigned>(live[i]));
+        }
+        if (failure) *failure = result;
+        return true;
+    }
+    template <class F> bool write_buffers(F&& write) const
+    {
+        for (const auto& b : sources) if (!write(b.address, std::span<const std::byte>(b.bytes))) return false;
+        return true;
+    }
+    template <class F> bool write_owner_numeric(F&& write) const
+    {
+        for (const auto& o : owners) if (!write(o.address + 0x32a0, std::span(o.bytes).subspan(48, 280))) return false;
+        return true;
+    }
+};
+}
diff --git a/rpcs3/Emu/Cell/green_ggpo_options.h b/rpcs3/Emu/Cell/green_ggpo_options.h
new file mode 100644
index 000000000..ddce8aafd
--- /dev/null
+++ b/rpcs3/Emu/Cell/green_ggpo_options.h
@@ -0,0 +1,82 @@
+#pragma once
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <string_view>
+
+namespace green_ggpo
+{
+inline constexpr int default_prediction_limit = 3;
+
+inline std::optional<int> parse_prediction_limit(std::string_view text)
+{
+    const auto space = [](char c) { return c == ' ' || c == '\t' || c == '\r' || c == '\n'; };
+    while (!text.empty() && space(text.front())) text.remove_prefix(1);
+    while (!text.empty() && space(text.back())) text.remove_suffix(1);
+    if (text.size() != 1 || (text[0] != '3' && text[0] != '5' && text[0] != '8')) return {};
+    return text[0] - '0';
+}
+
+inline std::uint64_t monotonic_us()
+{
+    return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+// Registration-to-forward-consumption age. Owner updates are not game frames;
+// timestamps exclude controller polling before the native registration call.
+// Neither source lead nor this measurement alone establishes network-added0F.
+class input_timing
+{
+    struct sample { std::uint64_t update, us; };
+    std::map<std::uint32_t, sample> samples;
+public:
+    std::int64_t last_age_updates = -1, last_age_us = -1;
+    std::uint64_t measured = 0, max_age_updates = 0, max_age_us = 0;
+    void clear()
+    {
+        samples.clear(); last_age_updates = last_age_us = -1;
+        measured = max_age_updates = max_age_us = 0;
+    }
+    std::size_t retained() const { return samples.size(); }
+    void registered(std::uint32_t id, std::uint64_t update, std::uint64_t us)
+    {
+        samples.emplace(id, sample{update, us});
+        while (samples.size() > 128) samples.erase(samples.begin());
+    }
+    void consumed(std::uint32_t id, std::uint64_t update, std::uint64_t us)
+    {
+        last_age_updates = last_age_us = -1;
+        const auto found = samples.find(id);
+        if (found == samples.end() || update < found->second.update || us < found->second.us) return;
+        last_age_updates = static_cast<std::int64_t>(update - found->second.update);
+        last_age_us = static_cast<std::int64_t>(us - found->second.us);
+        ++measured;
+        max_age_updates = std::max(max_age_updates, update - found->second.update);
+        max_age_us = std::max(max_age_us, us - found->second.us);
+    }
+};
+
+struct runtime_metrics
+{
+    std::uint64_t last_save_us{}, max_save_us{}, last_load_us{}, max_load_us{};
+    std::uint64_t last_replay_us{}, max_replay_us{}, snapshot_bytes{}, max_snapshot_bytes{};
+    std::uint32_t last_restore_depth{}, max_restore_depth{};
+    void saved(std::uint64_t begin, std::size_t bytes)
+    {
+        last_save_us = monotonic_us() - begin; max_save_us = std::max(max_save_us, last_save_us);
+        snapshot_bytes = bytes; max_snapshot_bytes = std::max(max_snapshot_bytes, snapshot_bytes);
+    }
+    void loaded(std::uint64_t begin, std::uint32_t depth)
+    {
+        last_load_us = monotonic_us() - begin; max_load_us = std::max(max_load_us, last_load_us);
+        last_restore_depth = depth; max_restore_depth = std::max(max_restore_depth, depth);
+    }
+    void replayed(std::uint64_t begin)
+    {
+        last_replay_us = monotonic_us() - begin; max_replay_us = std::max(max_replay_us, last_replay_us);
+    }
+};
+}
