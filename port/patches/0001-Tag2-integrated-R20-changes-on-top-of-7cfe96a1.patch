diff --git a/rpcs3/Emu/Cell/GreenGGPO.cpp b/rpcs3/Emu/Cell/GreenGGPO.cpp
new file mode 100644
index 000000000..a4bade926
--- /dev/null
+++ b/rpcs3/Emu/Cell/GreenGGPO.cpp
@@ -0,0 +1,217 @@
+// Compiled without RPCS3's PCH: the upstream GGPO types stay inside this TU.
+#include "green_ggpo.h"
+#include <algorithm>
+#include <cstring>
+#include <limits>
+#include <map>
+#include <stdexcept>
+#include <string>
+
+#if defined(_WIN32) && !defined(_WINDOWS)
+#define _WINDOWS
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include "../../../3rdparty/ggpo_sync/src/lib/ggpo/types.h"
+
+// Upstream's desktop assertion displays a dialog then exit(0). An emulator must
+// unwind this adapter to its logged session-failure boundary instead.
+#undef ASSERT
+#define ASSERT(x) do { if (!(x)) throw green_ggpo::failure("GGPO assertion: " #x); } while (false)
+
+// Per-frame text logging is supplied by the host adapter, not a process-global
+// upstream file or environment flag. This also avoids serialising input history.
+void Log(const char*, ...) {}
+void LogFlush() {}
+
+#ifdef _MSC_VER
+#pragma warning(push)
+#pragma warning(disable: 4244 4267 4458 4706)
+#endif
+#include "../../../3rdparty/ggpo_sync/src/lib/ggpo/game_input.cpp"
+#include "../../../3rdparty/ggpo_sync/src/lib/ggpo/input_queue.cpp"
+#include "../../../3rdparty/ggpo_sync/src/lib/ggpo/sync.cpp"
+#ifdef _MSC_VER
+#pragma warning(pop)
+#endif
+
+static_assert(MAX_PREDICTION_FRAMES == green_ggpo::maximum_prediction_frames);
+
+namespace green_ggpo
+{
+struct session::impl
+{
+    static thread_local impl* current;
+    callbacks host;
+    UdpMsg::connect_status connected[2]{};
+    Sync sync{connected};
+    int side, remote_last = -1, local_last = -1;
+    const int prediction_limit;
+    bool prepared = false, poisoned = false;
+    std::uint16_t prepared_pad{};
+    std::map<int, std::uint16_t> remote;
+
+    struct scope
+    {
+        impl* previous;
+        explicit scope(impl* p) : previous(current) { current = p; }
+        ~scope() { current = previous; }
+    };
+
+    static impl& active()
+    {
+        if (!current) throw green_ggpo::failure("GGPO callback outside a session");
+        return *current;
+    }
+    void require(bool ok, const char* message)
+    {
+        if (!ok) { poisoned = true; throw green_ggpo::failure(message); }
+    }
+    template <typename F> decltype(auto) checked(F&& f)
+    {
+        require(!poisoned, "GGPO session already failed");
+        scope guard(this);
+        try { return f(); }
+        catch (...) { poisoned = true; throw; }
+    }
+    static bool save(unsigned char** buffer, int* len, int* checksum, int frame)
+    {
+        auto& s = active();
+        std::vector<std::byte> data;
+        s.require(s.host.save(s.host.context, frame, data), "GGPO save callback failed");
+        s.require(!data.empty() && data.size() <= 8 * 1024 * 1024, "GGPO state size invalid");
+        auto bytes = std::make_unique_for_overwrite<unsigned char[]>(data.size());
+        std::memcpy(bytes.get(), data.data(), data.size());
+        *len = static_cast<int>(data.size());
+        *checksum = 0; // No claim that native pointer-bearing bytes are a peer checksum.
+        *buffer = bytes.release();
+        return true;
+    }
+    static bool load(unsigned char* buffer, int len)
+    {
+        auto& s = active();
+        s.require(buffer && len > 0, "GGPO state buffer invalid");
+        s.require(s.host.load(s.host.context, {reinterpret_cast<const std::byte*>(buffer), static_cast<std::size_t>(len)}),
+            "GGPO load callback failed");
+        return true;
+    }
+    static bool advance_callback(int)
+    {
+        auto& s = active();
+        const input values = s.synchronized();
+        s.require(s.host.advance(s.host.context, values), "GGPO replay callback failed");
+        s.sync.IncrementFrame();
+        return true;
+    }
+    input synchronized()
+    {
+        input values{};
+        require(sync.SynchronizeInputs(values.data(), sizeof(values)) == 0, "GGPO player disconnected");
+        return values;
+    }
+    impl(int local_side, callbacks cb, int limit) : host(cb), side(local_side), prediction_limit(limit)
+    {
+        // Initialize callbacks before any throwing validation: Sync's destructor
+        // frees its (possibly null) frame buffers even if construction fails.
+        GGPOSessionCallbacks c{};
+        c.begin_game = [](const char*) { return true; };
+        c.save_game_state = save;
+        c.load_game_state = load;
+        c.log_game_state = [](char*, unsigned char*, int) { return true; };
+        c.free_buffer = [](void* buffer) { delete[] static_cast<unsigned char*>(buffer); };
+        c.advance_frame = advance_callback;
+        c.on_event = [](GGPOEvent*) { return true; };
+        Sync::Config config{c, limit, 2, sizeof(std::uint16_t)};
+        sync.Init(config);
+        require(limit == 3 || limit == 5 || limit == 8, "GGPO prediction limit must be 3, 5, or 8");
+        require(side == 0 || side == 1, "GGPO local side invalid");
+        require(host.save && host.load && host.advance, "GGPO host callbacks missing");
+        for (auto& player : connected) player.last_frame = -1;
+    }
+};
+thread_local session::impl* session::impl::current = nullptr;
+
+session::session(int local_side, callbacks cb, int limit) : state(std::make_unique<impl>(local_side, cb, limit)) {}
+session::~session() = default;
+
+void session::submit_remote(int frame, std::uint16_t pad)
+{
+    state->checked([&]
+    {
+        auto& s = *state;
+        s.require(frame >= 0 && frame <= s.sync.GetFrameCount() + 64, "GGPO remote frame outside receive window");
+        if (frame < s.sync.GetFrameCount() - 64) return; // Already retired duplicate.
+        const auto [it, inserted] = s.remote.emplace(frame, pad);
+        s.require(inserted || it->second == pad, "Conflicting authoritative GGPO input");
+        if (!inserted) return;
+        for (;;)
+        {
+            const auto next = s.remote.find(s.remote_last + 1);
+            if (next == s.remote.end()) break;
+            auto value = next->second;
+            GameInput real;
+            real.init(next->first, reinterpret_cast<char*>(&value), sizeof(value));
+            s.sync.AddRemoteInput(1 - s.side, real);
+            s.remote_last = next->first;
+        }
+        while (!s.remote.empty() && s.remote.begin()->first < s.sync.GetFrameCount() - 64)
+            s.remote.erase(s.remote.begin());
+    });
+}
+
+void session::reconcile()
+{
+    state->checked([&]
+    {
+        auto& s = *state;
+        // Check before discarding confirmed inputs: replay may still need them.
+        s.sync.CheckSimulation(0);
+        s.sync.SetLastConfirmedFrame(std::min(s.remote_last, s.local_last));
+    });
+}
+
+bool session::prepare(std::uint16_t local_pad)
+{
+    return state->checked([&]
+    {
+        auto& s = *state;
+        if (s.prepared)
+        {
+            s.require(local_pad == s.prepared_pad, "Local GGPO input changed before frame execution");
+            return true;
+        }
+        s.require(s.sync.GetFrameCount() < 0x3fffffff, "GGPO frame counter exhausted");
+        GameInput local;
+        local.init(s.sync.GetFrameCount(), reinterpret_cast<char*>(&local_pad), sizeof(local_pad));
+        if (!s.sync.AddLocalInput(s.side, local)) return false;
+        s.local_last = local.frame;
+        s.prepared = true;
+        s.prepared_pad = local_pad;
+        return true;
+    });
+}
+
+input session::inputs()
+{
+    return state->checked([&]
+    {
+        state->require(state->prepared || state->sync.InRollback(), "GGPO inputs requested before local submission");
+        return state->synchronized();
+    });
+}
+void session::advance()
+{
+    state->checked([&]
+    {
+        state->require(state->prepared && !state->sync.InRollback(), "GGPO forward frame not prepared");
+        state->sync.IncrementFrame();
+        state->prepared = false;
+    });
+}
+int session::frame() const { return state->sync.GetFrameCount(); }
+int session::last_remote_frame() const { return state->remote_last; }
+int session::prediction_limit() const { return state->prediction_limit; }
+bool session::replaying() const { return state->sync.InRollback(); }
+bool session::failed() const { return state->poisoned; }
+}
diff --git a/rpcs3/Emu/Cell/GreenGGPOHost.cpp b/rpcs3/Emu/Cell/GreenGGPOHost.cpp
new file mode 100644
