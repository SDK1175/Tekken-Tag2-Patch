+	void render_device::create_pipeline_cache()
+	{
+		if (g_cfg.video.disable_on_disk_shader_cache) return;
+		using namespace rsx::persistent_cache;
+		bytes initial;
+		try
+		{
+			VkPhysicalDeviceProperties properties{};
+			vkGetPhysicalDeviceProperties(*pgpu, &properties);
+			bytes identity;
+			put32(identity, properties.vendorID); put32(identity, properties.deviceID);
+			put32(identity, properties.driverVersion); put32(identity, properties.apiVersion);
+			identity.insert(identity.end(), std::begin(properties.pipelineCacheUUID), std::end(properties.pipelineCacheUUID));
+			m_pipeline_cache_key = key_for({reinterpret_cast<const char*>(identity.data()), identity.size()}, 0, 0, "tag2-vk-pipeline1");
+			const auto stored = read_file(fs::get_cache_dir() + "cache/vulkan_pipeline/" + m_pipeline_cache_key + ".bin");
+			const auto payload = unpack(m_pipeline_cache_key, stored);
+			if (compatible_pipeline(payload, properties.vendorID, properties.deviceID, properties.pipelineCacheUUID))
+				initial.assign(payload.begin(), payload.end());
+		}
+		catch (...) { initial.clear(); }
+
+		VkPipelineCacheCreateInfo info{};
+		info.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+		// Default flags provide internal synchronization for parallel compilation.
+		info.initialDataSize = initial.size();
+		info.pInitialData = initial.empty() ? nullptr : initial.data();
+		auto result = vkCreatePipelineCache(dev, &info, nullptr, &m_pipeline_cache);
+		if (result != VK_SUCCESS && !initial.empty())
+		{
+			info.initialDataSize = 0; info.pInitialData = nullptr;
+			m_pipeline_cache = VK_NULL_HANDLE;
+			result = vkCreatePipelineCache(dev, &info, nullptr, &m_pipeline_cache);
+			initial.clear();
+		}
+		if (result != VK_SUCCESS)
+		{
+			m_pipeline_cache = VK_NULL_HANDLE;
+			rsx_log.warning("Native Vulkan pipeline cache unavailable (%d); using normal pipeline creation", static_cast<s32>(result));
+		}
+		else
+			rsx_log.notice("Native Vulkan pipeline cache: loaded %llu bytes for this GPU/driver", static_cast<u64>(initial.size()));
+	}
