+  const auto it=std::find_if(package.entries.begin(),package.entries.end(),[&](const Entry& e){return e.path==p;});
+  if(it==package.entries.end())throw Failure("Unexpected native recovery file");
+  if(it->hash==after)return safe_path(stage,p);
+  if(it->policy=="frames") {const auto selected=QByteArray::number(j["frames"].toInt())+"\n";if(hash_bytes(selected)!=after)throw Failure("Recovery frame choice mismatch");}
