+  NativeProgressDialog progress(QString::fromUtf8("태그2 업데이트 적용 중…"),QString{},0,0);progress.setWindowTitle(QString::fromUtf8("태그2 업데이트"));progress.prevent_cancel();progress.setAutoClose(false);progress.setAutoReset(false);progress.setMinimumDuration(0);progress.setWindowModality(Qt::ApplicationModal);progress.show();QApplication::processEvents();
+  auto report=[&](const QString& phase,int n,int max){const bool committing=phase=="commit";progress.setLabelText((committing?QString::fromUtf8("태그2 업데이트 적용 중… %1 / %2"):QString::fromUtf8("태그2 업데이트 적용 준비 중… %1 / %2")).arg(n).arg(max));progress.setRange(0,phase=="prepared"?0:max);progress.setValue(n);QApplication::processEvents();};
