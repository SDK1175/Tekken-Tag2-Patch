+#pragma once
+#include <QString>
+#include <QByteArray>
+#include <QJsonObject>
+#include <QSet>
+#include <stdexcept>
+namespace tag2 {
+class Failure: public std::runtime_error {
+ QByteArray message;
+ public:
+ // MSVC's _HAS_EXCEPTIONS=0 runtime_error retains only the supplied pointer.
+ // Keep our own bytes alive through catch handlers and exception copies.
+ explicit Failure(const QString& s):std::runtime_error("Tag2 operation failed"),message(s.toUtf8()){}
+ const char* what() const noexcept override{return message.constData();}
+};
+QString safe_path(const QString& root,const QString& relative);
+QString hash_file(const QString& path);
+QString hash_bytes(const QByteArray& bytes);
+void safe_absolute(const QString& path);
+QByteArray read_bytes(const QString& path,qint64 limit=1024*1024);
+QJsonObject strict_json(const QByteArray& bytes);
+void atomic_write(const QString& path,const QByteArray& bytes);
+void unpack_zip(const QByteArray& data,const QString& stage,const QSet<QString>& allowed);
+}
