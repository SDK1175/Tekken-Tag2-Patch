+}
+
+// out slot is a guest address, NOT an index. Mirrors 354578..354660 with
+// either original 3 slots or audited direct-patched 6 slots. No guest writes.
+inline bool select_restore_slot(memory m,std::uint32_t manager,std::uint32_t slots,std::uint32_t& slot,std::uint32_t& frame) noexcept
+{
+    if((slots!=3&&slots!=6)||!detail::bounded(manager,0x2c))return false;
