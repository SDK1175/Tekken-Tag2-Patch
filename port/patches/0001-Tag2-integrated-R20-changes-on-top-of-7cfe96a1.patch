diff --git a/rpcs3/rpcs3qt/tag2_native_package.cpp b/rpcs3/rpcs3qt/tag2_native_package.cpp
new file mode 100644
index 000000000..8327432b8
--- /dev/null
+++ b/rpcs3/rpcs3qt/tag2_native_package.cpp
@@ -0,0 +1,83 @@
+#include "tag2_native_package.h"
+#include "tag2_native_launch_guard.h"
+#include "tag2_native_frames.h"
+#include "tag2_native_retirement.h"
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QFileInfo>
+#include <QMap>
+#include <QRegularExpression>
+namespace tag2 {
+#include "tag2_native_policy.inc"
+static bool frame_ok(int n){return n==3||n==5||n==8;}
+static QString policy(const QString& p){return p=="green_rollback/rollback_frames.txt"?"frames":p=="green_rollback/framedata_enabled.txt"?"if_missing":"replace";}
+static void verify_patch_files(const QString& root){
+ for(const QString& p:{"patches/patch.yml","config/patch_config.yml"})if(!QFileInfo(safe_path(root,p)).isFile())throw Failure(QString::fromUtf8("패치 파일이 없습니다. 최초 통합 ZIP을 기존 폴더에 풀어 주세요: ")+p);
+}
+QSet<QString> allowed_files(){auto p=managed_paths;p.insert(manifest_path);return p;}
+bool permitted(const QString& p){return managed_paths.contains(p)||p==manifest_path;}
+Package parse_package(const QByteArray& bytes){
+ const auto j=strict_json(bytes);const int sequence=j["sequence"].toInt(-1);
+ if(j["schema"].toInt()!=2||sequence<6||j["runtime_abi"]!="qt6102-tag2-rpcs3-r6"||!j["files"].isArray())throw Failure("Unsupported native launcher release");
+ static const QRegularExpression release("^TAG2-RPCS3-[0-9]{8}-R[0-9]+$"),sha("^[0-9a-f]{64}$");
+ if(!release.match(j["release_id"].toString()).hasMatch()||!j["release_id"].toString().endsWith("-R"+QString::number(sequence)))throw Failure("Invalid native release identity");
+ Package p{sequence,j["release_id"].toString(),{},j};QSet<QString> seen;
+ for(const auto& value:j["files"].toArray()){
+  const auto row=value.toObject();Entry e{row["path"].toString(),row["sha256"].toString(),row["policy"].toString()};
+  if(!managed_paths.contains(e.path)||seen.contains(e.path)||!sha.match(e.hash).hasMatch()||e.policy!=policy(e.path))throw Failure("Invalid managed file: "+e.path);
+  if(e.path=="rpcs3-u1.exe"&&e.hash!=stable_u1)throw Failure("Stable U1 identity changed");
+  if(runtime_pins.contains(e.path)&&runtime_pins[e.path]!=e.hash)throw Failure("Runtime ABI change needs a separate transition package: "+e.path);
+  seen.insert(e.path);p.entries.append(e);
+ }
+ if(seen!=managed_paths)throw Failure("Incomplete native package");
+ return p;
+}
+Package load_package(const QString& root){
+ const auto p=parse_package(read_bytes(safe_path(root,manifest_path)));
+ for(const auto& e:p.entries)if(hash_file(safe_path(root,e.path))!=e.hash)throw Failure("Package hash mismatch: "+e.path);
+ return p;
+}
+void verify_installed(const QString& root,const Package& p){
+ verify_patch_files(root);
+ for(const auto& e:p.entries){const auto path=safe_path(root,e.path);
+  if(e.policy=="frames") {bool ok=false;const int n=read_bytes(path,32).trimmed().toInt(&ok);if(!ok||!frame_ok(n))throw Failure("Invalid rollback frame setting");}
+  else if(e.policy=="if_missing") {if(!QFileInfo(path).isFile())throw Failure("Missing setting: "+e.path);}
+  else if(installed_file_hash(root,e,p.sequence)!=e.hash)throw Failure("Installed file changed: "+e.path);
+ }
+ const auto actual=parse_package(read_bytes(safe_path(root,manifest_path)));
+ if(actual.json!=p.json)throw Failure("Installed manifest changed");
+}
+void verify_launch(const QString& root,const Package& p,int mode){
+ if(update_in_progress())throw Failure(launch_blocked_message());
+ if(mode<1||mode>3)throw Failure("Invalid launch mode");
+ verify_patch_files(root);
+ for(const QString& pending:{".tag2-native/pending.json",".tag2-native/frames/pending.json",".tag2-update/pending.json",".tag2-update/online-pending.json",".green-online-backups/u1-base-20261102/active.json"})
+  if(QFileInfo::exists(safe_path(root,pending)))throw Failure("Recovery pending");
+ const QString engine=mode==1?"rpcs3-u1.exe":"rpcs3.exe";
+ for(const auto& e:p.entries){
+  const bool shared=!e.path.startsWith("TAG2_NATIVE/")&&(e.path.endsWith(".dll")||e.path.endsWith(".qm"));
+  const bool gameplay=mode!=1&&(e.path.startsWith("patches/")||e.path.startsWith("green_rollback/"))&&e.policy=="replace";
+  if((e.path==engine||shared||gameplay)&&hash_file(safe_path(root,e.path))!=e.hash)throw Failure("Launch file changed: "+e.path);
+ }
+ if(mode==1||read_bytes(safe_path(root,"green_rollback/framedata_enabled.txt"),32)!="0\n")verify_frame_runtime(root);
+ if(mode!=1)read_preferences(root);
+}
+Preferences read_preferences(const QString& root){
+ Preferences p;QString state=safe_path(root,".tag2-native/state.json");
+ if(!QFileInfo::exists(state))state=safe_path(root,".tag2-update/state.json");
+ if(QFileInfo::exists(state)){auto j=strict_json(read_bytes(state));
+  if(j["schema"].toInt()!=1)throw Failure("Unsupported preference state");
+  p.mode=j["mode"].toString("both");p.frames=j["frames"].toInt(3);
+  if((p.mode!="both"&&p.mode!="u1")||!frame_ok(p.frames))throw Failure("Invalid saved selection");
+ }
+ const QString frames=safe_path(root,"green_rollback/rollback_frames.txt");
+ if(QFileInfo::exists(frames)){bool ok=false;int n=read_bytes(frames,32).trimmed().toInt(&ok);if(!ok||!frame_ok(n))throw Failure("Invalid existing frame choice");p.frames=n;}
+ return p;
+}
+void write_preferences(const QString& root,const Preferences& p){
+ if((p.mode!="both"&&p.mode!="u1")||!frame_ok(p.frames))throw Failure("Invalid selection");
+ atomic_write(safe_path(root,"green_rollback/rollback_frames.txt"),QByteArray::number(p.frames)+"\n");
+ const QJsonObject state{{"schema",1},{"mode",p.mode},{"frames",p.frames}};
+ atomic_write(safe_path(root,".tag2-native/state.json"),QJsonDocument(state).toJson());
+}
+}
