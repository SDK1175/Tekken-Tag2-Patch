+
+namespace green_ggpo
+{
+// Distinct from the unchanged three-slot native snapshot serializer ring.
+// The original constructor and all destructor loops retain allocation ownership.
+inline constexpr unsigned native_queue_capacity = 8;
+struct queue_patch
+{
+    std::uint32_t address, expected, replacement;
+};
+inline constexpr std::array<queue_patch, 2> queue_patches{{
+    {0x00584f30, 0x38600024, 0x38600060}, // Allocate eight 12-byte input pairs.
