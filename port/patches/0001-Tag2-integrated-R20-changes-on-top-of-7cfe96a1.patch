@@ -0,0 +1,9 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+#include "util/types.hpp"
+#include <vector>
+namespace ttt2_native {
+// Call only for a live main executable after YAML and static HLE installation,
+// before PPU analysis/compilation. Original title/hash gates live inside.
+void install(std::vector<u32>& applied);
+}
diff --git a/rpcs3/Emu/Cell/TTT2NativeKernels.h b/rpcs3/Emu/Cell/TTT2NativeKernels.h
new file mode 100644
index 000000000..d10886aef
--- /dev/null
+++ b/rpcs3/Emu/Cell/TTT2NativeKernels.h
@@ -0,0 +1,524 @@
+// Generated restricted PPU kernels. GPL-2.0-only. Do not hand-edit.
+#pragma once
+#include <array>
+#include <bit>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+namespace ttt2_native::kernels {
+constexpr std::uint64_t mask64(unsigned mb, unsigned me) {
+    const auto left = UINT64_MAX >> mb;
+    const auto right = UINT64_MAX << (63u - me);
+    return mb <= me ? left & right : left | right;
+}
+constexpr std::uint64_t dup32(std::uint32_t v) { return std::uint64_t(v) | (std::uint64_t(v) << 32); }
+template<unsigned N> constexpr std::uint64_t sext(std::uint64_t v) {
+    const auto sign=UINT64_C(1)<<(N-1); const auto mask=(UINT64_C(1)<<N)-1;
+    return ((v & mask) ^ sign) - sign;
+}
+constexpr std::uint64_t sext32(std::uint32_t v) { return sext<32>(v); }
+template<unsigned N, bool Signed> inline void compare(std::uint32_t& cr, std::uint32_t xer,
+    unsigned field, std::uint64_t av, std::uint64_t bv) {
+    bool lt, gt;
+    if constexpr (Signed && N==64) {
+        const auto a=std::bit_cast<std::int64_t>(av), b=std::bit_cast<std::int64_t>(bv);
+        lt=a<b; gt=a>b;
+    } else if constexpr (Signed) {
+        const auto a=std::bit_cast<std::int32_t>(static_cast<std::uint32_t>(av));
+        const auto b=std::bit_cast<std::int32_t>(static_cast<std::uint32_t>(bv));
+        lt=a<b; gt=a>b;
+    } else if constexpr (N==32) {
+        const auto a=static_cast<std::uint32_t>(av), b=static_cast<std::uint32_t>(bv);
+        lt=a<b; gt=a>b;
+    } else { lt=av<bv; gt=av>bv; }
+    const unsigned shift=28-4*field;
+    const auto nibble=(lt?8u:gt?4u:2u) | (xer>>31);
+    cr=(cr & ~(15u<<shift)) | (nibble<<shift);
+}
+using run_fn=void (*)(std::uint64_t*, std::uint32_t&, std::uint32_t);
