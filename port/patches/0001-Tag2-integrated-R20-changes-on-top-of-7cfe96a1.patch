diff --git a/rpcs3/Emu/Cell/TTT2NativePolicy.h b/rpcs3/Emu/Cell/TTT2NativePolicy.h
new file mode 100644
index 000000000..29b24c691
--- /dev/null
+++ b/rpcs3/Emu/Cell/TTT2NativePolicy.h
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+#include <cstdint>
+#include <span>
+#include <string_view>
+namespace ttt2_native {
+enum class mode { off, verify, native };
+inline constexpr std::string_view expected_hash="PPU-8645cfa235c9980ff74b5e06388b29e97fdbbed9";
+inline constexpr mode parse_mode(std::string_view s) {
+    return s=="verify" ? mode::verify : s=="native" ? mode::native : mode::off;
+}
+inline constexpr bool accepts_game(std::string_view title, std::string_view hash) {
+    return title=="BLES01702" && hash==expected_hash;
+}
+inline constexpr bool overlap(std::uint32_t address, std::uint32_t size, std::span<const std::uint32_t> patches) {
+    const std::uint64_t end=std::uint64_t(address)+size;
+    for (const auto p:patches) {
+        if (p==UINT32_MAX) continue;
+        // RPCS3 uses low address bits for some patch/gate markers.
+        const auto word=p & ~3u;
+        if (word>=address && std::uint64_t(word)<end) return true;
+    }
+    return false;
+}
+inline constexpr bool native_allowed(mode m, std::uint64_t verified, bool disabled) {
+    return m==mode::native && verified>=64 && !disabled;
+}
+inline constexpr bool needs_check(mode m, std::uint64_t verified, std::uint64_t calls, bool disabled) {
+    return !disabled && (m==mode::verify || (m==mode::native && (verified<64 || calls%1024==0)));
+}
+} // namespace ttt2_native
diff --git a/rpcs3/Emu/Cell/green_ggpo.h b/rpcs3/Emu/Cell/green_ggpo.h
new file mode 100644
index 000000000..b98407617
--- /dev/null
+++ b/rpcs3/Emu/Cell/green_ggpo.h
@@ -0,0 +1,56 @@
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <span>
+#include <string>
+#include <utility>
+#include <vector>
+
+// External-transport GGPO backend. Native RPCN delivery supplies authoritative
+// inputs; prediction, state history and replay are the actual GGPO Sync engine.
+namespace green_ggpo
+{
+inline constexpr int prediction_frames = 3; // Legacy caller default.
+inline constexpr int maximum_prediction_frames = 8; // Owned history capacity.
+using input = std::array<std::uint16_t, 2>;
+// RPCS3's MSVC TUs use _HAS_EXCEPTIONS=0, whose std::exception is stdext::exception.
+// CRT/dependency TUs can use the other ABI. Do not inherit an STL exception or
+// share its COMDAT throw metadata across those modes.
+class failure final
+{
+    std::string message;
+public:
+    explicit failure(std::string reason) : message(std::move(reason)) {}
+    const char* what() const noexcept { return message.c_str(); }
+};
+struct callbacks
+{
+    void* context{};
+    bool (*save)(void*, int frame, std::vector<std::byte>&){};
+    bool (*load)(void*, std::span<const std::byte>){};
+    bool (*advance)(void*, const input&){};
+};
+
+class session
+{
+    struct impl;
+    std::unique_ptr<impl> state;
+public:
+    session(int local_side, callbacks host, int limit = prediction_frames);
+    ~session();
+    session(const session&) = delete;
+    session& operator=(const session&) = delete;
+    void submit_remote(int frame, std::uint16_t pad);
+    void reconcile();
+    bool prepare(std::uint16_t local_pad);
+    input inputs();
+    void advance();
+    int frame() const;
+    int last_remote_frame() const;
+    int prediction_limit() const;
+    bool replaying() const;
+    bool failed() const;
+};
+}
