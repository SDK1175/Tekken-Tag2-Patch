index 000000000..b0cfa2c0e
--- /dev/null
+++ b/rpcs3/Emu/Cell/green_rollback_result_log.h
@@ -0,0 +1,214 @@
+#pragma once
+#include <array>
+#include <bit>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <span>
+
+namespace green_rollback
+{
+struct result_snapshot
+{
+    bool ranked_valid = false;
+    std::uint32_t scene = 0;
+    std::int32_t phase_current = -1, phase_next = -1;
+    std::array<std::int32_t, 2> wins{-1, -1}, round_result{-1, -1};
+    std::int32_t target_wins = -1, result_code = -1, selected_winner = -1;
+    std::int32_t storage_state = -1, storage_error = -1, storage_status = -1;
+    bool operator==(const result_snapshot&) const = default;
+};
+enum class result_outcome { unknown, win, loss, draw };
+struct result_observation
+{
+    result_snapshot snapshot;
+    result_outcome outcome = result_outcome::unknown;
+    bool final_transition = false, changed = false;
+    std::uint64_t match_serial = 0;
+};
+namespace result_read_detail
+{
+inline bool range(std::uint32_t at, std::uint32_t size) noexcept
+{
+    return at >= 0x10000 && size && std::uint64_t{at} + size <= 0x40000000;
+}
+inline bool pointer(std::uint32_t at, std::uint32_t size) noexcept
+{
+    return !(at & 3) && range(at, size);
+}
+template <typename Reader, std::size_t Size>
+bool read(Reader& reader, std::uint32_t at, std::array<std::byte, Size>& out) noexcept
+{
+    if (!range(at, static_cast<std::uint32_t>(Size))) return false;
+    try { return reader(at, std::span<std::byte>{out}); }
+    catch (...) { return false; }
+}
+template <typename Reader>
+bool word(Reader& reader, std::uint32_t at, std::uint32_t& out) noexcept
+{
+    std::array<std::byte, 4> bytes{};
+    if ((at & 3) || !read(reader, at, bytes)) return false;
+    out = (std::to_integer<std::uint32_t>(bytes[0]) << 24) |
+        (std::to_integer<std::uint32_t>(bytes[1]) << 16) |
+        (std::to_integer<std::uint32_t>(bytes[2]) << 8) |
+        std::to_integer<std::uint32_t>(bytes[3]);
+    return true;
+}
+template <typename Reader>
+bool signed_word(Reader& reader, std::uint32_t at, std::int32_t& out) noexcept
+{
+    std::uint32_t value = 0;
+    if (!word(reader, at, value)) return false;
+    out = std::bit_cast<std::int32_t>(value);
+    return true;
+}
+template <typename Reader>
+bool byte(Reader& reader, std::uint32_t at, std::int32_t& out) noexcept
+{
+    std::array<std::byte, 1> bytes{};
+    if (!read(reader, at, bytes)) return false;
+    out = std::to_integer<std::int32_t>(bytes[0]);
+    return true;
+}
+}
+
+// BLES01702 01.03 only. Reader must reject unreadable ranges and fill the
+// requested bytes on success. Every addition is preceded by a checked object
+// span; reads are restricted to the actual fields, and never call guest code.
+// Original ELF evidence: work/rank_log_review_20261104/result_field_audit.
+template <typename Reader>
+result_snapshot read_result_snapshot(Reader&& reader) noexcept
+{
+    using namespace result_read_detail;
+    result_snapshot result;
+    signed_word(reader, 0x0165e530, result.phase_current);
+    signed_word(reader, 0x0165e534, result.phase_next);
+
+    // Native 52E570 loads +10 from static manager 18FCE78. 563948 returns
+    // pending before checking error. Idle/no-error is not storage durability.
+    std::int32_t enabled = -1;
+    std::uint32_t storage_address = 0;
+    if (byte(reader, 0x018fce70, enabled) && enabled == 1 &&
+        word(reader, 0x018fce88, storage_address) && pointer(storage_address, 0x1d0b))
+    {
+        const bool state = signed_word(reader, storage_address + 0x1cd0, result.storage_state);
+        const bool error = byte(reader, storage_address + 0x1d0a, result.storage_error);
+        if (state && error)
+            result.storage_status = result.storage_state ? 1 : result.storage_error ? 2 : 0;
+    }
+
+    // 3A7240 -> 16A220 scene getter, 3B3E28 ranked constructor. The vtable
+    // and kind are checked together so another mode cannot reuse this layout.
+    std::uint32_t scene_root = 0, scene_context = 0, scene_address = 0, vtable = 0, kind = 0;
+    if (!word(reader, 0x01629628, scene_root) || !pointer(scene_root, 0x104) ||
+        !word(reader, scene_root + 0x100, scene_context) || !pointer(scene_context, 0xe0) ||
+        !word(reader, scene_context + 0xdc, scene_address) || !pointer(scene_address, 0x3d4)) return result;
+    result.scene = scene_address;
+    if (!word(reader, scene_address, vtable) || vtable != 0x014fa5b0 ||
+        !word(reader, scene_address + 0x1c0, kind) || kind != 16) return result;
+
+    // 3A6FC0: side record = scene_address + 8 + side*D4. D0E60/D0EB4
+    // increment awards and write signed round markers; CD908 selects match
+    // result code, and still selects a presentation actor for code3 (draw).
+    bool valid = true;
+    valid &= signed_word(reader, scene_address + 8, result.wins[0]);
+    valid &= signed_word(reader, scene_address + 8 + 0xd4, result.wins[1]);
+    valid &= signed_word(reader, scene_address + 8 + 0x24, result.round_result[0]);
+    valid &= signed_word(reader, scene_address + 8 + 0xd4 + 0x24, result.round_result[1]);
+    valid &= byte(reader, scene_address + 0x2a0, result.target_wins);
+    if (result.target_wins >= 128) result.target_wins -= 256;
+    valid &= byte(reader, scene_address + 0x2b0, result.result_code);
+    valid &= byte(reader, scene_address + 0x29a, result.selected_winner);
+    result.ranked_valid = valid;
+    return result;
+}
+
+class result_tracker
+{
+    std::optional<result_snapshot> previous_;
+    std::optional<std::uint32_t> previous_local_;
+    std::uint64_t previous_connection_ = 0;
+    result_outcome previous_outcome_ = result_outcome::unknown;
+    bool identity_ = false, seen_zero_ = false, confirmed_ = false;
+    std::uint32_t scene_ = 0;
+    std::uint64_t connection_ = 0, serial_ = 0;
+    std::int32_t last_code_ = -1, candidate_ = -1;
+
+    void disarm() noexcept { seen_zero_ = confirmed_ = false; candidate_ = -1; }
+    static bool consistent(const result_snapshot& value) noexcept
+    {
+        // Targets1..5 are the audited diagnostic support range. Native has
+        // other completion routes; unsupported cases deliberately stay unknown.
+        if (value.target_wins < 1 || value.target_wins > 5 ||
+            value.wins[0] < 0 || value.wins[1] < 0 ||
+            value.wins[0] > 127 || value.wins[1] > 127 ||
+            (value.wins[0] < value.target_wins && value.wins[1] < value.target_wins)) return false;
+        switch (value.result_code)
+        {
+        case 1: return value.wins[0] > value.wins[1] && value.selected_winner == 0;
+        case 2: return value.wins[1] > value.wins[0] && value.selected_winner == 1;
+        case 3: return value.wins[0] == value.wins[1] &&
+            (value.selected_winner == 0 || value.selected_winner == 1);
+        default: return false;
+        }
+    }
+public:
+    // connection_id is a host binding generation, not a GGPO round epoch.
+    // A zero generation means unbound. local_side must come from a validated
+    // native source, never from the selected presentation actor or a default0.
+    result_observation sample(const result_snapshot& value,
+        std::optional<std::uint32_t> local_side, std::uint64_t connection_id) noexcept
+    {
+        result_observation result{value};
+        if (identity_ && (connection_id != connection_ ||
+            (value.ranked_valid && value.scene != scene_)))
+        {
+            identity_ = false; last_code_ = -1; disarm();
+        }
+        if (!value.ranked_valid || !value.scene || !connection_id ||
+            value.phase_current < 0 || value.phase_next < 0)
+        {
+            // A gap can hide reset/reuse at the same address. Require a new
+            // observed zero before any later current outcome is interpreted.
+            disarm();
+        }
+        else
+        {
+            if (!identity_)
+            {
+                identity_ = true; scene_ = value.scene; connection_ = connection_id;
+                ++serial_; last_code_ = -1; disarm();
+            }
+            if (value.result_code == 0)
+            {
+                if (last_code_ > 0) ++serial_;
+                disarm(); seen_zero_ = true;
+            }
+            else if (value.result_code >= 1 && value.result_code <= 3 && consistent(value))
+            {
+                if (last_code_ == 0 && seen_zero_) candidate_ = value.result_code;
+                else if (last_code_ != value.result_code) disarm();
+                if (candidate_ == value.result_code && value.phase_current == 8 && value.phase_next == 8)
+                {
+                    result.final_transition = !confirmed_;
+                    confirmed_ = true;
+                }
+                if (confirmed_ && candidate_ == value.result_code && local_side && *local_side <= 1)
+                {
+                    if (value.result_code == 3) result.outcome = result_outcome::draw;
+                    else result.outcome = (value.result_code == 1 ? 0u : 1u) == *local_side ?
+                        result_outcome::win : result_outcome::loss;
+                }
+            }
+            else disarm();
+            last_code_ = value.result_code;
+        }
+        result.match_serial = serial_;
+        result.changed = !previous_ || *previous_ != value || previous_local_ != local_side ||
+            previous_connection_ != connection_id || previous_outcome_ != result.outcome || result.final_transition;
+        previous_ = value; previous_local_ = local_side; previous_connection_ = connection_id;
+        previous_outcome_ = result.outcome;
+        return result;
+    }
+};
+}
