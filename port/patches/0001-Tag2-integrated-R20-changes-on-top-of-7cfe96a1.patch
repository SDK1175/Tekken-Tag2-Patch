+    inline bool header(capture_record& r)
+    {
+        std::uint8_t a[16],b[8],c[448],ptr[8];
+        if(!word(0x165e530,r.mode) || r.mode!=21 || !word(0x165e534,r.mode_pending) || !word(0x16fc150,r.main)
