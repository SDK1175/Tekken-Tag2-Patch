+void NativeTransaction::recover(){recover_one(safe_path(root,".tag2-native/pending.json"),".tag2-native/transactions",true,false);}
+void NativeTransaction::validate_recovery(){recover_one(safe_path(root,".tag2-native/pending.json"),".tag2-native/transactions",true,false,true);}
+void NativeTransaction::recover_legacy(){
+ if(QFileInfo::exists(safe_path(root,".green-online-backups/u1-base-20261102/active.json")))throw Failure("Older U1 recovery must be completed before native migration");
+ recover_one(safe_path(root,".tag2-update/online-pending.json"),".tag2-update/online/transactions",false,true);
+ recover_one(safe_path(root,".tag2-update/pending.json"),".tag2-update/transactions",false,false);
+}
+void NativeTransaction::apply(const QString& source){
+ recover();recover_legacy();const auto package=load_package(source);const auto prefs=read_preferences(root);
+ if(QFileInfo::exists(safe_path(root,manifest_path))){auto installed=parse_package(read_bytes(safe_path(root,manifest_path)));verify_installed(root,installed);
+  if(package.sequence<installed.sequence||(package.sequence==installed.sequence&&package.json!=installed.json))throw Failure("Release downgrade or identity collision");
+  if(package.json==installed.json)return;
+ }else if(hash_file(safe_path(root,"rpcs3.exe"))!=stable_u1)throw Failure("Migration needs the known stable R2/U1 installation");
+ const QString id=QUuid::createUuid().toString(QUuid::Id128),tx=safe_path(root,".tag2-native/transactions/"+id),stage=safe_path(tx,"replacement");
+ // Keep an immutable complete original release separately from effective settings.
+ int staged=0;for(const auto& e:package.entries){copy(safe_path(source,e.path),safe_path(stage,e.path),e.hash);if(progress)progress("stage",++staged,package.entries.size());}
+ copy(safe_path(source,manifest_path),safe_path(stage,manifest_path),hash_file(safe_path(source,manifest_path)));
+ load_package(stage);QJsonArray rows;
+ auto record=[&](const QString& p,const QString& after){const QString target=safe_path(root,p),before=hash_file(target);
+  if(!before.isEmpty()&&before!=after)copy(target,safe_path(tx,"original/"+p),before);
+  rows.append(QJsonObject{{"path",p},{"before",before.isEmpty()?QJsonValue(QJsonValue::Null):QJsonValue(before)},{"after",after}});
+ };
+ for(const auto& e:package.entries){const QString before=hash_file(safe_path(root,e.path));QString after=e.hash;
+  if(e.policy=="frames"){const auto selected=QByteArray::number(prefs.frames)+"\n";atomic_write(safe_path(tx,"effective/"+e.path),selected);after=hash_bytes(selected);}
+  else if(e.policy=="if_missing"&&!before.isEmpty()){copy(safe_path(root,e.path),safe_path(tx,"effective/"+e.path),before);after=before;}
+  record(e.path,after);
+ }
+ record(manifest_path,hash_file(safe_path(stage,manifest_path)));
+ // Settings are separate: release verification still checks shipped defaults.
+ const QJsonObject journal{{"schema",1},{"transaction_id",id},{"release",package.release},{"mode",prefs.mode},{"frames",prefs.frames},{"operations",rows}};
+ for(auto value:rows){auto row=value.toObject();if(hash_file(safe_path(root,row["path"].toString()))!=row["before"].toString())throw Failure("File changed while staging");}
+ assert_stopped(root);atomic_write(safe_path(root,".tag2-native/pending.json"),QJsonDocument(journal).toJson());
+ if(progress)progress("prepared",0,rows.size());recover();
+}
+void NativeTransaction::migrate(const QString& source){
+ if(identity(source)==identity(root)||identity(source).startsWith(identity(root)+"/")||identity(root).startsWith(identity(source)+"/"))throw Failure("Extract the transition package into a separate folder");
+ apply(source);
+}
