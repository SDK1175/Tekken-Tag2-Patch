--- /dev/null
+++ b/rpcs3/Emu/Cell/green_rollback_core.h
@@ -0,0 +1,398 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <utility>
+#include <vector>
+
+// Single-owner primitives. The adapter must hold a coherent game-frame boundary
+// throughout capture/restore: mappings, identities and competing writers must
+// remain stable. No PPU/SPU/GPU synchronization is provided by this header.
+namespace green_rollback
+{
+inline constexpr std::uint32_t max_frame = 0x7fffffffu;
+inline constexpr std::uint32_t max_prediction = 5;
+inline constexpr std::size_t snapshot_count = 6;
+inline constexpr std::size_t source_record_count = 36;
+inline constexpr std::size_t source_record_bytes = 20;
+inline constexpr std::size_t max_regions = 64;
+inline constexpr std::size_t max_snapshot_bytes = 8 * 1024 * 1024;
+enum class errc { ok, duplicate, not_ready, old_epoch, missing_input, stale_input, conflicting_input,
+    prediction_limit, invalid_interval, invalid_source, frame_end, invalid_region, overlap, too_large,
+    read_failed, mapping_changed, snapshot_missing, snapshot_conflict, stale_snapshot, snapshot_corrupt,
+    partial_commit, poisoned, terminal };
+struct input_record { std::uint32_t id = 0; std::uint16_t pad = 0; };
+struct id_interval { std::uint32_t first, last; };
+struct decoded_inputs { errc code = errc::not_ready; std::array<input_record, 36> records{}; std::size_t count = 0; };
+struct input_resolution { errc code = errc::not_ready; input_record value{}; std::uint32_t source_id = 0; bool predicted = false; };
+inline decoded_inputs decode_native_source(std::span<const std::byte> source, std::optional<id_interval> skip = {}) noexcept
+{
+    decoded_inputs result;
+    if (source.size() != source_record_count * source_record_bytes)
+    {
+        result.code = errc::invalid_source;
+        return result;
+    }
+    if (skip && (skip->first > skip->last || skip->last > max_frame))
+    {
+        result.code = errc::invalid_interval;
+        return result;
+    }
+    for (std::size_t i = 0; i < source_record_count; ++i)
+    {
+        const auto entry = source.subspan(i * source_record_bytes, source_record_bytes);
+        const auto byte = [&](std::size_t at) { return std::to_integer<std::uint32_t>(entry[at]); };
+        const std::uint32_t id = (byte(12) << 24) | (byte(13) << 16) | (byte(14) << 8) | byte(15);
+        // Native held/absent markers are never authoritative frames.
+        if (id == 0xfffffffeu || id == 0xffffffffu) continue;
+        if (id > max_frame)
+        {
+            result.code = errc::invalid_source;
+            result.count = 0;
+            return result;
+        }
+        if (skip && id >= skip->first && id <= skip->last) continue;
+        result.records[result.count++] = {id, static_cast<std::uint16_t>((byte(18) << 8) | byte(19))};
+    }
+    result.code = errc::ok;
+    return result;
+}
+inline bool next_frame(std::uint32_t current, std::uint32_t& next) noexcept
+{
+    if (current >= max_frame) return false;
+    next = current + 1;
+    return true;
+}
+class input_timeline
+{
+    std::uint64_t epoch_ = 0;
+    bool poisoned_ = false;
+    std::optional<std::uint32_t> evicted_through_;
+    std::array<std::optional<input_record>, source_record_count> records_{};
+public:
+    errc reset(std::uint64_t epoch) noexcept
+    {
+        if (epoch <= epoch_) return errc::old_epoch;
+        epoch_ = epoch;
+        poisoned_ = false;
+        evicted_through_.reset();
+        for (auto& record : records_) record.reset();
+        return errc::ok;
+    }
+    void poison() noexcept { poisoned_ = true; }
+    errc insert(std::uint64_t epoch, input_record input) noexcept
+    {
+        if (!epoch_ || epoch != epoch_) return errc::old_epoch;
+        if (poisoned_) return errc::poisoned;
+        if (input.id > max_frame) return errc::invalid_source;
+        if (evicted_through_ && input.id <= *evicted_through_) return errc::stale_input;
+        std::optional<input_record>* empty = nullptr;
+        std::optional<input_record>* oldest = nullptr;
+        for (auto& slot : records_)
+        {
+            if (!slot)
+            {
+                if (!empty) empty = &slot;
+                continue;
+            }
+            if (slot->id == input.id)
+            {
+                if (slot->pad == input.pad) return errc::duplicate;
+                poisoned_ = true;
+                return errc::conflicting_input;
+            }
+            if (!oldest || slot->id < (*oldest)->id) oldest = &slot;
+        }
+        // Capacity counts actual records, not raw source ID distance: native
+        // skip intervals can make adjacent simulation frames have distant IDs.
+        if (empty) *empty = input;
+        else
+        {
+            if (input.id < (*oldest)->id) return errc::stale_input;
+            evicted_through_ = (*oldest)->id;
+            *oldest = input;
+        }
+        return errc::ok;
+    }
+    // Only authoritative records at or BEFORE target may seed hold prediction.
+    // The adapter also gates prediction with session_guard::can_predict().
+    input_resolution resolve(std::uint64_t epoch, std::uint32_t target, std::optional<id_interval> skip = {}) const noexcept
+    {
+        if (!epoch_ || epoch != epoch_) return {errc::old_epoch};
+        if (poisoned_) return {errc::poisoned};
+        if (target > max_frame) return {errc::frame_end};
+        if (skip && (skip->first > skip->last || skip->last > max_frame)) return {errc::invalid_interval};
+        const auto skipped = [&](std::uint32_t id) { return skip && id >= skip->first && id <= skip->last; };
+        if (skipped(target)) return {errc::invalid_source};
+        const input_record* latest = nullptr;
+        for (const auto& record : records_)
+            if (record && record->id <= target && !skipped(record->id) && (!latest || record->id > latest->id)) latest = &*record;
+        if (!latest) return {errc::missing_input};
+        std::uint32_t distance = target - latest->id;
+        if (skip && distance)
+        {
+            const std::uint32_t first = std::max(latest->id + 1, skip->first);
+            const std::uint32_t last = std::min(target, skip->last);
+            if (first <= last) distance -= last - first + 1;
+        }
+        if (distance > max_prediction) return {errc::prediction_limit};
+        return {errc::ok, {target, latest->pad}, latest->id, latest->id != target};
+    }
+};
+struct region
+{
+    std::uint32_t address, size;
+    std::uint64_t identity;
+    bool operator==(const region&) const = default;
+};
+struct memory_callbacks
+{
+    void* context;
+    bool (*validate)(void*, const region&) noexcept;
+    bool (*read)(void*, std::uint32_t, std::span<std::byte>) noexcept;
+    bool (*write)(void*, std::uint32_t, std::span<const std::byte>) noexcept;
+};
+// A const inspection view is exposed for diagnostics. Mutation, including after
+// capture, is outside the API; the metadata+bytes digest detects accidental damage.
+struct snapshot_image
+{
+    std::uint64_t epoch = 0;
+    std::uint32_t frame = 0;
+    std::array<region, max_regions> regions{};
+    std::size_t region_count = 0;
+    std::vector<std::byte> bytes;
+    std::uint64_t hash = 0;
+};
+struct restore_result { errc code = errc::not_ready; std::size_t committed_regions = 0; };
+namespace detail
+{
+struct layout
+{
+    std::array<region, max_regions> regions{};
+    std::size_t count = 0, bytes = 0;
+};
+inline errc make_layout(std::span<const region> ranges, std::size_t limit, layout& result) noexcept
+{
+    result = {};
+    if (ranges.empty()) return errc::invalid_region;
+    if (ranges.size() > max_regions) return errc::too_large;
+    for (const region& r : ranges)
+    {
+        if (!r.size || std::uint64_t(r.address) + r.size > (std::uint64_t{1} << 32))
+            return errc::invalid_region;
+        result.regions[result.count++] = r;
+    }
+    std::sort(result.regions.begin(), result.regions.begin() + result.count,
+        [](const region& a, const region& b) { return a.address < b.address; });
+    std::size_t count = 0;
+    for (std::size_t i = 0; i < result.count; ++i)
+    {
+        const region r = result.regions[i];
+        if (count)
+        {
+            const region& previous = result.regions[count - 1];
+            if (r == previous) continue;
+            if (std::uint64_t(previous.address) + previous.size > r.address) return errc::overlap;
+        }
+        if (r.size > limit - result.bytes) return errc::too_large;
+        result.bytes += r.size;
+        result.regions[count++] = r;
+    }
+    result.count = count;
+    return errc::ok;
+}
+inline std::uint64_t digest(const snapshot_image& image) noexcept
+{
+    std::uint64_t hash = 14695981039346656037ull;
+    const auto add = [&](std::uint64_t value)
+    {
+        for (unsigned i = 0; i < 8; ++i)
+        {
+            hash = (hash ^ (value & 255)) * 1099511628211ull;
+            value >>= 8;
+        }
+    };
+    add(image.epoch);
+    add(image.frame);
+    add(image.region_count);
+    add(image.bytes.size());
+    for (std::size_t i = 0; i < image.region_count && i < max_regions; ++i)
+    {
+        add(image.regions[i].address);
+        add(image.regions[i].size);
+        add(image.regions[i].identity);
+    }
+    for (std::byte value : image.bytes) hash = (hash ^ std::to_integer<unsigned char>(value)) * 1099511628211ull;
+    return hash;
+}
+}
+class snapshot_store
+{
+    std::size_t limit_;
+    std::uint64_t epoch_ = 0;
+    bool poisoned_ = false;
+    std::optional<std::uint32_t> evicted_through_;
+    std::array<std::optional<snapshot_image>, snapshot_count> slots_{};
+public:
+    explicit snapshot_store(std::size_t byte_limit) : limit_(std::min(byte_limit, max_snapshot_bytes)) {}
+    errc reset(std::uint64_t epoch) noexcept
+    {
+        if (epoch <= epoch_) return errc::old_epoch;
+        epoch_ = epoch;
+        poisoned_ = false;
+        evicted_through_.reset();
+        for (auto& slot : slots_) slot.reset();
+        return errc::ok;
+    }
+    void poison() noexcept { poisoned_ = true; }
+    // Captures publish only after every validation and read succeeds. Existing
+    // frame images cannot be replaced, even with nominally identical bytes.
+    errc capture(std::uint64_t epoch, std::uint32_t frame, std::span<const region> regions, memory_callbacks memory)
+    {
+        if (!epoch_ || epoch != epoch_) return errc::old_epoch;
+        if (poisoned_) return errc::poisoned;
+        if (frame > max_frame) return errc::frame_end;
+        if (find(epoch, frame)) return errc::snapshot_conflict;
+        if (evicted_through_ && frame <= *evicted_through_) return errc::stale_snapshot;
+        std::optional<snapshot_image>* destination = nullptr;
+        std::optional<snapshot_image>* oldest = nullptr;
+        for (auto& slot : slots_)
+        {
+            if (!slot)
+            {
+                if (!destination) destination = &slot;
+                continue;
+            }
+            if (!oldest || slot->frame < (*oldest)->frame) oldest = &slot;
+        }
+        if (!destination)
+        {
+            if (frame < (*oldest)->frame) return errc::stale_snapshot;
+            destination = oldest;
+        }
+        detail::layout layout;
+        if (const errc error = detail::make_layout(regions, limit_, layout); error != errc::ok) return error;
+        if (!memory.validate || !memory.read) return errc::mapping_changed;
+        for (std::size_t i = 0; i < layout.count; ++i)
+            if (!memory.validate(memory.context, layout.regions[i])) return errc::mapping_changed;
+        snapshot_image candidate;
+        candidate.epoch = epoch;
+        candidate.frame = frame;
+        candidate.regions = layout.regions;
+        candidate.region_count = layout.count;
+        candidate.bytes.resize(layout.bytes);
+        std::size_t offset = 0;
+        for (std::size_t i = 0; i < layout.count; ++i)
+        {
+            const region& r = layout.regions[i];
+            if (!memory.read(memory.context, r.address, std::span(candidate.bytes).subspan(offset, r.size)))
+                return errc::read_failed;
+            offset += r.size;
+        }
+        candidate.hash = detail::digest(candidate);
+        if (*destination) evicted_through_ = (*destination)->frame;
+        *destination = std::move(candidate);
+        return errc::ok;
+    }
+    // 검사만 수행하고 guest read/write나 미래 slot 무효화를 하지 않아.
+    // 예약은 아니므로 adapter가 검사/복원 사이의 epoch와 mapping을 지켜야 해.
+    // restore도 같은 검사를 다시 수행해 변경된 mapping을 거부해.
+    errc validate_restore(std::uint64_t epoch, std::uint32_t frame, std::span<const region> expected, memory_callbacks memory) const
+    {
+        if (!epoch_ || epoch != epoch_) return errc::old_epoch;
+        if (poisoned_) return errc::poisoned;
+        if (frame > max_frame) return errc::frame_end;
+        const snapshot_image* image = find(epoch, frame);
+        if (!image) return errc::snapshot_missing;
+        if (image->region_count == 0 || image->region_count > max_regions || image->bytes.size() > limit_ ||
+            detail::digest(*image) != image->hash)
+            return errc::snapshot_corrupt;
+        detail::layout saved;
+        if (detail::make_layout(std::span(image->regions).first(image->region_count), limit_, saved) != errc::ok ||
+            saved.count != image->region_count || saved.bytes != image->bytes.size() ||
+            !std::equal(saved.regions.begin(), saved.regions.begin() + saved.count, image->regions.begin()))
+            return errc::snapshot_corrupt;
+        detail::layout layout;
+        if (const errc error = detail::make_layout(expected, limit_, layout); error != errc::ok) return error;
+        if (layout.count != saved.count ||
+            !std::equal(layout.regions.begin(), layout.regions.begin() + layout.count, saved.regions.begin()))
+            return errc::mapping_changed;
+        if (!memory.validate || !memory.write) return errc::mapping_changed;
+        for (std::size_t i = 0; i < layout.count; ++i)
+            if (!memory.validate(memory.context, layout.regions[i])) return errc::mapping_changed;
+        return errc::ok;
+    }
+    // All preflight failures perform ZERO guest writes. Commit is deliberately
+    // not described as atomic: write(false) may have touched its own span. Stop
+    // immediately and poison the store; committed_regions counts only completed
+    // callbacks. The adapter must terminate that session, not continue simulation.
+    // A caller with noexcept memcpy writes and stable mappings gets full commit.
+    restore_result restore(std::uint64_t epoch, std::uint32_t frame, std::span<const region> expected, memory_callbacks memory)
+    {
+        if (const auto error = validate_restore(epoch, frame, expected, memory); error != errc::ok) return {error};
+        const snapshot_image* image = find(epoch, frame);
+        std::size_t offset = 0;
+        for (std::size_t i = 0; i < image->region_count; ++i)
+        {
+            const region& r = image->regions[i];
+            if (!memory.write(memory.context, r.address, std::span(image->bytes).subspan(offset, r.size)))
+            {
+                poisoned_ = true;
+                return {errc::partial_commit, i};
+            }
+            offset += r.size;
+        }
+        for (auto& slot : slots_) if (slot && slot->frame > frame) slot.reset();
+        return {errc::ok, image->region_count};
+    }
+    const snapshot_image* find(std::uint64_t epoch, std::uint32_t frame) const noexcept
+    {
+        if (!epoch_ || epoch != epoch_ || frame > max_frame) return nullptr;
+        for (const auto& slot : slots_)
+            if (slot && slot->epoch == epoch && slot->frame == frame) return &*slot;
+        return nullptr;
+    }
+};
+enum class session_phase { stopped, running, draining, poisoned };
+class session_guard
+{
+    std::uint64_t epoch_ = 0;
+    session_phase phase_ = session_phase::stopped;
+    std::uint32_t terminal_frame_ = 0;
+public:
+    bool can_predict() const noexcept { return phase_ == session_phase::running; }
+    errc reset(std::uint64_t epoch) noexcept
+    {
+        if (epoch <= epoch_) return errc::old_epoch;
+        epoch_ = epoch;
+        phase_ = session_phase::running;
+        terminal_frame_ = 0;
+        return errc::ok;
+    }
+    errc begin_drain(std::uint32_t last_simulated_frame) noexcept
+    {
+        if (phase_ == session_phase::poisoned) return errc::poisoned;
+        if (phase_ == session_phase::stopped) return errc::terminal;
+        if (last_simulated_frame > max_frame) return errc::frame_end;
+        if (phase_ == session_phase::draining)
+            return last_simulated_frame == terminal_frame_ ? errc::duplicate : errc::terminal;
+        terminal_frame_ = last_simulated_frame;
+        phase_ = session_phase::draining;
+        return errc::ok;
+    }
+    errc finish_drain(std::uint32_t confirmed_frame) noexcept
+    {
+        if (phase_ == session_phase::poisoned) return errc::poisoned;
+        if (phase_ != session_phase::draining) return errc::terminal;
+        if (confirmed_frame > max_frame) return errc::frame_end;
+        if (confirmed_frame < terminal_frame_) return errc::not_ready;
+        phase_ = session_phase::stopped;
+        return errc::ok;
+    }
+    session_phase state() const noexcept { return phase_; }
+    void poison() noexcept { phase_ = session_phase::poisoned; }
+};
+}
diff --git a/rpcs3/Emu/Cell/green_rollback_diagnostics.h b/rpcs3/Emu/Cell/green_rollback_diagnostics.h
new file mode 100644
index 000000000..823adcf89
--- /dev/null
+++ b/rpcs3/Emu/Cell/green_rollback_diagnostics.h
@@ -0,0 +1,67 @@
+#pragma once
+#include <array>
+#include <bit>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+namespace green_rollback::diagnostics
+{
+inline constexpr std::uint32_t schema=1;
+struct memory {void* context{};bool(*read)(void*,std::uint32_t,std::span<std::byte>) noexcept{};};
+enum class status {ok,unavailable};
+struct battle_sample
+{
+    std::uint32_t frame{};
+    std::array<std::uint32_t,2> mode{};
+    std::int32_t timer_raw{};
+    std::array<std::int32_t,4> health_raw{};
+};
+struct capture_result {status code{status::unavailable};battle_sample value{};};
+namespace detail
+{
+inline bool word(memory m,std::uint64_t address,std::uint32_t& value) noexcept
+{
+    if(!m.read||address<0x10000||address+4>0x40000000||(address&3))return false;
+    std::array<std::byte,4> bytes{};
+    if(!m.read(m.context,static_cast<std::uint32_t>(address),bytes))return false;
+    value=0;for(auto byte:bytes)value=(value<<8)|std::to_integer<std::uint32_t>(byte);
+    return true;
+}
+inline bool pointer(memory m,std::uint64_t at,std::uint32_t& value) noexcept
+{return word(m,at,value)&&value>=0x10000&&value<0x40000000&&!(value&3);}
+}
+// 원본 ELF 9fb66382...95e55의 정적 근거만 사용해.
+// health: actor+60, 101FD0/D07xx의 signed zero/positive 검사.
+// timer: battle+2EC, D0740..D074C의 감소 연산. 화면 초 단위가 아니야.
+// root-slot 순서를 유지하며 local/remote나 캐릭터 이름으로 해석하지 않아.
+// caller가 동기화된 게임 경계에서 호출해야 해. 이 함수는 guest 쓰기가 없어.
+inline capture_result capture(memory m) noexcept
+{
+    battle_sample sample;
+    std::uint32_t root=0,world=0,battle=0,timer=0;
+    if(!detail::word(m,0x0165e4f4,sample.frame)||
+       !detail::word(m,0x0165e530,sample.mode[0])||!detail::word(m,0x0165e534,sample.mode[1])||
+       !detail::pointer(m,0x01629628,root)||!detail::pointer(m,std::uint64_t(root)+0x100,world)||
+       !detail::pointer(m,std::uint64_t(world)+0xdc,battle)||!detail::word(m,std::uint64_t(battle)+0x2ec,timer))return {};
+    sample.timer_raw=std::bit_cast<std::int32_t>(timer);
+    for(std::uint32_t i=0;i<4;++i)
+    {
+        std::uint32_t actor=0,hp=0;
+        if(!detail::pointer(m,0x0163ad98+i*4,actor)||!detail::word(m,std::uint64_t(actor)+0x60,hp))return {};
+        sample.health_raw[i]=std::bit_cast<std::int32_t>(hp);
+    }
+    return {status::ok,sample};
+}
+// 주소와 구조체 padding을 제외한 관측값의 FNV64야. 전체 상태 동등성 증명이 아니야.
+inline std::uint64_t digest(const battle_sample& sample) noexcept
+{
+    const std::array<std::uint32_t,9> words{schema,sample.frame,sample.mode[0],sample.mode[1],
+        std::bit_cast<std::uint32_t>(sample.timer_raw),std::bit_cast<std::uint32_t>(sample.health_raw[0]),
+        std::bit_cast<std::uint32_t>(sample.health_raw[1]),std::bit_cast<std::uint32_t>(sample.health_raw[2]),
+        std::bit_cast<std::uint32_t>(sample.health_raw[3])};
+    std::uint64_t hash=14695981039346656037ull;
+    for(auto word:words)for(unsigned i=0;i<4;++i)
+        hash=(hash^((word>>(24-i*8))&255))*1099511628211ull;
+    return hash;
+}
+}
diff --git a/rpcs3/Emu/Cell/green_rollback_native.h b/rpcs3/Emu/Cell/green_rollback_native.h
new file mode 100644
index 000000000..ab77c096f
--- /dev/null
+++ b/rpcs3/Emu/Cell/green_rollback_native.h
@@ -0,0 +1,439 @@
+#pragma once
+// TTT2 01.03, original EBOOT SHA256 9fb66382...95e55.
+// Title/region policy belongs to the host image gate, not this memory ABI.
+// Read-only, bounded preflight for native 0x354544. This is NOT a complete
+// snapshot closure or an allocation-generation oracle. See adapter_audit.
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <span>
+#include <utility>
+#include <vector>
+
+namespace green_rollback::native
+{
+struct memory
+{
+    void* context{};
+    bool (*read)(void*,std::uint32_t,std::span<std::byte>) noexcept{};
+    bool (*valid)(void*,std::uint32_t,std::uint32_t,bool write) noexcept{};
+};
+enum class status
+{
+    ok, unreadable, out_of_range, invalid_manager, invalid_slot,
+    invalid_snapshot, invalid_actor, null_copy_target, unsupported_getter,
+    unsupported_stage, arithmetic_overflow, limit_exceeded, alias_conflict
+};
+enum coverage : std::uint32_t
+{
+    partial_virtual_stage=1, partial_native_side_effects=2,
+    unproven_allocation_generation=4, conservative_actor_routes=8
+};
+struct range { std::uint32_t address{},size{}; bool operator==(const range&) const = default; };
+struct identity { std::uint32_t address{},value{}; std::uint8_t size{4}; bool operator==(const identity&) const = default; };
+struct owner { std::uint32_t address{},snapshot_first{},snapshot_second{}; bool operator==(const owner&) const = default; };
+struct layout
+{
+    std::uint32_t manager{},slot{},frame{};
+    std::uint32_t coverage{partial_virtual_stage|partial_native_side_effects|unproven_allocation_generation|conservative_actor_routes};
+    std::vector<identity> identities;
+    std::vector<range> saved_sources,live_targets;
+    std::vector<owner> owners;
+};
+struct result { status code{status::ok}; layout value; std::uint32_t address{}; };
+inline constexpr std::uint32_t slot_stride=0x230b0, slot_count=6;
+
+namespace detail
+{
+inline bool bounded(std::uint32_t at,std::uint32_t size) noexcept
+{return at!=0&&size!=0&&std::uint64_t(at)+size<=0x100000000ull;}
+inline bool get(memory m,std::uint32_t at,std::uint32_t& out) noexcept
+{
+    std::array<std::byte,4> b{};
+    if(!bounded(at,4)||!m.read||!m.valid||!m.valid(m.context,at,4,false)||!m.read(m.context,at,b))return false;
+    out=0;for(const auto v:b)out=(out<<8)|std::to_integer<std::uint32_t>(v);return true;
+}
+struct inspector
+{
+    memory m; result out;
+    std::uint32_t slots = slot_count;
+    bool fail(status s,std::uint32_t at) noexcept {if(out.code==status::ok){out.code=s;out.address=at;}return false;}
+    std::uint32_t add(std::uint32_t at,std::uint32_t offset)
+    {
+        if(!at||std::uint64_t(at)+offset>0xffffffffull){fail(status::arithmetic_overflow,at);return 0;}
+        return at+offset;
+    }
+    bool valid(std::uint32_t at,std::uint32_t size,bool write=false)
+    {
+        if(out.code!=status::ok)return false;
+        if(!at)return fail(status::null_copy_target,at);
+        if(!bounded(at,size))return fail(status::arithmetic_overflow,at);
+        if(!m.valid||!m.read||!m.valid(m.context,at,size,write))return fail(status::out_of_range,at);
+        return true;
+    }
+    std::uint32_t word(std::uint32_t at,bool bind=false)
+    {
+        std::uint32_t v=0;if(!valid(at,4))return 0;
+        if(!get(m,at,v)){fail(status::unreadable,at);return 0;}
+        if(bind)out.value.identities.push_back({at,v,4});return v;
+    }
+    std::uint8_t byte(std::uint32_t at,bool bind=false)
+    {
+        std::array<std::byte,1> b{};if(!valid(at,1))return 0;
+        if(!m.read(m.context,at,b)){fail(status::unreadable,at);return 0;}
+        const auto v=std::to_integer<std::uint8_t>(b[0]);
+        if(bind)out.value.identities.push_back({at,v,1});return v;
+    }
+    std::uint32_t ptr(std::uint32_t at,bool required=true)
+    {
+        const auto p=word(at,true);
+        if(required&&!p)fail(status::null_copy_target,at);
+        if(p&&(p&3))fail(status::out_of_range,p);
+        return p;
+    }
+    bool span(std::vector<range>& v,std::uint32_t at,std::uint32_t size,bool write)
+    {
+        if(size>0x1000000)return fail(status::limit_exceeded,at);
+        if(!valid(at,size,write))return false;
+        if(v.size()>=512)return fail(status::limit_exceeded,at);
+        const range r{at,size};if(std::find(v.begin(),v.end(),r)==v.end())v.push_back(r);
+        return true;
+    }
+    bool source(std::uint32_t at,std::uint32_t size){return span(out.value.saved_sources,at,size,false);}
+    bool target(std::uint32_t at,std::uint32_t size){return span(out.value.live_targets,at,size,true);}
+    std::uint32_t resource(std::uint32_t index)
+    {
+        if(index>4){fail(status::unsupported_getter,index);return 0;}
+        const auto r=ptr(0x01726104);
+        auto e=ptr(add(r,0x104+index*4),false);
+        if(!e)e=ptr(add(r,0x114));
+        return e;
+    }
+    std::uint32_t battle()
+    {
+        const auto a=ptr(0x01629628),b=ptr(add(a,0x100));
+        return ptr(add(b,0xdc));
+    }
+    std::uint32_t method(std::uint32_t object,std::uint32_t offset)
+    {
+        const auto vt=ptr(object),opd=ptr(add(vt,offset));
+        const auto code=ptr(opd),toc=ptr(add(opd,4));
+        if(toc!=0x015b10a0&&toc!=0x015c1090)fail(status::unsupported_getter,opd);
+        valid(code,4);return code;
+    }
+    // Only exact, side-effect-free PPC instruction forms are interpreted. No
+    // arbitrary guest code is called. Caller must attest the original image.
+    std::uint32_t leaf(std::uint32_t object,std::uint32_t code,bool constant,status unsupported)
+    {
+        const auto a=word(code,true),b=word(add(code,4),true);
+        const bool zero_extend=b==0x78630020;
+        if(b!=0x4e800020&&(!zero_extend||word(add(code,8),true)!=0x4e800020))
+        {fail(unsupported,code);return 0;}
+        const auto imm=static_cast<std::int16_t>(a&0xffff);
+        if(constant)
+        {
+            if((a&0xffff0000)!=0x38600000||imm<0){fail(unsupported,code);return 0;}
+            return static_cast<std::uint32_t>(imm);
+        }
+        if(imm<0){fail(unsupported,code);return 0;}
+        if((a&0xffff0000)==0x38630000)return add(object,static_cast<std::uint32_t>(imm));
+        if((a&0xffff0000)==0x80630000)return ptr(add(object,static_cast<std::uint32_t>(imm)));
+        fail(unsupported,code);return 0;
+    }
+    template<std::size_t N> bool exact(std::uint32_t code,const std::array<std::uint32_t,N>& expected,status unsupported)
+    {
+        for(std::size_t i=0;i<N;i++)if(word(add(code,static_cast<std::uint32_t>(i*4)),true)!=expected[i])
+            return fail(unsupported,code);
+        return out.code==status::ok;
+    }
+    std::uint32_t stage_size(std::uint32_t stage,std::uint32_t code)
+    {
+        if(code!=0x00b2d310)return leaf(stage,code,true,status::unsupported_stage);
+        // Actual original stage vtables014F8248/014F8280 virtual+24 delegate
+        // to virtual+20. B2D308 at +20 returns 0x138. Do not execute the wrapper.
+        constexpr std::array<std::uint32_t,17> wrapper={
+            0x7c6b1b78,0x7c0802a6,0xf821ff91,0xf8010080,0x812b0000,0x81490020,
+            0x800a0000,0xf8410028,0x7c0903a6,0x804a0004,0x4e800421,0xe8410028,
+            0xe8010080,0x78630020,0x7c0803a6,0x38210070,0x4e800020};
+        if(!exact(code,wrapper,status::unsupported_stage))return 0;
+        return leaf(stage,method(stage,0x20),true,status::unsupported_stage);
+    }
+    bool stage_copy_target(std::uint32_t stage,std::uint32_t code,std::uint32_t size)
+    {
+        if(code!=0x00b2d400)return true; // Unknown virtual destination closure remains partial.
+        constexpr std::array<std::uint32_t,43> restore={
+            0xf821ff61,0x7c0802a6,0xfb410070,0xfb610078,0xfb810080,0xfba10088,
+            0xf80100b0,0x81230000,0x787b0020,0x7c7c1b78,0x7f63db78,0x7c9a2378,
+            0x3bbc0004,0x81690020,0x800b0000,0xf8410028,0x7c0903a6,0x804b0004,
+            0x4e800421,0xe8410028,0x7b440020,0x78650020,0x7ba30020,0x48738895,
+            0xe8410028,0x813c0000,0x7f63db78,0x81690020,0x800b0000,0xf8410028,
+            0x7c0903a6,0x804b0004,0x4e800421,0xe8410028,0xe80100b0,0x78630020,
+            0xeb410070,0x7c0803a6,0xeb610078,0xeb810080,0xeba10088,0x382100a0,
+            0x4e800020};
+        if(!exact(code,restore,status::unsupported_stage))return false;
+        const auto copy_size=leaf(stage,method(stage,0x20),true,status::unsupported_stage);
+        if(copy_size!=size)return fail(status::unsupported_stage,code);
+        return size==0||target(add(stage,4),size);
+    }
+    bool ready(std::uint32_t index)
+    {
+        const auto root=ptr(0x01726120);
+        if(word(add(root,0x334+index*20)))return false;
+        // 5BD928 -> C118B4 (blr): intrusive list at root+index*20+0x10.
+        const auto sentinel=ptr(add(root,0x10+index*20));
+        auto node=ptr(sentinel);
+        for(unsigned count=0;node!=sentinel&&out.code==status::ok;count++)
+        {
+            if(count>=256){fail(status::limit_exceeded,node);return false;}
+            if(byte(add(node,0x1a))||byte(add(node,0x1b)))return true;
+            if(!byte(add(node,0x19))||!byte(add(node,0x18)))return false;
+            node=ptr(node);
+        }
+        return out.code==status::ok;
+    }
+    std::uint32_t matrix(std::uint32_t actor)
+    {
+        if(!byte(0x017262c4,true))return 0x015eab80;
+        bool extra=false;std::uint32_t index=0;
+        if(byte(add(actor,0x1e74),true))index=4;
+        else
+        {
+            index=word(add(actor,0x4c),true);
+            if(index>=4&&index<=7)return 0x015eab80;
+            if(index>11)return 0x015eab80;
+            if(index>=8){extra=true;index=word(add(ptr(add(actor,0xa0)),0x4c),true);}
+        }
+        if(index>4){fail(status::unsupported_getter,actor);return 0;}
+        const auto state=ptr(0x017262c0);
+        const auto id=word(add(state,0x198+index*0xb70));
+        bool loaded=true;
+        if(!extra)loaded=word(add(state,0x140+index*0xb70))==7&&ready(index);
+        if(static_cast<std::int32_t>(id)<0||!loaded)return 0x01726140+(extra?0x140:index*0x40);
+        const auto own=ptr(add(resource(index),extra?0x54:0x50));
+        return leaf(own,method(own,0x30),false,status::unsupported_getter);
+    }
+    std::uint32_t object(std::uint32_t actor)
+    {
+        const bool extra=word(add(actor,0x84),true)!=0;
+        const auto indexed=extra?ptr(add(actor,0xa0)):actor;
+        const auto index=word(add(indexed,0x3dc),true);
+        if(index>4){fail(status::unsupported_getter,index);return 0;}
+        const auto state=ptr(0x017262c0);
+        if(static_cast<std::int32_t>(word(add(state,0x198+index*0xb70)))<0)return 0;
+        const auto own=ptr(add(resource(index),extra?0x54:0x50));
+        return ptr(add(own,0x50));
+    }
+    bool special(std::uint32_t actor)
+    {
+        if(word(add(actor,0x50),true)==0x1b)return true;
+        if(word(add(actor,0x54),true)!=0x31)return false;
+        const auto side=word(add(actor,0x1f00),true);
+        if(side>1){fail(status::unsupported_getter,actor);return false;}
+        const auto b=battle(),mode=word(add(b,0x1c0));
+        // 172668 chooses a different, lazily constructed owner in modes 7/15.
+        if(mode==7||mode==15){fail(status::unsupported_getter,0x00172668);return false;}
+        const auto at=0x016a5c8c+0x10+side*0xfe+0x4c;
+        return (std::uint16_t(byte(at,true))<<8|byte(at+1,true))==3;
+    }
+    std::uint32_t extra_actor(std::uint32_t index)
+    {
+        const auto primary=ptr(0x0163ad98+index*4);
+        const auto alternate=ptr(add(primary,0xac));
+        const bool swapped=word(add(primary,0x1e70),true)==0;
+        for(const auto actor:std::array<std::uint32_t,2>{swapped?alternate:primary,swapped?primary:alternate})
+            if(special(actor)){const auto x=ptr(add(actor,0xa8),false);if(x)return x;}
+        return 0;
+    }
+    bool small_entry(std::uint32_t selected)
+    {
+        // 115A34 selects a 70-byte entry from descriptor+1A0/+1A4.
+        // Actor+110 can itself change (119C44/119C58), so recover candidates
+        // from the OWNED saved primary records, not live selector equality.
+        // Bind concrete live table metadata; mapped same-address allocation
+        // reuse remains covered by unproven_allocation_generation.
+        for (std::uint32_t i = 0; i < 4; ++i)
+        for (const auto offset : {0x88u, 0x90u, 0x110u})
+        {
+            const auto descriptor = word(add(out.value.slot, i * 0x5c80 + offset));
+            if (!descriptor || (descriptor & 3) || descriptor > UINT32_MAX - 0x1a8) continue;
+            std::uint32_t base = 0, count = 0;
+            if (!get(m, descriptor + 0x1a0, base) || !get(m, descriptor + 0x1a4, count)) continue;
+            if (!base || (base & 3) || !count || count > 0x1000000 / 0x70 ||
+                std::uint64_t(base) + std::uint64_t(count) * 0x70 > 0x100000000ull) continue;
+            if (selected < base || (selected - base) % 0x70 || (selected - base) / 0x70 >= count) continue;
+            ptr(descriptor + 0x1a0); word(descriptor + 0x1a4, true);
+            return target(selected, 0x70);
+        }
+        return fail(status::unsupported_getter, selected);
+    }
+    bool actor(std::uint32_t a,std::uint32_t rec,std::uint32_t index,bool extra)
+    {
+        if(!target(a,0x28b0))return false;
+        // Actor+0/+4 are mutable payload, copied by A66588 (A665F4/A6660C),
+        // not a vtable or allocation identity. Root/extra/secondary pointers
+        // and the concrete resource-owner/getter routes are bound separately.
+        // FIX6 rejected a real payload change at primary actor0163D710 here.
+        const auto second=ptr(add(a,0xa4),false);if(second)target(second,0x28b0);
+        const auto matrix_target=matrix(a);
+        // Native stvx aligns down; refuse a misaligned getter result rather
+        // than validating a different span than the one the instruction uses.
+        if(matrix_target&15)fail(status::out_of_range,matrix_target);
+        target(matrix_target,0x40);
+        const auto own=ptr(add(resource(index),extra?0x54:0x50),false);
+        const auto first=ptr(add(rec,extra?0x51ac:0x51a0),false);
+        const auto last=ptr(add(rec,extra?0x51b0:0x51a4),false);
+        if(own)
+        {
+            valid(own,0x70);word(own,true);
+            if(first){source(first,0x3200);target(add(own,0x70),0x3200);}
+            if(last){source(last,0x10a0);target(add(own,0x33c0),0x10a0);}
+            if(!extra)target(add(own,0x60),4);
+            // Host-owned 336-byte supplement / 280-byte numeric subrange.
+            valid(add(own,0x3270),0x150);target(add(own,0x32a0),0x118);
+            out.value.owners.push_back({own,first,last});
+        }
+        const auto obj=object(a),saved=ptr(add(rec,0x51b4),false);
+        if(obj)word(obj,true);
+        if(saved)
+        {
+            if(!obj||!byte(add(obj,0x3c)))return fail(status::null_copy_target,obj);
+            const auto allocation=ptr(add(obj,0x14));
+            if(static_cast<std::int32_t>(word(add(allocation,0x10)))<=0)return fail(status::null_copy_target,obj);
+            const auto destination=ptr(add(obj,0x20));
+            source(saved,0x2a30);target(destination,0x2a30);
+        }
+        if(extra)return out.code==status::ok;
+        if(word(add(a,0x4c),true)>3)return fail(status::null_copy_target,a);
