@@ -0,0 +1,20 @@
+#pragma once
+#include <atomic>
+#include <memory>
+#include <QString>
+
+namespace tag2 {
+// A callback may outlive its panel during Qt event processing. Every active
+// call keeps the same token alive, including the check -> download transition.
+inline std::atomic<unsigned> active_update_operations{0};
+inline bool update_in_progress(){return active_update_operations.load()!=0;}
+inline QString launch_blocked_message(){return QString::fromUtf8("업데이트 작업이 진행 중입니다. 완료된 뒤 게임을 실행해 주세요.");}
+struct LaunchGuard final {
+ std::shared_ptr<void> emulation;
+ std::shared_ptr<void> progress;
+ LaunchGuard(){++active_update_operations;}
+ ~LaunchGuard(){progress.reset();emulation.reset();--active_update_operations;}
+ LaunchGuard(const LaunchGuard&)=delete;
+ LaunchGuard& operator=(const LaunchGuard&)=delete;
+};
+}
