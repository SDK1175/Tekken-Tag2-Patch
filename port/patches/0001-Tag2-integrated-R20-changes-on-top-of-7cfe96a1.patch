+#include "tag2_native_transaction.h"
+#include <QCoreApplication>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QMap>
+#include <QRegularExpression>
+#include <QSaveFile>
+#include <QUuid>
+#include <windows.h>
+#include <tlhelp32.h>
+#include <algorithm>
+namespace tag2 {
+#include "tag2_native_legacy.inc"
+static QString identity(const QString& path){
+ HANDLE h=CreateFileW(reinterpret_cast<LPCWSTR>(QDir::toNativeSeparators(path).utf16()),0,FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_SHARE_DELETE,nullptr,OPEN_EXISTING,FILE_FLAG_BACKUP_SEMANTICS,nullptr);
+ if(h==INVALID_HANDLE_VALUE)throw Failure("Cannot identify path: "+path);
+ wchar_t result[32768];DWORD n=GetFinalPathNameByHandleW(h,result,32768,FILE_NAME_NORMALIZED);CloseHandle(h);
+ if(!n||n>=32768)throw Failure("Cannot resolve installation identity");
+ return QDir::fromNativeSeparators(QString::fromWCharArray(result,n)).toCaseFolded();
+}
+void assert_stopped(const QString& root){
+ const QString target=identity(root)+"/";
+ HANDLE snapshot=CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS,0);if(snapshot==INVALID_HANDLE_VALUE)throw Failure("Cannot inspect running programs");
+ PROCESSENTRY32W entry{};entry.dwSize=sizeof(entry);QString conflict;
+ for(BOOL ok=Process32FirstW(snapshot,&entry);ok;ok=Process32NextW(snapshot,&entry)){
+  if(entry.th32ProcessID==GetCurrentProcessId())continue;
+  const QString name=QString::fromWCharArray(entry.szExeFile).toLower();
+  if(!name.startsWith("rpcs3")&&!name.startsWith("tag2")&&!name.startsWith(QString::fromUtf8("태그2"))&&!name.startsWith("python"))continue;
+  HANDLE process=OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION,FALSE,entry.th32ProcessID);
+  if(!process){if(name.startsWith("rpcs3"))conflict=name;continue;}
+  wchar_t path[32768];DWORD size=32768;const BOOL got=QueryFullProcessImageNameW(process,0,path,&size);CloseHandle(process);
+  if(!got){conflict=name;break;}
+  try{
+   const QString executable=identity(QString::fromWCharArray(path,size));
+   if(!executable.startsWith(target))continue;
+   if(name.startsWith("python")){
+    // An installation may contain independent read-only diagnostic workers.
+    // Only the runtimes used by our native/R2 update tools belong to this guard.
+    const QString relative=executable.mid(target.size());
+    if(relative!="tag2_native/runtime/python.exe"&&relative!="tag2_native/runtime/pythonw.exe"&&
+       relative!="green_ggpo_simple_3f/runtime/python.exe"&&relative!="green_ggpo_simple_3f/runtime/pythonw.exe")continue;
+   }
+   conflict=name;break;
+  }
+  catch(const Failure&){conflict=name;break;}
+ }
+ CloseHandle(snapshot);if(!conflict.isEmpty())throw Failure(QString::fromUtf8("실행 중인 게임/런처를 먼저 종료해 주세요: ")+conflict);
+}
+static HANDLE acquire(const QString& path){
+ safe_absolute(path);if(!QDir().mkpath(QFileInfo(path).absolutePath()))throw Failure("Cannot create updater directory");safe_absolute(path);
+ HANDLE h=CreateFileW(reinterpret_cast<LPCWSTR>(QDir::toNativeSeparators(path).utf16()),GENERIC_READ|GENERIC_WRITE,0,nullptr,OPEN_ALWAYS,FILE_ATTRIBUTE_NORMAL,nullptr);
+ if(h==INVALID_HANDLE_VALUE)throw Failure(QString::fromUtf8("다른 업데이트가 실행 중이거나 폴더에 쓸 수 없습니다."));return h;
+}
+NativeTransaction::NativeTransaction(const QString& r,Progress p):root(QDir(r).absolutePath()),progress(p){
+ safe_absolute(root);assert_stopped(root);
+ legacy_lock=acquire(safe_path(root,".tag2-update/lock"));
+ try{native_lock=acquire(safe_path(root,".tag2-native/lock"));}catch(...){CloseHandle(legacy_lock);legacy_lock=nullptr;throw;}
+}
+NativeTransaction::~NativeTransaction(){if(native_lock)CloseHandle(native_lock);if(legacy_lock)CloseHandle(legacy_lock);}
+static void copy(const QString& from,const QString& to,const QString& expected){
+ safe_absolute(from);safe_absolute(to);if(!QDir().mkpath(QFileInfo(to).absolutePath()))throw Failure("Cannot create destination directory");safe_absolute(to);
+ QFile input(from);QSaveFile output(to);output.setDirectWriteFallback(false);
+ if(!input.open(QIODevice::ReadOnly)||!output.open(QIODevice::WriteOnly))throw Failure("Cannot stage file: "+to);
+ while(!input.atEnd()){const auto block=input.read(1024*1024);if(block.isEmpty()&&input.error()!=QFile::NoError)throw Failure("Cannot read source");if(output.write(block)!=block.size())throw Failure("Cannot write staged file");}
+ if(!output.flush()||!output.commit()||hash_file(to)!=expected)throw Failure("Staged copy verification failed: "+to);
+}
+static QString hash_value(const QJsonValue& v,bool nullable){
+ if(v.isNull()&&nullable)return {};
+ static const QRegularExpression valid("^[0-9a-f]{64}$");
+ if(!v.isString()||!valid.match(v.toString()).hasMatch())throw Failure("Invalid recovery hash");return v.toString();
+}
+static bool old_payload(const QString& p){return legacy_hashes.contains("GREEN_GGPO_SIMPLE_3F/payload/"+p);}
+static void replace(const QString& from,const QString& to,const QString& after,const QString& before,const QString& retired){
+ const QString temporary=to+".tag2-"+QUuid::createUuid().toString(QUuid::Id128)+".tmp";
+ copy(from,temporary,after);safe_absolute(to);
+ if(hash_file(to)!=before){QFile::remove(temporary);throw Failure("Destination changed during replacement");}
+ auto move=[](const QString& a,const QString& b,DWORD flags){return MoveFileExW(reinterpret_cast<LPCWSTR>(QDir::toNativeSeparators(a).utf16()),reinterpret_cast<LPCWSTR>(QDir::toNativeSeparators(b).utf16()),flags);};
+ if(move(temporary,to,MOVEFILE_REPLACE_EXISTING|MOVEFILE_WRITE_THROUGH))return;
+ // Never move the sole launcher out of the way. Updates run from their verified
+ // staged package after the root launcher exits; a denied replace keeps it intact.
+ QFile::remove(temporary);throw Failure("Replacement blocked; verified recovery files retained: "+to);
+}
+void NativeTransaction::recover_one(const QString& pending,const QString& folder,bool native,bool online,bool validate_only){
+ if(!QFileInfo::exists(pending))return;
+ const auto j=strict_json(read_bytes(pending));const QString id=j["transaction_id"].toString();
+ if(j["schema"].toInt()!=1||!QRegularExpression("^[0-9a-f]{32}$").match(id).hasMatch())throw Failure("Invalid recovery identity");
+ const QString tx=safe_path(root,folder+"/"+id),stage=safe_path(tx,"replacement");
+ const QString rows_key=online?"files":"operations";
+ if(!j[rows_key].isArray())throw Failure("Missing recovery operations");
+ auto rows=j[rows_key].toArray();if(rows.size()>512)throw Failure("Recovery entry limit");
+ Package package;QJsonObject legacy_state;QSet<QString> expected;
+ if(native){package=load_package(stage);if(j["release"]!=package.release)throw Failure("Recovery release mismatch");expected=allowed_files();}
+ if(online){
+  hash_value(j["host_sha256"],false);const auto release=j["release"].toObject();
+  if(release["sequence"].toInt()!=2||release["release_id"]!="TAG2-COMMON-20261103-R2")throw Failure("Only the frozen R2 online journal is supported");
+  for(auto i=legacy_hashes.begin();i!=legacy_hashes.end();++i)expected.insert(i.key());
+ }
+ if(!native&&!online){
+  legacy_state=strict_json(read_bytes(safe_path(root,".tag2-update/state.json")));
+  if(legacy_state["schema"].toInt()!=1||!QRegularExpression("^[0-9a-f]{32}$").match(legacy_state["installation_id"].toString()).hasMatch()||j["installation_id"]!=legacy_state["installation_id"]||!j["release"].isString())throw Failure("Legacy installation identity mismatch");
