+// SPDX-License-Identifier: GPL-2.0-only
+// Player Match lobby control. Combat, pad sampling and GGPO replay are untouched.
+#include "stdafx.h"
+#include "TTT2LobbyPass.h"
+#include "TTT2LobbyMessage.h"
+#include "TTT2LobbySnapshot.h"
+#include "TTT2LobbyClient.h"
+#include "TTT2LobbyInbox.h"
+#include "PPUModule.h"
+#include "PPUThread.h"
+#include "PPUFunction.h"
+#include "Emu/IdManager.h"
+#include "Emu/Memory/vm.h"
+#include "Emu/System.h"
+#include "Utilities/ppu_patch.h"
+#include "Crypto/sha256.h"
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <mutex>
+#include <random>
+#include <stdexcept>
+
+LOG_CHANNEL(tag2_lobby_log,"Tag2Lobby");
+extern void ppu_register_range(u32 addr,u32 size);
+extern u32 ppu_get_far_jump(u32 entry);
+
+namespace ttt2_lobby {
+namespace {
+#include "TTT2LobbyContract.inc"
+constexpr u32 network_toc=0x015c1090;
+constexpr u32 send_vtable=0x014fcf78,receive_vtable=0x014fcf48;
+constexpr u32 object_stride=sizeof(guest_object),object_limit=16;
+enum class hook:usz {cleanup,activate,eligibility,room_update,member_event,network_update};
+std::atomic<u64> public_view{0},intent{0},revision_source{1},nonce_counter{1};
+u64 revision(){return revision_source.fetch_add(1,std::memory_order_relaxed)&0x0000ffffffffffffULL;}
+void unavailable(){intent.store(0);public_view.store((revision()<<16)|static_cast<u8>(pass_status::unavailable));}
+u64 nonce(){
+ static const u64 seed=[](){std::random_device random;return (u64{random()}<<32)^random()^static_cast<u64>(std::chrono::steady_clock::now().time_since_epoch().count());}();
+ const auto value=seed^(nonce_counter.fetch_add(1)*0x9e3779b97f4a7c15ULL);return value?value:nonce();
+}
+bool mapped(u32 at,u32 bytes,bool writable=false){return at>=0x10000&&bytes&&u64{at}+bytes<=0x100000000ULL&&vm::check_addr(at,writable?vm::page_writable:vm::page_readable,bytes);}
+u32 word(u32 at){if(!mapped(at,4))throw std::runtime_error("Lobby pointer unavailable");return vm::read32(at);}
+u8 byte(u32 at){if(!mapped(at,1))throw std::runtime_error("Lobby byte unavailable");return *vm::get_super_ptr<u8>(at);}
+
+// Keep nested guest calls on a separate ABI linkage area and restore registers.
+struct registers {
+ ppu_thread& p;std::array<u64,32> gpr;std::array<f64,32> fpr;std::array<v128,32> vr;
+ decltype(ppu_thread::cr) cr;decltype(ppu_thread::fpscr) fpscr;decltype(ppu_thread::xer) xer;
+ u64 ctr,lr;u32 vrsave,jm_mask;bool nj;v128 sat;
+ explicit registers(ppu_thread& cpu):p(cpu),cr(cpu.cr),fpscr(cpu.fpscr),xer(cpu.xer),ctr(cpu.ctr),lr(cpu.lr),vrsave(cpu.vrsave),jm_mask(cpu.jm_mask),nj(cpu.nj),sat(cpu.sat){std::copy_n(p.gpr,32,gpr.begin());std::copy_n(p.fpr,32,fpr.begin());std::copy_n(p.vr,32,vr.begin());}
+ ~registers(){std::copy(gpr.begin(),gpr.end(),p.gpr);std::copy(fpr.begin(),fpr.end(),p.fpr);std::copy(vr.begin(),vr.end(),p.vr);p.cr=cr;p.fpscr=fpscr;p.xer=xer;p.ctr=ctr;p.lr=lr;p.vrsave=vrsave;p.jm_mask=jm_mask;p.nj=nj;p.sat=sat;}
+};
+u64 call(ppu_thread& cpu,u32 entry,std::initializer_list<u64> args){
+ registers saved(cpu);const u64 previous=cpu.gpr[1];
+ if(args.size()>8||previous<0x200||previous>UINT32_MAX||(previous&15))throw std::runtime_error("Lobby call stack unavailable");
+ const u32 stack=static_cast<u32>(previous-0x200);
+ // Match the existing GGPO bridge: native thread stacks have known lower
+ // bounds, while game-managed stacks must have a mapped writable linkage area.
+ const bool in_thread_stack=previous>=cpu.stack_addr&&previous<=u64{cpu.stack_addr}+cpu.stack_size;
+ if((in_thread_stack&&stack<cpu.stack_addr)||!mapped(stack,0x200,true))throw std::runtime_error("Lobby linkage area unavailable");
+ vm::write64(stack,previous);cpu.gpr[1]=stack;std::copy(args.begin(),args.end(),cpu.gpr+3);cpu.fast_call(entry,network_toc);
+ if(cpu.state.all_of(cpu_flag::exit))throw std::runtime_error("Lobby call stopped");return cpu.gpr[3];
+}
+
+void message_type(ppu_thread& cpu){cpu.gpr[3]=application_type;}
+void message_size(ppu_thread& cpu){cpu.gpr[3]=sizeof(wire);}
+void message_destroy(ppu_thread& cpu){cpu.gpr[3]=0;}
+void message_serialize(ppu_thread& cpu){
+ const u32 object=static_cast<u32>(cpu.gpr[3]),dest=static_cast<u32>(cpu.gpr[4]);const u64 capacity=cpu.gpr[5];cpu.gpr[3]=0;
+ if(capacity<sizeof(wire)||!mapped(object,sizeof(guest_object))||!mapped(dest,sizeof(wire),true))return;
+ guest_object local;std::memcpy(&local,vm::get_super_ptr<u8>(object),sizeof(local));
+ cpu.gpr[3]=write_message(local,std::span<u8>(vm::get_super_ptr<u8>(dest),sizeof(wire)));
+}
+void message_deserialize(ppu_thread& cpu){
+ const u32 object=static_cast<u32>(cpu.gpr[3]),source=static_cast<u32>(cpu.gpr[4]);const u64 length=cpu.gpr[5];cpu.gpr[3]=0;
+ if(!mapped(object,sizeof(guest_object),true))return;
+ vm::write32(object+offsetof(guest_object,valid),0);
+ if(length!=sizeof(wire)||!mapped(source,sizeof(wire)))return;
+ guest_object local;std::memcpy(&local,vm::get_super_ptr<u8>(object),sizeof(local));
+ if(!read_message(local,std::span<const u8>(vm::get_super_ptr<u8>(source),sizeof(wire))))return;
+ std::memcpy(vm::get_super_ptr<u8>(object),&local,sizeof(local));cpu.gpr[3]=1;
+}
+const std::array<u32,6> message_indices{REG_HIDDEN_FUNC(message_type),REG_HIDDEN_FUNC(message_size),REG_HIDDEN_FUNC(message_serialize),REG_HIDDEN_FUNC(message_deserialize),REG_HIDDEN_FUNC(message_destroy),REG_HIDDEN_FUNC(message_destroy)};
+
+struct binding {u64 generation=0;u32 manager=0,data=0,controller=0;bool host=false,eligible=false;};
+struct runtime {
+ std::mutex mutex;std::array<u32,hook_pins.size()> original{};u32 storage=0,vtable=0;bool installed=false,disabled=false;
+ message_inbox inbox;std::atomic_flag receiving=ATOMIC_FLAG_INIT;
