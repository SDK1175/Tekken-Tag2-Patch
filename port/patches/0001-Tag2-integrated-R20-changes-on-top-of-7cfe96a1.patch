+ QList<QJsonObject> ordered;for(auto v:rows)ordered.append(v.toObject());
+ std::stable_sort(ordered.begin(),ordered.end(),[](const auto& a,const auto& b){return (a["path"].toString()==manifest_path?1:0)<(b["path"].toString()==manifest_path?1:0);});
