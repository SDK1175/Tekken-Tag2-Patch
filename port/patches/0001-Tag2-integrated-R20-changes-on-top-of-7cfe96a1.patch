diff --git a/rpcs3/rpcs3qt/tag2_lobby_notice.h b/rpcs3/rpcs3qt/tag2_lobby_notice.h
new file mode 100644
index 000000000..9a1c6ebb3
--- /dev/null
+++ b/rpcs3/rpcs3qt/tag2_lobby_notice.h
@@ -0,0 +1,28 @@
+#pragma once
+#include "../Emu/Cell/TTT2LobbyPass.h"
+#include <string_view>
+
+namespace tag2 {
+// Presentation only: no request submission, network access or guest mutation.
+class lobby_notice_model {
+ std::uint64_t revision_=0,first_seen_ms_=0;
+public:
+ std::string_view update(const ttt2_lobby::pass_view& view,bool running,std::uint64_t now_ms){
+  if(!running||!view.installed||!view.revision)return {};
+  if(revision_!=view.revision){revision_=view.revision;first_seen_ms_=now_ms;}
+  using ttt2_lobby::pass_status;
+  if(view.swap_sides&&(view.status==pass_status::approval_needed||view.status==pass_status::approval_wait)){
+   if(now_ms-first_seen_ms_>=10000)return {};
+   if(view.status==pass_status::approval_needed&&view.can_pass&&view.can_cancel)
+    return "상대방이 1P·2P 자리 교환을 요청했습니다.\n동의: Ctrl+Shift+F8\n동의하지 않으면 바뀌지 않으며, 요청은 자동으로 취소됩니다.";
+   if(view.status==pass_status::approval_wait&&view.can_cancel)
+    return "자리 교환을 요청했습니다. 상대방의 동의를 기다리고 있습니다.\n상대방이 동의해야 1P·2P 자리가 바뀝니다.\n취소하려면 RPCS3 실행창의 ‘요청 취소’를 눌러 주세요.";
+  }
+  if(view.status==pass_status::accepted)
+   return view.swap_sides?"서로 동의하여 1P·2P 자리가 바뀌었습니다.":"내 차례를 다음 분께 넘겼습니다.";
+  if(view.status==pass_status::pending&&now_ms-first_seen_ms_<3000)
+   return "요청을 전달하고 있습니다. 잠시 기다려 주세요.";
+  return {};
+ }
+};
+}
diff --git a/rpcs3/rpcs3qt/tag2_lobby_overlay.h b/rpcs3/rpcs3qt/tag2_lobby_overlay.h
new file mode 100644
index 000000000..1a61acbe7
--- /dev/null
+++ b/rpcs3/rpcs3qt/tag2_lobby_overlay.h
@@ -0,0 +1,35 @@
+#pragma once
+#include "tag2_lobby_notice.h"
+#include "Emu/System.h"
+#include "Emu/RSX/Overlays/overlays.h"
+#include <chrono>
+#include <string>
+
+namespace tag2 {
+// Labels are touched only by the RSX render thread. GUI timers merely request
+// a refresh; the current atomic lobby view is rechecked before every drawing.
+class lobby_overlay final : public rsx::overlays::overlay {
+ lobby_notice_model model_;
+ rsx::overlays::label label_;
+ std::string text_;
+public:
+ lobby_overlay(){
+  label_.set_pos(100,24);
+  label_.set_size(1080,112);
+  label_.set_padding(14,14,10,10);
+  label_.set_font("ttt2-hud-malgunbd.ttf",16);
+  label_.set_wrap_text(true);
+  label_.fore_color={1.f,0.96f,0.8f,1.f};
+  label_.back_color={0.06f,0.09f,0.15f,0.94f};
+  visible=true;
+ }
+ rsx::overlays::compiled_resource get_compiled() override {
+  const auto now=std::chrono::steady_clock::now().time_since_epoch();
+  const auto text=model_.update(ttt2_lobby::view(),Emu.IsRunning(),
+   static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(now).count()));
+  if(text.empty())return {};
+  if(text_!=text){text_=text;label_.set_text(text_);}
+  rsx::overlays::compiled_resource result;result.add(label_.get_compiled());return result;
+ }
+};
+}
