+inline unsigned queue_count(const snapshot& s){unsigned count=0;for(auto id:s.queue)if(id>=0)++count;return count;}
+inline bool two_player_room(const snapshot& s){
+ if(!valid_snapshot(s)||queue_count(s)!=2||s.queue[0]<0||s.queue[1]<0)return false;
+ return s.active==((1U<<s.queue[0])|(1U<<s.queue[1]));
+}
+inline bool eligible_sender(const snapshot& s,std::uint32_t local){
+ if(!valid_snapshot(s)||local>=6||s.phase!=1||!(s.active&(1U<<local))||(s.queue[0]!=static_cast<int>(local)&&s.queue[1]!=static_cast<int>(local)))return false;
+ // Keep the automatically READY winner ready; only change selected sides.
+ // Both READY means the native start transition takes precedence.
+ if(two_player_room(s))return s.ready!=s.active;
+ return queue_count(s)>=3&&!(s.ready&(1U<<local));
+}
+inline bool active_offer(const message& m){
+ return m.offer>=1&&m.offer<=6&&two_player_room(m.room)&&m.room.phase==1&&
+  m.room.ready!=m.room.active&&(m.room.active&(1U<<(m.offer-1)));
+}
+inline std::optional<message_kind> action_for(const message& advertisement,std::uint32_t local){
+ if(!advertisement.nonce||!advertisement.epoch||
+  (advertisement.kind!=message_kind::state&&advertisement.kind!=message_kind::accepted)||
+  !eligible_sender(advertisement.room,local))return {};
+ if(!advertisement.offer)return message_kind::request;
+ if(advertisement.kind==message_kind::state&&active_offer(advertisement)&&advertisement.offer!=local+1)return message_kind::confirm;
+ return {};
+}
+inline bool cancellable(const message& advertisement,std::uint32_t local){
+ return advertisement.nonce&&advertisement.epoch&&advertisement.kind==message_kind::state&&
+  active_offer(advertisement)&&eligible_sender(advertisement.room,local);
+}
+inline wire encode(const message& m){
+ wire out{};auto put=[&](unsigned at,unsigned count,std::uint64_t value){for(unsigned i=0;i<count;++i)out[at+count-1-i]=static_cast<std::uint8_t>(value>>(i*8));};
+ put(0,4,application_type);out[4]=protocol_version;out[5]=static_cast<std::uint8_t>(m.kind);
+ put(8,8,m.nonce);put(16,8,m.epoch);put(24,8,m.sequence);put(32,4,m.sender);put(36,4,m.room.phase);
+ for(unsigned i=0;i<6;++i)put(40+2*i,2,static_cast<std::uint16_t>(m.room.queue[i]));
+ out[52]=m.room.active;out[53]=m.room.ready;out[54]=m.offer;put(56,4,m.actor);return out;
+}
+inline std::optional<message> decode(std::span<const std::uint8_t> data){
+ if(data.size()!=64)return {};
+ auto get=[&](unsigned at,unsigned count){std::uint64_t value=0;for(unsigned i=0;i<count;++i)value=(value<<8)|data[at+i];return value;};
+ if(get(0,4)!=application_type||data[4]!=protocol_version||data[5]<1||data[5]>5||data[6]||data[7]||data[55]||get(60,4))return {};
+ message m;m.kind=static_cast<message_kind>(data[5]);m.nonce=get(8,8);m.epoch=get(16,8);m.sequence=get(24,8);m.sender=static_cast<std::uint32_t>(get(32,4));m.room.phase=static_cast<std::uint32_t>(get(36,4));
+ for(unsigned i=0;i<6;++i){const auto id=get(40+i*2,2);m.room.queue[i]=id==0xffff?-1:static_cast<std::int16_t>(id);}
+ m.room.active=data[52];m.room.ready=data[53];m.offer=data[54];m.actor=static_cast<std::uint32_t>(get(56,4));
+ if(!m.nonce||!m.epoch||m.sender>=6||!(m.room.active&(1U<<m.sender))||!valid_snapshot(m.room))return {};
+ if(m.offer&&!active_offer(m))return {};
+ if(m.kind==message_kind::state){if(m.sequence||m.actor!=0xffffffff)return {};}
+ else{
+  if(!m.sequence||m.actor>=6||(m.kind!=message_kind::accepted&&m.actor!=m.sender))return {};
+  if(m.kind==message_kind::request||m.kind==message_kind::accepted){if(m.offer)return {};}
+  else if(!m.offer)return {};
+ }
+ return m;
+}
+class authority {
+ std::uint64_t nonce_=0,epoch_=0;
+ snapshot room_;
+ std::array<std::uint64_t,6> accepted_sequences{};
+ std::uint8_t offer_=0;
+ std::uint64_t offered_at_=0;
+ void bump(){if(epoch_==std::numeric_limits<std::uint64_t>::max()){nonce_=0;epoch_=0;}else if(nonce_)++epoch_;}
+ void clear_offer(){offer_=0;offered_at_=0;}
+ bool matches(const message& request,const snapshot& actual)const{
+  return nonce_&&epoch_&&request.nonce==nonce_&&request.epoch==epoch_&&request.sender<6&&
+   request.actor==request.sender&&request.sequence>accepted_sequences[request.sender]&&
+   valid_snapshot(actual)&&valid_snapshot(request.room)&&same_generation(actual,room_)&&same_selection(request.room,actual);
+ }
+public:
+ void activate(std::uint64_t nonce,const snapshot& room){nonce_=nonce;epoch_=1;room_=room;accepted_sequences={};clear_offer();}
+ void observe(const snapshot& room){
+  for(unsigned i=0;i<6;++i)if(((room_.active^room.active)&(1U<<i))||room_.accounts[i]!=room.accounts[i])accepted_sequences[i]=0;
+  if(!same_generation(room_,room)||(offer_&&room_.ready!=room.ready)){clear_offer();bump();}room_=room;
+ }
+ void departure(std::uint32_t member){if(member<6){accepted_sequences[member]=0;clear_offer();bump();}}
+ message state(std::uint32_t host)const{return {message_kind::state,nonce_,epoch_,0,host,0xffffffff,room_,offer_};}
+ bool propose(const message& request,const snapshot& actual,std::uint64_t now_ms){
+  if(request.kind!=message_kind::request||request.offer||offer_||!matches(request,actual)||
+   !two_player_room(actual)||!eligible_sender(actual,request.sender))return false;
+  accepted_sequences[request.sender]=request.sequence;room_=actual;
+  offer_=static_cast<std::uint8_t>(request.sender+1);offered_at_=now_ms;bump();return true;
+ }
+ bool cancel(const message& request,const snapshot& actual){
+  if(request.kind!=message_kind::cancel||!offer_||request.offer!=offer_||!matches(request,actual)||
+   !two_player_room(actual)||!eligible_sender(actual,request.sender)||actual.ready!=room_.ready)return false;
+  accepted_sequences[request.sender]=request.sequence;clear_offer();bump();return true;
+ }
+ bool expire(std::uint64_t now_ms){
+  if(!offer_||now_ms<offered_at_||now_ms-offered_at_<10000)return false;
+  clear_offer();bump();return true;
+ }
+ std::optional<decision> check(const message& request,const snapshot& actual)const{
+  if(!matches(request,actual)||!eligible_sender(actual,request.sender))return {};
+  if(two_player_room(actual)){
+   if(request.kind!=message_kind::confirm||!offer_||request.offer!=offer_||
+    offer_==request.sender+1||actual.ready!=room_.ready)return {};
+   return decision{1,false};
+  }
+  if(request.kind!=message_kind::request||request.offer||offer_)return {};
+  if(actual.queue[0]==static_cast<int>(request.sender))return decision{1,true};
+  if(actual.queue[1]==static_cast<int>(request.sender))return decision{0,false};return {};
+ }
+ std::optional<message> commit(const message& request,const snapshot& after,std::uint32_t host){
+  if(!check(request,room_)||!valid_snapshot(after)||after.phase!=room_.phase||after.active!=room_.active||after.ready!=room_.ready||after.accounts!=room_.accounts)return {};
+  auto expected=room_.queue;
+  if(two_player_room(room_)){const auto first=expected[0];expected[0]=expected[1];expected[1]=first;}
+  else{
+   expected.fill(-1);unsigned index=0;
+   for(const auto id:room_.queue)if(id>=0&&id!=static_cast<int>(request.sender))expected[index++]=id;
+   expected[index]=static_cast<std::int16_t>(request.sender);
+  }
+  if(after.queue!=expected)return {};
+  accepted_sequences[request.sender]=request.sequence;room_=after;clear_offer();bump();
+  return message{message_kind::accepted,nonce_,epoch_,request.sequence,host,request.sender,room_};
+ }
+};
+}
