diff --git a/rpcs3/rpcs3qt/tag2_native_game.cpp b/rpcs3/rpcs3qt/tag2_native_game.cpp
new file mode 100644
index 000000000..797909f6c
--- /dev/null
+++ b/rpcs3/rpcs3qt/tag2_native_game.cpp
@@ -0,0 +1,38 @@
+#include "tag2_native_panel.h"
+#include <QFileInfo>
+#include <QDir>
+#include <QJsonDocument>
+#include <QJsonArray>
+#include <QRegularExpression>
+#include <QtEndian>
+namespace tag2 {
+QString resolve_game(const QString& p){
+ if(QFileInfo(p).isFile()&&QFileInfo(p).suffix().compare("iso",Qt::CaseInsensitive)==0)return QFileInfo(p).absoluteFilePath();
+ const QString base=QFileInfo(p).isFile()?QFileInfo(p).absolutePath():QDir(p).absolutePath();
+ const QStringList candidates={base,base+"/PS3_GAME",QDir(base).absoluteFilePath("..")};
+ for(const auto& c:candidates)if(QFileInfo::exists(c+"/USRDIR/EBOOT.BIN")&&QFileInfo::exists(c+"/PARAM.SFO")){
+  const auto b=read_bytes(c+"/PARAM.SFO",65536);if(b.size()<20||b.left(4)!=QByteArray("\0PSF",4))continue;
+  auto u32=[&](int offset){return qFromLittleEndian<quint32>(reinterpret_cast<const uchar*>(b.constData()+offset));};
+  const quint32 keys=u32(8),data=u32(12),count=u32(16);if(count>256||20ULL+16ULL*count>quint64(b.size()))continue;
+  for(quint32 i=0;i<count;++i){int off=20+16*i;quint32 key=keys+qFromLittleEndian<quint16>(reinterpret_cast<const uchar*>(b.constData()+off));quint64 value=quint64(data)+u32(off+12);quint32 size=u32(off+4);
+   if(key>=quint32(b.size())||value+size>quint64(b.size())||size>128)continue;
+   int end=b.indexOf('\0',key);if(end<0)continue;
+   if(b.mid(key,end-key)=="TITLE_ID"&&b.mid(value,size).split('\0').first()=="BLES01702")return QDir(c).absolutePath();
+  }
+ }
+ return {};
+}
+QString find_game(const QString& root){
+ for(const QString& file:{"config/games.yml","games.yml"})if(QFileInfo::exists(root+"/"+file)){
+  const auto lines=QString::fromUtf8(read_bytes(root+"/"+file)).split('\n');
+  for(const auto& line:lines){auto m=QRegularExpression("^BLES01702:\\s*(.+?)\\s*$").match(line);if(!m.hasMatch())continue;QString p=m.captured(1);
+   if(p.startsWith('\'')&&p.endsWith('\''))p=p.mid(1,p.size()-2).replace("''","'");
+   else if(p.startsWith('"')&&p.endsWith('"')){auto a=QJsonDocument::fromJson(("["+p+"]").toUtf8()).array();if(a.size()!=1||!a[0].isString())continue;p=a[0].toString();}
+   auto found=resolve_game(QDir::isAbsolutePath(p)?p:QDir(root).filePath(p));if(!found.isEmpty())return found;
+   p=QDir::fromNativeSeparators(p);while(p.endsWith('/'))p.chop(1);
+   found=resolve_game(QDir(root).filePath("games/"+QFileInfo(p).fileName()));if(!found.isEmpty())return found;
+  }
+ }
+ return {};
+}
+}
diff --git a/rpcs3/rpcs3qt/tag2_native_graphics.cpp b/rpcs3/rpcs3qt/tag2_native_graphics.cpp
new file mode 100644
index 000000000..614e4a052
--- /dev/null
+++ b/rpcs3/rpcs3qt/tag2_native_graphics.cpp
@@ -0,0 +1,179 @@
+#include "tag2_native_graphics.h"
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QRegularExpression>
+#include <yaml-cpp/yaml.h>
+namespace tag2 {
+namespace {
+#include "tag2_native_graphics_payload.inc"
+constexpr auto migration_id="TAG2-R13-GRAPHICS-1";
+constexpr auto folder=".tag2-native/graphics-r13/";
+constexpr auto ppu="PPU-8645cfa235c9980ff74b5e06388b29e97fdbbed9";
+constexpr auto patch_name="Fixed 1280x720 dynamic fight rendering";
+const QString global_config="config/config.yml",custom_config="config/custom_configs/config_BLES01702.yml",patch_config="config/patch_config.yml",imported_patch="patches/imported_patch.yml";
+QString script_name(){return QString::fromUtf8("그래픽 설정 원복.cmd");}
+QStringList keys(const QString&kind){
+ if(kind=="shader")return {"Video","Shader Mode"};
+ if(kind=="patch")return {ppu,patch_name,"TEKKEN TAG TOURNAMENT 2","BLES01702","01.03","Enabled"};
+ throw Failure("Unknown graphics setting");
+}
+void validate_yaml(const YAML::Node&node,int depth,qsizetype&count,QList<YAML::Node>&parents){
+ if(++count>1000000||depth>64)throw Failure("Graphics YAML structure limit");
+ if(!node.IsMap()&&!node.IsSequence())return;
+ for(const auto&parent:parents)if(node.is(parent))throw Failure("Cyclic graphics YAML");
+ parents.push_back(node);
+ if(node.IsMap()){
+  QSet<QString>seen;
+  for(const auto&item:node){
+   if(!item.first.IsScalar())throw Failure("Graphics YAML requires scalar mapping keys");
+   const auto key=QString::fromStdString(item.first.Scalar());if(seen.contains(key))throw GraphicsDuplicateKey(QString("Duplicate graphics YAML key: %1 (line %2)").arg(key).arg(item.first.Mark().line+1));seen.insert(key);
+   validate_yaml(item.second,depth+1,count,parents);
+  }
+ }else for(const auto&item:node)validate_yaml(item,depth+1,count,parents);
+ parents.removeLast();
+}
+// YAML aliases share mutable node identity. Reconstruct each occurrence so
+// changing a target leaf never changes an unrelated aliased configuration.
+YAML::Node detach(const YAML::Node&node){
+ if(!node.IsMap()&&!node.IsSequence())return YAML::Clone(node);
+ YAML::Node result(node.Type());result.SetTag(node.Tag());result.SetStyle(node.Style());
+ if(node.IsMap())for(const auto&item:node)result[YAML::Clone(item.first)]=detach(item.second);
+ else for(const auto&item:node)result.push_back(detach(item));
+ return result;
+}
+YAML::Node parse_yaml(const QByteArray&bytes){
+ try{
+  const auto documents=YAML::LoadAll(bytes.toStdString());
+  if(documents.empty())return YAML::Node(YAML::NodeType::Map);
+  if(documents.size()!=1||!documents.front().IsMap())throw Failure("Graphics YAML must contain one mapping document");
+  auto result=documents.front();qsizetype count=0;QList<YAML::Node>parents;validate_yaml(result,0,count,parents);return detach(result);
+ }catch(const YAML::Exception&e){throw Failure("Cannot read graphics YAML: "+QString::fromUtf8(e.what()));}
+}
+QByteArray emit_yaml(const YAML::Node&node){
+ YAML::Emitter out;out.SetIndent(2);out<<node;if(!out.good())throw Failure("Cannot encode graphics YAML");
+ const QByteArray result=QByteArray(out.c_str())+'\n';parse_yaml(result);return result;
+}
+YAML::Node leaf(const YAML::Node&node,const QStringList&path,int index=0){
+ if(!node.IsMap())throw Failure("Graphics setting parent is not a mapping");
+ const auto child=node[path[index].toStdString()];
+ if(!child.IsDefined()||index==path.size()-1)return child;
+ return leaf(child,path,index+1);
+}
+bool set_leaf(YAML::Node node,const QStringList&path,const YAML::Node&value,bool exists,int index=0){
+ if(!node.IsMap())throw Failure("Graphics setting parent is not a mapping");
+ const auto key=path[index].toStdString();const auto current=static_cast<const YAML::Node&>(node)[key];
+ if(index==path.size()-1){
+  if(!exists){if(!current.IsDefined())return false;node.remove(key);return true;}
+  if(current.IsDefined()&&YAML::Dump(current)==YAML::Dump(value))return false;
+  node[key]=YAML::Clone(value);return true;
+ }
+ if(!current.IsDefined()){
+  if(!exists)return false;
+  node[key]=YAML::Node(YAML::NodeType::Map);
+ }else if(!current.IsMap())throw Failure("Graphics setting parent is not a mapping");
+ return set_leaf(node[key],path,value,exists,index+1);
+}
+struct Document{QString path;QByteArray before;YAML::Node node;bool exists=false;bool changed=false;};
+Document document(const QString&root,const QString&path){
+ const auto absolute=safe_path(root,path);const bool exists=QFileInfo::exists(absolute);
+ const auto before=exists?read_bytes(absolute,16LL*1024*1024):QByteArray{};
+ try{return {path,before,exists?parse_yaml(before):YAML::Node(YAML::NodeType::Map),exists,false};}
+ catch(const GraphicsDuplicateKey&e){throw GraphicsDuplicateKey(path+": "+QString::fromUtf8(e.what()));}
+}
+QJsonObject snapshot(const Document&doc,const QString&kind){
+ const auto value=leaf(doc.node,keys(kind));const bool exists=value.IsDefined();
+ if(exists&&!value.IsScalar())throw Failure("Graphics setting value is not a scalar");
+ if(exists&&kind=="patch")try{value.as<bool>();}catch(const YAML::Exception&){throw Failure("Patch Enabled setting is not boolean");}
+ return {{"path",doc.path},{"kind",kind},{"exists",exists},{"yaml",exists?QString::fromStdString(YAML::Dump(value)):QString{}}};
+}
+bool target_path(const QString&path){return path==global_config||path==custom_config||path==patch_config||path==imported_patch||path==script_name();}
+QString store_path(const QString&hash){return QString::fromLatin1(folder)+"store/"+hash+".bin";}
+void store(const QString&root,const QByteArray&bytes){const auto path=safe_path(root,store_path(hash_bytes(bytes)));if(!QFileInfo::exists(path))atomic_write(path,bytes);if(hash_file(path)!=hash_bytes(bytes))throw Failure("Graphics recovery storage changed");}
+bool hash_valid(const QString&hash){return QRegularExpression("^[0-9a-f]{64}$").match(hash).hasMatch();}
+QJsonObject receipt(const QString&root){
+ const auto path=safe_path(root,QString::fromLatin1(folder)+"applied.json");if(!QFileInfo::exists(path))return {};
+ const auto value=strict_json(read_bytes(path));
+ if(value["schema"].toInt()!=1||value["id"]!=migration_id||(value["state"]!="applied"&&value["state"]!="restored")||!value["settings"].isArray())throw Failure("Invalid graphics migration receipt");
+ return value;
+}
+void commit_pending(const QString&root,Progress progress){
+ const auto pending=safe_path(root,QString::fromLatin1(folder)+"pending.json");if(!QFileInfo::exists(pending))return;
+ const auto journal=strict_json(read_bytes(pending));const auto mode=journal["mode"].toString();
+ if(journal["schema"].toInt()!=1||journal["id"]!=migration_id||(mode!="apply"&&mode!="restore")||!journal["operations"].isArray()||!journal["settings"].isArray())throw Failure("Invalid graphics recovery journal");
+ const auto operations=journal["operations"].toArray();if(operations.size()>5)throw Failure("Graphics recovery operation limit");QSet<QString>seen;
+ // Validate every pending operation before committing any more files.
+ for(const auto&entry:operations){
+  if(!entry.isObject())throw Failure("Invalid graphics recovery operation");const auto op=entry.toObject();const auto path=op["path"].toString(),before=op["before"].toString(),after=op["after"].toString();
+  if(!target_path(path)||seen.contains(path)||!op["before"].isString()||(!before.isEmpty()&&!hash_valid(before))||!hash_valid(after))throw Failure("Invalid graphics recovery path/hash");seen.insert(path);
+  if(!before.isEmpty()&&hash_file(safe_path(root,store_path(before)))!=before)throw Failure("Graphics backup verification failed");
+  if(hash_file(safe_path(root,store_path(after)))!=after)throw Failure("Graphics replacement verification failed");
+  const auto current=hash_file(safe_path(root,path));if(current!=before&&current!=after)throw Failure("Graphics setting changed during recovery; backups retained: "+path);
+ }
+ int index=0;
+ for(const auto&entry:operations){const auto op=entry.toObject();const auto path=safe_path(root,op["path"].toString()),after=op["after"].toString();
+  if(hash_file(path)!=after){if(hash_file(path)!=op["before"].toString())throw Failure("Graphics setting changed before commit");atomic_write(path,read_bytes(safe_path(root,store_path(after)),16LL*1024*1024));}
+  if(hash_file(path)!=after)throw Failure("Graphics setting verification failed");
+  if(progress)progress("graphics-file",++index,operations.size());
+ }
+ const QJsonObject done{{"schema",1},{"id",migration_id},{"state",mode=="restore"?"restored":"applied"},{"settings",journal["settings"]}};
+ atomic_write(safe_path(root,QString::fromLatin1(folder)+"applied.json"),QJsonDocument(done).toJson());
+ if(progress)progress("graphics-complete",operations.size(),operations.size());
+ if(!QFile::remove(pending))throw Failure("Cannot finish graphics recovery");
+}
+void prepare(const QString&root,const QString&mode,const QJsonArray&settings,const QList<QPair<Document,QByteArray>>&changes,Progress progress){
+ QJsonArray operations;
+ for(const auto&change:changes){const auto&doc=change.first;const auto&after=change.second;
+  const auto before=doc.exists?hash_bytes(doc.before):QString{};
+  if(hash_file(safe_path(root,doc.path))!=before)throw Failure("Graphics setting changed while preparing");
+  if(doc.exists)store(root,doc.before);store(root,after);
+  operations.push_back(QJsonObject{{"path",doc.path},{"before",before},{"after",hash_bytes(after)}});
+ }
+ // Recheck the whole plan after staging to avoid partially applying stale inputs.
+ for(const auto&entry:operations){const auto op=entry.toObject();if(hash_file(safe_path(root,op["path"].toString()))!=op["before"].toString())throw Failure("Graphics setting changed before journaling");}
+ const QJsonObject journal{{"schema",1},{"id",migration_id},{"mode",mode},{"settings",settings},{"operations",operations}};
+ atomic_write(safe_path(root,QString::fromLatin1(folder)+"pending.json"),QJsonDocument(journal).toJson());
+ if(progress)progress("graphics-prepared",0,operations.size());commit_pending(root,progress);
+}
+}
+void migrate_graphics_locked(const QString&root,Progress progress){
+ commit_pending(root,progress);if(!receipt(root).isEmpty())return;
+ // Parse all current documents before creating a recovery journal or changing settings.
+ auto imported=document(root,imported_patch),enabled=document(root,patch_config),global=document(root,global_config);
+ QList<Document>configs{global};if(QFileInfo::exists(safe_path(root,custom_config)))configs.push_back(document(root,custom_config));
+ const auto shipped=parse_yaml(QByteArray(fixed_graphics_patch));
+ const auto version=static_cast<const YAML::Node&>(imported.node)["Version"];
+ if(version.IsDefined()&&(!version.IsScalar()||version.Scalar()!="1.2"))throw Failure("Unsupported imported patch version");
+ if(!version.IsDefined()){imported.node["Version"]="1.2";imported.changed=true;}
+ const auto existing=leaf(imported.node,{ppu,patch_name});const auto wanted=shipped[ppu][patch_name];
+ if(existing.IsDefined()){
+  if(YAML::Dump(existing)!=YAML::Dump(wanted))throw Failure("A different fixed-resolution patch uses the R13 name; existing definition preserved");
+ }else imported.changed=set_leaf(imported.node,{ppu,patch_name},wanted,true)||imported.changed;
+ QJsonArray settings;settings.push_back(snapshot(enabled,"patch"));
+ enabled.changed=set_leaf(enabled.node,keys("patch"),YAML::Node(true),true);
+ for(auto&cfg:configs){settings.push_back(snapshot(cfg,"shader"));cfg.changed=set_leaf(cfg.node,keys("shader"),YAML::Node("Async with Shader Interpreter"),true);}
+ QList<QPair<Document,QByteArray>>changes;
+ if(imported.changed)changes.push_back({imported,emit_yaml(imported.node)});
+ if(enabled.changed)changes.push_back({enabled,emit_yaml(enabled.node)});
+ for(const auto&cfg:configs)if(cfg.changed)changes.push_back({cfg,emit_yaml(cfg.node)});
+ const auto script=safe_path(root,script_name());const bool script_exists=QFileInfo::exists(script);const auto current_script=script_exists?read_bytes(script):QByteArray{};
+ if(script_exists&&current_script!=QByteArray(graphics_restore_script))throw Failure("Graphics restore script name is already used; existing file preserved");
+ if(!script_exists){Document doc;doc.path=script_name();changes.push_back({doc,QByteArray(graphics_restore_script)});}
+ prepare(root,"apply",settings,changes,progress);
+}
+void restore_graphics_locked(const QString&root,Progress progress){
+ commit_pending(root,progress);const auto previous=receipt(root);if(previous.isEmpty())throw Failure("R13 graphics migration has not run");if(previous["state"]=="restored")return;
+ const auto settings=previous["settings"].toArray();if(settings.isEmpty()||settings.size()>3)throw Failure("Invalid graphics setting snapshots");
+ QList<QPair<Document,QByteArray>>changes;QSet<QString>seen;
+ for(const auto&value:settings){
+  if(!value.isObject())throw Failure("Invalid graphics setting snapshot");const auto setting=value.toObject();const auto path=setting["path"].toString(),kind=setting["kind"].toString();
+  if((kind=="patch"&&path!=patch_config)||(kind=="shader"&&path!=global_config&&path!=custom_config)||(kind!="patch"&&kind!="shader")||seen.contains(path)||!setting["exists"].isBool()||!setting["yaml"].isString())throw Failure("Invalid graphics restore target");seen.insert(path);
+  auto doc=document(root,path);const bool exists=setting["exists"].toBool();YAML::Node prior;
+  if(exists){try{prior=YAML::Load(setting["yaml"].toString().toStdString());}catch(const YAML::Exception&){throw Failure("Invalid prior graphics value");}}
+  if(set_leaf(doc.node,keys(kind),prior,exists))changes.push_back({doc,emit_yaml(doc.node)});
+ }
+ prepare(root,"restore",settings,changes,progress);
+}
+}
