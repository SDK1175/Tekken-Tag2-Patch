+        supplements.poison();
+        local_inputs.poison();
+        remote_inputs.poison();
+        ++rejected;
+        record(reason, frame, detail);
+        record("restore_failure", frame, detail);
+        green_rb_log.fatal("Rollback session stopped: %s at frame %u (detail=0x%llx). See %s", reason, frame, detail, log_path);
+        // RPCS3 fmt::throw_exception terminates the host thread directly; it
+        // cannot unwind a suspend_all rendezvous. Use a real C++ exception,
+        // caught inside this translation unit, to release every CPU first.
+        throw std::runtime_error(fmt::format("롤백 세션을 중단했어: %s; frame %u; diagnostic %s", reason, frame, log_path));
+    }
