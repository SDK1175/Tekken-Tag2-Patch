+    runtime()
+    {
+        const std::string directory = fs::get_config_dir() + "green_rollback/";
+        fs::create_path(directory);
+        const auto stamp = std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::system_clock::now().time_since_epoch()).count();
+        log_path = directory + fmt::format("rollback-%llu.jsonl", static_cast<u64>(stamp));
+        log.open(log_path, fs::rewrite);
+        if (!log) throw std::runtime_error(fmt::format("롤백 진단 파일을 열 수 없어: %s", log_path));
+        record("session_start", 0, 0);
+        green_rb_log.notice("GREEN ONLINE R4 beta: native transport, 5F limit, integrated H7 host. Diagnostic log: %s", log_path);
+    }
+
+    void record(const char* kind, u32 frame, u64 detail, u32 address = 0)
+    {
+        if (!log) return;
+        const std::string line = fmt::format(
+            "{\"event\":\"%s\",\"epoch\":%llu,\"frame\":%u,\"detail\":%llu,"
+            "\"address\":%u,\"manager\":%u,\"net\":%u,\"saves\":%llu,\"restores\":%llu,"
+            "\"resimulated\":%llu,\"predicted\":%llu,\"stalls\":%llu}\n",
+            kind, epoch, frame, detail, address, manager, net, saves, restores, replay_frames, predictions, stalls);
+        log.write(line);
+        if (!std::strcmp(kind, "restore_failure") || !std::strcmp(kind, "session_end")) log.sync();
+    }
+
+    [[noreturn]] void fail(const char* reason, u32 frame, u64 detail = 0)
+    {
