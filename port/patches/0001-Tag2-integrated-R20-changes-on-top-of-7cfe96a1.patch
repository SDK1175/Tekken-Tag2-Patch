+        r.main_vtable=be32(a);r.wrapper=be32(a+4);r.main_mode=be32(a+8);r.main_pending=be32(a+12);
+        const bool warmup=(r.main_mode==32 || r.main_mode==33) && r.main_pending==r.main_mode;
+        if((!warmup && (r.main_mode!=9 || r.main_pending!=9)) || r.main_vtable!=0x14fb0b0
+            || !read_guest(r.wrapper,b,sizeof(b)))return false;
