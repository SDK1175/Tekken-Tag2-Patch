index 000000000..462049a79
--- /dev/null
+++ b/rpcs3/rpcs3qt/tag2_native_retirement.h
@@ -0,0 +1,97 @@
+#pragma once
+#include "tag2_native_package.h"
+#include <QDir>
+#include <QFileInfo>
+#include <QJsonDocument>
+#include <QMap>
+#include <windows.h>
+namespace tag2 {
+namespace retirement_detail {
+inline const QMap<QString,QString>& known(){
+ static const QMap<QString,QString> entries={
+  {"rpcs3-u1.exe",stable_u1},
+  {"rpcs3-ggpo.exe","fd22f386020792a20c17902c0bedf141cd067d34a0aa8e9b1d636a2f0dacb75a"},
+  {"GREEN_GGPO_SIMPLE_3F/launcher/Tag2Entry.exe","06be3abb0fe47ccfec86414536f79e29355d04a6eb909b4e5641dd27541bb2b8"},
+  {"GREEN_GGPO_SIMPLE_3F/launcher/Tag2Launcher.exe","32f761e19c80dbf1787718975755c2cfcc897a216b6c5fa2acaf23a82600ca5d"},
+  {"GREEN_GGPO_SIMPLE_3F/launcher/Tag2Online.exe","3e073650fa5853121cafeab18d8af340acc38537462b70a190c069ef3c5863ad"}
+ };return entries;
+}
+inline QString backup_name(const QString& path,const QString& hash){return ".tag2-native/retired-launchers/v1/"+hash+"/"+path+".bak";}
+inline QString receipt_name(const QString& path){return ".tag2-native/retired-launchers/v1/records/"+hash_bytes(path.toUtf8())+".json";}
+inline QString verified_backup(const QString& root,const QString& path,const QString& expected){
+ if(known().value(path)!=expected||expected.isEmpty())throw Failure("Unrecognized retired launcher");
+ const auto j=strict_json(read_bytes(safe_path(root,receipt_name(path))));
+ const QString backup=backup_name(path,expected);
+ if(j["schema"].toInt()!=1||j["path"]!=path||j["sha256"]!=expected||j["backup"]!=backup||
+    (j["state"]!="backed_up"&&j["state"]!="removed"))throw Failure("Invalid launcher retirement receipt");
+ const auto actual=hash_file(safe_path(root,backup));
+ if(actual!=expected)throw Failure("Retired launcher backup changed: "+path);
+ return actual;
+}
+inline bool recovery_pending(const QString& root){
+ for(const QString& p:{".tag2-native/pending.json",".tag2-native/frames/pending.json",".tag2-native/patches/pending.json",
+                       ".tag2-update/pending.json",".tag2-update/online-pending.json"})
+  if(QFileInfo::exists(safe_path(root,p)))return true;
+ // Old releases used several namespaces. Inspect immediate directories only;
+ // never follow links, modify, or remove any recovery tree.
+ const auto base=safe_path(root,".green-online-backups");
+ for(const auto& info:QDir(base).entryInfoList(QDir::Dirs|QDir::NoDotAndDotDot|QDir::Hidden|QDir::System)){
+  safe_absolute(info.absoluteFilePath());
+  if(QFileInfo::exists(safe_path(root,".green-online-backups/"+info.fileName()+"/active.json")))return true;
+ }
+ return false;
+}
+struct LockedFile{
+ HANDLE handle=INVALID_HANDLE_VALUE;
+ explicit LockedFile(const QString& path){
+  safe_absolute(path);
+  // Defer even for read-only users (e.g. scanners sharing delete). Otherwise
+  // deletion can remain pending and make immediate installed verification fail.
+  handle=CreateFileW(reinterpret_cast<LPCWSTR>(QDir::toNativeSeparators(path).utf16()),GENERIC_READ|DELETE,
+                     0,nullptr,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL,nullptr);
+  if(handle==INVALID_HANDLE_VALUE)throw Failure("Legacy launcher is busy: "+path);
+ }
+ ~LockedFile(){if(handle!=INVALID_HANDLE_VALUE)CloseHandle(handle);}
+ LockedFile(const LockedFile&)=delete;
+ QByteArray bytes(){
+  LARGE_INTEGER length{};
+  if(!GetFileSizeEx(handle,&length)||length.QuadPart<0||length.QuadPart>128LL*1024*1024)throw Failure("Legacy launcher size invalid");
+  QByteArray data(static_cast<qsizetype>(length.QuadPart),Qt::Uninitialized);DWORD read=0;
+  if(!ReadFile(handle,data.data(),static_cast<DWORD>(data.size()),&read,nullptr)||read!=data.size())throw Failure("Cannot read legacy launcher");
+  return data;
+ }
+ void remove(){FILE_DISPOSITION_INFO info{TRUE};if(!SetFileInformationByHandle(handle,FileDispositionInfo,&info,sizeof(info)))throw Failure("Cannot retire legacy launcher");}
+};
+}
+// Installed validation only: downloaded/staged packages still need real files.
+// Only the immutable U1 contract entry can be resolved through a receipt.
+inline QString installed_file_hash(const QString& root,const Entry& e,int sequence){
+ const auto path=safe_path(root,e.path);
+ if(QFileInfo::exists(path)||sequence<17||e.path!="rpcs3-u1.exe"||e.hash!=stable_u1)return hash_file(path);
+ return retirement_detail::verified_backup(root,e.path,e.hash);
+}
+// Caller holds NativeTransaction and has completed recovery and verification.
+// A receipt is durable before removal. Both backed_up and removed states are
+// valid after a crash, but neither can mask an existing modified public file.
+inline QString retire_legacy_launchers_locked(const QString& root){
+ using namespace retirement_detail;
+ if(recovery_pending(root))return QString::fromUtf8("이전 복구가 진행 중이라 구 실행기 정리를 보류했습니다.");
+ int removed=0,kept=0;
+ for(auto it=known().cbegin();it!=known().cend();++it){
+  const auto path=safe_path(root,it.key());
+  if(!QFileInfo::exists(path))continue;
+  LockedFile input(path);const auto bytes=input.bytes();
+  if(hash_bytes(bytes)!=it.value()){++kept;continue;}
+  const auto relative=backup_name(it.key(),it.value()),backup=safe_path(root,relative);
+  if(!QFileInfo::exists(backup))atomic_write(backup,bytes);
+  if(hash_file(backup)!=it.value())throw Failure("Legacy launcher backup collision: "+it.key());
+  QJsonObject record{{"schema",1},{"path",it.key()},{"sha256",it.value()},{"backup",relative},{"state","backed_up"}};
+  const auto receipt=safe_path(root,receipt_name(it.key()));atomic_write(receipt,QJsonDocument(record).toJson());
+  input.remove();record["state"]="removed";atomic_write(receipt,QJsonDocument(record).toJson());++removed;
+ }
+ QStringList notices;
+ if(removed)notices.append(QString::fromUtf8("구 U1/GGPO 실행기 %1개를 백업하고 정리했습니다. rpcs3.exe로 실행해 주세요.").arg(removed));
+ if(kept)notices.append(QString::fromUtf8("배포본과 다른 구 실행기 %1개는 그대로 보존했습니다.").arg(kept));
+ return notices.join('\n');
+}
+}
