diff --git a/3rdparty/ggpo_sync/src/lib/ggpo/ring_buffer.h b/3rdparty/ggpo_sync/src/lib/ggpo/ring_buffer.h
new file mode 100644
index 000000000..9a5d9d6a7
--- /dev/null
