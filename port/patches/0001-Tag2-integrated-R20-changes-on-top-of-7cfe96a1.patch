@@ -0,0 +1,166 @@
+#pragma once
+// Embedded, isolated CPython on ONE owner thread. Never exits the host process.
+// No compile-time Python import library; use the user's pinned local runtime.
+#include <chrono>
+#include <filesystem>
+#include <string>
+#include <thread>
+#include <vector>
+#ifdef _WIN32
+#include <Windows.h>
+#include "ttt2_pyconfig310.h"
+#else
+#include <Python.h>
+#include <dlfcn.h>
+#endif
+namespace ttt2_py
+{
+#ifdef _WIN32
+using object=ttt2_py_abi::object;using thread_state=ttt2_py_abi::thread_state;
+using status=ttt2_py_abi::status;using config=ttt2_py_abi::config;
+using preconfig=ttt2_py_abi::preconfig;using wide_list=ttt2_py_abi::wide_list;
+#else
+using object=PyObject;using thread_state=PyThreadState;using status=PyStatus;
+using config=PyConfig;using preconfig=PyPreConfig;using wide_list=PyWideStringList;
+#endif
+class runtime
+{
+#ifdef _WIN32
+ HMODULE library=nullptr;
+#else
+ void* library=nullptr;
+#endif
+ bool active=false;
+ std::thread::id owner;
+ object* globals=nullptr;object* tick_function=nullptr;
+ const char* (*get_version)()=nullptr;
+ int (*is_initialized)()=nullptr;
+ void (*pre_config)(preconfig*)=nullptr;
+ status (*pre_initialize)(const preconfig*)=nullptr;
+ void (*init_config)(config*)=nullptr;
+ status (*set_string)(config*,wchar_t**,const wchar_t*)=nullptr;
+ status (*append)(wide_list*,const wchar_t*)=nullptr;
+ status (*initialize_config)(const config*)=nullptr;
+ void (*clear_config)(config*)=nullptr;
+ object* (*add_module)(const char*)=nullptr;
+ object* (*get_dict)(object*)=nullptr;
+ object* (*get_attribute)(object*,const char*)=nullptr;
+ int (*callable_check)(object*)=nullptr;
+ object* (*call_object)(object*,object*)=nullptr;
+ object* (*run_string)(const char*,int,object*,object*,void*)=nullptr;
+ void (*decref)(object*)=nullptr;
+ void (*err_clear)()=nullptr;
+ thread_state* (*save_thread)()=nullptr;
+ void (*restore_thread)(thread_state*)=nullptr;
+ int (*finalize)()=nullptr;
+ std::string failure;
+ template<typename T> bool symbol(T& target,const char* name)
+ {
+#ifdef _WIN32
+  target=reinterpret_cast<T>(GetProcAddress(library,name));
+#else
+  target=reinterpret_cast<T>(dlsym(library,name));
+#endif
+  if(!target){failure=std::string("CPython export missing: ")+name;return false;}return true;
+ }
+ bool success(status s)
+ {
