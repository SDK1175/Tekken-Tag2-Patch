+                const auto bootstrap=std::string("import sys, pathlib, traceback\n")+
+                    "_home=pathlib.Path("+ttt2_py::python_path(selected.preferences)+")\n"+
+                    "_code=pathlib.Path("+ttt2_py::python_path(home)+")\n"+
