+            "\"rollback_limit\":%d,\"ggpo_queue_delay\":0,\"input_age_updates\":%lld,\"input_age_us\":%lld,\"input_age_samples\":%llu,\"max_input_age_us\":%llu,"
+            "\"restore_depth\":%u,\"max_restore_depth\":%u,\"snapshot_bytes\":%llu,\"max_snapshot_bytes\":%llu,"
+            "\"save_us\":%llu,\"max_save_us\":%llu,\"load_us\":%llu,\"max_load_us\":%llu,\"replay_us\":%llu,\"max_replay_us\":%llu,"
+            "\"log_dropped\":%llu,\"log_sink_failures\":%llu,\"callback_timing\":\"last_completed_including_encode_enqueue_excluding_async_io\"}\n",
+            event, epoch, inspect_guest && mapped(world_address, 4) ? word(world_address) : last_world, ggpo ? ggpo->frame() : -1,
+            detail, saves, restores, replays, predictions, waits, received, next_id, ggpo ? ggpo->last_remote_frame() : -1,
+            static_cast<u32>(local_inputs.contains(next_id)), static_cast<u32>(remote_inputs.contains(next_id)),
+            native ? word(net + 0x1720) : 0, native ? word(net + 0x28 + 0x1300) : 0,
+            native ? word(net + 0x28 + 0x1608) : 0, native ? byte(net + 0x176c) : 0,
+            source ? word(local + 0x2d0) : absent, source ? word(local + 0x2d4) : absent, static_cast<u32>(inspect_guest), side,
+            rollback_limit, input_timing.last_age_updates, input_timing.last_age_us, input_timing.measured, input_timing.max_age_us,
+            metrics.last_restore_depth, metrics.max_restore_depth, metrics.snapshot_bytes, metrics.max_snapshot_bytes,
+            metrics.last_save_us, metrics.max_save_us, metrics.last_load_us, metrics.max_load_us, metrics.last_replay_us, metrics.max_replay_us,
+            counts.dropped, counts.failures));
+    }
+    void record_preflight(const green_ggpo::native_state::validation_failure& failure, u32 snapshot_frame)
+    {
+        const char* check = green_ggpo::native_state::reason_name(failure.code);
+        if (log_writer)
+        {
+            log_writer->enqueue(fmt::format("{\"event\":\"native_restore_preflight_detail\",\"check\":\"%s\",\"epoch\":%llu,\"side\":%u,"
+                "\"ggpo_frame\":%d,\"snapshot_frame\":%u,\"address\":%u,\"expected\":%u,\"actual\":%u,\"route_changes\":%u}\n",
+                check, epoch, side, ggpo ? ggpo->frame() : -1, snapshot_frame,
+                failure.address, failure.expected, failure.actual, failure.route_changes));
+        }
+        green_rb_log.error("GGPO restore rejected: check=%s address=0x%08x expected=0x%08x actual=0x%08x snapshot=%u epoch=%llu side=%u",
+            check, failure.address, failure.expected, failure.actual, snapshot_frame, epoch, side);
+    }
+    void require(bool ok, const char* reason)
+    { if (!ok) { record(reason); throw green_ggpo::failure(reason); } }
+    bool fight() const { return mapped(0x0165e530, 8) && word(0x0165e530) == 4 && word(0x0165e534) == 4; }
+    bool terminal() const { return word(0x0165e4fc) || static_cast<s32>(word(0x0165e4f8)) > 0; }
+    bool owner(ppu_thread& cpu) const { return thread.load() == cpu.id; }
+    u64 invoke(hook h, std::initializer_list<u64> args)
+    {
+        const bool battle = h == hook::step || h == hook::snapshot;
+        return call_guest(*ppu, original[static_cast<usz>(h)], battle ? battle_toc : network_toc, args);
+    }
+    void end_match()
+    {
+        if (ggpo)
+        {
+            // A completed native step has consumed frame(), but advance/save
+            // has not yet moved GGPO to the next frame at the outer boundary.
+            require(ggpo->last_remote_frame() >= ggpo->frame() - (completed_step ? 0 : 1), "fight_exit_with_unconfirmed_input");
+            observe_result("round_end");
+            record("fight_end"); ggpo.reset(); ++epoch;
+            frame_ids.clear(); local_inputs.clear(); remote_inputs.clear(); queued_frame = -1;
+            input_timing.clear();
+        }
+        manager = snapshot_ring = 0; completed_step = false;
+    }
+    bool combat_context_valid() const
+    {
+        return fight() && word(manager_address) == manager && mapped(manager, 0x60, true) &&
+            snapshot_ring && word(manager + 4) == snapshot_ring && mapped(snapshot_ring, 3 * slot_stride, true);
+    }
+    void waited(const char* reason)
+    {
+        if (++waits == 1 || waits % 120 == 0) record(reason, next_id);
+    }
+    bool bind_network(u32 candidate)
+    {
+        const auto invalid = [&](const char* reason)
+        {
+            const bool active = !!ggpo;
+            if (net || active)
+            {
+                observe_result("transport_state");
+                if (results) results->note("transport_invalid", reason, candidate);
+                record("native_transport_lost"); ggpo.reset(); ++epoch;
+                frame_ids.clear(); local_inputs.clear(); remote_inputs.clear();
+                input_timing.clear();
+                net = local = remote = manager = snapshot_ring = 0; queued_frame = -1; completed_step = false;
+            }
+            result_side_valid = false;
+            // A pending native queue cannot safely fall back after GGPO owned it.
+            require(!active, "active_native_transport_lost");
+            return false;
+        };
+        if (!mapped(candidate, 0x1780)) return invalid("transport_unmapped");
+        const u32 n = candidate + 0x28;
+        if (word(n + 0x12f4) != 2 || word(n + 0x12f8) != 2 || word(n + 0x13b0) > 1) return invalid("transport_status");
+        const auto a = word(n + 0x12dc), b = word(n + 0x12e0);
+        if (a == b || !mapped(a, 0x300) || !mapped(b, 0x300)) return invalid("transport_player_pointer");
+        if (byte(a + 0x2ec) || byte(b + 0x2ec)) return invalid("transport_player_disconnect_flag");
+        if (word(a + 0x2e8) > 1 || word(b + 0x2e8) > 1 || word(a + 0x2e8) == word(b + 0x2e8))
+            return invalid("transport_player_side_mapping");
+        const u32 bound_side = word(a + 0x2e8);
+        if (!result_side_valid || result_net != candidate || result_local != a || result_remote != b || result_side != bound_side)
+        {
+            ++result_connection;
+            result_net = candidate; result_local = a; result_remote = b; result_side = bound_side;
+            result_side_valid = true;
+        }
+        if (net != candidate || local != a || remote != b || side != word(a + 0x2e8))
+        {
+            end_match(); ++epoch; local_inputs.clear(); remote_inputs.clear();
+            input_timing.clear();
+            net = candidate; local = a; remote = b; side = word(a + 0x2e8);
+            record("native_transport_bound", side);
+        }
+        return true;
+    }
+    void insert(std::map<u32, u16>& inputs, u32 id, u16 pad)
+    {
+        if (id > 0x7fffffff) return;
+        const auto [it, added] = inputs.emplace(id, pad);
+        require(added || it->second == pad, "conflicting_native_input");
+        while (inputs.size() > 128) inputs.erase(inputs.begin());
+    }
+    void receipt(u32 pair)
+    {
+        // 584A5C passes its confirmed pair at r1+0x70 to 582934. PPU
+        // stacks are above mapped()'s snapshot/game-object address range.
+        require(pair <= UINT32_MAX - 11 && vm::check_addr(pair, vm::page_readable, 12), "native_input_pair_unmapped");
+        insert(local_inputs, word(pair + side * 4), vm::read16(pair + 8 + side * 2));
+        insert(remote_inputs, word(pair + (1 - side) * 4), vm::read16(pair + 8 + (1 - side) * 2));
+    }
+    u32 skip_announced(u32 id)
+    {
+        const auto first = word(net + 0x28 + 0x13c4), last = word(net + 0x28 + 0x13c8);
+        if (first <= last && last < 0x7fffffff && id >= first && id <= last) id = last + 1;
+        return id;
+    }
+    u32 successor(u32 id)
+    {
+        require(id < 0x7fffffff, "native_source_id_exhausted");
+        return skip_announced(id + 1);
+    }
+    void feed_remote()
+    {
+        if (!ggpo) return;
+        for (const auto& [frame, id] : frame_ids)
+            if (frame > ggpo->last_remote_frame())
+                if (const auto i = remote_inputs.find(id); i != remote_inputs.end()) ggpo->submit_remote(frame, i->second);
+    }
+    void reconcile()
+    {
+        if (!ggpo) return;
+        feed_remote();
+        // Replay borrows selected-input views; ACK/socket queues remain live.
+        std::array<std::byte, 24> selected;
+        require(read_memory(nullptr, net + 0x1740, selected), "selected_input_read_failed");
+        try { ggpo->reconcile(); }
+        catch (...) { write_memory(net + 0x1740, selected); throw; }
+        require(write_memory(net + 0x1740, selected), "selected_input_restore_failed");
+    }
+    bool prepare(u32 id)
+    {
+        require(ggpo && id == next_id, "native_source_timeline_shifted");
+        const auto selected = skip_announced(id);
+        if (selected != id)
+        {
+            require(!frame_ids.contains(ggpo->frame()), "prepared_native_source_skipped");
+            next_id = id = selected; record("native_source_skip", id);
+        }
+        const auto own = local_inputs.find(id);
+        if (own == local_inputs.end()) { waited("wait_local_input"); return false; }
+        reconcile();
+        if (!ggpo->prepare(own->second)) { waited("wait_prediction_limit"); return false; }
+        const auto [key, added] = frame_ids.emplace(ggpo->frame(), id);
+        require(added || key->second == id, "ggpo_frame_rebound");
+        reconcile();
+        return true;
+    }
+    void apply_inputs(const green_ggpo::input& input)
+    {
+        const auto i = frame_ids.find(ggpo->frame());
+        require(i != frame_ids.end(), "replay_source_id_missing");
+        for (u32 p = 0; p < 2; ++p)
+        {
+            vm::write32(net + 0x174c + p * 4, last_input_id);
+            vm::write16(net + 0x1754 + p * 2, last_input[p]);
+            vm::write32(net + 0x1740 + p * 4, i->second);
+            vm::write16(net + 0x1748 + p * 2, input[p]);
+        }
+        last_input = input; last_input_id = i->second;
+    }
+
+    u64 wait_native_step()
+    {
+        require(ggpo && combat_context_valid() && !terminal() &&
+            byte(net + 0x176c) == 0 && last_input_id <= 0x7fffffff &&
+            word(net + 0x1740 + side * 4) == last_input_id && queued_frame != ggpo->frame(),
+            "native_advanced_without_local_input");
+        const int frame = ggpo->frame();
+        const u32 world = word(world_address), source = next_id, previous = last_input_id;
+        const auto previous_input = last_input;
+        require(world == origin + static_cast<u32>(frame), "native_wait_frame_mismatch");
+        std::array<std::byte, 24> selected_before{}, selected_after{};
+        std::array<std::byte, 16> queue_before{}, queue_after{};
+        require(read_memory(nullptr, net + 0x1740, selected_before) &&
+            read_memory(nullptr, net + 0x171c, queue_before), "native_wait_views_unmapped");
+        // CAB40(1) is the game's non-simulating maintenance path. A raw return0
+        // would omit that work. It is allowed only after a failed input selection
+        // which retained the previous IDs; never hide a newly selected input.
+        const auto result = invoke(hook::step, {1});
+        require(ggpo && ggpo->frame() == frame && combat_context_valid() && !terminal() &&
+            word(world_address) == world && next_id == source && last_input_id == previous &&
+            last_input == previous_input && !completed_step && byte(net + 0x176c) == 0 &&
+            read_memory(nullptr, net + 0x1740, selected_after) && selected_after == selected_before &&
+            read_memory(nullptr, net + 0x171c, queue_after) && queue_after == queue_before,
+            "native_wait_changed_timeline");
+        waited("wait_native_step");
+        return result;
+    }
+
+    static bool save_callback(void* context, int frame, std::vector<std::byte>& out)
+    {
+        auto& s = *static_cast<runtime*>(context);
+        const auto begin = green_ggpo::monotonic_us();
+        s.require(s.ppu && mapped(s.manager, 0x60, true) && word(world_address) == s.origin + static_cast<u32>(frame), "save_frame_mismatch");
+        // 354DF0 reads every slot before returning. Checking after that call is
+        // too late when the native frame has already released its buffers.
+        s.require(s.combat_context_valid() && word(s.manager + 8) < 3, "snapshot_context_retired");
+        const u8 was_replay = byte(s.manager + 0x24);
+        put_byte(s.manager + 0x24, 0); // Force full save, never the native replay shortcut.
+        call_guest(*s.ppu, 0x00354df0, battle_toc, {s.manager});
+        put_byte(s.manager + 0x24, was_replay);
+        const u32 index = word(s.manager + 8), ring = word(s.manager + 4);
+        s.require(index < 3 && mapped(ring, 3 * slot_stride), "snapshot_ring_invalid");
+        std::optional<green_ggpo::native_state> snapshot;
+        suspended(*s.ppu, [&] { snapshot = green_ggpo::native_state::capture(memory, s.manager, ring + index * slot_stride, s.epoch); });
+        s.require(snapshot.has_value(), "native_snapshot_not_supported");
+        state_header header{s.epoch, 0x47475031, static_cast<u32>(frame), s.origin, s.last_input_id, s.last_input};
+        out.reserve(sizeof(header) + snapshot->encoded_size());
+        out.resize(sizeof(header)); std::memcpy(out.data(), &header, sizeof(header));
+        snapshot->encode_append(out);
+        if (++s.saves == 1 || s.saves % 300 == 0) s.record("state_saved", frame);
+        s.metrics.saved(begin, out.size());
+        return true;
+    }
+    static bool load_callback(void* context, std::span<const std::byte> bytes)
+    {
+        auto& s = *static_cast<runtime*>(context);
+        const auto begin = green_ggpo::monotonic_us();
+        s.require(bytes.size() > sizeof(state_header), "ggpo_snapshot_truncated");
+        state_header header{}; std::memcpy(&header, bytes.data(), sizeof(header));
+        s.require(header.magic == 0x47475031 && header.epoch == s.epoch && header.origin == s.origin, "ggpo_snapshot_epoch_mismatch");
+        auto image = green_ggpo::native_state::decode(bytes.subspan(sizeof(header)), s.epoch);
+        s.require(image && image->manager_address() == s.manager && image->frame() == s.origin + header.frame, "ggpo_snapshot_invalid");
+        const u32 now = word(world_address);
+        s.require(s.ggpo && now > image->frame() && now - image->frame() <= static_cast<u32>(s.ggpo->prediction_limit()), "native_restore_depth_invalid");
+        const u32 depth = now - image->frame();
+        green_ggpo::native_state::validation_failure failure{};
+        const char* failure_reason = nullptr;
+        const auto check_suspended = [&](bool ok, const char* reason)
+        { if (!ok) { failure_reason = reason; throw green_ggpo::failure(reason); } };
+        const auto report_validation = [&]
+        {
+            if (failure.code != green_ggpo::native_state::validation_code::ok) s.record_preflight(failure, image->frame());
+            else if (failure.route_changes) s.record("native_restore_route_reconciled", failure.route_changes, false);
+        };
+        try
+        {
+            suspended(*s.ppu, [&]
+            {
+            check_suspended(image->validate(memory, &failure), "native_restore_preflight_failed");
+            check_suspended(image->write_buffers(write_memory), "native_snapshot_buffer_restore_failed");
+            const auto index = (image->slot_address() - word(s.manager + 4)) / slot_stride;
+            check_suspended(index < 3, "native_restore_slot_invalid");
+            put_byte(image->slot_address() + 0x230a8, 1);
+            // Native mode1 only adds3 once to a negative index, so it cannot
+            // select depths4..8 safely. Mode0 selects C-1; input histories still
+            // rewind by the full manager+10 depth through native1072F4.
+            vm::write32(s.manager + 0xc, (index + 1) % 3);
+            vm::write32(s.manager + 0x10, depth); put_byte(s.manager + 0x18, 0);
+            });
+        }
+        catch (...)
+        {
+            report_validation();
+            if (failure_reason) s.record(failure_reason, 0, false);
+            throw;
+        }
+        report_validation();
+        call_guest(*s.ppu, 0x00354544, battle_toc, {s.manager});
+        put_byte(s.manager + 0x18, 0); vm::write32(s.manager + 8, word(s.manager + 0xc));
+        bool owner_written = false;
+        suspended(*s.ppu, [&] { owner_written = image->write_owner_numeric(write_memory); });
+        s.require(owner_written, "owner_numeric_restore_failed");
+        s.require(word(world_address) == image->frame(), "native_restore_frame_mismatch");
+        s.last_input_id = header.last_id; s.last_input = header.last_input;
+        ++s.restores; s.record("state_loaded", header.frame);
+        s.metrics.loaded(begin, depth); return true;
+    }
+    static bool advance_callback(void* context, const green_ggpo::input& input)
+    {
+        auto& s = *static_cast<runtime*>(context);
+        const auto begin = green_ggpo::monotonic_us();
+        const u32 before = word(world_address);
+        s.require(before == s.origin + static_cast<u32>(s.ggpo->frame()), "replay_frame_mismatch");
+        s.apply_inputs(input); put_byte(s.manager + 0x24, 1);
+        try
+        {
+            s.invoke(hook::step, {0});
+            put_byte(s.manager + 0x24, 0);
+            // Same post-step calls as the game's native reconciliation loop.
+            s.require(mapped(s.task, 4), "replay_task_missing");
+            const auto table = word(s.task);
+            s.require(mapped(table + 0x4c, 4), "replay_task_vtable_invalid");
+            const auto opd = word(table + 0x4c);
+            s.require(mapped(opd, 8) && mapped(word(opd), 4), "replay_task_method_invalid");
+            if (call_guest(*s.ppu, word(opd), word(opd + 4), {s.task})) call_guest(*s.ppu, 0x003e0548, network_toc, {s.task});
+        }
+        catch (...) { put_byte(s.manager + 0x24, 0); throw; }
+        put_byte(s.manager + 0x24, 0);
+        s.require(word(world_address) == before + 1, "ggpo_replay_did_not_advance");
+        s.metrics.replayed(begin);
+        ++s.replays; return true;
+    }
+    void start_match()
+    {
+        if (!bind_network(net)) return;
+        manager = word(manager_address);
+        if (!mapped(manager, 0x60, true) || !mapped(word(manager + 4), 3 * slot_stride) || word(net + 0x1720)) { manager = 0; return; }
+        const u32 a = word(net + 0x1740), b = word(net + 0x1744);
+        if (a != b || a > 0x7fffffff || word(world_address) < 300 || terminal()) { manager = 0; return; }
+        receipt(net + 0x1740);
+        origin = last_world = word(world_address); next_id = a;
+        snapshot_ring = word(manager + 4);
+        last_input = {vm::read16(net + 0x1754), vm::read16(net + 0x1756)};
+        last_input_id = word(net + 0x174c); frame_ids.clear(); queued_frame = -1;
+        ggpo = std::make_unique<green_ggpo::session>(static_cast<int>(side), green_ggpo::callbacks{this, save_callback, load_callback, advance_callback}, rollback_limit);
+        record("ggpo_match_started", a);
+    }
+
+    u64 dispatch(hook kind, ppu_thread& cpu)
+    {
+        const u32 a = static_cast<u32>(cpu.gpr[3]), b = static_cast<u32>(cpu.gpr[4]);
+        if (kind == hook::frame && !thread.load()) thread.store(cpu.id);
+        if (!owner(cpu))
+            return call_guest(cpu, original[static_cast<usz>(kind)], (kind == hook::step || kind == hook::snapshot) ? battle_toc : network_toc, {a, b});
+        ppu = &cpu;
+        if (kind == hook::frame)
+        {
+            observe_result();
+            ++input_update_count;
+            if (!task) record("frame_hook_entered");
+            if (ggpo && (!combat_context_valid() || word(world_address) < last_world))
+            { end_match(); net = local = remote = 0; }
+            if (ggpo) require(bind_network(net), "frame_transport_not_ready");
+            task = a; completed_step = false;
+            const auto result = invoke(kind, {a});
+            observe_result();
+            // Native post-step work may end combat and free the snapshot ring
+            // before this outer hook returns (FIX3 crashed in this interval).
+            if (ggpo && (!combat_context_valid() || word(world_address) < last_world))
+            { end_match(); net = local = remote = 0; }
+            else if (ggpo && completed_step)
+            {
+                ggpo->advance(); last_world = word(world_address); next_id = successor(next_id); queued_frame = -1;
+                completed_step = false;
+                while (frame_ids.size() > 64) frame_ids.erase(frame_ids.begin());
+            }
+            return result;
+        }
+        if (kind == hook::registration)
+        {
+            const bool bound = bind_network(a);
+            const u32 record_address = bound ? word(a + 0x28 + 0x1308) : 0;
+            const auto result = invoke(kind, {a});
+            if (bound && result && record_address >= local && record_address - local < 36 * 20 && (record_address - local) % 20 == 0)
+            {
+                insert(local_inputs, word(record_address + 12), vm::read16(record_address + 18));
+                input_timing.registered(word(record_address + 12), input_update_count, green_ggpo::monotonic_us());
+            }
+            return result;
+        }
+        if (kind == hook::remote_input)
+        {
+            // 5877FC accepts a decoded network record (r4) into a source node
+            // (r3), with the receive-window base in r5. Only zero is success.
+            // Publish after its complete copy: the native destination ID is
+            // written before its pad bytes, so polling the ring can race it.
+            const auto result = invoke(kind, {a, b, cpu.gpr[5]});
+            if (net && a == remote && result == 0)
+            {
+                // The decoder can supply a packet on the high PPU stack.
+                require(b <= UINT32_MAX - 12 && vm::check_addr(b, vm::page_readable, 12), "remote_packet_unmapped");
+                const u32 id = word(b + 4);
+                require(id <= 0x7fffffff, "accepted_remote_packet_invalid");
+                insert(remote_inputs, id, vm::read16(b + 10));
+                if (++received == 1 || received % 300 == 0) record("remote_input_received", id);
+            }
+            return result;
+        }
+        if (kind == hook::input_update)
+        {
+            if (!bind_network(a)) return invoke(kind, {a, b});
+            if (ggpo) reconcile();
+            const u8 gate = byte(a + 0x1714);
+            if (ggpo) put_byte(a + 0x1714, 1);
+            u64 result;
+            try { result = invoke(kind, {a, b}); }
+            catch (...) { put_byte(a + 0x1714, gate); throw; }
+            put_byte(a + 0x1714, gate);
+            if (result) receipt(a + 0x1740);
+            return result;
+        }
+        if (kind == hook::predict)
+        {
+            if (!ggpo || a != net || b != net + 0x1740 || !fight() || terminal()) return 0;
+            if (queued_frame == ggpo->frame()) return 0;
+            const u32 count = word(net + 0x1720), capacity = word(net + 0x1724), head = word(net + 0x171c), ring = word(net + 0x1728);
+            require(capacity == green_ggpo::native_queue_capacity && count <= capacity && head < capacity && mapped(ring, capacity * 12, true), "native_prediction_queue_invalid");
+            if (count == capacity) { waited("wait_native_queue"); return 0; }
+            if (!prepare(next_id)) return 0;
+            const auto input = ggpo->inputs();
+            const u32 pair = ring + ((head + count) % capacity) * 12;
+            const bool remote_real = remote_inputs.contains(next_id);
+            for (u32 p = 0; p < 2; ++p)
+            {
+                vm::write32(pair + p * 4, p == side || remote_real ? next_id : held);
+                vm::write16(pair + 8 + p * 2, input[p]);
+            }
+            vm::write32(net + 0x1720, count + 1); queued_frame = ggpo->frame();
+            if (++predictions == 1) record("ggpo_prediction_started");
+            return pair;
+        }
+        if (kind == hook::consume && ggpo && a == net)
+        {
+            // Native ACK progression stays; GGPO owns mismatch detection/replay.
+            const u32 count = word(net + 0x1720), head = word(net + 0x171c), ring = word(net + 0x1728);
+            require(b && count > 0 && count <= green_ggpo::native_queue_capacity && word(net + 0x1724) == green_ggpo::native_queue_capacity && head < green_ggpo::native_queue_capacity && mapped(ring, green_ggpo::native_queue_capacity * 12, true), "native_receipt_queue_invalid");
+            receipt(b);
+            const u32 pair = ring + head * 12;
+            require(word(b + side * 4) == word(pair + side * 4), "native_receipt_id_mismatch");
+            vm::write32(pair, absent); vm::write32(pair + 4, absent); vm::write32(pair + 8, 0);
+            vm::write32(net + 0x1720, count - 1); vm::write32(net + 0x171c, (head + 1) % green_ggpo::native_queue_capacity);
+            return 1;
+        }
+        if (kind == hook::correction && ggpo && a + 0x10 == net)
+        { require(bind_network(net), "correction_transport_not_ready"); reconcile(); return umax; }
+        if (kind == hook::snapshot && ggpo && a == manager) return 0;
+        if (kind == hook::step)
+        {
+            if (!ggpo && net && fight() && (a & 255) == 0) start_match();
+            if (!ggpo) return invoke(kind, {a});
+            require(bind_network(net), "step_transport_not_ready");
+            require(fight() && word(manager_address) == manager, "combat_context_changed");
+            if (a & 255) return invoke(kind, {a});
+            require(!completed_step, "multiple_forward_steps_in_one_update");
+            if (!prepare(next_id)) return wait_native_step();
+            require(word(net + 0x1740 + side * 4) == next_id, "native_selected_source_mismatch");
+            const u32 before = word(world_address);
+            require(before == origin + static_cast<u32>(ggpo->frame()), "forward_frame_mismatch");
+            apply_inputs(ggpo->inputs());
+            input_timing.consumed(next_id, input_update_count, green_ggpo::monotonic_us());
+            const auto result = invoke(kind, {a});
+            require(word(world_address) == before + 1, "ggpo_forward_did_not_advance");
+            completed_step = true; return result;
+        }
+        return invoke(kind, {a, b});
+    }
+};
+std::unique_ptr<runtime> session;
+
+template <hook Kind> u64 dispatch_hook(ppu_thread& ppu)
+{
+    const auto report_error = [&](const char* reason)
+    {
+        if (session) session->poisoned.store(true);
+        try
+        {
+            if (session) session->record("session_failure", sites[static_cast<usz>(Kind)].address, false);
+            if (session && session->results) session->results->note("session_failure", reason, sites[static_cast<usz>(Kind)].address);
+            green_rb_log.error("GGPO stopped: %s; hook 0x%x. %s", reason, sites[static_cast<usz>(Kind)].address, session ? session->log_path : "no session");
+        }
+        catch (...) {} // Failure reporting must not bypass PPU exit/queued teardown.
+    };
+    try
+    {
+        if (!session || session->poisoned.load()) throw green_ggpo::failure("GGPO session unavailable");
+        return session->dispatch(Kind, ppu);
+    }
+    catch (const green_ggpo::failure& error) { report_error(error.what()); }
+    catch (const std::exception& error) { report_error(error.what()); }
+    catch (...)
+    {
+        if (session) session->poisoned.store(true);
+        try
+        {
+            if (session) session->record("unknown_session_failure", sites[static_cast<usz>(Kind)].address, false);
+            if (session && session->results) session->results->note("session_failure", "unknown_callback_failure", sites[static_cast<usz>(Kind)].address);
+            green_rb_log.error("GGPO stopped after an unknown callback failure");
+        }
+        catch (...) {}
+    }
+    ppu.state += cpu_flag::exit;
+    if (!session || !session->stop_queued.exchange(true)) Emu.CallFromMainThread([] { Emu.Kill(false); });
+    return 0;
+}
+const std::array<u32, sites.size()> indices{
+    REG_HIDDEN_FUNC(dispatch_hook<hook::frame>), REG_HIDDEN_FUNC(dispatch_hook<hook::step>),
+    REG_HIDDEN_FUNC(dispatch_hook<hook::input_update>), REG_HIDDEN_FUNC(dispatch_hook<hook::predict>),
+    REG_HIDDEN_FUNC(dispatch_hook<hook::consume>), REG_HIDDEN_FUNC(dispatch_hook<hook::registration>),
+    REG_HIDDEN_FUNC(dispatch_hook<hook::correction>), REG_HIDDEN_FUNC(dispatch_hook<hook::snapshot>),
+    REG_HIDDEN_FUNC(dispatch_hook<hook::remote_input>)};
+}
+void request_launch_mode(netcode_mode mode) { mode_selection.request(mode); }
+netcode_mode launch_mode() { return mode_selection.preference(); }
+void set_mode(netcode_mode mode) { start_failed = false; start_error.clear(); mode_selection.effective(mode); }
+netcode_mode get_mode() { return mode_selection.effective(); }
+bool boot_failed() { return start_failed; }
+const std::string& boot_error() { return start_error; }
+void note_exit(const char* event, int elapsed_ms, int signal_read) noexcept
+{
+    // UI/system paths may run without the VM lock. Use immutable last-observed
+    // fields, never guest memory or the combat runtime from these threads.
+    if (const auto journal = active_result_journal.load()) journal->note(event, "", 0, elapsed_ms, signal_read);
+}
+void stop()
+{
+    try { if (session) session->record("session_end", 0, false); }
+    catch (...) {} // Diagnostics must not prevent session destruction.
+    session.reset(); mode_selection.stop();
+}
+static void install_native_receive_guard_checked(std::vector<u32>& applied)
+{
+    // The fixed-size native receive arena is shared by Delay and Rollback.
+    // Unrelated titles/versions and saved-state loading retain their behavior.
+    if (Emu.GetTitleID() != "BLES01702" || (Emu.GetAppVersion() != "01.03" && Emu.GetAppVersion() != "1.03") ||
+        Emu.GetExecutableHash() != "PPU-8645cfa235c9980ff74b5e06388b29e97fdbbed9" || Emu.DeserialManager())
+        return;
+    using namespace receive_guard;
+    if (!mapped(contract_address, contract_size) || !mapped(hook_address, 4, true))
+        throw green_ggpo::failure("Tag2 native receive code is unavailable");
+    std::array<u8, 32> digest{};
+    if (mbedtls_sha256_ret(vm::get_super_ptr<u8>(contract_address), contract_size, digest.data(), 0) != 0 ||
+        digest != contract_digest || word(hook_address) != displaced)
+        throw green_ggpo::failure("Tag2 native receive code contract conflict");
+    // Far jumps may be registered without modifying the underlying opcode.
+    for (u32 address = contract_address; address < contract_address + contract_size; address += 4)
+        if (ppu_get_far_jump(address) || std::find(applied.begin(), applied.end(), address) != applied.end())
+            throw green_ggpo::failure(fmt::format("Tag2 native receive hook conflict at 0x%x", address));
+    applied.reserve(applied.size() + 1);
+    g_fxo->need<ppu_patch_block_registry_t>();
+    auto& blocks = g_fxo->get<ppu_patch_block_registry_t>().block_addresses;
+    blocks.reserve(blocks.size() + 1);
+    const auto map = vm::get(vm::any, hook_address);
+    const u32 code = map ? map->alloc(0x10000, nullptr, 0x10000, vm::alloc_executable) : 0;
+    if (!code) throw green_ggpo::failure("Tag2 native receive guard allocation failed");
+    ppu_register_range(code, 0x10000);
+    for (usz i = 0; i < instructions.size(); ++i)
+        vm::write32(code + static_cast<u32>(i) * 4, instructions[i]);
+    if (!ppu_form_branch_to_code(hook_address, code, false, false))
+        throw green_ggpo::failure("Tag2 native receive guard installation failed");
+    blocks.insert(hook_address);
+    applied.push_back(hook_address);
+    green_rb_log.notice("Tag2 native receive capacity guard installed (100 slots)");
+}
+static void install_hooks_checked(std::vector<u32>& applied)
+{
+    if (get_mode() != netcode_mode::rollback) return;
+    if (Emu.GetTitleID() != "BLES01702" || (Emu.GetAppVersion() != "01.03" && Emu.GetAppVersion() != "1.03") ||
+        Emu.GetExecutableHash() != "PPU-8645cfa235c9980ff74b5e06388b29e97fdbbed9" || Emu.DeserialManager())
+        throw green_ggpo::failure("GGPO requires a fresh BLES01702 v1.03 boot");
+    if (session) throw green_ggpo::failure("Previous GGPO session was not stopped");
+    for (const auto& site : sites)
+        if (!mapped(site.address, 4) || word(site.address) != site.opcode || ppu_get_far_jump(site.address))
+            throw green_ggpo::failure(fmt::format("GGPO code contract conflict at 0x%x", site.address));
+    for (const auto& patch : green_ggpo::queue_patches)
+        if (!mapped(patch.address, 4, true) || word(patch.address) != patch.expected || ppu_get_far_jump(patch.address))
+            throw green_ggpo::failure(fmt::format("GGPO queue constructor conflict at 0x%x", patch.address));
+    applied.reserve(applied.size() + sites.size() + green_ggpo::queue_patches.size());
+    // Snapshot serializer ring remains3. Only the original input-pair queue
+    // constructor allocates8; original capacity-driven reset/free retains ownership.
+    session = std::make_unique<runtime>();
+    const auto map = vm::get(vm::any, 0x000cab40);
+    const u32 code = map ? map->alloc(0x10000, nullptr, 0x10000, vm::alloc_executable) : 0;
+    if (!code) throw green_ggpo::failure("GGPO native call trampoline allocation failed");
+    ppu_register_range(code, 0x10000);
+    for (usz i = 0; i < sites.size(); ++i)
+    {
+        const auto& site = sites[i];
+        const u32 trampoline = code + static_cast<u32>(i) * 16;
+        vm::write32(trampoline, site.opcode);
+        vm::write32(trampoline + 4, 0x48000002 | (site.address + 4)); // ba preserves LR/TOC
+        const u32 target = g_fxo->get<ppu_function_manager>().func_addr(indices[i], true);
+        if (!target || !ppu_form_branch_to_code(site.address, target, false, false))
+            throw green_ggpo::failure(fmt::format("GGPO hook install failed at 0x%x", site.address));
+        session->original[i] = trampoline;
+        g_fxo->need<ppu_patch_block_registry_t>();
+        g_fxo->get<ppu_patch_block_registry_t>().block_addresses.insert(site.address);
+        applied.push_back(site.address);
+    }
+    usz queue_applied = 0;
+    try
+    {
+        for (const auto& patch : green_ggpo::queue_patches)
+        {
+            vm::write32(patch.address, patch.replacement);
+            ++queue_applied;
+            applied.push_back(patch.address);
+        }
+        session->record("hooks_installed", sites.size() + queue_applied);
+    }
+    catch (...)
+    {
+        while (queue_applied)
+        {
+            const auto& patch = green_ggpo::queue_patches[--queue_applied];
+            vm::write32(patch.address, patch.expected);
+            applied.pop_back();
+        }
+        throw;
+    }
+}
+bool install_hooks(std::vector<u32>&)
+{
+    // Leave the original native receive/input/queue code untouched. This also
+    // omits the GGPO-era receive capacity guard formerly shared with Delay.
+    // PPUModule installs the independent lobby controls after this returns.
+    set_mode(netcode_mode::delay);
+    return true;
+}
+}
