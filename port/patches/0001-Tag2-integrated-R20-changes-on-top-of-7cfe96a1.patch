+struct runtime
+{
+    std::string log_path;
+    std::shared_ptr<diagnostic_lifetime> log_lifetime;
+    std::unique_ptr<bounded_file_sink> log_sink;
+    std::unique_ptr<async_log_writer> log_writer;
