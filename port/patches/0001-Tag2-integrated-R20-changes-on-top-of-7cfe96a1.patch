+  if(parser.isSet("tag2-graphics-restore")){
+   if(parser.isSet("tag2-apply")||parser.isSet("tag2-recover")||parser.isSet("tag2-frame-apply"))throw Failure("Conflicting graphics restore request");
+   const auto restore_root=QFileInfo(parser.value("tag2-graphics-restore")).absoluteFilePath();
+   NativeTransaction tx(restore_root);tx.recover();tx.recover_legacy();
+   const auto installed=parse_package(read_bytes(safe_path(restore_root,manifest_path)));verify_installed(restore_root,installed);
+   if(installed.sequence<13)throw Failure("Graphics restore requires an R13 installation");
+   restore_graphics_locked(restore_root);std::fprintf(stdout,"Previous graphics settings restored. R13 remains installed.\n");result=0;return true;
+  }
+  const bool installing=parser.isSet("tag2-apply"),recovering=parser.isSet("tag2-recover"),frames=parser.isSet("tag2-frame-apply");if(int(installing)+int(recovering)+int(frames)>1)throw Failure("Conflicting update requests");
+  const QString root=(installing||recovering)?QFileInfo(parser.value(installing?"tag2-apply":"tag2-recover")).absoluteFilePath():QCoreApplication::applicationDirPath();
+  if(installing)validate_update_stage(root,QCoreApplication::applicationDirPath());
+  if(installing||recovering||frames||parser.isSet("tag2-parent-pid")||parser.isSet("tag2-parent-created"))wait_for_parent(root,parser.value("tag2-parent-pid"),parser.value("tag2-parent-created"));
+  QCoreApplication::instance()->setProperty("tag2.resume",parser.isSet("tag2-resume-rollback"));
