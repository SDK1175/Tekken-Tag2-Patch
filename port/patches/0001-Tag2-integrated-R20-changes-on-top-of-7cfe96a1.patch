+#include <QApplication>
+#include <QMessageBox>
+#include <QPushButton>
+#include <QPointer>
+#include <vector>
+
+namespace tag2 {
+class UpdateUiGuard final {
+ std::vector<QPointer<QWidget>> enabled_windows;
+public:
+ UpdateUiGuard(){for(auto* window:QApplication::topLevelWidgets())if(window->isEnabled()){enabled_windows.emplace_back(window);window->setEnabled(false);}}
+ ~UpdateUiGuard(){for(const auto& window:enabled_windows)if(window)window->setEnabled(true);}
+ UpdateUiGuard(const UpdateUiGuard&)=delete;
+ UpdateUiGuard& operator=(const UpdateUiGuard&)=delete;
+};
+inline bool block_update_launch(QWidget* parent=nullptr){
+ if(!update_in_progress())return false;
+ for(auto* window:QApplication::topLevelWidgets())if(window->objectName()=="tag2UpdateProgress"){window->raise();window->activateWindow();return true;}
+ for(auto* window:QApplication::topLevelWidgets())if(window->objectName()=="tag2LaunchBlocked"){window->raise();return true;}
+ auto* message=new QMessageBox(QMessageBox::Information,QString::fromUtf8("태그2 업데이트"),launch_blocked_message(),QMessageBox::Ok,parent);
+ message->setObjectName("tag2LaunchBlocked");message->setAttribute(Qt::WA_DeleteOnClose);message->button(QMessageBox::Ok)->setText(QString::fromUtf8("확인"));message->open();
+ return true;
+}
+}
