+template <class F> void suspended(ppu_thread& ppu, F&& operation)
+{
+    std::exception_ptr failure;
+    // A VM writer may be waiting for this PPU before it can acknowledge pause.
+    // Release the passive lock AND publish wait (a writer may have cached our
+    // pointer). A caller with wait set must use the null-owner rendezvous path.
+    vm::temporary_unlock(ppu);
+    cpu_thread::suspend_all(nullptr, {}, [&]
+    {
+        try { operation(); } catch (...) { failure = std::current_exception(); }
+    });
+    // Reacquire the passive VM lock and handle pause/stop before guest access,
+    // including callback failures. Never unwind through suspend_work::push.
+    const bool stopped = ppu.check_state();
+    if (failure) std::rethrow_exception(failure);
+    if (stopped) throw green_ggpo::failure("GGPO snapshot aborted");
+}
+
+// fast_call alone does not save argument registers or the caller's linkage area.
+struct guest_registers
+{
+    ppu_thread& ppu;
+    std::array<u64, 32> gpr;
+    std::array<f64, 32> fpr;
+    std::array<v128, 32> vr;
+    decltype(ppu.cr) cr;
+    decltype(ppu.fpscr) fpscr;
+    decltype(ppu.xer) xer;
+    u64 ctr, lr;
+    u32 vrsave, jm_mask;
+    bool nj;
+    v128 sat;
+    explicit guest_registers(ppu_thread& p) : ppu(p), cr(p.cr), fpscr(p.fpscr), xer(p.xer),
+        ctr(p.ctr), lr(p.lr), vrsave(p.vrsave), jm_mask(p.jm_mask), nj(p.nj), sat(p.sat)
+    { std::copy_n(p.gpr, 32, gpr.begin()); std::copy_n(p.fpr, 32, fpr.begin()); std::copy_n(p.vr, 32, vr.begin()); }
+    ~guest_registers()
+    {
+        std::copy(gpr.begin(), gpr.end(), ppu.gpr); std::copy(fpr.begin(), fpr.end(), ppu.fpr); std::copy(vr.begin(), vr.end(), ppu.vr);
+        ppu.cr = cr; ppu.fpscr = fpscr; ppu.xer = xer; ppu.ctr = ctr; ppu.lr = lr;
+        ppu.vrsave = vrsave; ppu.jm_mask = jm_mask; ppu.nj = nj; ppu.sat = sat;
+    }
+};
+u64 call_guest(ppu_thread& ppu, u32 entry, u32 toc, std::initializer_list<u64> args)
+{
+    guest_registers saved(ppu);
+    const u64 caller_stack = ppu.gpr[1];
+    if (args.size() > 8 || caller_stack < 0x200 || caller_stack > UINT32_MAX || (caller_stack & 15))
+        throw green_ggpo::failure("GGPO native call stack invalid");
+    const u32 stack = static_cast<u32>(caller_stack - 0x200);
+    // mapped() intentionally limits serializer/game objects to low memory.
+    // PPU stacks live at 0xd0000000 and must use the full guest VM address space.
+    const bool in_thread_stack = caller_stack >= ppu.stack_addr && caller_stack <= u64{ppu.stack_addr} + ppu.stack_size;
+    if ((in_thread_stack && stack < ppu.stack_addr) || !vm::check_addr(stack, vm::page_writable, 0x200))
+        throw green_ggpo::failure("GGPO native call stack invalid");
+    vm::write64(stack, ppu.gpr[1]); ppu.gpr[1] = stack;
+    std::copy(args.begin(), args.end(), ppu.gpr + 3);
+    ppu.fast_call(entry, toc);
+    if (ppu.state.all_of(cpu_flag::exit)) throw green_ggpo::failure("GGPO native call aborted");
+    return ppu.gpr[3];
+}
