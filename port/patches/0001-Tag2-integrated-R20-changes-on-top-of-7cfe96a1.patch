+        net = candidate;
+        local = a;
+        remote = b;
+        return true;
+    }
+
+    frame_image* image_for(u32 slot)
+    {
+        if (slot < ring || (slot - ring) % slot_size || (slot - ring) / slot_size >= snapshot_count) return nullptr;
+        auto& image = snapshots[(slot - ring) / slot_size];
+        return image.valid && image.epoch == epoch ? &image : nullptr;
+    }
+
+    bool prediction_ready(u32 candidate)
+    {
+        if (!active || poisoned || !guard.can_predict() || !fight() || terminal() || !network(candidate)) return false;
+        const u32 frame = read32(frame_address);
+        if (frame < 300 || read8(manager + 0x18) || read8(manager + 0x24)) return false;
+        if (read32(net + 0x1724) != max_prediction || read32(net + 0x171c) >= max_prediction ||
+            read32(net + 0x1720) >= max_prediction || !mapped(read32(net + 0x1728), max_prediction * 12, true)) return false;
+        const u32 index = read32(manager + 8);
+        if (index >= snapshot_count) return false;
+        const u32 slot = ring + index * slot_size;
+        const frame_image* image = image_for(slot);
+        return image && read8(slot + 0x230a8) && image->layout.frame + 1 == frame;
+    }
+
+    std::optional<id_interval> skip_interval() const
+    {
+        const u32 first = read32(net + 0x28 + 0x13c4), last = read32(net + 0x28 + 0x13c8);
+        if (first <= last && last <= max_frame) return id_interval{first, last};
+        return {};
+    }
+
+    bool next_source(u32 previous, u32& next) const
+    {
+        if (!next_frame(previous, next)) return false;
+        if (const auto skip = skip_interval(); skip && next >= skip->first && next <= skip->last)
+            return next_frame(skip->last, next);
+        return true;
+    }
+
+    void ingest(input_timeline& timeline, u32 node)
+    {
+        const auto data = decode_native_source(std::span(vm::get_super_ptr<const std::byte>(node), source_record_count * source_record_bytes));
+        if (data.code != errc::ok) fail("invalid_input_record", read32(frame_address), node);
+        for (usz i = 0; i < data.count; ++i)
+        {
+            const errc error = timeline.insert(epoch, data.records[i]);
+            if (error == errc::conflicting_input) fail("conflicting_authoritative_input", read32(frame_address), data.records[i].id);
+        }
+    }
+
+    bool predict(ppu_thread& ppu)
+    {
+        if (!active || !network(static_cast<u32>(ppu.gpr[3]))) return false;
+        u32 result = 0;
+        with_suspended(ppu, [&]
+        {
+            if (!prediction_ready(net)) { ++stalls; return; }
+            const u32 frame = read32(frame_address), pending = read32(net + 0x1720);
+            if (predicted_at == frame || static_cast<u32>(ppu.gpr[4]) != net + 0x1740) return;
+            u32 target = read32(local + 0x2d4);
+            for (u32 i = 0; i <= pending; ++i) if (!next_source(target, target)) return;
+            // Local records are admitted only at the post-registration hook.
+            const auto own = local_inputs.resolve(epoch, target, skip_interval());
+            if (own.code != errc::ok || own.predicted) { ++stalls; return; }
+            ingest(remote_inputs, remote);
+            const auto peer = remote_inputs.resolve(epoch, target, skip_interval());
+            if (peer.code != errc::ok) { ++stalls; return; }
+            const u32 side = read32(local + 0x2e8);
+            const u32 ids[2] = {side ? (peer.predicted ? held_id : target) : target,
+                                side ? target : (peer.predicted ? held_id : target)};
+            const u32 pads = side ? (u32{peer.value.pad} << 16) | own.value.pad : (u32{own.value.pad} << 16) | peer.value.pad;
+            const u32 address = read32(net + 0x1728) + ((read32(net + 0x171c) + pending) % max_prediction) * 12;
+            vm::write32(address, ids[0]);
+            vm::write32(address + 4, ids[1]);
+            vm::write32(address + 8, pads);
+            std::atomic_thread_fence(std::memory_order_release);
+            vm::write32(net + 0x1720, pending + 1);
+            result = address;
+            predicted_at = frame;
+            ++predictions;
+        });
+        ppu.gpr[3] = result;
+        ppu.cia = static_cast<u32>(ppu.lr) & ~3u;
+        return true;
+    }
+
+    void owner_save(ppu_thread& ppu)
+    {
+        if (!active || !full_save) return;
+        const u32 owner = static_cast<u32>(ppu.gpr[4]) - 0x70;
+        const u32 buffer = static_cast<u32>(ppu.gpr[3]);
+        if (static_cast<u32>(ppu.gpr[25]) != save_slot || !mapped(owner, 0x4460) || !mapped(buffer, 0x3200, true))
+            fail("owner_capture_invalid", read32(frame_address), owner);
+        owner_image image;
+        image.owner = owner;
+        image.source_buffer = buffer;
+        with_suspended(ppu, [&] { std::memcpy(image.gap.data(), vm::get_super_ptr<u8>(owner + 0x3270), image.gap.size()); });
+        const auto old = std::find_if(saving_owners.begin(), saving_owners.end(), [&](const auto& value) { return value.owner == owner; });
+        if (old != saving_owners.end())
+        {
+            if (old->gap != image.gap) fail("aliased_owner_changed_during_save", read32(frame_address), owner);
+            return;
+        }
+        if (saving_owners.size() >= 6) fail("owner_count_invalid", read32(frame_address), saving_owners.size());
+        saving_owners.push_back(image);
+    }
+
+    static bool supplement_valid(void* context, const region& range) noexcept
+    {
+        const auto* image = static_cast<const frame_image*>(context);
+        return mapped(range.address, range.size, true) && std::any_of(image->owners.begin(), image->owners.end(), [&](const auto& owner)
+        { return range.address == owner.owner + 0x32a0 && range.size == 280 && range.identity == owner.owner; });
+    }
+    static bool supplement_write(void*, u32 address, std::span<const std::byte> bytes) noexcept
+    {
+        if (!mapped(address, static_cast<u32>(bytes.size()), true)) return false;
+        std::memcpy(vm::get_super_ptr<u8>(address), bytes.data(), bytes.size());
+        return true;
+    }
+
+    static bool supplement_read(void* context, u32 address, std::span<std::byte> bytes) noexcept
+    {
+        const auto* image = static_cast<const frame_image*>(context);
+        for (const auto& owner : image->owners)
+        {
+            if (address != owner.owner + 0x32a0 || bytes.size() != 280) continue;
+            // Use the bytes captured immediately before this owner's native
+            // memcpy, never a second live read at the end of the whole save.
+            std::memcpy(bytes.data(), owner.gap.data() + 48, bytes.size());
+            return true;
+        }
+        return false;
+    }
+
+    std::vector<region> regions(const frame_image& image) const
+    {
+        std::vector<region> result;
+        for (const auto& owner : image.owners) result.push_back({owner.owner + 0x32a0, 280, owner.owner});
+        return result;
+    }
+
+    void finish_save(ppu_thread& ppu)
+    {
+        if (!active || !full_save) return;
+        full_save = false;
+        with_suspended(ppu, [&]
+        {
+            auto inspected = native::inspect_layout(native_memory, save_manager, save_slot);
+            if (inspected.code != native::status::ok)
+            {
+                ++unsupported_snapshots;
+                if (unsupported_snapshots <= 5)
+                {
+                    record("snapshot_not_usable", read32(frame_address), static_cast<u64>(inspected.code), inspected.address);
+                    green_rb_log.warning("Rollback snapshot not usable: reason %u at 0x%x", static_cast<u32>(inspected.code), inspected.address);
+                }
+                return;
+            }
+            frame_image candidate;
+            candidate.valid = true;
+            candidate.epoch = epoch;
+            candidate.layout = std::move(inspected.value);
+            candidate.owners = saving_owners;
+            for (const auto& owner : candidate.owners)
+            {
+                if (std::none_of(candidate.layout.owners.begin(), candidate.layout.owners.end(), [&](const auto& native_owner)
+                    { return native_owner.address == owner.owner && native_owner.snapshot_first == owner.source_buffer; }))
+                    fail("owner_snapshot_mismatch", candidate.layout.frame, owner.owner);
+            }
+            for (const auto& native_owner : candidate.layout.owners)
+            {
+                if (native_owner.snapshot_first && std::none_of(candidate.owners.begin(), candidate.owners.end(), [&](const auto& owner)
+                    { return native_owner.address == owner.owner; }))
+                    fail("owner_capture_missing", candidate.layout.frame, native_owner.address);
+            }
+            for (const auto& range : candidate.layout.saved_sources) candidate.hashes.push_back(hash_bytes(range.address, range.size));
+            const auto extra = regions(candidate);
+            if (!extra.empty())
+            {
+                const errc error = supplements.capture(epoch, candidate.layout.frame, extra,
+                    {&candidate, supplement_valid, supplement_read, supplement_write});
+                if (error != errc::ok) fail("supplement_capture_failed", candidate.layout.frame, static_cast<u64>(error));
+            }
+            snapshots[(save_slot - ring) / slot_size] = std::move(candidate);
+            ++saves;
+        });
+    }
+
+    void before_restore(ppu_thread& ppu)
+    {
+        if (!active) return;
+        u32 target = 0, frame = 0;
+        with_suspended(ppu, [&]
+        {
+            const u32 m = static_cast<u32>(ppu.gpr[3]);
+            if (m != manager || !native::select_restore_slot(native_memory, m, snapshot_count, target, frame))
+                fail("restore_slot_invalid", read32(frame_address), m);
+            frame_image* image = image_for(target);
+            if (!image || image->layout.frame != frame) fail("snapshot_missing", read32(frame_address), target);
+            const u32 current = read32(frame_address);
+            if (frame > current || current - frame > max_prediction) fail("rollback_window_exceeded", current, frame);
+            const auto current_layout = native::inspect_layout(native_memory, m, target);
+            if (current_layout.code != native::status::ok || !native::same_identity(image->layout, current_layout.value))
+                fail("snapshot_identity_changed", current, static_cast<u64>(current_layout.code));
+            for (usz i = 0; i < image->hashes.size(); ++i)
+            {
+                const auto& range = image->layout.saved_sources[i];
+                if (!mapped(range.address, range.size) || image->hashes[i] != hash_bytes(range.address, range.size))
+                    fail("native_snapshot_corrupt", current, range.address);
+            }
+            for (const auto& owner : image->owners)
+            {
+                if (!mapped(owner.owner, 0x4460, true) ||
+                    std::memcmp(vm::get_super_ptr<u8>(owner.owner + 0x3270), owner.gap.data(), 48) ||
+                    std::memcmp(vm::get_super_ptr<u8>(owner.owner + 0x33b8), owner.gap.data() + 328, 8))
+                    fail("owner_lifetime_changed", current, owner.owner);
+            }
+            const auto extra = regions(*image);
+            if (!extra.empty())
+            {
+                const auto checked = supplements.validate_restore(epoch, frame, extra,
+                    {image, supplement_valid, supplement_read, supplement_write});
+                if (checked != errc::ok) fail("supplement_preflight_failed", current, static_cast<u64>(checked));
+            }
+            restore_slot = target;
+        });
+        record("restore_begin", frame, read32(frame_address) - frame);
+    }
+
+    void after_restore(ppu_thread& ppu)
+    {
+        if (!active || !restore_slot) return;
+        frame_image* image = image_for(restore_slot);
+        if (!image) fail("restore_receipt_missing", read32(frame_address), restore_slot);
+        const u32 frame = image->layout.frame;
+        with_suspended(ppu, [&]
+        {
+            const auto extra = regions(*image);
+            if (!extra.empty())
+            {
+                const auto result = supplements.restore(epoch, frame, extra, {image, supplement_valid, native_read, supplement_write});
+                if (result.code != errc::ok) fail("supplement_restore_failed", frame, static_cast<u64>(result.code));
+            }
+            for (auto& newer : snapshots) if (newer.valid && newer.layout.frame > frame) newer.valid = false;
+        });
+        if (read32(frame_address) != frame) fail("native_frame_restore_failed", read32(frame_address), frame);
+        ++restores;
+        restore_slot = 0;
+        predicted_at = absent_id;
+        record("restore_complete", frame, 0);
+    }
+
+    void observe_battle(ppu_thread& ppu)
+    {
+        diagnostics::capture_result captured;
+        u32 pending = absent_id, ids[2]{absent_id, absent_id}, pads[2]{};
+        with_suspended(ppu, [&]
+        {
+            captured = diagnostics::capture({nullptr, native_read});
+            if (net && mapped(net, 0x1780))
+            {
+                pending = read32(net + 0x1720);
+                ids[0] = read32(net + 0x1740);
+                ids[1] = read32(net + 0x1744);
+                pads[0] = vm::read16(net + 0x1748);
+                pads[1] = vm::read16(net + 0x174a);
+            }
+        });
+        if (captured.code != diagnostics::status::ok || pending > max_prediction) return;
+        const auto& value = captured.value;
+        // A partial observation for offline comparison, never a peer checksum
+        // or evidence that all emulator/game state is deterministic.
+        log.write(fmt::format(
+            "{\"event\":\"battle_observation\",\"schema\":1,\"epoch\":%llu,\"frame\":%u,"
+            "\"phase\":\"after_step\",\"pending\":%u,\"input_ids\":[%u,%u],\"input_pads\":[%u,%u],"
+            "\"mode\":[%u,%u],\"timer_raw\":%d,\"health_raw\":[%d,%d,%d,%d],\"digest\":\"%016llx\"}\n",
+            epoch, value.frame, pending, ids[0], ids[1], pads[0], pads[1], value.mode[0], value.mode[1], value.timer_raw,
+            value.health_raw[0], value.health_raw[1], value.health_raw[2], value.health_raw[3], diagnostics::digest(value)));
+    }
+
+    bool dispatch(ppu_thread& ppu, event kind)
+    {
+        if (poisoned) fail("poisoned_session_reentered", observed_frame);
+        if (kind == event::step) { boundary(ppu); return false; }
+        if (!thread || ppu.id != thread) return false;
+        switch (kind)
+        {
+        case event::forward_end:
+        case event::replay_end:
+        {
+            const u32 now = read32(frame_address);
+            if (active && kind == event::replay_end)
+            {
+                if (now != step_frame + 1) fail("resimulation_did_not_advance", now, step_frame);
+                ++replay_frames;
+            }
+            if (active && now == step_frame + 1 && (now % 60 == 0 || kind == event::replay_end))
+                observe_battle(ppu);
+            return false;
+        }
+        case event::save_entry:
+            full_save = false;
+            saving_owners.clear();
+            save_manager = static_cast<u32>(ppu.gpr[3]);
+            return false;
+        case event::save_full:
+            if (active)
+            {
+                save_slot = static_cast<u32>(ppu.gpr[25]);
+                if (save_slot < ring || (save_slot - ring) % slot_size || (save_slot - ring) / slot_size >= snapshot_count)
+                    fail("save_slot_invalid", read32(frame_address), save_slot);
+                full_save = true;
+            }
+            return false;
+        case event::owner_save:
+        case event::extra_owner_save: owner_save(ppu); return false;
+        case event::save_end: finish_save(ppu); return false;
+        case event::restore_entry: before_restore(ppu); return false;
+        case event::restore_end: after_restore(ppu); return false;
+        case event::predict: return predict(ppu);
+        case event::registration:
+            if (active && network(static_cast<u32>(ppu.gpr[30])))
+                with_suspended(ppu, [&]
+                {
+                    // 58BA60 -> 4C5614 returns the pad address (record+0x12).
+                    // r28 is that memcpy destination, not the record header.
+                    const u32 pad_address = static_cast<u32>(ppu.gpr[28]);
+                    if (pad_address < 18) fail("local_registration_address_invalid", read32(frame_address), pad_address);
+                    const u32 record = pad_address - 18;
+                    if (record < local || record - local >= source_record_count * source_record_bytes ||
+                        (record - local) % source_record_bytes)
+                        fail("local_registration_address_invalid", read32(frame_address), record);
+                    // The producer publishes an ID before pad registration.
+                    // Admit only the single record whose pad memcpy just ended;
+                    // scanning the whole local ring could admit a placeholder.
+                    const input_record input{read32(record + 12), vm::read16(pad_address)};
+                    const auto error = local_inputs.insert(epoch, input);
+                    if (error != errc::ok && error != errc::duplicate)
+                        fail("local_registration_invalid", read32(frame_address), static_cast<u64>(error));
+                });
+            return false;
+        case event::predict_gate:
+            if (active && !ppu.gpr[0] && prediction_ready(static_cast<u32>(ppu.gpr[30])) &&
+                read32(net + 0x1720) > 0 && predicted_at != read32(frame_address)) ppu.gpr[0] = 1;
+            return false;
+        case event::buffer_policy:
+            if (active && ppu.gpr[31] >= 0x28 && prediction_ready(static_cast<u32>(ppu.gpr[31]) - 0x28) &&
+                ppu.gpr[3] > 0 && ppu.gpr[3] <= 36 && ppu.gpr[29] <= 36) --ppu.gpr[3];
+            return false;
+        case event::correction:
+            if (active && static_cast<s32>(ppu.gpr[3]) >= 0) record("input_correction", read32(frame_address), ppu.gpr[3]);
+            return false;
+        default: return false;
+        }
+    }
+};
+
+std::unique_ptr<runtime> session;
+
+template <event Kind>
+void hook_dispatch(ppu_thread& ppu, ppu_opcode_t, be_t<u32>*, ppu_intrp_func*)
+{
+    try
+    {
+        if (!session) throw std::runtime_error("롤백 세션 없이 실행 훅이 호출됐어");
+        if (!session->dispatch(ppu, Kind)) ppu.cia = session->trampolines[static_cast<usz>(Kind)];
+    }
+    catch (...)
+    {
+        // with_suspended has already released the CPU rendezvous. Stop the
+        // session through the UI thread before another game/result step runs.
+        ppu.state += cpu_flag::exit;
+        Emu.CallFromMainThread([] { Emu.Kill(false); });
+        // PPU dispatch checks exit immediately after this HLE returns. Do not
+        // throw through the surrounding RPCS3 frames built without C++ EH.
+        return;
+    }
+}
+
+template <event Kind> u32 register_hook()
+{
+    return ppu_function_manager::register_function<decltype(&hook_dispatch<Kind>), &hook_dispatch<Kind>>(hook_dispatch<Kind>);
+}
+
+const std::array<u32, event_count> hook_indices{
+    register_hook<event::step>(), register_hook<event::forward_end>(), register_hook<event::replay_end>(),
+    register_hook<event::save_entry>(), register_hook<event::save_full>(), register_hook<event::save_end>(),
+    register_hook<event::restore_entry>(), register_hook<event::restore_end>(),
+    register_hook<event::owner_save>(), register_hook<event::extra_owner_save>(),
+    register_hook<event::predict>(), register_hook<event::predict_gate>(), register_hook<event::buffer_policy>(),
+    register_hook<event::registration>(), register_hook<event::production>(), register_hook<event::correction>()};
+}
+
+void set_mode(netcode_mode mode)
+{
+    start_failed = false;
+    start_error.clear();
+    selected_mode.store(mode);
+}
+netcode_mode get_mode() { return selected_mode.load(); }
+bool boot_failed() { return start_failed; }
+const std::string& boot_error() { return start_error; }
+
+void stop()
+{
+    if (session) session->record("session_end", session->observed_frame, session->rejected);
+    session.reset();
+    selected_mode.store(netcode_mode::delay);
+}
+
+static void install_hooks_checked(std::vector<u32>& applied)
+{
+    if (get_mode() != netcode_mode::rollback) return;
+    if (Emu.GetTitleID() != "BLES01702" || (Emu.GetAppVersion() != "01.03" && Emu.GetAppVersion() != "1.03") ||
+        Emu.GetExecutableHash() != "PPU-8645cfa235c9980ff74b5e06388b29e97fdbbed9" || Emu.DeserialManager())
+        throw std::runtime_error("롤백은 지원되는 BLES01702 v1.03 실행파일을 새로 부팅해야 사용할 수 있어");
+    if (session) throw std::runtime_error("이전 롤백 세션 정리가 끝나지 않았어");
+
+    // Preflight the entire code contract before changing a single instruction.
+    // A separately enabled legacy rollback patch is refused rather than layered.
+    for (const auto& patch : contract::patches)
+        if (!mapped(patch.address, 4) || read32(patch.address) != patch.original || ppu_get_far_jump(patch.address))
+            throw std::runtime_error(fmt::format("0x%x의 기존 코드와 롤백이 충돌해. 이전 롤백 패치를 꺼 줘", patch.address));
+    for (const auto& hook : contract::hooks)
+        if (!mapped(hook.address, 4) || read32(hook.address) != hook.original || ppu_get_far_jump(hook.address))
+            throw std::runtime_error(fmt::format("0x%x의 게임 코드가 롤백 지원 조건과 달라", hook.address));
+
+    session = std::make_unique<runtime>();
+    const auto map = vm::get(vm::any, 0x000cab40);
+    const u32 code = map ? map->alloc(0x10000, nullptr, 0x10000, vm::alloc_executable) : 0;
+    if (!code) throw std::runtime_error("롤백 실행 훅 메모리를 할당하지 못했어");
+    ppu_register_range(code, 0x10000);
+    for (const auto& patch : contract::patches)
+    {
+        *vm::get_super_ptr<be_t<u32>>(patch.address) = patch.replacement;
+        applied.push_back(patch.address);
+    }
+    for (const auto& hook : contract::hooks)
+    {
+        const usz index = static_cast<usz>(hook.kind);
+        const u32 trampoline = code + static_cast<u32>(index) * 16;
+        *vm::get_super_ptr<be_t<u32>>(trampoline) = hook.original;
+        *vm::get_super_ptr<be_t<u32>>(trampoline + 4) = 0x60000000;
+        const u32 target = g_fxo->get<ppu_function_manager>().func_addr(hook_indices[index], true);
+        if (!target || !ppu_form_branch_to_code(trampoline + 4, hook.address + 4, false, false) ||
+            !ppu_form_branch_to_code(hook.address, target, false, false))
+            throw std::runtime_error(fmt::format("0x%x의 롤백 실행 훅을 설치하지 못했어", hook.address));
+        session->trampolines[index] = trampoline;
+        g_fxo->need<ppu_patch_block_registry_t>();
+        g_fxo->get<ppu_patch_block_registry_t>().block_addresses.insert(hook.address);
+        applied.push_back(hook.address);
+    }
+    session->record("hooks_installed", 0, contract::hooks.size());
+}
+
+bool install_hooks(std::vector<u32>& applied)
+{
+    try
+    {
+        install_hooks_checked(applied);
+        return true;
+    }
+    catch (const std::exception& error)
+    {
+        start_error = error.what();
+    }
+    catch (...)
+    {
+        start_error = "롤백 초기화 중 알 수 없는 오류가 났어";
+    }
+    start_failed = true;
+    green_rb_log.error("GREEN ONLINE boot refused: %s", start_error);
+    if (session) session->record("boot_failure", 0, 0);
+    // The loader must stop without running guest code, then release its VM.
+    session.reset();
+    return false;
+}
+}
