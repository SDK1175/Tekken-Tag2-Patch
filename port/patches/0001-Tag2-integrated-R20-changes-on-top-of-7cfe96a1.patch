+  if(!native&&(p=="patches/patch.yml"||p=="config/patch_config.yml")&&now!=after)throw Failure(QString::fromUtf8("이전 업데이트 복구가 현재 패치 파일을 변경하려 하여 중단했습니다. 기존 설정은 보존했습니다: ")+p);
