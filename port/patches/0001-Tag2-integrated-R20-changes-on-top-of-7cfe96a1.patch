+bool mapped(u32 at, u32 bytes, bool write = false)
+{
+    return at >= 0x10000 && bytes && u64{at} + bytes <= 0x40000000 &&
+        vm::check_addr(at, write ? vm::page_writable : vm::page_readable, bytes);
+}
+u32 word(u32 at) { return vm::read32(at); }
+u8 byte(u32 at) { return *vm::get_super_ptr<u8>(at); }
+void put_byte(u32 at, u8 value) { *vm::get_super_ptr<u8>(at) = value; }
+bool read_memory(void*, u32 at, std::span<std::byte> out) noexcept
+{
+    if (out.size() > UINT32_MAX || !mapped(at, static_cast<u32>(out.size()))) return false;
+    std::memcpy(out.data(), vm::get_super_ptr<u8>(at), out.size()); return true;
+}
+bool valid_memory(void*, u32 at, u32 bytes, bool write) noexcept { return mapped(at, bytes, write); }
+bool write_memory(u32 at, std::span<const std::byte> bytes)
+{
+    if (bytes.size() > UINT32_MAX || !mapped(at, static_cast<u32>(bytes.size()), true)) return false;
+    std::memcpy(vm::get_super_ptr<u8>(at), bytes.data(), bytes.size()); return true;
+}
+const native::memory memory{nullptr, read_memory, valid_memory};
