+        void run()
+        {
+            std::uint64_t seq=0,attempts=0,rejected=0,invalidated_display=0,last_display=0,clear_display=0;
+            capture_record prior{};
+            bool had_gate=false;
+            // Per-thread high-resolution waitable timer; never change global timer
+            // resolution, busy-spin, or wait while holding an input/RSX lock.
+            HANDLE timer=CreateWaitableTimerExW(nullptr,nullptr,0x00000002,TIMER_ALL_ACCESS);
+            while(!quit.load(std::memory_order_relaxed))
+            {
+                capture_record r{};
+                const auto now=GetTickCount64();
+                bool gate_loss=!Emu.IsRunning();
+                const bool gate=!gate_loss&&capture(r,gate_loss);
+                if(gate && had_gate && !same_identity(prior,r))gate_loss=true;
+                if(gate_loss)
+                {
+                    generation.unsafe_observation();store64(shared+112,generation.value);
+                    invalidated_display=load64(shared+136);
+                    if(overlay)overlay->visible=false;
+                }
+                store64(shared+40,++attempts);store32(shared+64,(gate||!gate_loss)?1:0);
+                if(gate)
+                {
+                    if(had_gate && same_identity(prior,r) && r.frame_after!=prior.frame_after && r.frame_after!=prior.frame_after+1)
+                    {clear_display=load64(shared+136);last_display=0;}
+                    store64(shared+72,now);store32(shared+68,r.frame_after);
+                    r.sequence=++seq;r.guard=seq*2;r.rejected_before=rejected;r.gate_epoch=generation.value;
+                    auto* slot=shared+header_size+((seq-1)%capacity)*record_size;
+                    store64(slot,seq*2-1);std::memcpy(slot+8,reinterpret_cast<std::uint8_t*>(&r)+8,record_size-8);
+                    MemoryBarrier();store64(slot,seq*2);store64(shared+32,seq);
+                }
+                else
+                {
+                    store64(shared+48,++rejected);
+                }
+                if(overlay)
+                {
+                    std::uint8_t d[2112]{};
+                    const auto guard=load64(shared+128);
+                    if(gate && !(guard&1))
+                    {
+                        std::memcpy(d,shared+128,sizeof(d));MemoryBarrier();
+                        const auto display_seq=host64(d+8),stamp=host64(d+16);
+                        const bool allowed=guard==load64(shared+128) && guard!=0 && display_seq>invalidated_display
+                            && host64(d+56)==generation.value
+                            && host32(d+24)==1 && host32(d+28)==1 && fresh(now,stamp,500)
+                            && host32(d+40)==r.main && host32(d+44)==r.game
+                            && host32(d+48)==r.p1_pointer && host32(d+52)==r.p2_pointer
+                            && host32(d+32)<1024 && host32(d+36)<1024;
+                        if(allowed)
+                        {
+                            if(display_seq!=last_display)
+                            {
+                                auto first=safe_text(d+64,host32(d+32)),second=safe_text(d+1088,host32(d+36));
+                                if(display_seq<=clear_display){first=cleared_training_values(first);second=cleared_training_values(second);}
+                                overlay->text(std::move(first),std::move(second));
+                                last_display=display_seq;
+                            }
+                            overlay->capture_ms=now;overlay->display_ms=stamp;overlay->visible=true;
+                        }
+                        else overlay->visible=false;
+                    }
+                    else if(gate_loss)overlay->visible=false;
+                }
+                if(gate){prior=r;had_gate=true;}
+                else if(gate_loss)had_gate=false;
+                LARGE_INTEGER due{};due.QuadPart=-10000;
+                if(timer && SetWaitableTimer(timer,&due,0,nullptr,nullptr,FALSE))WaitForSingleObject(timer,20);
+                else std::this_thread::sleep_for(std::chrono::milliseconds(1));
+            }
+            if(timer)CloseHandle(timer);
+            if(overlay)overlay->visible=false;
+            store32(shared+64,0);store32(shared+80,0);
+        }
+    public:
+        ~capture_service(){stop();}
+        void start()
+        {
+            stop();
+            generation.start();
+            if(Emu.GetTitleID()!="BLES01702" || Emu.GetAppVersion()!="01.03" || !build_matches())return;
+            const auto name="Local\\TTT2_FRAMEDATA_"+std::to_string(GetCurrentProcessId());
+            mapping=CreateFileMappingA(INVALID_HANDLE_VALUE,nullptr,PAGE_READWRITE,0,mapping_size,name.c_str());
+            if(!mapping)return;
+            shared=static_cast<std::uint8_t*>(MapViewOfFile(mapping,FILE_MAP_ALL_ACCESS,0,0,mapping_size));
+            if(!shared){CloseHandle(mapping);mapping=nullptr;return;}
+            std::memset(shared,0,mapping_size);std::memcpy(shared,"TTT2FD03",8);
+            store32(shared+8,3);store32(shared+12,header_size);store32(shared+16,record_size);store32(shared+20,capacity);
+            store32(shared+24,GetCurrentProcessId());store32(shared+28,1);store32(shared+80,1);store32(shared+88,1000);
+            store64(shared+96,GetTickCount64());
+            store64(shared+112,generation.value);
+            // Display manager mutation only happens once, outside all capture reads.
+            if(g_cfg.misc.use_native_interface)
+                if(auto manager=g_fxo->try_get<rsx::overlays::display_manager>())overlay=manager->create<framedata_overlay>();
+            store32(shared+104,overlay?1:0);store32(shared+108,overlay?native_style_capability:0);
+            sys_log.notice("%s",build_marker);
+            quit=false;bridge_enabled=true;worker=std::thread([this]{run();});
+            calculator=std::thread([this]{run_calculator();});
+        }
+        void stop()
+        {
+            bridge_enabled=false;quit=true;
+            // Keep the IPC mapping alive until the calculator released its view.
+            if(calculator.joinable())calculator.join();
+            if(worker.joinable())worker.join();
+            if(overlay)
+            {
+                overlay->visible=false;
+                if(auto manager=g_fxo->try_get<rsx::overlays::display_manager>())manager->remove(overlay->uid);
+                overlay.reset();
+            }
+            if(shared){UnmapViewOfFile(shared);shared=nullptr;}
+            if(mapping){CloseHandle(mapping);mapping=nullptr;}
+        }
+    };
+    inline capture_service service;
+    inline void start(){service.start();}
+    inline void stop(){service.stop();}
+}
+#else
+namespace ttt2_framedata {inline void start(){} inline void stop(){}}
+#endif
