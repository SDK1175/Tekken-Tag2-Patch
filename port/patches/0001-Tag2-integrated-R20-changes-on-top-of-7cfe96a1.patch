+ for(const auto& other:visited)if(node.is(other))shared=true;
+ parents.append(node);visited.append(node);
+ if(node.IsMap()){
+  QSet<QString> seen;
+  for(const auto& item:node){
+   if(!item.first.IsScalar())throw Failure("Practice configuration requires scalar keys");
+   const auto key=QString::fromStdString(item.first.Scalar());if(seen.contains(key))throw Failure("Duplicate practice configuration key: "+key);seen.insert(key);
+   validate(item.second,depth+1,count,parents,visited,shared);
+  }
+ }else for(const auto& item:node)validate(item,depth+1,count,parents,visited,shared);
+ parents.removeLast();
+}
+inline YAML::Node parse(const QByteArray& bytes,bool& shared){
+ try{
+  const auto docs=YAML::LoadAll(bytes.toStdString());
+  if(docs.empty()||(docs.size()==1&&docs.front().IsNull()))return YAML::Node(YAML::NodeType::Map);
+  if(docs.size()!=1||!docs.front().IsMap())throw Failure("Practice configuration requires one mapping document");
+  int count=0;QList<YAML::Node> parents,visited;validate(docs.front(),0,count,parents,visited,shared);return docs.front();
+ }catch(const YAML::Exception& e){throw Failure("Cannot read practice configuration: "+QString::fromUtf8(e.what()));}
+}
+inline YAML::Node detach(const YAML::Node& node){
+ if(!node.IsMap()&&!node.IsSequence())return YAML::Clone(node);
+ YAML::Node result(node.Type());result.SetTag(node.Tag());result.SetStyle(node.Style());
+ if(node.IsMap())for(const auto& item:node)result[YAML::Clone(item.first)]=detach(item.second);
+ else for(const auto& item:node)result.push_back(detach(item));
+ return result;
+}
+inline void set_enabled(YAML::Node node,const QStringList& path,int at=0){
+ const auto key=path[at].toStdString();if(at==path.size()-1){node[key]=true;return;}
+ if(!static_cast<const YAML::Node&>(node)[key].IsDefined())node[key]=YAML::Node(YAML::NodeType::Map);
+ set_enabled(node[key],path,at+1);
+}
+inline bool equal(const YAML::Node& a,const YAML::Node& b){
+ if(a.Type()!=b.Type())return false;if(a.IsScalar())return a.Scalar()==b.Scalar();if(a.IsNull())return true;
+ if(a.size()!=b.size())return false;
+ if(a.IsMap()){for(const auto& item:a){const auto other=b[item.first.Scalar()];if(!other.IsDefined()||!equal(item.second,other))return false;}}
+ else for(std::size_t i=0;i<a.size();++i)if(!equal(a[i],b[i]))return false;
+ return true;
+}
+inline QByteArray desired(const QByteArray& before){
+ bool shared=false;const auto doc=parse(before,shared);const auto path=keys();YAML::Node node=doc;
+ qsizetype insertion=before.size();bool block=!shared;int missing=-1;
+ for(int i=0;i<path.size();++i){
+  if(!node.IsMap())throw Failure("Practice setting parent is not a mapping");
+  block=block&&node.Style()!=YAML::EmitterStyle::Flow;
+  const auto child=static_cast<const YAML::Node&>(node)[path[i].toStdString()];
+  if(!child.IsDefined()){missing=i;break;}
+  if(i==path.size()-1){
+   try{if(!child.IsScalar())throw Failure("Practice Enabled setting is not boolean");child.as<bool>();}
+   catch(const YAML::Exception&){throw Failure("Practice Enabled setting is not boolean");}
+   return before; // An explicit true or false is always the user's choice.
+  }
+  bool found=false;
+  for(const auto& item:node){
+   if(found){const auto pos=item.first.Mark().pos;if(pos<0)block=false;else insertion=qMin(insertion,qsizetype(pos));break;}
+   if(item.first.Scalar()==path[i].toStdString())found=true;
+  }
+  node.reset(child);
+ }
+ auto expected=detach(doc);set_enabled(expected,path);
+ QByteArray after;
+ if(block&&node.size()>0&&node.begin()->first.Mark().column>=0){
+  // Insert after the target mapping, before the next ancestor sibling. No
+  // unrelated scalar, comment, line ending or explicitly chosen value moves.
+  if(insertion<before.size())insertion=before.lastIndexOf('\n',insertion-1)+1;
+  else{
+   const auto end=QRegularExpression("(?m)^\\.\\.\\.(?:[ \\t]+#[^\\r\\n]*)?[ \\t]*\\r?$").match(QString::fromUtf8(before));
+   if(end.hasMatch())insertion=QString::fromUtf8(before).left(end.capturedStart()).toUtf8().size();
+  }
+  const auto newline=before.contains("\r\n")?QByteArray("\r\n"):QByteArray("\n");
+  QByteArray add;if(insertion>0&&before[insertion-1]!='\n')add+=newline;
+  const int indent=node.begin()->first.Mark().column;
+  for(int i=missing;i<path.size();++i){YAML::Emitter key;key<<YAML::DoubleQuoted<<path[i].toStdString();add+=QByteArray(indent+2*(i-missing),' ')+key.c_str()+':';if(i==path.size()-1)add+=" true";add+=newline;}
+  after=before.left(insertion)+add+before.mid(insertion);
+ }else{
+  // Flow mappings or aliased containers cannot safely receive a block splice.
+  // Detached re-emission preserves their values without changing an alias peer.
+  YAML::Emitter out;out.SetIndent(2);out<<expected;if(!out.good())throw Failure("Cannot encode practice configuration");after=QByteArray(out.c_str())+'\n';
+ }
+ bool unused=false;if(!equal(expected,parse(after,unused)))throw Failure("Practice configuration edit changed unrelated values");
+ return after;
+}
+inline bool hash_valid(const QString& value){return QRegularExpression("^[0-9a-f]{64}$").match(value).hasMatch();}
+inline QString stored(const QString& hash){return folder+"store/"+hash+".yml";}
+inline void store(const QString& root,const QByteArray& bytes){const auto hash=hash_bytes(bytes),file=safe_path(root,stored(hash));if(!QFileInfo::exists(file))atomic_write(file,bytes);if(hash_file(file)!=hash)throw Failure("Practice configuration backup changed");}
+inline void validate_journal(const QJsonObject& journal){
+ const auto before=journal["before"].toString(),after=journal["after"].toString();
+ if(journal["schema"].toInt()!=1||journal["id"]!=identity||journal["path"]!=target||!journal["before"].isString()||(!before.isEmpty()&&!hash_valid(before))||!hash_valid(after))throw Failure("Invalid practice configuration journal");
+}
+inline void commit_pending(const QString& root,Progress progress){
+ const auto pending=safe_path(root,folder+"pending.json");if(!QFileInfo::exists(pending))return;
+ const auto journal=strict_json(read_bytes(pending));validate_journal(journal);
+ const auto before=journal["before"].toString(),after=journal["after"].toString(),file=safe_path(root,target);
+ const auto original=before.isEmpty()?QByteArray{}:read_bytes(safe_path(root,stored(before)),16*1024*1024);
+ const auto replacement=read_bytes(safe_path(root,stored(after)),16*1024*1024);
+ if((!before.isEmpty()&&hash_bytes(original)!=before)||hash_bytes(replacement)!=after||desired(original)!=replacement)throw Failure("Practice configuration recovery payload changed");
+ const auto current=hash_file(file);if(current!=before&&current!=after)throw Failure("Practice configuration changed during recovery; existing file and backup preserved");
+ assert_stopped(root);if(current!=after)atomic_write(file,replacement);if(hash_file(file)!=after)throw Failure("Practice configuration verification failed");
+ if(progress)progress("practice-file",1,1);
+ auto receipt=journal;receipt["state"]="applied";atomic_write(safe_path(root,folder+"applied.json"),QJsonDocument(receipt).toJson());
+ if(progress)progress("practice-receipt",1,1);
+ if(!QFile::remove(pending))throw Failure("Cannot finish practice configuration recovery");
+}
+}
+// The caller holds the installation's NativeTransaction. A completed receipt
+// deliberately stops migration even when the GUI later removes the Enabled key.
+inline void enable_practice_positions_locked(const QString& root,Progress progress={}){
+ using namespace practice_config_detail;commit_pending(root,progress);
+ const auto receipt=safe_path(root,folder+"applied.json");
+ if(QFileInfo::exists(receipt)){const auto done=strict_json(read_bytes(receipt));validate_journal(done);if(done["state"]!="applied")throw Failure("Invalid practice activation receipt");return;}
+ const auto file=safe_path(root,target);const bool exists=QFileInfo::exists(file);const auto original=exists?read_bytes(file,16*1024*1024):QByteArray{};
+ const auto replacement=desired(original);const auto before=exists?hash_bytes(original):QString{},after=hash_bytes(replacement);
+ if(exists)store(root,original);store(root,replacement);
+ if(hash_file(file)!=before)throw Failure("Practice configuration changed before migration");
+ const QJsonObject journal{{"schema",1},{"id",identity},{"path",target},{"before",before},{"after",after}};
+ atomic_write(safe_path(root,folder+"pending.json"),QJsonDocument(journal).toJson());
+ if(progress)progress("practice-prepared",0,1);commit_pending(root,progress);
+}
+}
