+ const std::string& error()const{return failure;}
+ bool open(const std::filesystem::path& path,bool require_310=true)
+ {
+  if(library){failure="runtime already loaded";return false;}
+  if(!path.is_absolute()||!std::filesystem::is_regular_file(path)){failure="local Python library missing";return false;}
+#ifdef _WIN32
+  library=LoadLibraryExW(path.c_str(),nullptr,LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR|LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
