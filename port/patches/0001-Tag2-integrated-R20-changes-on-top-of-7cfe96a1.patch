+  const bool available=!working&&!checking&&!closing&&(!hooks.stopped||hooks.stopped());display->setEnabled(available&&state.ready);install->setEnabled(available&&!state.ready);
+  install->setText(state.ready?QString::fromUtf8("프레임표 설치됨"):state.installed?QString::fromUtf8("프레임표 다시 설치"):QString::fromUtf8("프레임표 설치"));
+ }catch(...){display->setEnabled(false);install->setEnabled(false);}
+}
+void NativePanel::install_frames(){
+ if(working||checking||closing||operation)return;
+ try{if(frame_state(root).ready){refresh_frames();return;}}catch(const Failure& e){show_error(QString::fromUtf8(e.what()));return;}
+ if(hooks.stopped&&!hooks.stopped()){show_error(QString::fromUtf8("프레임표 설치 전에 게임을 종료해 주세요."));return;}
+ QPointer<NativePanel> self(this);operation=std::make_shared<LaunchGuard>();auto work=operation;cancelled=false;
+ try{
+  auto acquire=hooks.inhibit_launch;if(acquire)work->emulation=acquire();if(!self)return;
+  set_working(true);begin_progress();report("verify",0,0);if(!self)return;if(closing||cancelled){finish_work();return;}
+  verify_installed(root,parse_package(read_bytes(safe_path(root,manifest_path))));report("download",0,0);if(!self)return;if(closing||cancelled){finish_work();return;}auto download=hooks.frame_download;
+  const auto stage=download([self](const QString& p,int n,int total){if(self)self->report(p,n,total);},[self]{return !self||self->cancelled||self->closing;});
+  if(!self)return;if(closing||cancelled){show_error(QString::fromUtf8("프레임표 설치를 취소했습니다."));finish_work();return;}
+  report("verify",0,0);if(!self)return;if(closing||cancelled){finish_work();return;}validate_frame_stage(root,stage);
+  if(hooks.stopped&&!hooks.stopped())throw Failure(QString::fromUtf8("게임이 실행되어 설치를 중단했습니다. 게임을 종료한 뒤 다시 눌러 주세요."));
+  report("handoff",0,0);if(!self)return;if(closing||cancelled){finish_work();return;}
+  const auto parent=restart_arguments();const QStringList args={"--tag2-frame-apply",stage,"--tag2-parent-pid",parent[1],"--tag2-parent-created",parent[2]};
+  if(progress_dialog){progress_dialog->prevent_cancel();progress_dialog->show();}
+  closing=true;auto external=hooks.external;const bool accepted=external(safe_path(root,"rpcs3.exe"),args);
+  if(self&&!accepted){closing=false;cancelled=false;show_error(QString::fromUtf8("프레임표 설치 전환을 취소했습니다."));finish_work();}
+ }catch(const std::exception& e){if(self){closing=false;show_error(cancelled?QString::fromUtf8("프레임표 설치를 취소했습니다."):QString::fromUtf8("프레임표를 설치하지 못했습니다.\n")+QString::fromUtf8(e.what()));finish_work();}}
+}
+}
