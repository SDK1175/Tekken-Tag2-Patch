+template <typename F>
+void with_suspended(ppu_thread& ppu, F&& operation)
+{
+    // suspend_all may run the operation on another CPU's host thread. Never let
+    // an exception unwind its rendezvous; propagate only after every CPU is released.
+    std::exception_ptr failure;
+    cpu_thread::suspend_all(&ppu, {}, [&]
+    {
+        try { operation(); }
+        catch (...) { failure = std::current_exception(); }
+    });
+    if (failure) std::rethrow_exception(failure);
+}
+
+u64 hash_bytes(u32 address, u32 bytes)
+{
+    u64 hash = 14695981039346656037ull;
+    const auto data = vm::get_super_ptr<u8>(address);
+    for (u32 i = 0; i < bytes; ++i) hash = (hash ^ data[i]) * 1099511628211ull;
+    return hash;
+}
+
+struct owner_image
