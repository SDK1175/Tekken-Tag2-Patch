  const auto j=strict_json(bytes);const int sequence=j["sequence"].toInt(-1);
- if(j["schema"].toInt()!=2||sequence<6||j["runtime_abi"]!="qt6102-tag2-rpcs3-r6"||!j["files"].isArray())throw Failure("Unsupported native launcher release");
