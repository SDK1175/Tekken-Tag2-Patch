diff --git a/rpcs3/rpcs3qt/tag2_native_update_cleanup.h b/rpcs3/rpcs3qt/tag2_native_update_cleanup.h
new file mode 100644
index 000000000..cb4b507f6
--- /dev/null
+++ b/rpcs3/rpcs3qt/tag2_native_update_cleanup.h
@@ -0,0 +1,103 @@
+#pragma once
+#include "tag2_native_package.h"
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QMap>
+#include <QRegularExpression>
+#include <algorithm>
+
+namespace tag2 {
+namespace update_cleanup_detail {
+inline bool digest(const QString& s){return QRegularExpression("^[0-9a-f]{64}$").match(s).hasMatch();}
+inline bool uuid(const QString& s){return QRegularExpression("^[0-9a-f]{32}$").match(s).hasMatch();}
+
+// Delete only the exact files and hashes of a completed native transaction.
+// Never recurse through a folder, follow a link or remove unknown files.
+inline bool remove_known(const QString& base,const QMap<QString,QString>& files){
+ QSet<QString> parents;
+ auto ordered_files=files.keys();
+ std::stable_sort(ordered_files.begin(),ordered_files.end(),[](const QString& a,const QString& b){return int(a.endsWith(manifest_path))<int(b.endsWith(manifest_path));});
+ for(const auto& name:ordered_files){
+  const auto path=safe_path(base,name);
+  if(QFileInfo::exists(path)&&hash_file(path)!=files[name])return false;
+ }
+ for(const auto& name:ordered_files){
+  const auto path=safe_path(base,name);
+  if(QFileInfo::exists(path)&&(!QFile::remove(path)))return false;
+  auto parent=QFileInfo(path).absolutePath();
+  while(parent!=base&&parent.startsWith(base+'/')){
+   parents.insert(parent);parent=QFileInfo(parent).absolutePath();
+  }
+ }
+ auto ordered=parents.values();std::sort(ordered.begin(),ordered.end(),[](const QString& a,const QString& b){return a.size()>b.size();});
+ for(const auto& path:ordered){safe_absolute(path);QDir().rmdir(path);}
+ return true;
+}
+inline void completed_transaction(const QString& root,const QString& folder,const Package& installed){
+ const auto base=QDir(safe_path(root,".tag2-native/transactions/"+folder)).absolutePath();
+ const auto receipt=safe_path(base,"receipt.json");
+ if(!QFileInfo::exists(receipt))return;
+ const auto receipt_bytes=read_bytes(receipt);const auto j=strict_json(receipt_bytes);
+ if(j["schema"].toInt()!=1||j["transaction_id"]!=folder||!j["operations"].isArray())return;
+ const auto manifest=safe_path(base,"replacement/"+QString(manifest_path));
+ if(!QFileInfo::exists(manifest))return;
+ const auto manifest_bytes=read_bytes(manifest);const auto package=parse_package(manifest_bytes);
+ if(package.sequence>installed.sequence||j["release"]!=package.release)return;
+ QMap<QString,QString> originals,effective,replacement,retired;QSet<QString> seen;
+ for(const auto& e:package.entries)replacement.insert(e.path,e.hash);
+ replacement.insert(manifest_path,hash_bytes(manifest_bytes));
+ for(const auto& value:j["operations"].toArray()){
+  const auto row=value.toObject();const auto path=row["path"].toString(),before=row["before"].toString(),after=row["after"].toString();
+  if(!permitted(path)||seen.contains(path)||(!row["before"].isNull()&&!digest(before))||!digest(after))return;
+  seen.insert(path);
+  if(!before.isEmpty()&&before!=after)originals.insert(path,before);
+  if(!before.isEmpty()&&QFileInfo::exists(safe_path(base,"retired/"+path)))retired.insert(path,before);
+  if(replacement[path]!=after){
+   const auto entry=std::find_if(package.entries.begin(),package.entries.end(),[&](const Entry& e){return e.path==path;});
+   if(entry==package.entries.end()||(entry->policy!="frames"&&entry->policy!="if_missing"))return;
+   effective.insert(path,after);
+  }else if(QFileInfo::exists(safe_path(base,"effective/"+path)))effective.insert(path,after);
+ }
+ if(seen!=allowed_files())return;
+ // Check all cohorts before removing any. Already missing files are harmless
+ // when retrying cleanup after an interrupted successful update.
+ QMap<QString,QString> all;
+ for(const auto& group:{qMakePair(QString("original/"),originals),qMakePair(QString("effective/"),effective),qMakePair(QString("retired/"),retired),qMakePair(QString("replacement/"),replacement)})
+  for(auto it=group.second.begin();it!=group.second.end();++it)all.insert(group.first+it.key(),it.value());
+ if(!remove_known(base,all))return;
+ if(hash_file(receipt)==hash_bytes(receipt_bytes))QFile::remove(receipt);
+ QDir().rmdir(base);
+}
+inline void completed_download(const QString& root,const QString& folder,const Package& installed){
+ const auto base=QDir(safe_path(root,".tag2-native/downloads/"+folder)).absolutePath();
+ const auto manifest=safe_path(base,manifest_path);
+ if(!QFileInfo::exists(manifest))return;
+ const auto bytes=read_bytes(manifest);const auto package=parse_package(bytes);
+ // Keep a staged future update (including one the user has not accepted).
+ if(package.sequence>installed.sequence||(package.sequence==installed.sequence&&package.json!=installed.json))return;
+ QMap<QString,QString> files;for(const auto& e:package.entries)files.insert(e.path,e.hash);
+ files.insert(manifest_path,hash_bytes(bytes));
+ if(remove_known(base,files))QDir().rmdir(base);
+}
+}
+
+// Called only at startup, after the installation passed verification and while
+// its update lock is held. No background worker, gameplay polling or telemetry.
+inline void discard_completed_update_copies_locked(const QString& root,const Package& installed){
+ using namespace update_cleanup_detail;
+ for(const QString& pending:{".tag2-native/pending.json",".tag2-native/frames/pending.json",".tag2-update/pending.json",".tag2-update/online-pending.json"})
+  if(QFileInfo::exists(safe_path(root,pending)))return;
+ for(const QString& kind:{"transactions","downloads"}){
+  const QDir dir(safe_path(root,".tag2-native/"+kind));
+  for(const auto& name:dir.entryList(QDir::Dirs|QDir::NoDotAndDotDot|QDir::NoSymLinks)){
+   if(!uuid(name))continue;
+   try{
+    if(kind=="transactions")completed_transaction(root,name,installed);
+    else completed_download(root,name,installed);
+   }catch(const Failure&){/* Unrecognized, modified or locked files stay put. */}
+  }
+ }
+}
+}
diff --git a/rpcs3/rpcs3qt/tag2_native_warmup_patch.h b/rpcs3/rpcs3qt/tag2_native_warmup_patch.h
new file mode 100644
index 000000000..f33b26d61
--- /dev/null
+++ b/rpcs3/rpcs3qt/tag2_native_warmup_patch.h
@@ -0,0 +1,61 @@
+#pragma once
+#include "tag2_native_transaction.h"
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonDocument>
+#include <QtEndian>
+
+namespace tag2 {
+namespace warmup_detail {
+#include "tag2_native_warmup_payload.inc"
+}
+
+// The installation transaction is held by the caller. Replace only a known
+// warmup block; settings, other patch entries and unknown edits are preserved.
+inline void migrate_warmup_counter_locked(const QString& root,Progress progress={}) {
+ using namespace warmup_detail;
+ const auto receipt=safe_path(root,".tag2-native/patches/warmup-counter-v18.json");
+ if(QFileInfo::exists(receipt)) {
+  const auto applied=strict_json(read_bytes(receipt));
+  if(applied["schema"].toInt()==1&&applied["version"]=="1.8-first-contact-counter")return;
+ }
+ const auto target=safe_path(root,"patches/patch.yml");
+ const auto original=read_bytes(target,128LL*1024*1024);
+ const QByteArray begin="# BEGIN TTT2 WARMUP CONTROLS V1",end="# END TTT2 WARMUP CONTROLS V1";
+ const auto first=original.indexOf(begin),last=original.indexOf(end);
+ if(first<0||last<first||original.indexOf(begin,first+begin.size())>=0||original.indexOf(end,last+end.size())>=0)return;
+ const auto length=last+end.size()-first;
+ const auto old_block=original.mid(first,length);
+ auto normalized=old_block;normalized.replace("\r\n","\n");
+ const auto old_hash=hash_bytes(normalized);
+ auto result=original;
+ bool recognized=false,changed=false;
+ for(const auto& block:warmup_blocks) {
+  if(old_hash==block.after){recognized=true;break;}
+  if(old_hash!=block.before)continue;
+  const auto packed=QByteArray::fromBase64(block.packed);
+  if(packed.size()<4||block.size>2*1024*1024||qFromBigEndian<quint32>(packed.constData())!=block.size)throw Failure("Invalid warmup payload size");
+  auto replacement=qUncompress(packed);
+  if(replacement.size()!=block.size||hash_bytes(replacement)!=block.after)throw Failure("Warmup payload verification failed");
+  if(old_block.contains("\r\n"))replacement.replace("\n","\r\n");
+  result.replace(first,length,replacement);recognized=true;changed=true;break;
+ }
+ if(!recognized)return;
+ const auto before=hash_bytes(original),after=hash_bytes(result);
+ QString backup;
+ if(changed) {
+  assert_stopped(root);
+  backup=".tag2-native/patches/backups/"+before+".yml";
+  const auto path=safe_path(root,backup);
+  if(!QFileInfo::exists(path))atomic_write(path,original);
+  if(hash_file(path)!=before)throw Failure("Warmup patch backup changed");
+  if(progress)progress("warmup-counter-backed-up",0,1);
+  if(hash_file(target)!=before)throw Failure("Patch changed during warmup migration; original preserved");
+  atomic_write(target,result);
+  if(hash_file(target)!=after)throw Failure("Warmup patch installation verification failed");
+  if(progress)progress("warmup-counter-committed",1,1);
+ }
+ atomic_write(receipt,QJsonDocument(QJsonObject{{"schema",1},{"version","1.8-first-contact-counter"},
+  {"before",before},{"sha256",after},{"backup",backup}}).toJson());
+}
+}
diff --git a/rpcs3/rpcs3qt/tag2_native_warmup_payload.inc b/rpcs3/rpcs3qt/tag2_native_warmup_payload.inc
new file mode 100644
index 000000000..d927b1159
