diff --git a/rpcs3/Emu/Cell/PPUThread.cpp b/rpcs3/Emu/Cell/PPUThread.cpp
index f5342b0bf..6c8a72646 100644
--- a/rpcs3/Emu/Cell/PPUThread.cpp
+++ b/rpcs3/Emu/Cell/PPUThread.cpp
@@ -514,7 +514,8 @@ static void ppu_fallback(ppu_thread& ppu, ppu_opcode_t op, be_t<u32>* this_op, p
 // TODO: Make this a dispatch call
 void ppu_recompiler_fallback(ppu_thread& ppu)
 {
-	perf_meter<"PPUFALL1"_u64> perf0;
+	perf_meter<"PPUFALL1"_u64> perf0(0);
+	if (g_cfg.core.perf_report) perf0.restart();
 
 	if (g_cfg.core.ppu_debug)
 	{
@@ -544,7 +545,8 @@ void ppu_recompiler_fallback(ppu_thread& ppu)
 
 void ppu_reservation_fallback(ppu_thread& ppu)
 {
-	perf_meter<"PPUFALL2"_u64> perf0;
+	perf_meter<"PPUFALL2"_u64> perf0(0);
+	if (g_cfg.core.perf_report) perf0.restart();
 
 	const auto& table = g_fxo->get<ppu_interpreter_rt>();
 
@@ -3446,7 +3448,14 @@ static void ppu_trace(u64 addr)
 template <typename T>
 static T ppu_load_acquire_reservation(ppu_thread& ppu, u32 addr)
 {
-	perf_meter<"LARX"_u32> perf0;
+	// Retry timing is needed only when the previous failure can match this
+	// reservation. Both the exact-address and 128-byte comparisons below then
+	// retain their timestamp; ordinary loads need no profiling clock read.
+	perf_meter<"LARX"_u32> perf0(0);
+	if (g_cfg.core.perf_report || (addr & ~127u) == (ppu.last_faddr & ~127u))
+	{
+		perf0.restart();
+	}
 
 	// Do not allow stores accessed from the same cache line to past reservation load
 	atomic_fence_seq_cst();
@@ -3595,7 +3604,9 @@ extern u64 ppu_ldarx(ppu_thread& ppu, u32 addr)
 template <typename T>
 static bool ppu_store_reservation(ppu_thread& ppu, u32 addr, u64 reg_value)
 {
-	perf_meter<"STCX"_u32> perf0;
+	// Failure/retry timestamps are captured separately at the failure site.
+	perf_meter<"STCX"_u32> perf0(0);
+	if (g_cfg.core.perf_report) perf0.restart();
 
 	if (addr % sizeof(T))
 	{
diff --git a/rpcs3/Emu/Cell/SPUThread.cpp b/rpcs3/Emu/Cell/SPUThread.cpp
index 66a69563b..d30a9f352 100644
--- a/rpcs3/Emu/Cell/SPUThread.cpp
+++ b/rpcs3/Emu/Cell/SPUThread.cpp
@@ -3942,7 +3942,13 @@ bool spu_thread::do_mfc(bool can_escape, bool must_finish)
 	{
 		// Get commands' execution mask
 		// Mask bits are always set when mfc_transfers_shuffling is 0
-		return static_cast<u16>((0 - (1u << std::min<u32>(g_cfg.core.mfc_transfers_shuffling, size))) | utils::get_tsc());
+		const u32 shuffle_bits = std::min<u32>(g_cfg.core.mfc_transfers_shuffling, size);
+		if (!shuffle_bits) [[likely]]
+		{
+			// (-1 | timestamp) is always -1; no clock read is needed.
+			return u16{0xffff};
+		}
+		return static_cast<u16>((0 - (1u << shuffle_bits)) | utils::get_tsc());
 	};
 
 	// Process enqueued commands
diff --git a/rpcs3/Emu/NP/rpcn_config.cpp b/rpcs3/Emu/NP/rpcn_config.cpp
index 6665adbf7..6e9bdd0da 100644
--- a/rpcs3/Emu/NP/rpcn_config.cpp
+++ b/rpcs3/Emu/NP/rpcn_config.cpp
@@ -1,6 +1,8 @@
 #include "stdafx.h"
 #include "rpcn_config.h"
 #include "Utilities/File.h"
+#include <algorithm>
+#include <charconv>
 
 cfg_rpcn g_cfg_rpcn;
 
@@ -213,30 +215,31 @@ bool cfg_rpcn::del_host(std::string_view del_description, std::string_view del_h
 
 std::optional<std::pair<std::string, u16>> parse_rpcn_host(std::string_view host)
 {
-	if (host.empty())
+	// This is a hostname[:port], not a web URL. Preserve empty fields so
+	// malformed input cannot become a different, apparently valid endpoint.
+	const auto separator = host.find(':');
+	const auto hostname = host.substr(0, separator);
+	if (hostname.empty() || hostname.find_first_of("/\\?#@[]") != std::string_view::npos ||
+		std::any_of(host.begin(), host.end(), [](unsigned char c) { return c <= 0x20 || c == 0x7f; }))
 	{
-		rpcn_log.error("RPCN host is empty!");
-		return std::nullopt;
-	}
-
-	auto splithost = fmt::split(host, {":"});
-	if (splithost.size() != 1 && splithost.size() != 2)
-	{
-		rpcn_log.error("RPCN host is invalid!");
+		rpcn_log.error("RPCN host is invalid! Enter a server hostname, optionally followed by :port, without a web URL or spaces.");
 		return std::nullopt;
 	}
 
 	u16 port = 31313;
 
-	if (splithost.size() == 2)
+	if (separator != std::string_view::npos)
 	{
-		port = ::narrow<u16>(std::stoul(splithost[1]));
-		if (port == 0)
+		const auto text = host.substr(separator + 1);
+		u32 value = 0;
+		const auto [end, error] = std::from_chars(text.data(), text.data() + text.size(), value);
+		if (error != std::errc{} || end != text.data() + text.size() || value == 0 || value > 65535)
 		{
-			rpcn_log.error("RPCN port is invalid!");
+			rpcn_log.error("RPCN port is invalid! Enter a decimal port from 1 to 65535.");
 			return std::nullopt;
 		}
+		port = static_cast<u16>(value);
 	}
 
-	return std::make_pair(std::move(splithost[0]), port);
+	return std::make_pair(std::string(hostname), port);
 }
