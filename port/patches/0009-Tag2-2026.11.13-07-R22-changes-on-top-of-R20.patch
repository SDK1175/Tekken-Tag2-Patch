--- /dev/null
+++ b/rpcs3/rpcs3qt/tag2_launcher.h
@@ -0,0 +1,118 @@
+#pragma once
+#include <QWidget>
+#include <QGridLayout>
+#include <QVBoxLayout>
+#include <QLabel>
+#include <QPushButton>
+#include <QPainter>
+#include <QPixmap>
+#include <QCheckBox>
+#include <QPointer>
+#include <QSignalBlocker>
+#include <array>
+#include <functional>
+
+namespace tag2 {
+class LauncherArtwork final : public QWidget
+{
+    QPixmap artwork{QStringLiteral(":/tag2_launcher/artwork.png")};
+public:
+    explicit LauncherArtwork(QWidget* parent=nullptr) : QWidget(parent) { setMinimumHeight(230); }
+protected:
+    void paintEvent(QPaintEvent*) override
+    {
+        QPainter painter(this);
+        painter.setRenderHint(QPainter::SmoothPixmapTransform);
+        // The supplied reference already contains the characters and logo.
+        // Display its artwork area; the buttons below are real Qt controls.
+        if(!artwork.isNull())
+        {
+            const QSize fitted=QSize(artwork.width(),520).scaled(size(),Qt::KeepAspectRatio);
+            const QRect target((width()-fitted.width())/2,(height()-fitted.height())/2,fitted.width(),fitted.height());
+            painter.drawPixmap(target,artwork,QRect(0,0,artwork.width(),520));
+        }
+    }
+};
+// Uses the existing main-window actions; owns no emulator or update state.
+class Launcher final : public QWidget
+{
+public:
+    using Actions = std::array<std::function<void()>, 6>;
+    explicit Launcher(Actions actions, QWidget* parent = nullptr) : QWidget(parent)
+    {
+        setObjectName("tag2Launcher");
+        auto* layout = new QVBoxLayout(this);
+        layout->setContentsMargins(14, 0, 14, 14);
+        layout->setSpacing(12);
+        auto* title = new LauncherArtwork(this);
+        title->setObjectName("tag2Artwork");
+        layout->addWidget(title, 4);
+        auto* grid = new QGridLayout;
+        grid->setSpacing(14);
+        const std::array<const char*, 6> labels = {
+            "태그2 실행", "게임 패치 매니저", "옵션", "단축키 내역", "RPCN 가입", "종료"};
+        for (int i = 0; i < 6; ++i)
+        {
+            auto* button = new QPushButton(QString::fromUtf8(labels[i]), this);
+            button->setObjectName(QStringLiteral("tag2Action%1").arg(i));
+            button->setMinimumHeight(52);
+            grid->addWidget(button,i/2,i%2);
+            connect(button, &QPushButton::clicked, this, [action = std::move(actions[i])] {
+                if (action) action();
+            });
+        }
+        layout->addLayout(grid, 2);
+        frames = new QCheckBox(QString::fromUtf8("프레임표 표시"), this);
+        frames->setObjectName("tag2FrameDisplay");
+        frames->setToolTip(QString::fromUtf8("게임 중에는 Ctrl+F10으로 표시를 전환할 수 있어."));
+        frames->setEnabled(false);
+        layout->addWidget(frames);
+        version = new QLabel(QString::fromUtf8("현재 버전: 확인 중…"),this);
+        version->setObjectName("tag2LauncherVersion");
+        version->setTextFormat(Qt::PlainText);
+        version->setTextInteractionFlags(Qt::TextSelectableByMouse);
+        layout->addWidget(version);
+        status = new QLabel(this);
+        status->setObjectName("tag2LauncherStatus");
+        status->setWordWrap(true);
+        status->setMinimumHeight(44);
+        layout->addWidget(status);
+        setStyleSheet(QStringLiteral(
+            "QWidget#tag2Launcher {background:qlineargradient(x1:0,y1:0,x2:1,y2:1,"
+            "stop:0 #290a15,stop:0.48 #10131c,stop:1 #09283e);color:#eeeeee;}"
+            "QLabel#tag2Title {color:white;font-size:27px;font-weight:900;}"
+            "QLabel#tag2LauncherStatus {color:#c1cad7;font-size:12px;}"
+            "QLabel#tag2LauncherVersion {color:#d6e2ef;font-size:12px;}"
+            "QCheckBox#tag2FrameDisplay {color:#d6e2ef;font-size:13px;}"
+            "QCheckBox#tag2FrameDisplay:disabled {color:#8492a2;}"
+            "QWidget#tag2Launcher QPushButton {background:#182332;color:white;"
+            "border:1px solid #63788c;border-radius:7px;font-size:16px;font-weight:600;}"
+            "QWidget#tag2Launcher QPushButton:hover {background:#253e55;border-color:#8ecfff;}"
+            "QWidget#tag2Launcher QPushButton:focus {border:2px solid #b9e5ff;}"
+            "QWidget#tag2Launcher QPushButton:pressed {background:#751c29;}"
+            "QPushButton#tag2Action0 {border-color:#f04d60;background:#521723;}"));
+    }
+    QLabel* status = nullptr;
+    QLabel* version = nullptr;
+    QCheckBox* frames = nullptr;
+
+    void bindFrameControl(QCheckBox* control)
+    {
+        frame_source = control;
+        connect(frames, &QCheckBox::clicked, this, [this] {
+            if (frame_source && frame_source->isEnabled()) frame_source->click();
+            syncFrameControl();
+        });
+        syncFrameControl();
+    }
+
+    void syncFrameControl()
+    {
+        const QSignalBlocker blocker(frames);
+        frames->setEnabled(frame_source && frame_source->isEnabled());
+        frames->setChecked(frame_source && frame_source->isChecked());
+    }
+private:
+    QPointer<QCheckBox> frame_source;
+};
+}
