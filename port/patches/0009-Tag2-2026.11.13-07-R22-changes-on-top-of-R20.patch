diff --git a/rpcs3/rpcs3qt/tag2_release_version.h b/rpcs3/rpcs3qt/tag2_release_version.h
new file mode 100644
index 000000000..09a9f9b6a
--- /dev/null
+++ b/rpcs3/rpcs3qt/tag2_release_version.h
@@ -0,0 +1,38 @@
+#pragma once
+#include <QDate>
+#include <QJsonArray>
+#include <QJsonObject>
+#include <QRegularExpression>
+
+namespace tag2 {
+inline bool valid_display_version(const QString& value)
+{
+    const auto match=QRegularExpression("^([0-9]{4}\\.[0-9]{2}\\.[0-9]{2})-([0-9]{2,3})$").match(value);
+    return match.hasMatch() && QDate::fromString(match.captured(1),"yyyy.MM.dd").isValid()
+        && match.captured(2).toInt()>0;
+}
+inline QString release_version(const QString& identity,const QString& display={})
+{
+    if(valid_display_version(display))return display;
+    const auto match=QRegularExpression("^TAG2-RPCS3-([0-9]{8})-R([0-9]+)$").match(identity);
+    if(match.hasMatch())
+    {
+        const auto date=QDate::fromString(match.captured(1),"yyyyMMdd");
+        if(date.isValid())return QStringLiteral("R%1 (%2)").arg(match.captured(2),date.toString("yyyy.MM.dd"));
+    }
+    return QString::fromUtf8("확인 불가");
+}
+inline QString installed_version(const QJsonObject& manifest,const QString& executable_hash)
+{
+    const auto version=release_version(manifest["release_id"].toString(),manifest["display_version"].toString());
+    QString expected;int matches=0;
+    for(const auto value:manifest["files"].toArray())
+    {
+        const auto row=value.toObject();
+        if(row["path"]=="rpcs3.exe"){expected=row["sha256"].toString();++matches;}
+    }
+    if(matches!=1 || !QRegularExpression("^[0-9a-f]{64}$").match(executable_hash).hasMatch() || expected!=executable_hash)
+        return version+QString::fromUtf8(" · EXE 불일치");
+    return version;
+}
+}
