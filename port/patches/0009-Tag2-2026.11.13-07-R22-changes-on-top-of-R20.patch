+#pragma once
+#include <QFileInfo>
+#include <QMainWindow>
+#include <QToolBar>
+
+namespace tag2 {
+// The public/default executable keeps the existing UI. The optional local
+// entry is the same executable data in the same installation directory.
+inline bool simple_ui_requested(const QString& executable)
+{
+    return QFileInfo(executable).fileName().compare(
+        QStringLiteral("rpcs3_tag2.exe"), Qt::CaseInsensitive) == 0;
+}
+
+inline void attach_classic_panel(QMainWindow* window, QWidget* panel, const QString& version)
+{
+    auto* bar = new QToolBar(QString::fromUtf8("태그2"), window);
+    bar->setObjectName("tag2Toolbar");
+    bar->setMovable(false);
+    bar->addWidget(panel);
+    window->addToolBarBreak(Qt::TopToolBarArea);
+    window->addToolBar(Qt::TopToolBarArea, bar);
+    window->setWindowTitle(QString::fromUtf8("RPCS3 · 태그2 · ") + version);
+}
+}
